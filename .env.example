# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/receiptap"

# Random long string for session encryption — generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-real-random-secret"

# Square Developer credentials (developer.squareup.com)
SQUARE_APP_ID=""
SQUARE_APP_SECRET=""

# Google Sign-In (console.cloud.google.com -> APIs & Services -> Credentials)
# Used for the "Continue with Google" email-capture option on receipts.
# Add your production + localhost domains as Authorized JavaScript origins.
GOOGLE_CLIENT_ID=""

# Sign in with Apple (developer.apple.com -> Certificates, Identifiers & Profiles)
# APPLE_CLIENT_ID is the Services ID you register there (acts as the OAuth
# client_id) -- also requires a "Sign in with Apple" private key (.p8 file).
# Register both /merchant/apple/callback and /account/apple/callback as
# Return URLs on that Services ID (production + localhost).
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""   # contents of the downloaded .p8 file, with its real
                        # newlines replaced by literal \n so it fits on one line

# Sign in with Microsoft (portal.azure.com -> App registrations)
# Register both /merchant/microsoft/callback and /account/microsoft/callback
# as Redirect URIs (Web platform) on the app registration.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Anthropic API key (console.anthropic.com) — powers the AI receipt
# categorization feature (spending category + tax-deductibility suggestion).
# Best-effort: if this is unset, the rest of the app still works fine,
# receipts just won't get category badges.
ANTHROPIC_API_KEY=""

# Stripe (dashboard.stripe.com) — ReceipTap's own subscription billing.
# STRIPE_SECRET_KEY: Developers -> API keys -> Secret key (use the test-mode
#   key while developing; starts with sk_test_)
# STRIPE_PRICE_ID: Product catalog -> create a recurring monthly Price ->
#   copy its ID (starts with price_)
# STRIPE_WEBHOOK_SECRET: Developers -> Webhooks -> add endpoint pointing to
#   {your-domain}/webhooks/stripe, subscribe to customer.subscription.* and
#   invoice.payment_failed -> copy the signing secret (starts with whsec_)
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# Data retention purge (services/dataRetentionService.js, wired up daily in
# server.js). Windows themselves live in config/retention.js, not here.
# Must be the literal string "true" to enable LIVE deletion -- unset, empty,
# or anything else keeps every run in dry-run mode (reports what would be
# deleted, deletes nothing). Leave unset until the purge has been watched
# running in dry-run mode in production for a while and its dry-run
# PurgeLog output has actually been reviewed.
RETENTION_PURGE_ENABLED="false"

# Warranty expiry reminders (services/warrantyReminderService.js, wired up
# daily in server.js). Same convention as RETENTION_PURGE_ENABLED above --
# must be the literal string "true" to actually notify anyone; unset keeps
# every run in dry-run mode (logs what WOULD be sent, sends nothing, stamps
# nothing).
WARRANTY_REMINDERS_ENABLED="false"

# Public-facing base URL for links meant to be shared or clicked from
# outside this app (affiliate referral links, the partner-program card on a
# shopper's receipt, Stripe Connect onboarding callbacks). Without this, a
# link falls back to whatever host the page was loaded from -- "localhost"
# if you're viewing your own dashboard locally, which then gets copied and
# shared as if it were real. Set this to your real deployed domain, e.g.
# "https://receiptap.up.railway.app" or your custom domain.
APP_BASE_URL=""

# App environment
NODE_ENV="development"
PORT=3000

# Web push. Generate a pair with: npx web-push generate-vapid-keys
# Without these, push is simply off -- everything else still works.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@receiptap.com

# --- File storage -----------------------------------------------------------
# Where uploaded receipt photos, logos and profile photos are stored.
#
# Leave these unset in development and files go to public/uploads on local
# disk. That is NOT safe in production: a container's filesystem does not
# survive a redeploy, so every scanned receipt photo would be destroyed by an
# ordinary deploy while the database still points at it. A receipt photo is
# the record a tax authority actually accepts (see config/retention.js), so
# losing it loses the evidence.
#
# Set both to use Supabase Storage. The SERVICE key, not the anon key --
# these writes happen server-side for a user who must never reach the bucket
# directly. Create a PUBLIC bucket named below before deploying.
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
SUPABASE_STORAGE_BUCKET="uploads"

# --- Clover webhook ---------------------------------------------------------
# Shown in Clover's Developer Dashboard > Webhooks once a URL is configured.
# REQUIRED in production: without it every Clover webhook is refused, because
# an unverified endpoint lets anyone who finds the URL POST fabricated sales.
CLOVER_WEBHOOK_AUTH_TOKEN=""
