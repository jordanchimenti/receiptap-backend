# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/receiptap"

# Random long string for session encryption — generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-real-random-secret"

# Square Developer credentials (developer.squareup.com)
SQUARE_APP_ID=""
SQUARE_APP_SECRET=""
# Webhooks -> your subscription -> signature key. Square's HMAC is computed
# over (notification URL + raw body), so SQUARE_WEBHOOK_URL must be the exact
# URL registered in the Square dashboard, character for character -- a
# trailing slash difference is enough to make every signature check fail.
SQUARE_WEBHOOK_SIGNATURE_KEY=""
SQUARE_WEBHOOK_URL=""
# Sandbox-only. Powers the "Send test receipt" button by ringing a real
# sandbox sale; a merchant's own OAuth token is read-only and can't. Leave
# empty in production.
SQUARE_SANDBOX_TEST_TOKEN=""

# Clover Developer credentials (clover.com/developers)
CLOVER_APP_ID=""
CLOVER_APP_SECRET=""
# "production" switches to Clover's live API hosts. Anything else (including
# unset) stays on sandbox -- production is deliberately opt-in.
CLOVER_ENV="sandbox"
# Shared secret Clover sends back on each webhook. Unlike Square, Clover's
# check is a plain header compare, not an HMAC over the body.
CLOVER_WEBHOOK_AUTH_TOKEN=""

# Lightspeed Retail (X-Series) OAuth credentials
LIGHTSPEED_CLIENT_ID=""
LIGHTSPEED_CLIENT_SECRET=""

# Shopify app credentials (partners.shopify.com)
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""

# Google Sign-In (console.cloud.google.com -> APIs & Services -> Credentials)
# Used for the "Continue with Google" email-capture option on receipts.
# Add your production + localhost domains as Authorized JavaScript origins.
GOOGLE_CLIENT_ID=""

# Anthropic API key (console.anthropic.com) — powers the AI receipt
# categorization feature (spending category + tax-deductibility suggestion).
# Best-effort: if this is unset, the rest of the app still works fine,
# receipts just won't get category badges.
ANTHROPIC_API_KEY=""

# Stripe (dashboard.stripe.com) — ReceipTap's own subscription billing.
# STRIPE_SECRET_KEY: Developers -> API keys -> Secret key (use the test-mode
#   key while developing; starts with sk_test_)
# STRIPE_PRICE_ID: Product catalog -> create a recurring monthly Price ->
#   copy its ID (starts with price_)
# STRIPE_WEBHOOK_SECRET: Developers -> Webhooks -> add endpoint pointing to
#   {your-domain}/webhooks/stripe, subscribe to customer.subscription.* and
#   invoice.payment_failed -> copy the signing secret (starts with whsec_)
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# Data retention purge (services/dataRetentionService.js, wired up daily in
# server.js). Windows themselves live in config/retention.js, not here.
# Must be the literal string "true" to enable LIVE deletion -- unset, empty,
# or anything else keeps every run in dry-run mode (reports what would be
# deleted, deletes nothing). Leave unset until the purge has been watched
# running in dry-run mode in production for a while and its dry-run
# PurgeLog output has actually been reviewed.
RETENTION_PURGE_ENABLED="false"

# Public-facing base URL for links meant to be shared or clicked from
# outside this app (affiliate referral links, the partner-program card on a
# shopper's receipt, Stripe Connect onboarding callbacks). Without this, a
# link falls back to whatever host the page was loaded from -- "localhost"
# if you're viewing your own dashboard locally, which then gets copied and
# shared as if it were real. Set this to your real deployed domain, e.g.
# "https://receiptap.up.railway.app" or your custom domain.
APP_BASE_URL=""

# Resend (resend.com) -- transactional email. Today this is password resets
# only; there is no marketing/bulk sender in this app. Without
# RESEND_FROM_EMAIL, mail goes out from Resend's shared onboarding@resend.dev
# sandbox domain, which is fine for testing and wrong for production -- verify
# your own domain in Resend and set a real from-address before launch.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Comma-separated emails allowed into /admin. Unset means nobody is an owner
# and the admin panel is unreachable, which is the safe default.
ADMIN_EMAILS=""

# Base URL printed into NFC puck QR codes (routes/admin.js). Split out from
# APP_BASE_URL because pucks are physical objects -- once a QR is printed and
# stuck to a puck, that URL can never change. Falls back to the request's own
# host when unset.
PUCK_BASE_URL=""

# Where merchant-uploaded logos and profile photos are written on disk.
# MUST be set in production to a persistent volume's mount path (e.g.
# "/data/uploads"), or every redeploy wipes every uploaded logo -- and logos
# print on receipts. Unset falls back to public/uploads/ inside the repo,
# which is correct for local development. See lib/uploadPaths.js.
UPLOAD_DIR=""

# App environment
NODE_ENV="development"
PORT=3000
