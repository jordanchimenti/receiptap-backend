# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/receiptap"

# Random long string for session encryption — generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-real-random-secret"

# Square Developer credentials (developer.squareup.com)
SQUARE_APP_ID=""
SQUARE_APP_SECRET=""

# Google Sign-In (console.cloud.google.com -> APIs & Services -> Credentials)
# Used for the "Continue with Google" email-capture option on receipts.
# Add your production + localhost domains as Authorized JavaScript origins.
GOOGLE_CLIENT_ID=""

# Anthropic API key (console.anthropic.com) — powers the AI receipt
# categorization feature (spending category + tax-deductibility suggestion).
# Best-effort: if this is unset, the rest of the app still works fine,
# receipts just won't get category badges.
ANTHROPIC_API_KEY=""

# Stripe (dashboard.stripe.com) — ReceipTap's own subscription billing.
# STRIPE_SECRET_KEY: Developers -> API keys -> Secret key (use the test-mode
#   key while developing; starts with sk_test_)
# STRIPE_PRICE_ID: Product catalog -> create a recurring monthly Price ->
#   copy its ID (starts with price_)
# STRIPE_WEBHOOK_SECRET: Developers -> Webhooks -> add endpoint pointing to
#   {your-domain}/webhooks/stripe, subscribe to customer.subscription.* and
#   invoice.payment_failed -> copy the signing secret (starts with whsec_)
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# App environment
NODE_ENV="development"
PORT=3000
