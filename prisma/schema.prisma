// prisma/schema.prisma
// One real, complete schema — merges everything built across this project.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Merchant — a business using ReceipTap
// ---------------------------------------------------------------------------
model Merchant {
  id           String   @id @default(cuid())
  businessName String
  ownerName    String? // the person's own name, e.g. "Welcome back, Jordan" -- distinct from businessName
  profilePhotoUrl String? // the person's own avatar photo, shown top-right in the dashboard rail
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  isActive     Boolean  @default(true) // false once a merchant deactivates their own account

  // Square OAuth
  squareMerchantId  String? @unique
  squareAccessToken String?

  // Shopify OAuth (POS / storefront)
  shopifyShopDomain   String? @unique
  shopifyAccessToken  String?

  // Billing — ReceipTap's own subscription (merchant pays ReceipTap monthly).
  // Trial lives in Stripe: card collected at checkout, 30-day trial, then
  // auto-charge. INCOMPLETE = signed up but hasn't completed checkout yet.
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  subscriptionStatus   SubscriptionStatus @default(INCOMPLETE)
  trialEndsAt          DateTime?

  pucks             Puck[]
  issuedReceipts    Transaction[]  @relation("IssuedReceipts")
  collectedExpenses Transaction[]  @relation("CollectedExpenses")
  receiptTheme      ReceiptTheme?
  loyaltyProgram    LoyaltyProgram?
  loyaltyCards      LoyaltyCard[]

  // Affiliate program -- set if this merchant signed up via someone's
  // referral link. A merchant can ALSO be an affiliate themselves (their own
  // "Refer & Earn" page reuses this same merchant login) via ownAffiliateAccount.
  referredByAffiliateId String?
  referredByAffiliate   Affiliate?   @relation("ReferredMerchants", fields: [referredByAffiliateId], references: [id])
  ownAffiliateAccount   Affiliate?   @relation("AffiliateOwnMerchant")
  commissionsGenerated  Commission[]
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

// ---------------------------------------------------------------------------
// Puck — a physical NFC device
// ---------------------------------------------------------------------------
model Puck {
  id        String     @id // short unique ID, e.g. "K7mP2xQ9wZ" — encoded on the NFC chip as /r/{id}
  claimCode String     @unique // 6-char code printed on the insert card

  status    PuckStatus @default(UNCLAIMED)
  source    PuckSource @default(BATCH) // BATCH = scripts/generate-batch.js hardware order, ADMIN = one-off /admin/pucks button

  merchantId    String?
  merchant      Merchant? @relation(fields: [merchantId], references: [id])
  posLocationId String?   // which Square location this puck belongs to
  posDeviceId   String?   // which SPECIFIC register/terminal within that location — needed when a store has 2+ lanes

  currentTransactionId String?
  transactionExpiresAt DateTime?

  createdAt  DateTime  @default(now())
  claimedAt  DateTime?

  @@index([merchantId])
  @@index([claimCode])
}

enum PuckStatus {
  UNCLAIMED
  CLAIMED
}

enum PuckSource {
  BATCH
  ADMIN
}

// ---------------------------------------------------------------------------
// Transaction — one sale, saved from a POS webhook
// ---------------------------------------------------------------------------
model Transaction {
  id            String   @id // reuse the POS's own transaction ID
  merchantId    String   // who ISSUED the receipt (the seller)
  merchant      Merchant @relation("IssuedReceipts", fields: [merchantId], references: [id])

  posProvider   String   // "square" | "shopify" | "clover" | "toast" | ...
  posLocationId String?
  posDeviceId   String?  // which specific register/terminal rang this up, if Square provided one

  lineItems     Json     // [{ name, quantity, unitPrice, total }]
  subtotal      Int      // cents
  tax           Int      // cents
  total         Int      // cents
  paymentMethod String?

  // Consumer wallet — set only if a customer explicitly claims this receipt
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // AI categorization — populated after a customer/merchant saves this receipt.
  // Null until categorized; categorization is best-effort and never blocks the save.
  aiCategory       String?  // e.g. "Food & Drink", "Office Supplies", "Hardware & Tools"
  aiTaxDeductible  Boolean?
  aiReasoning      String?  // short human-readable explanation, shown as a tooltip
  aiCategorizedAt  DateTime?

  // Merchant expense tracking — set only if a DIFFERENT merchant claims this
  // as a purchase they made (buying from another ReceipTap merchant)
  collectedByMerchantId String?
  collectedByMerchant   Merchant? @relation("CollectedExpenses", fields: [collectedByMerchantId], references: [id])

  createdAt DateTime @default(now())

  @@index([merchantId])
  @@index([customerId])
  @@index([collectedByMerchantId])
}

// ---------------------------------------------------------------------------
// ReceiptTheme — one row per merchant, the customizable receipt branding
// ---------------------------------------------------------------------------
model ReceiptTheme {
  merchantId String   @id
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  layoutId     String  @default("classic") // "classic" | "modern" | "minimal" — which structural template to render
  logoUrl      String?
  displayName  String? // shown on receipts instead of Merchant.businessName, if set -- lets a merchant show a nicer/different name to customers without renaming their actual account
  location     String? // free-text address/location line, shown on receipts if set -- e.g. "123 Main St, Springfield" -- not tied to any Location model, just display text
  primaryColor String  @default("#111111")
  accentColor  String  @default("#2563eb")

  headerText String?
  footerText String?

  showGoogleReview Boolean @default(false)
  googleReviewUrl  String?
  showWarranty     Boolean @default(false)
  showWalletSave   Boolean @default(true)

  // Social links shown as clickable icons on receipts -- each is optional,
  // and its icon only renders if a URL is set.
  instagramUrl String?
  facebookUrl  String?
  tiktokUrl    String?
  xUrl         String?
  youtubeUrl   String?
  linkedinUrl  String?

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// LoyaltyProgram — one merchant's punch-card settings (their offer)
// ---------------------------------------------------------------------------
model LoyaltyProgram {
  merchantId String   @id
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  enabled Boolean @default(false)

  offerType  String @default("PERCENT") // "PERCENT" | "AMOUNT"
  offerValue Int    @default(10)        // percent (1-100) if PERCENT, cents if AMOUNT

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// LoyaltyCard — one customer's punch card at one merchant. Punches accrue as
// they link more receipts to their account; once full they can request a
// redemption code, the merchant confirms it in person, and the customer signs
// on their own phone -- at which point the card resets for the next cycle.
// ---------------------------------------------------------------------------
model LoyaltyCard {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  punches Int @default(1) // 0-5

  redemptionStatus String    @default("NONE") // NONE | PENDING | CONFIRMED
  redemptionCode   String? // short code the customer reads off to the cashier
  lastSignatureUrl String?   @db.Text // most recent redemption's signature, kept for the merchant's own record
  lastRedeemedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([merchantId, customerId])
  @@index([redemptionCode])
}

// ---------------------------------------------------------------------------
// Affiliate — refers new merchants to ReceipTap and earns a recurring
// commission on their subscription. Two kinds, same table:
//   MERCHANT — an existing ReceipTap merchant referring others. They use
//     their normal merchant login (no separate password) via
//     Merchant.ownAffiliateAccount; earns 20% while their OWN subscription
//     is active, and stops earning new commissions (without losing past
//     ones) if it lapses.
//   REGULAR — a standalone affiliate (e.g. future sales team) with their own
//     signup/login, not tied to any Merchant account; flat 15%.
// ---------------------------------------------------------------------------
model Affiliate {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String? // only set for REGULAR -- MERCHANT type authenticates via their existing merchant session
  type         AffiliateType @default(REGULAR)
  referralCode String        @unique // used as ?ref=CODE on the merchant signup link

  merchantId String?   @unique // set only when type = MERCHANT
  merchant   Merchant? @relation("AffiliateOwnMerchant", fields: [merchantId], references: [id])

  // Stripe Connect Express account -- required before any payout can be sent
  stripeConnectAccountId String?  @unique
  stripeConnectOnboarded Boolean  @default(false)

  createdAt DateTime @default(now())

  referredMerchants Merchant[]   @relation("ReferredMerchants")
  commissions       Commission[]
}

enum AffiliateType {
  MERCHANT
  REGULAR
}

// ---------------------------------------------------------------------------
// Commission — one payout-eligible amount, generated from one successful
// Stripe invoice payment on a referred merchant's subscription.
// ---------------------------------------------------------------------------
model Commission {
  id String @id @default(cuid())

  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])
  merchantId  String
  merchant    Merchant  @relation(fields: [merchantId], references: [id])

  stripeInvoiceId  String            @unique // idempotency: one commission per invoice paid
  amountCents      Int
  rate             Int // the % applied at the time (15 or 20) -- kept for audit even if rates change later
  status           CommissionStatus  @default(PENDING)
  stripeTransferId String?

  createdAt DateTime  @default(now())
  paidAt    DateTime?
}

enum CommissionStatus {
  PENDING
  PAID
  FAILED
}

// ---------------------------------------------------------------------------
// Customer — a consumer with a personal receipt wallet across ALL merchants
// ---------------------------------------------------------------------------
model Customer {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String?
  googleId     String?       @unique // set if they signed in with Google instead of email
  name         String?
  createdAt    DateTime      @default(now())

  transactions Transaction[]
  loyaltyCards LoyaltyCard[]
}
