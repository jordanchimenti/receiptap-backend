// prisma/schema.prisma
// One real, complete schema — merges everything built across this project.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Merchant — a business using ReceipTap
// ---------------------------------------------------------------------------
model Merchant {
  id                String    @id @default(cuid())
  businessName      String
  ownerName         String? // the person's own name, e.g. "Welcome back, Jordan" -- distinct from businessName
  ownerPhone        String? // the person's own phone number, optional -- account/login contact info, not shown on a receipt (that's ReceiptTheme.phone, a separate field)
  // ISO 3166-1 alpha-2 of the country picked in the phone input's dropdown
  // (see lib/countryPhoneCodes.js) -- lets the dropdown remember what was
  // selected rather than resetting to the default on every page load.
  // Cosmetic pairing with ownerPhone only; never validated against it.
  ownerPhoneCountry String?   @default("CA")
  profilePhotoUrl   String? // the person's own avatar photo, shown top-right in the dashboard rail
  email             String    @unique
  passwordHash      String? // null for accounts created via "Sign in with Google" that never set a password
  googleId          String?   @unique // set if they signed in with Google instead of email/password
  appleId           String?   @unique // set if they signed in with Apple instead of email/password
  microsoftId       String?   @unique // set if they signed in with Microsoft instead of email/password
  createdAt         DateTime  @default(now())
  isActive          Boolean   @default(true) // false once a merchant deactivates their own account
  deactivatedAt     DateTime? // when isActive went false -- services/dataRetentionService.js needs this to compute the DEACTIVATED_MERCHANT_PURGE_DAYS window; there is no reactivation flow anywhere in the app, so this is never cleared once set
  dataPurgedAt      DateTime? // set once purgeDeactivatedMerchants() has scrubbed this merchant -- prevents reprocessing an already-purged row on every future run

  // Business Settings ("Business Profile" / "Business Address") -- printed
  // on every receipt/PDF a customer receives (see views/receipt.ejs's
  // businessAddressLines and views/receipt-layouts/*.ejs), except industry,
  // which stays account-only. phone/gstHstNumber live on ReceiptTheme
  // instead, reused rather than duplicated -- see Business Settings' own
  // comment in views/business-settings.ejs.
  businessEmail     String? // public-facing contact email, separate from the login email above
  website           String?
  industry          String?
  addressLine1      String?
  addressLine2      String? // suite/unit/level, optional
  addressCity       String?
  addressRegion     String? // state/province
  addressPostalCode String?
  addressCountry    String?

  // "Forgot password?" flow -- token is single-use (cleared on success) and
  // expires 1 hour after being issued, whichever comes first.
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?

  // Email verification -- demo-tier only (see routes/auth.js). Demo signup
  // is the only free, no-card path in the app, so it's the cheapest one to
  // fake an address on. Paid signups never touch these fields (Stripe
  // checkout already implicitly validates the person). A demo account
  // created via Google sign-in gets emailVerifiedAt set immediately instead
  // of going through the token below, since Google already verified it.
  emailVerifiedAt                 DateTime?
  emailVerificationToken          String?   @unique
  emailVerificationTokenExpiresAt DateTime?

  // Square OAuth. The access token DOES expire -- 30 days -- contrary to
  // what a comment here used to claim; that was wrong, and this codebase
  // ran on an already-dead token in production for weeks before the gap
  // was caught (2026-09-05). squareAccessTokenExpiresAt (an ISO timestamp,
  // Square's own format -- unlike Clover's unix-seconds field below) lets
  // services/squareService.js's getValidAccessToken know when to use
  // squareRefreshToken to get a new one before making an API call. Every
  // Square API call in this app must go through that function now, never
  // read merchant.squareAccessToken directly.
  squareMerchantId           String?   @unique
  squareAccessToken          String?
  squareRefreshToken         String?
  squareAccessTokenExpiresAt DateTime?

  // Shopify OAuth (POS / storefront)
  shopifyShopDomain  String? @unique
  shopifyAccessToken String?

  // Clover OAuth. Access token expires
  // (v2/OAuth flow, 30 min) -- cloverAccessTokenExpiresAt lets
  // services/cloverService.js know when to use cloverRefreshToken to get
  // a new one before making an API call.
  cloverMerchantId           String?   @unique
  cloverAccessToken          String?
  cloverRefreshToken         String?
  cloverAccessTokenExpiresAt DateTime?

  // Lightspeed Retail (X-Series) OAuth. Like Clover, the access token
  // expires -- services/lightspeedService.js's getValidAccessToken uses
  // lightspeedAccessTokenExpiresAt the same way cloverService.js does.
  // Unlike Clover, the refresh token itself ROTATES on every refresh (the
  // old one is revoked the moment a new one is issued), so both tokens get
  // overwritten together on every refresh, never just the access token.
  // lightspeedDomainPrefix identifies which X-Series retailer this is --
  // X-Series has no separate numeric merchant ID the way Square/Clover do;
  // API calls are made against https://{domainPrefix}.retail.lightspeed.app.
  lightspeedDomainPrefix         String?   @unique
  lightspeedAccessToken          String?
  lightspeedRefreshToken         String?
  lightspeedAccessTokenExpiresAt DateTime?
  // Cursor for services/lightspeedPoller.js -- Lightspeed's own API docs say
  // webhook delivery "cannot be guaranteed" and recommend polling instead, so
  // this is the backstop: the highest sale version number (Sale._metadata
  // .version) already seen, so the next poll only asks for sales newer than
  // this. BigInt, not Int -- confirmed live that real version numbers (55+
  // billion on a brand new trial store) already exceed a 32-bit integer;
  // this is some kind of global/sharded counter, not a small per-retailer
  // one despite Lightspeed's own docs calling it that. Null until the first
  // poll after connecting.
  lightspeedLastSaleVersion BigInt?

  // Toast POS. Unlike Square/Clover/Lightspeed, there is no redirect-based
  // OAuth here -- Toast's self-serve "Standard API access" has the MERCHANT
  // generate a static clientId/clientSecret themselves in their own Toast
  // Web account (requires their own Toast RMS Essentials+ subscription) and
  // hand them to this app directly. A real OAuth-style "any merchant clicks
  // Connect" flow requires Toast's own Partner Integration Program, a
  // separate, gatekept business approval this app doesn't have (see
  // routes/toast.js). toastAccessToken/ExpiresAt are this app's own cache of
  // the token that clientId/clientSecret produce -- re-requested only when
  // expired, never more than roughly once a day, because Toast's
  // authentication endpoint enforces a hard cap of 2 requests per hour per
  // IP and can terminate API access over-requesting it.
  toastRestaurantGuid       String?   @unique
  toastClientId             String?
  toastClientSecret         String?
  toastAccessToken          String?
  toastAccessTokenExpiresAt DateTime?
  // Cursor for services/toastPoller.js. Toast's Orders API has no webhook
  // available at the Standard API tier (webhook registration appears to be
  // Partner-program-only, and there's no way to confirm otherwise without
  // one) -- polling is the only mechanism this app can rely on, so it's the
  // primary path here, not a backstop the way it is for Lightspeed. Stores
  // the end of the last successfully-polled time window (not a version
  // number -- Toast's API has no such cursor); the next poll resumes from
  // here, in at-most-1-hour chunks (Toast's startDate/endDate query only
  // accepts up to a 1-hour range). Null until the first poll after
  // connecting.
  toastLastPollAt DateTime?

  // Billing — ReceipTap's own subscription (merchant pays ReceipTap monthly).
  // Trial lives in Stripe: card collected at checkout, 30-day trial, then
  // auto-charge. INCOMPLETE = signed up but hasn't completed checkout yet.
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  subscriptionStatus   SubscriptionStatus @default(INCOMPLETE)
  trialEndsAt          DateTime?

  // Free tier: signed up with no card at all, specifically to design their
  // receipt before committing to a paid plan. Never has a Stripe
  // subscription -- middleware/demoAccountGate.js restricts these accounts
  // to receipt design + billing (to upgrade) only; requireActiveSubscription
  // (middleware/subscriptionGate.js) explicitly skips its own check for them
  // rather than blocking on the permanently-INCOMPLETE subscriptionStatus.
  isDemoAccount Boolean @default(false)

  // Same as Customer.homeScreenAddedAt -- first time this merchant opened the
  // business dashboard from their home screen.
  homeScreenAddedAt DateTime?

  // Hardware return shipping label -- set alongside Puck.returnDeadlineAt
  // (see syncPuckReturnWindows() in services/stripeService.js) when
  // services/easypostService.js successfully buys a real prepaid label for
  // the merchant's currently-unreturned pucks. Merchant-level, not
  // per-puck: this app only ever has one active return window/batch open
  // at a time (every unreturned puck gets the same deadline together, and
  // a restart clears them all together), so one label naturally covers
  // whatever's outstanding rather than needing a label per puck. Cleared
  // in the same restart branch that clears returnDeadlineAt. Null if
  // EASYPOST_API_KEY isn't configured, the merchant's address on file
  // can't be rated, or EasyPost is down -- the return-notice email still
  // goes out either way, just without a label attached (see
  // services/emailService.js's sendReturnPucksEmail).
  returnLabelUrl         String?
  returnTrackingCode     String?
  returnTrackingUrl      String?
  returnLabelGeneratedAt DateTime?

  pucks                 Puck[]
  hardwareOrders        HardwareOrder[]
  issuedReceipts        Transaction[]          @relation("IssuedReceipts")
  collectedExpenses     Transaction[]          @relation("CollectedExpenses")
  receiptTheme          ReceiptTheme?
  loyaltyProgram        LoyaltyProgram?
  loyaltyCards          LoyaltyCard[]
  legalAcceptances      LegalAcceptance[]
  purgeLogsInitiated    PurgeLog[]
  emailSuppressions     EmailSuppression[]
  notifications         Notification[]
  merchantNotifications MerchantNotification[]

  // Affiliate program -- set if this merchant signed up via someone's
  // referral link. A merchant can ALSO be an affiliate themselves (their own
  // "Refer & Earn" page reuses this same merchant login) via ownAffiliateAccount.
  referredByAffiliateId String?
  referredByAffiliate   Affiliate?   @relation("ReferredMerchants", fields: [referredByAffiliateId], references: [id])
  ownAffiliateAccount   Affiliate?   @relation("AffiliateOwnMerchant")
  commissionsGenerated  Commission[]
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

// ---------------------------------------------------------------------------
// Puck — a physical NFC device
// ---------------------------------------------------------------------------
model Puck {
  id        String @id // short unique ID, e.g. "K7mP2xQ9wZ" — encoded on the NFC chip as /r/{id}
  claimCode String @unique // 6-char code printed on the insert card

  status PuckStatus @default(UNCLAIMED)
  source PuckSource @default(BATCH) // BATCH = scripts/generate-batch.js hardware order, ADMIN = one-off /admin/pucks button

  merchantId    String?
  merchant      Merchant? @relation(fields: [merchantId], references: [id])
  posLocationId String? // which POS location this puck belongs to (Square location, Clover merchant, ...)
  posDeviceId   String? // which SPECIFIC register/terminal within that location — needed when a store has 2+ lanes

  currentTransactionId String?
  transactionExpiresAt DateTime?

  // Set when a merchant taps their own puck to pair it and there is no recent
  // unassigned sale to bind it to yet -- it waits, and the next sale that
  // arrives from a register no puck covers claims it. The ReceipTaps page has
  // shown a "Pairing right now" state and filter for this all along; the
  // column was simply never added, so it always read false (there is a note
  // to that effect in computePucksData).
  awaitingSaleAssignment DateTime?

  createdAt DateTime  @default(now())
  claimedAt DateTime?

  // Hardware return tracking (Terms of Service, "Hardware (NFC pucks)"
  // section) -- set on every puck a merchant currently has when their
  // subscription is canceled (see syncPuckReturnWindows() in
  // services/stripeService.js), cleared if they restart before returning
  // it. Tracking only -- the $60 USD replacement fee itself is still
  // charged by hand in Stripe if the deadline passes with no return; see
  // docs/LEGAL_REVIEW_NOTES.md item 7 for why that isn't automated (yet).
  returnDeadlineAt DateTime?
  returnedAt       DateTime? // set from /admin/pucks once the founder confirms a puck physically arrived back

  @@index([merchantId])
  @@index([claimCode])
}

enum PuckStatus {
  UNCLAIMED
  CLAIMED
}

enum PuckSource {
  BATCH
  ADMIN
}

// ---------------------------------------------------------------------------
// HardwareOrder — a merchant paying the flat per-shipment shipping fee
// (services/stripeService.js's SHIPPING_FEE_CENTS, $25 USD, disclosed in the
// Terms' "Hardware (NFC pucks)" -> "Shipping" section) to have a puck sent
// to them -- either their first one, or an additional one requested later
// ("Additional pucks may be requested and are subject to availability," same
// Terms section). This is the standalone purchase flow that section's own
// code comment used to say wasn't built yet -- see
// services/hardwareOrderService.js.
//
// This does NOT create or assign a Puck row. Which physical puck goes in the
// box is still a manual pick from admin's unclaimed inventory (source BATCH
// or ADMIN), same as always -- HardwareOrder only tracks the payment, the
// outbound shipping label/tracking, and the notifications around them. Once
// it physically arrives, the merchant links it to their account the same
// way they always have: entering its claimCode.
// ---------------------------------------------------------------------------
model HardwareOrder {
  id          String @id @default(cuid())
  orderNumber String @unique // human-friendly, e.g. "RT-7F3K9Q" -- shown to the buyer, not the cuid

  // Exactly one of these two is set, never both, never neither -- enforced
  // in code (services/hardwareOrderService.js's create functions), not a DB
  // constraint. A merchant orders pucks for their own registers; a REGULAR
  // affiliate (see prisma's Affiliate model comment) orders pucks to keep on
  // hand and hand-deliver to businesses they're signing up -- same order/
  // payment/shipping/tracking machinery either way, just a different buyer.
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id])
  affiliateId String?
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id])

  quantity         Int // how many pucks this shipment is for
  shippingFeeCents Int // snapshot of SHIPPING_FEE_CENTS at order time -- the flat per-shipment charge, not per-unit

  // Shipping address snapshot -- copied from Merchant.address* or
  // Affiliate.address* at order time (see routes/account-business.js and
  // routes/affiliates.js), not a live reference. Whoever ordered it
  // updating their address later shouldn't silently change where an
  // already-placed order ships to.
  shippingName       String
  shippingStreet1    String
  shippingStreet2    String?
  shippingCity       String
  shippingRegion     String
  shippingPostalCode String
  shippingCountry    String  @default("CA")
  shippingPhone      String?

  status HardwareOrderStatus @default(PENDING_PAYMENT)

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String?

  // Set by services/hardwareOrderService.js the moment payment is confirmed
  // (best-effort, same "never block, null on any failure" pattern as
  // services/easypostService.js's createReturnLabel). easypostTrackerId is
  // what services/hardwareOrderService.js's tracking-refresh job matches
  // incoming status against.
  labelUrl          String?
  trackingCode      String?
  trackingUrl       String?
  easypostTrackerId String? @unique

  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([merchantId, createdAt])
  @@index([affiliateId, createdAt])
}

enum HardwareOrderStatus {
  PENDING_PAYMENT // Stripe Checkout session created, not yet paid
  PAID // payment confirmed, label not bought yet (or EasyPost failed/not configured)
  LABEL_PURCHASED // prepaid label bought, not yet scanned by the carrier
  IN_TRANSIT // EasyPost tracker reports movement
  DELIVERED
  CANCELED
}

// ---------------------------------------------------------------------------
// Transaction — one sale, saved from a POS webhook
// ---------------------------------------------------------------------------
model Transaction {
  id         String   @id // reuse the POS's own transaction ID
  merchantId String // who ISSUED the receipt (the seller)
  merchant   Merchant @relation("IssuedReceipts", fields: [merchantId], references: [id])

  posProvider   String // "square" | "shopify" | "clover" | "toast" | ...
  posLocationId String?
  posDeviceId   String? // which specific register/terminal rang this up, if the POS provided one
  orderNumber   String? // the POS's own order identifier -- distinct from `id` (the payment ID) where the two differ

  lineItems     Json // [{ name, quantity, unitPrice, total }]
  subtotal      Int // cents
  tax           Int // cents
  discountTotal Int     @default(0) // cents, order-level discount already reflected in subtotal/total
  total         Int // cents
  paymentMethod String?

  // Payment detail, captured only where the POS actually reports it. Every
  // field is nullable and stays null rather than being inferred: a receipt
  // showing the wrong card tail or approval code is worse than one showing
  // neither. Square and Clover supply all of these; Shopify supplies the card
  // brand/tail on orders that carry payment_details; Lightspeed's X-Series
  // sale payload returned an empty payments array on a real sale, so nothing
  // is captured there (see routes/webhooks.js).
  cardBrand           String? // "Visa", "Mastercard", ...
  cardLast4           String? // last four digits only -- never a full PAN
  authCode            String? // issuer approval / authorization code
  amountTenderedCents Int? // cash handed over
  changeDueCents      Int? // cash returned

  // SHA-256 of Square's card_details.card.fingerprint, captured at sale time.
  // The raw fingerprint is never stored -- not here, not in a log.
  //
  // Why it lands on the transaction rather than going straight to
  // ShopperIdentifier: the webhook fires when the card is dipped, and at that
  // moment there is no shopper and no consent -- both arrive later, when
  // someone saves the receipt. This column is the only bridge between those
  // two events, since the raw value is unrecoverable afterwards.
  //
  // On its own it identifies nobody: it is payment metadata sitting beside
  // cardLast4 and authCode, scoped to one receipt, and deleted with it by the
  // existing retention jobs. It is ONLY ever linked to a person in
  // ShopperIdentifier, and only on explicit cross-merchant consent.
  cardFingerprintHash String?

  // True when this receipt landed in a wallet by card recognition rather than
  // by someone tapping. Provenance, not decoration: a shopper looking at a
  // receipt they never tapped for deserves to be told why it's there, and a
  // DSAR needs to distinguish "they handed us this" from "we matched them".
  autoSavedViaRecognition Boolean @default(false)

  // Consumer wallet — set only if a customer explicitly claims this receipt
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // AI categorization — populated after a customer/merchant saves this receipt.
  // Null until categorized; categorization is best-effort and never blocks the save.
  aiCategory      String? // e.g. "Food & Drink", "Office Supplies", "Hardware & Tools"
  aiTaxDeductible Boolean?
  aiReasoning     String? // short human-readable explanation, shown as a tooltip
  aiCategorizedAt DateTime?

  // The customer's own call on deductibility, which OVERRIDES aiTaxDeductible.
  // Deliberately a separate column rather than overwriting the AI's answer:
  // null means "nobody has disagreed", so the suggestion still shows and a
  // later re-categorisation is free to change it, while an explicit true/false
  // is a decision the AI must never quietly undo. It's the customer's tax
  // return -- see lib/receiptDeductible.js for how the two combine.
  taxDeductible Boolean?

  // Warranty tracking -- same shape as deductibility: the model estimates
  // from what was bought, the customer's own number (if they give one)
  // always wins. See lib/receiptWarranty.js.
  aiWarrantyMonths          Int? // the model's estimate; null = not the kind of purchase that typically carries one
  warrantyMonths            Int? // customer's correction; null = defer to the AI, 0 = "no warranty" (explicit)
  // Stored, not derived on read -- computeWarrantyExpiry() in
  // lib/receiptWarranty.js is the ONLY place this is computed, called from
  // both the categorization write path and the override route, so the
  // reminder job's date-range scan can never disagree with what the wallet
  // shows on screen.
  warrantyExpiresAt         DateTime?
  // Per-stage dedupe so the daily reminder job never double-sends. Reset to
  // null by the override route whenever warrantyExpiresAt changes -- a
  // stale flag from the wrong original date would otherwise silently
  // suppress the reminder the customer actually needs after a correction.
  warranty14dReminderSentAt DateTime?
  warranty3dReminderSentAt  DateTime?

  // Merchant expense tracking — set only if a DIFFERENT merchant claims this
  // as a purchase they made (buying from another ReceipTap merchant)
  collectedByMerchantId String?
  collectedByMerchant   Merchant? @relation("CollectedExpenses", fields: [collectedByMerchantId], references: [id])

  // --- Seller identity + tax snapshot ---------------------------------------
  // What was actually true about the merchant on the sale date, resolved from
  // Merchant + ReceiptTheme (or their documented defaults, if no ReceiptTheme
  // row exists yet -- see lib/receiptSnapshot.js) at the moment this row is
  // written, and never touched again. Merchant and ReceiptTheme themselves
  // stay fully mutable -- this is what lets a receipt keep stating what was
  // true on its own date after the merchant later edits their profile.
  // Nullability mirrors the source column's own nullability.
  //
  // sellerName is what was actually PRINTED (theme.displayName ||
  // merchant.businessName) -- sellerLegalName is Merchant.businessName
  // unconditionally, even when a displayName overrode it on the receipt, so
  // the legal entity behind the sale is still on record when the two differ.
  sellerName              String
  sellerLegalName         String?
  sellerAddressLine1      String?
  sellerAddressLine2      String?
  sellerAddressCity       String?
  sellerAddressRegion     String?
  sellerAddressPostalCode String?
  sellerAddressCountry    String?
  sellerGstHstNumber      String?
  sellerTaxNumberLabel    String?
  sellerTaxNumber2        String?
  sellerTaxNumber2Label   String?
  sellerTaxLabel          String  @default("Tax")

  // ISO 4217 code read from the POS payload, where the provider reports one.
  // Square and Shopify orders both carry a currency on their money fields;
  // Clover and Lightspeed don't expose one anywhere this app already fetches,
  // so those two handlers leave this null rather than guess.
  currency String?

  // Second tax amount in cents, pairing with sellerTaxNumber2/Label above the
  // same way ReceiptTheme.taxNumber2 already pairs with gstHstNumber. Schema
  // only -- no handler populates this yet, since no POS payload gives a
  // reliable type-attributed split (Square's order.taxes[] and Shopify's
  // tax_lines[] are both free-text-named, not GST/PST-typed).
  tax2 Int?

  // Why this was bought. Same field, same reasoning, as
  // ScannedReceipt.businessPurpose -- NOT on any POS payload, since a
  // register has no way to ask. It's the taxpayer's own note, and for US
  // travel, meals, gifts and listed property it's a hard requirement under
  // section 274(d) regardless of whether the receipt was tapped or
  // photographed: a receipt proves what was spent, never what it was for.
  // No UI writes this as of 2026-09-05 (founder decision -- removed the
  // editable "What it was for" section on views/receipt.ejs/scanned-receipt.ejs
  // rather than ask a customer to type it in) -- stays null for every
  // receipt now. Column and the missingSubstantiationFields flag for it
  // both kept rather than dropped, since the field is still real and a
  // future UI could write it again.
  businessPurpose String?

  // The buyer's name. NOT on any POS payload -- a register has no way to
  // ask -- so this is filled at the moment a shopper claims the receipt
  // (services/claimReceipt.js, services/receiptAutoSave.js) with their own
  // wallet profile name (Customer.name), which is required at signup
  // specifically so this is never blank for an account that has one (see
  // routes/customer-account.js's flagIfNameMissing). No longer editable
  // per-receipt as of 2026-09-05 -- the "Billed to" correction card on
  // views/receipt.ejs was removed; this is meant to be fully automatic now,
  // sourced only from the account's own name. CRA requires the buyer be
  // named once a purchase reaches $500 (see lib/receiptMissingFields.js).
  buyerName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shopperConsents ShopperConsent[]

  @@index([merchantId])
  @@index([customerId])
  @@index([collectedByMerchantId])
  @@index([warrantyExpiresAt])
}

// ---------------------------------------------------------------------------
// ReceiptTheme — one row per merchant, the customizable receipt branding
// ---------------------------------------------------------------------------
model ReceiptTheme {
  merchantId String   @id
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  layoutId     String  @default("classic") // "classic" | "modern" | "minimal" — which structural template to render
  logoUrl      String?
  displayName  String? // shown on receipts instead of Merchant.businessName, if set -- lets a merchant show a nicer/different name to customers without renaming their actual account
  location     String? // free-text address/location line, shown on receipts if set -- e.g. "123 Main St, Springfield" -- not tied to any Location model, just display text
  phone        String?
  // See Merchant.ownerPhoneCountry's comment -- same pairing, same purpose,
  // for the phone number that prints on receipts instead of the owner's own.
  phoneCountry String? @default("CA")
  primaryColor String  @default("#111111")
  accentColor  String  @default("#2563eb")

  headerText String?
  footerText String?

  // Receipt compliance -- gstHstNumber is what lets a Canadian customer claim
  // an input tax credit (CRA requires it on receipts for purchases $100+ --
  // raised from $30 by SOR/2021-63, effective April 20, 2021).
  // taxLabel is customizable since "Tax" isn't always accurate: a merchant
  // might charge GST/HST alone, or GST/HST + a provincial tax like PST/QST.
  // The merchant's tax registration number, and what to call it. The label
  // used to be hardcoded as "GST/HST" in all three layouts, which is right in
  // most of Canada, wrong in the US, and wrong again anywhere that says VAT.
  gstHstNumber   String?
  taxNumberLabel String? // "GST/HST", "VAT", "ABN"... defaults to GST/HST when unset

  // A SECOND registration number, because one slot isn't enough in Canada: a
  // Quebec merchant is registered for GST/HST *and* QST and must show both,
  // and BC/Saskatchewan/Manitoba merchants carry a PST number alongside GST.
  // With one field they could only ever print half of what their customers
  // need, so those customers could not recover the provincial tax.
  // Unused by US merchants, who have no equivalent registration to print.
  taxNumber2      String?
  taxNumber2Label String?

  taxLabel     String  @default("Tax")
  returnPolicy String?

  showGoogleReview Boolean @default(false)
  googleReviewUrl  String?
  showWarranty     Boolean @default(false)

  // Warranty terms the merchant writes once, carried by every receipt.
  // Before these existed the block was a bare toggle: it printed a "Register
  // Warranty" button with no terms behind it, pointing at a route that was
  // never built. The terms are what the customer actually needs months later.
  warrantyPeriod  String? // "1 year from purchase", "90 days"
  warrantyDetails String? // what's covered, and what isn't
  warrantyContact String? // how to start a claim -- email, phone, or a link

  showWalletSave Boolean @default(true)

  // Promotes ReceipTap to other business owners at the top of this
  // merchant's receipts, using their own Partner Program referral link.
  showPartnerProgram Boolean @default(false)

  // --- Header block visibility ---------------------------------------------
  // What appears at the top of the receipt. The VALUES these show (phone,
  // address, GST/HST, website, business email) are all edited in Business
  // Settings -- only whether they print lives here, so there's still exactly
  // one place to change each fact.
  showLogo          Boolean @default(true)
  showBusinessName  Boolean @default(true)
  showAddress       Boolean @default(true)
  showTaxNumber     Boolean @default(true)
  showPhone         Boolean @default(true)
  showWebsite       Boolean @default(true)
  showBusinessEmail Boolean @default(true)

  // --- Receipt block visibility (Receipt design > Blocks) -----------------
  // Every flag here controls something the Transaction model actually
  // carries -- toggles for data we don't capture (cashier, rounding, card
  // tail, approval code, tender/change) are deliberately absent rather than
  // shipped as switches that control nothing.
  showDateTime      Boolean @default(true)
  showReceiptNumber Boolean @default(true)
  showRegister      Boolean @default(false) // Transaction.posDeviceId, when the POS sent one

  showItemQuantity  Boolean @default(true)
  showItemUnitPrice Boolean @default(true)
  showItemLineTotal Boolean @default(true)
  itemLayout        String  @default("compact") // "compact" | "detailed"

  showSubtotal   Boolean @default(true)
  showDiscounts  Boolean @default(true)
  showTax        Boolean @default(true)
  showTotal      Boolean @default(true)
  totalProminent Boolean @default(true)

  showPaymentMethod Boolean @default(true)
  showCardTail      Boolean @default(true)
  showApprovalCode  Boolean @default(false) // useful for disputes, noise for most
  showTenderChange  Boolean @default(true)

  showBarcode        Boolean @default(false)
  // "receiptNumber" | "transactionId" | "bestAvailable" | "custom"
  barcodeValue       String  @default("receiptNumber")
  barcodeCustomValue String? // only used when barcodeValue is "custom"

  // Merchant-authored promo card -- all free text, so no POS data needed.
  showPromo        Boolean @default(false)
  promoTitle       String?
  promoMessage     String?
  promoButtonLabel String?
  promoButtonUrl   String?
  promoExpiryText  String?

  socialsHeading  String?
  customLinkLabel String?
  customLinkUrl   String?
  offerLine       String?

  footerLegal String? // legal / footer notes under the thank-you message

  // Social links shown as clickable icons on receipts -- each is optional,
  // and its icon only renders if a URL is set.
  instagramUrl String?
  facebookUrl  String?
  tiktokUrl    String?
  xUrl         String?
  youtubeUrl   String?
  linkedinUrl  String?

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// LoyaltyProgram — one merchant's punch-card settings (their offer)
// ---------------------------------------------------------------------------
model LoyaltyProgram {
  merchantId String   @id
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  enabled Boolean @default(false)

  // What earns a stamp. One of:
  //   ORDER  -- one stamp per receipt, whatever they bought
  //   VISIT  -- one stamp per calendar day, so a second coffee at 4pm doesn't
  //             fill the card twice (earnItemName/earnAmountCents unused)
  //   ITEM   -- one stamp per matching line item, matched on earnItemName
  //   AMOUNT -- one stamp per earnAmountCents of receipt total
  earnRule        String  @default("ORDER")
  earnItemName    String? // ITEM only -- case-insensitive substring of the line item name
  earnAmountCents Int     @default(1000) // AMOUNT only

  // How many stamps fill a card, and what the customer gets when it does.
  // rewardLabel is free text printed as-is on receipts and wallet cards
  // ("Free coffee", "10% off") -- it replaced the old offerType/offerValue
  // picker, which stays below only so existing rows keep their history.
  stampsRequired Int    @default(10)
  rewardLabel    String @default("Free reward")

  // Stamps a brand-new card arrives with. A card already underway gets
  // finished far more often than one starting at zero.
  headStartStamps Int @default(0)

  // Card design -- how the stamp card looks in the customer's wallet.
  cardLogoUrl    String?
  cardBackground String  @default("#0A84FF")
  cardAccent     String  @default("#FFFFFF")

  // Static, merchant-editable code. The customer types it on their own phone
  // to redeem a full card, or staff enters it on the Loyalty page to redeem
  // on a customer's behalf. Shared by every redemption until it's changed.
  redemptionCode String @default("REWARD")

  // Legacy percent/amount offer. No longer drives any UI -- rewardLabel does.
  // Kept so existing programs don't lose what they had configured.
  offerType  String @default("PERCENT") // "PERCENT" | "AMOUNT"
  offerValue Int    @default(10) // percent (1-100) if PERCENT, cents if AMOUNT

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// LoyaltyCard — one customer's stamp card at one merchant. There is no signup:
// the card is created by the first receipt they link from that merchant, and
// stamps accrue as they link more. Once full it's redeemed with the merchant's
// redemption code -- by the customer on their own phone, or by staff on the
// merchant's Loyalty page -- at which point the card resets for the next cycle.
// ---------------------------------------------------------------------------
model LoyaltyCard {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // Column is still named "punches" in Postgres -- the product calls them
  // stamps now, and renaming the column would move data for no gain.
  stamps Int @default(1) @map("punches") // 0..LoyaltyProgram.stampsRequired

  // Last time a stamp landed. Only the VISIT rule reads it, to hold a
  // customer to one stamp a day however many receipts they save.
  lastStampedAt DateTime?

  lastRedeemedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([merchantId, customerId])
}

// ---------------------------------------------------------------------------
// Notification — something that happened to a customer, waiting in their
// wallet. Deliberately general (type + title + body + link) rather than a
// loyalty-only table: the first one is "your stamp card is full", but the
// Notifications tab is the place everything else will land too.
//
// Written whether or not any email or push went out, and independently of
// whether either succeeded -- this is the record of record, and the other
// channels are best-effort copies of it.
// ---------------------------------------------------------------------------
model Notification {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  type  String // "LOYALTY_REWARD_READY"
  title String
  body  String

  // Where tapping it goes, and which merchant it's about (so a card that gets
  // redeemed or a program that gets deleted can clear its notifications).
  linkUrl    String?
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id])

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([customerId, createdAt])
  @@index([customerId, readAt])
}

// The merchant-facing equivalent of Notification above -- same shape, same
// read/unread semantics, kept as a SEPARATE model rather than making
// Notification.customerId optional and overloading one table for two
// different recipients. A merchant and a customer are different sessions,
// different dashboards, different tab bars (business-tab-bar.ejs vs
// wallet-tab-bar.ejs); a shared table would mean either side's query could
// accidentally pull the other's rows if a `where` clause were ever written
// slightly wrong. See services/merchantNotificationService.js.
model MerchantNotification {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  type  String // "LOYALTY_CARD_FILLED" | "BILLING_PROBLEM" | "POS_CONNECTION_FAILED" | "PAYOUT_COMPLETED" | "TREE_PLANTED"
  title String
  body  String

  // Where tapping it goes -- e.g. /account/business/loyalty for a filled
  // card, /account/business/billing for a billing problem.
  linkUrl String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([merchantId, createdAt])
  @@index([merchantId, readAt])
}

// ---------------------------------------------------------------------------
// PushSubscription — one browser that agreed to receive push notifications.
// A customer can have several (phone, laptop, a second browser), so pushes fan
// out to every row.
//
// The endpoint is the push service's own URL for that browser and is unique
// on its own -- re-subscribing the same browser updates the row rather than
// adding a duplicate. p256dh and auth are the browser-generated keys the
// payload is encrypted with; they're useless to anyone else and are what makes
// the push service unable to read the message it's delivering.
//
// Rows are deleted, not kept, when a push service answers 404/410: that is the
// browser telling us the subscription is dead (uninstalled, permission
// revoked, storage cleared).
// ---------------------------------------------------------------------------
model PushSubscription {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  endpoint String @unique
  p256dh   String
  auth     String

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Affiliate — refers new merchants to ReceipTap and earns a recurring
// commission on their subscription. Two kinds, same table:
//   MERCHANT — an existing ReceipTap merchant referring others. They use
//     their normal merchant login (no separate password) via
//     Merchant.ownAffiliateAccount; earns 20% while their OWN subscription
//     is active, and stops earning new commissions (without losing past
//     ones) if it lapses.
//   REGULAR — a standalone affiliate (e.g. future sales team) with their own
//     signup/login, not tied to any Merchant account; flat 15%.
// ---------------------------------------------------------------------------
model Affiliate {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String? // only set for REGULAR -- MERCHANT type authenticates via their existing merchant session
  type         AffiliateType @default(REGULAR)
  referralCode String        @unique // used as ?ref=CODE on the merchant signup link

  merchantId String?   @unique // set only when type = MERCHANT
  merchant   Merchant? @relation("AffiliateOwnMerchant", fields: [merchantId], references: [id])

  // Stripe Connect Express account -- required before any payout can be sent
  stripeConnectAccountId String? @unique
  stripeConnectOnboarded Boolean @default(false)

  // Commissions accumulate as PENDING and get paid out in a batch on this
  // cadence, rather than instantly per commission -- lastPayoutAt is when
  // that last ran, so the scheduler knows when the next one is due.
  payoutFrequency String    @default("WEEKLY") // "WEEKLY" | "MONTHLY"
  lastPayoutAt    DateTime?

  // Ship-to address for a REGULAR affiliate ordering pucks to keep on hand
  // and hand-deliver to businesses they're signing up (see
  // services/hardwareOrderService.js) -- same field shape as Merchant's
  // address* fields, entered/edited directly on the order page since there's
  // no separate Affiliate settings page. Never used for a MERCHANT-type
  // affiliate -- they order through their own merchant account instead (see
  // routes/affiliates.js's `requireAffiliateAuth`, which a MERCHANT-type
  // affiliate never actually authenticates through).
  addressLine1      String?
  addressLine2      String?
  addressCity       String?
  addressRegion     String?
  addressPostalCode String?
  addressCountry    String?
  phone             String?

  createdAt DateTime @default(now())

  referredMerchants Merchant[]      @relation("ReferredMerchants")
  commissions       Commission[]
  hardwareOrders    HardwareOrder[]

  // Shoppers who first met ReceipTap through this affiliate's receipts.
  referredCustomers Customer[] @relation("CustomerReferrals")
}

enum AffiliateType {
  MERCHANT
  REGULAR
}

// ---------------------------------------------------------------------------
// Commission — one payout-eligible amount, generated from one successful
// Stripe invoice payment on a referred merchant's subscription.
// ---------------------------------------------------------------------------
model Commission {
  id String @id @default(cuid())

  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])
  merchantId  String
  merchant    Merchant  @relation(fields: [merchantId], references: [id])

  stripeInvoiceId  String           @unique // idempotency: one commission per invoice paid
  amountCents      Int
  rate             Int // the % applied at the time (15 or 20) -- kept for audit even if rates change later
  status           CommissionStatus @default(PENDING)
  stripeTransferId String?

  createdAt DateTime  @default(now())
  paidAt    DateTime?
}

enum CommissionStatus {
  PENDING
  PAID
  FAILED
}

// ---------------------------------------------------------------------------
// Customer — a consumer with a personal receipt wallet across ALL merchants
// ---------------------------------------------------------------------------
model Customer {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique // set if they signed in with Google instead of email
  appleId      String?  @unique // set if they signed in with Apple instead of email
  microsoftId  String?  @unique // set if they signed in with Microsoft instead of email
  name         String?
  // Optional personal contact number -- about the customer, not their
  // receipts. Never printed anywhere or shown to a merchant; matches
  // Merchant.ownerPhone's "about you" framing on the business side.
  phone        String?
  // See Merchant.ownerPhoneCountry's comment -- same pairing, same purpose.
  phoneCountry String?  @default("CA")
  createdAt    DateTime @default(now())

  // "Forgot password?" flow -- token is single-use (cleared on success) and
  // expires 1 hour after being issued, whichever comes first.
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?

  // Referral attribution. Set when a shopper first creates a wallet account
  // from a merchant's receipt: that merchant introduced them to ReceipTap, so
  // if this same person later signs their OWN business up they're credited as
  // the referrer and earn commission on it. First touch wins -- once set, a
  // later receipt from a different merchant doesn't overwrite it.
  // Attribution expires REFERRAL_WINDOW_DAYS after the timestamp below
  // (lib/referralAttribution.js); the row is kept for history either way.
  // Whether tapping a puck while signed in saves the receipt on its own.
  // Defaults on, because that's what the save modal has always promised --
  // but a shopper who'd rather decide receipt by receipt can turn it off, and
  // then the Save button behaves exactly as it used to.
  //
  // Distinct from cross-merchant card recognition (ShopperIdentifier): this
  // one is about a receipt they DID tap for on this device, and needs no
  // identity matching. The two are separate switches because they're separate
  // decisions, and someone may reasonably want one without the other.
  autoSaveOnTap Boolean @default(true)

  // Which AI categories THIS customer treats as tax deductible.
  //
  // Deductibility isn't a property of a receipt, it's a property of the person
  // filing: whether they're self-employed, what the purchase was actually for,
  // and the rules where they file. None of that is on the receipt, so the model
  // was never in a position to decide it -- it can only say what was bought.
  // The customer says which of their own categories count, which is a claim
  // they're entitled to make about their own affairs.
  //
  // Empty by default: nothing is deductible until they say it is. A per-receipt
  // override still beats this (Transaction.taxDeductible), for the laptop and
  // the birthday gift bought at the same shop.
  deductibleCategories String[] @default([])

  referredByAffiliateId String?
  referredByAffiliate   Affiliate? @relation("CustomerReferrals", fields: [referredByAffiliateId], references: [id])
  referralAttributedAt  DateTime?

  // Whether we email them when a stamp card fills. The in-app notification
  // is always created either way -- this only governs the email, so turning
  // it off quietens their inbox without hiding anything from them.
  loyaltyEmails Boolean @default(true)

  // First time we saw this account open ReceipTap from the home screen
  // (display-mode: standalone). Not a "have they seen the tip" flag -- the
  // browser genuinely tells us this, so the setup step stays real account
  // state like every other one.
  homeScreenAddedAt DateTime?

  transactions      Transaction[]
  loyaltyCards      LoyaltyCard[]
  scannedReceipts   ScannedReceipt[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  identifiers       ShopperIdentifier[]
  legalAcceptances  ShopperLegalAcceptance[]

  @@index([referredByAffiliateId])
}

// A receipt the customer photographed/uploaded themselves, from a store
// that may not even be a ReceipTap merchant -- distinct from Transaction,
// which always means a real POS sale at a connected merchant and requires
// a real Merchant row via its non-nullable merchantId. Money in cents,
// same convention as Transaction.total.
model ScannedReceipt {
  id              String    @id @default(cuid())
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id])
  imageUrl        String
  merchantName    String
  purchaseDate    DateTime?
  total           Int
  aiCategory      String?
  // Same three the tapped receipts have carried all along. A photographed
  // receipt was categorised but never assessed for deductibility, so half a
  // customer's wallet could never appear in a tax export.
  aiTaxDeductible Boolean?
  aiReasoning     String?
  taxDeductible   Boolean?
  // Both read off the photo itself by the same AI extraction pass as
  // merchantName/total/date -- only populated when the receipt actually
  // prints them (e.g. "Visa •••• 6123", a store's own transaction/receipt
  // number). Never fabricated: ReceipTap doesn't collect real card data,
  // this is only ever what's legible on the paper the customer photographed.
  paymentMethod   String?
  receiptNumber   String?

  // The rest of what a paper receipt actually prints, read off the photo by
  // the same extraction pass. A tapped receipt gets all of this from the POS;
  // a scanned one had only a grand total, which made the two kinds of receipt
  // look very different in a wallet that's meant to hold both.
  //
  // Money in cents, like everywhere else in this project. All nullable: a
  // receipt that doesn't print a subtotal (or a photo where it isn't legible)
  // stores null rather than a guess.
  subtotal Int?
  tax      Int?
  tip      Int?

  // The merchant's tax registration number. Worth capturing specifically:
  // claiming an input tax credit in Canada requires the supplier's GST/HST
  // number on the receipt for purchases over $100 (raised from $30 by
  // SOR/2021-63, effective April 20, 2021), so a wallet that drops it makes
  // those receipts useless for exactly the person most likely to keep them.
  taxNumber String?

  // A second registration number, where the receipt prints one. Canadian
  // receipts routinely carry two -- federal GST/HST plus a provincial QST or
  // PST number -- and a single slot silently threw the second away, which is
  // the one a Quebec filer needs. Stored exactly as printed, label and all
  // ("QST 1016551356 TQ 0001"), because which tax it belongs to is part of
  // the record.
  taxNumber2 String?

  // The buyer's name, when the receipt prints one. Required by CRA for an
  // input tax credit once a purchase reaches $500 (raised from $150 by
  // SOR/2021-63, effective April 20, 2021) -- below that the supplier
  // details are enough, above it the recipient has to be named on the
  // document itself. Most retail receipts don't print it; invoices do.
  buyerName String?

  // Time of day exactly as printed ("18:42:29"), kept as text rather than
  // folded into purchaseDate on purpose: the paper says nothing about which
  // timezone it means, and inventing one would turn a fact into a guess.
  // IRS section 274(d) substantiation for travel and meals asks for the time.
  purchaseTimeText String?

  // The rest of what a till receipt routinely prints beyond the fields
  // above -- added after a scan of a real Little Caesars receipt showed
  // five printed fields with nowhere to go: a store phone number, the
  // cashier's name, the item count line, the tax's printed rate/label
  // (as opposed to taxNumber, which is the merchant's registration
  // number, a different thing), and the card payment's reference/
  // approval number. All read off the photo by the same extraction pass,
  // all nullable and never guessed, same as everything else here.
  merchantPhone          String?
  cashierName            String?
  itemCount              Int?
  taxLabel               String? // e.g. "HST 13%", exactly as printed
  paymentReferenceNumber String?

  // Why this was bought. NOT extracted -- it isn't on the paper. It's the
  // taxpayer's own note, and for US travel, meals, gifts and listed property
  // it is a hard requirement under section 274(d): a receipt proves what was
  // spent, never what it was for. No UI writes this as of 2026-09-05 -- same
  // founder decision as Transaction.businessPurpose's comment -- kept rather
  // than dropped since the field is still real.
  businessPurpose String?

  // ISO code as printed ("CAD", "USD"). Null when the receipt doesn't say --
  // better blank than showing a US total with a Canadian symbol.
  currency String?

  // The address line(s) printed on the receipt, useful for telling two
  // branches of the same chain apart.
  merchantAddress String?

  lineItems Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Warranty tracking -- same fields and precedence as Transaction, see the
  // comment there and lib/receiptWarranty.js.
  aiWarrantyMonths          Int?
  warrantyMonths            Int?
  warrantyExpiresAt         DateTime?
  warranty14dReminderSentAt DateTime?
  warranty3dReminderSentAt  DateTime?

  // Second tax amount in cents, pairing with taxNumber2 above the same way
  // Transaction.tax2 pairs with sellerTaxNumber2 -- see the comment there.
  // Not extracted by the AI scan pass yet; schema only, for symmetry.
  tax2 Int?

  shareLinks ScannedReceiptShareLink[]

  @@index([customerId])
  @@index([warrantyExpiresAt])
}

// A time-limited, unauthenticated link to one scanned receipt's photo -- see
// lib/receiptShareLink.js for the token/expiry design. onDelete: Cascade,
// unlike this app's usual RESTRICT-and-keep-forever pattern for audit
// tables (LegalAcceptance, ShopperConsent, etc.): a share link is an active
// convenience, not a record that has to outlive what it points at, so it
// should simply disappear along with the receipt it was for.
model ScannedReceiptShareLink {
  id               String         @id @default(cuid())
  scannedReceiptId String
  scannedReceipt   ScannedReceipt @relation(fields: [scannedReceiptId], references: [id], onDelete: Cascade)

  // Plaintext, not hashed -- see the file comment in lib/receiptShareLink.js
  // for why this matches Customer.resetToken rather than
  // Transaction.cardFingerprintHash.
  token     String    @unique
  expiresAt DateTime
  // Set on regenerate, never cleared -- rows are kept as history rather than
  // overwritten, same append-only reasoning as PurgeLog/LegalAcceptance.
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([scannedReceiptId])
}

// ---------------------------------------------------------------------------
// LegalAcceptance — one row per legal document a merchant has accepted.
// APPEND-ONLY: never update a row. A merchant re-accepting a newer version
// (see the re-acceptance interstitial in middleware/) creates a NEW row
// rather than overwriting the old one, so the full acceptance history for
// every version is preserved. "Which version is current" is never asked of
// this table -- it's read from config/legal.js, the single source of truth.
// ---------------------------------------------------------------------------
model LegalAcceptance {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  documentType LegalDocumentType
  version      String // e.g. "2026-08-05.1" -- matches config/legal.js at the moment this row was written

  acceptedAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?

  @@index([merchantId, documentType])
}

enum LegalDocumentType {
  TERMS
  PRIVACY
  DPA
}

// ---------------------------------------------------------------------------
// ShopperLegalAcceptance — the Customer-side mirror of LegalAcceptance above.
// Kept as its own table with its own enum rather than reusing LegalAcceptance
// -- that table's merchantId is required (see the model above), and a
// shopper's acceptance is a different relationship (Wallet Terms/Wallet
// Privacy, not TERMS/PRIVACY/DPA) with no DPA equivalent at all (an
// individual isn't a data controller, see config/legal.js). Same APPEND-ONLY
// rule: a re-acceptance writes a new row, never updates an old one.
// ---------------------------------------------------------------------------
model ShopperLegalAcceptance {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  documentType ShopperLegalDocumentType
  version      String // matches config/legal.js at the moment this row was written

  acceptedAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?

  @@index([customerId, documentType])
}

enum ShopperLegalDocumentType {
  SHOPPER_TERMS
  SHOPPER_PRIVACY
}

// ---------------------------------------------------------------------------
// ShopperConsent — one row per consent decision shown on the tap screen's
// email-capture step. APPEND-ONLY: never update a row. Logs BOTH grants and
// declines -- a shopper leaving the marketing checkbox unticked still gets a
// row (granted: false), not silence, so "we asked and they said no" is
// provable the same way "we asked and they said yes" is.
// ---------------------------------------------------------------------------
model ShopperConsent {
  id        String      @id @default(cuid())
  receiptId String
  receipt   Transaction @relation(fields: [receiptId], references: [id])

  consentType        ConsentType
  granted            Boolean
  consentTextVersion String // which exact wording (config/legal.js) was shown at the moment of this decision

  // Cross-merchant recognition is a SEPARATE PURPOSE from receipt delivery,
  // so under PIPEDA it needs its own consent and cannot ride along on the
  // transactional one. Kept as its own flag with its own timestamp rather
  // than another ConsentType value, so the moment it was granted is recorded
  // independently of when the receipt consent above was captured -- and so
  // withdrawing one never implies anything about the other.
  crossMerchantRecognition   Boolean   @default(false)
  crossMerchantRecognitionAt DateTime?

  createdAt DateTime @default(now())
  ipAddress String?

  @@index([receiptId])
}

// A passive identifier that lets ReceipTap recognise a returning shopper
// WITHOUT them tapping again -- currently only Square's card fingerprint.
//
// Three constraints shape this model:
//   1. Never store the raw value. identifierValueHash is SHA-256 of it; the
//      original fingerprint never lands in the database, a log, or a backup.
//   2. Identifiers are PLATFORM-SCOPED. A Square fingerprint and a Clover
//      token for the same physical card are unrelated values, so
//      sourcePlatform is part of the unique key and of every lookup. There is
//      deliberately no cross-platform identity graph here.
//   3. Only written with explicit cross-merchant recognition consent
//      (ShopperConsent.crossMerchantRecognition) -- see Stage 2.
//
// Platforms that expose no equivalent identifier (Clover, Shopify,
// Lightspeed, Toast today) simply never get a row, and those shoppers keep
// tapping every time. That degradation is the intended behaviour, not a gap.
model ShopperIdentifier {
  id        String   @id @default(cuid())
  shopperId String
  shopper   Customer @relation(fields: [shopperId], references: [id])

  identifierType      IdentifierType
  identifierValueHash String // SHA-256 hex -- never the raw value
  sourcePlatform      SourcePlatform

  createdAt DateTime  @default(now())
  // Soft revocation: a revoked row still proves the identifier was once
  // linked (needed for a DSAR audit trail) but must never match a lookup.
  revokedAt DateTime?

  // One row per (kind of identifier, value, platform). The same hash arriving
  // from two platforms is two distinct identifiers, not a conflict.
  @@unique([identifierType, identifierValueHash, sourcePlatform])
  @@index([shopperId])
}

enum IdentifierType {
  CARD_FINGERPRINT // the only one in use -- Square's card_details.card.fingerprint
  // EMAIL and PHONE are modelled but NOTHING WRITES THEM, deliberately. The
  // obvious source is a customer a POS attaches to a sale, and that was
  // considered and turned down: it depends on a cashier having looked the
  // person up (so coverage is patchy and unpredictable), the consent basis is
  // weaker -- the merchant's system hands us an identity the shopper gave the
  // SHOP, not us -- and an email is the same person everywhere, so scoping it
  // by sourcePlatform would split one identity across several rows while not
  // scoping it breaks the rule every other lookup follows.
  // Left here as named intent; wiring either up needs those three answered.
  EMAIL
  PHONE
}

enum SourcePlatform {
  SQUARE
  CLOVER
  SHOPIFY
  LIGHTSPEED
  TOAST
  MANUAL
}

enum ConsentType {
  TRANSACTIONAL
  MARKETING
}

// ---------------------------------------------------------------------------
// PurgeLog — one row per retention-purge run, scheduled or merchant-
// triggered. This is the evidence that the retention policy in
// config/retention.js is actually enforced, not just documented -- what
// ran, how many rows (with a per-table breakdown in `details`), when, and
// whether it errored partway through. APPEND-ONLY, same as
// LegalAcceptance/ShopperConsent: never update a row after it's written.
// ---------------------------------------------------------------------------
// Login sessions, stored here rather than in the server's memory so a deploy,
// crash or watch-reload doesn't sign out every merchant and shopper at once
// -- and so more than one instance can serve the same session.
//
// Read and written through lib/prismaSessionStore.js, which uses the app's
// EXISTING Prisma connection. That's the whole point: an off-the-shelf store
// opens its own pool, and Supabase's session-mode pooler caps at 15 clients
// total. When that was tried, session writes started failing with
// EMAXCONNSESSION and login broke silently -- the redirect succeeded and the
// session was never saved.
model Session {
  sid       String   @id
  data      String // the serialised session, as express-session hands it over
  expiresAt DateTime

  @@index([expiresAt])
}

model PurgeLog {
  id          String  @id @default(cuid())
  jobName     String // "purgeExpiredReceipts" | "purgeDeactivatedMerchants" | "deleteShopperByEmail" | "deleteShopperEverywhere"
  dryRun      Boolean @default(true)
  rowsDeleted Int     @default(0)
  details     Json? // per-table breakdown, e.g. { "Transaction": 120, "ShopperConsent": 240 }
  error       String? // set if the run failed partway through

  // Set only for a merchant-triggered deletion (the dashboard action in
  // Part E); null for the scheduled system job, which acts on no one's
  // behalf but the retention policy itself.
  initiatedByMerchantId String?
  initiatedByMerchant   Merchant? @relation(fields: [initiatedByMerchantId], references: [id])

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([jobName])
}

// ---------------------------------------------------------------------------
// EmailSuppression — one row per (email, merchant) a shopper has opted out
// of marketing from, or requested deleted. Deliberately survives
// purgeExpiredReceipts/purgeDeactivatedMerchants/deleteShopperByEmail --
// EMAIL_SUPPRESSION_RETENTION_MONTHS in config/retention.js is Infinity for
// exactly this row, on purpose: if it aged out and got purged like
// everything else, a shopper who unsubscribed could tap another receipt
// from the same merchant later and get silently re-enrolled in marketing,
// which defeats the entire point of a suppression list.
//
// `emailHash`, not `email` -- a plaintext table of "people who don't want
// marketing" is itself a marketing-relevant list of real addresses, which
// is exactly the kind of thing this model exists to prevent accumulating.
// Hashed the same normalized way on write and on check (see
// services/emailSuppressionService.js `hashEmail`), so a lookup is an exact
// hash match, never a decryption.
// ---------------------------------------------------------------------------
model EmailSuppression {
  id         String   @id @default(cuid())
  emailHash  String // sha256 of the lowercased, trimmed email -- see services/emailSuppressionService.js
  merchantId String // scoped per-merchant, matching how ShopperConsent MARKETING consent is itself per-merchant, not global
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  suppressedAt DateTime @default(now())
  reason       String // e.g. "unsubscribed" | "deletion_requested"

  @@index([emailHash, merchantId])
}
