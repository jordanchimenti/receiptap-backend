<!-- views/account-forgot-password.ejs -->
<!-- Step 1 of the password reset. Dark theme, same auth card as
     views/account-login.ejs (shared CSS in partials/auth-card-styles.ejs) so
     the whole sign-in flow looks like one thing.

     Note the copy stays deliberately vague about whether the address has an
     account -- the route renders this same success state either way, so that
     this page can't be used to check who's a ReceipTap customer. -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Forgot Password - ReceipTap</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
  <%- include('partials/wallet-dark-theme') %>
  <%- include('partials/auth-card-styles') %>
  <style>
    .sent-mark {
      width: 52px; height: 52px; border-radius: 50%; margin: 0 auto 18px; display: flex;
      align-items: center; justify-content: center; background: var(--w-accent-wash); color: var(--w-accent);
    }
    .back-link { font-size: 13px; color: var(--w-ink-soft); margin: 22px 0 0; }
    .back-link a { color: var(--w-accent); font-weight: 600; text-decoration: none; }
    .spam-note { font-size: 12.5px; color: var(--w-ink-soft); line-height: 1.55; margin: 18px 0 0; }
  </style>
</head>
<body>
  <div class="auth-shell">
    <div class="auth-card">
      <div class="logo-chip"><img src="/images/receiptap-logo.png" alt="ReceipTap" /></div>

      <% if (sent) { %>
        <div class="sent-mark">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg>
        </div>
        <div class="w-eyebrow">Reset password</div>
        <h1 class="auth-title">Check your email</h1>
        <p class="auth-sub">
          If that email has a ReceipTap account, we just sent a link to reset the password. It expires in 1 hour.
        </p>
        <p class="spam-note">
          Nothing after a minute or two? Check your spam folder — reset emails often land there.
        </p>
      <% } else { %>
        <div class="w-eyebrow">Reset password</div>
        <h1 class="auth-title">Forgot your password?</h1>
        <p class="auth-sub">Enter your email and we'll send you a link to set a new one.</p>

        <% if (error) { %><div class="w-error" style="display:block;"><%= error %></div><% } %>

        <form method="POST" action="/account/forgot-password">
          <div class="auth-field">
            <div class="auth-field-row"><label for="email">Email</label></div>
            <input type="email" id="email" name="email" placeholder="you@example.com" required autofocus />
          </div>
          <button type="submit" class="auth-pill-btn">Send reset link</button>
        </form>
      <% } %>

      <p class="back-link"><a href="/account/login">Back to log in</a></p>
    </div>
  </div>
</body>
</html>
