<!-- views/account-forgot-password.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Forgot Password - ReceipTap</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
</head>
<body>
  <div class="centered-shell">
    <div class="auth-card">
      <img src="/images/receiptap-logo.png" alt="ReceipTap" style="height: 60px; margin-bottom: 20px;" />

      <% if (sent) { %>
        <h1 style="font-size: 22px; margin-bottom: 6px;">Check your email</h1>
        <p style="font-size: 13.5px; color: var(--ink-soft); margin: 8px 0 24px; line-height: 1.5;">
          If that email has a ReceipTap account, we just sent a link to reset the password. It expires in 1 hour.
        </p>
      <% } else { %>
        <h1 style="font-size: 22px; margin-bottom: 6px;">Forgot your password?</h1>
        <p style="font-size: 13.5px; color: var(--ink-soft); margin: 8px 0 24px; line-height: 1.5;">
          Enter your email and we'll send you a link to reset it.
        </p>

        <% if (error) { %><div class="error-box"><%= error %></div><% } %>

        <form method="POST" action="/account/forgot-password">
          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required autofocus />
          </div>
          <button type="submit" class="btn btn-primary">Send reset link</button>
        </form>
      <% } %>

      <p style="font-size: 13px; color: var(--ink-soft); margin-top: 20px; text-align: center;">
        <a href="/account/login" style="color: var(--teal-deep); font-weight: 600; text-decoration: none;">Back to log in</a>
      </p>
    </div>
  </div>
</body>
</html>
