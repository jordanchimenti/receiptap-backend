<!-- views/account-install.ejs -->
<!-- "Add ReceipTap to your home screen", reached from the setup checklist on
     both dashboards. One page for shoppers and merchants -- it's the same app
     either way, only the back link differs.

     IMPORTANT, and the reason this page exists at all: there is no single
     "install" API across platforms.
       * Chrome/Edge (Android + desktop) fire beforeinstallprompt, which we
         captured in partials/wallet-dark-theme.ejs -- there, the button really
         does install in one tap.
       * iOS Safari has NO install API of any kind. Apple only allows
         Share -> Add to Home Screen, done by hand. No amount of JavaScript
         changes that, so on iPhone this page shows the exact steps instead of
         a button that couldn't work.
     Step 2 (notifications) is deliberately after step 1: on iOS, push is only
     available to a site opened from the home screen, so asking first would
     fail for the customers who most need it. -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Add to Home Screen - ReceipTap</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
  <%- include('partials/wallet-dark-theme') %>
  <style>
    .biz-header { display: flex; align-items: center; gap: 12px; margin-bottom: 6px; }
    .page-sub { font-size: 13px; color: var(--w-ink-soft); line-height: 1.55; margin: 0 0 18px 44px; }

    .step { padding: 18px; margin-bottom: 14px; }
    .step-head { display: flex; align-items: center; gap: 11px; margin-bottom: 12px; }
    .step-num {
      width: 26px; height: 26px; border-radius: 50%; flex: none; display: flex; align-items: center;
      justify-content: center; background: var(--w-accent-wash); color: var(--w-accent);
      font-size: 13px; font-weight: 700;
    }
    .step.done .step-num { background: rgba(5,107,254,0.18); }
    .step-title { font-size: 15px; font-weight: 700; color: var(--w-ink); }
    .step-text { font-size: 13px; color: var(--w-ink-soft); line-height: 1.6; }

    .big-btn {
      display: block; width: 100%; margin-top: 14px; padding: 15px; border-radius: 999px; border: none;
      background: var(--w-accent); color: #fff; font-size: 15px; font-weight: 700; cursor: pointer;
      font-family: inherit;
    }
    .big-btn:disabled { opacity: 0.5; cursor: default; }
    .status { font-size: 12.5px; color: var(--w-ink-soft); margin-top: 11px; line-height: 1.5; }
    .status.good { color: var(--w-accent); }

    /* Hand-steps, for platforms with no install API (i.e. every iPhone). */
    .manual { margin-top: 12px; }
    .manual-step { display: flex; align-items: flex-start; gap: 11px; padding: 9px 0; }
    .manual-icon {
      width: 28px; height: 28px; border-radius: 8px; flex: none; display: flex; align-items: center;
      justify-content: center; background: var(--w-card-raised); color: var(--w-accent);
    }
    .manual-text { font-size: 13px; color: var(--w-ink); line-height: 1.5; padding-top: 4px; }
    .manual-text em { color: var(--w-ink-soft); font-style: normal; }

    /* A small mock of the row they're hunting for in Safari's share sheet.
       Naming the menu item isn't enough -- it sits well down a long list, and
       people give up scrolling before they reach it. */
    .sheet-mock {
      display: flex; align-items: center; gap: 12px; padding: 12px 14px; margin-top: 9px;
      border-radius: 11px; background: #1c1c1e; border: 1px solid rgba(255,255,255,0.1);
    }
    .sheet-mock-label { flex: 1; font-size: 14px; color: #fff; }
    .sheet-mock-icon {
      width: 26px; height: 26px; border-radius: 6px; flex: none; display: flex; align-items: center;
      justify-content: center; background: rgba(255,255,255,0.14); color: #fff;
    }

    /* Bouncing pointer at Safari's own Share button. Fixed to the viewport
       edge, because that's where Safari's toolbar is -- not anywhere inside
       the page. */
    .share-pointer {
      position: fixed; left: 0; right: 0; z-index: 60; text-align: center;
      pointer-events: none; display: none;
    }
    .share-pointer.show { display: block; }
    .share-pointer.bottom {
      bottom: 0; padding: 26px 0 max(8px, env(safe-area-inset-bottom));
      /* Fades the page out underneath, so the arrow stays readable whatever
         it happens to be sitting over. */
      background: linear-gradient(to top, rgba(10,10,10,0.97) 55%, rgba(10,10,10,0));
    }
    .share-pointer.topright { top: 6px; right: 10px; left: auto; text-align: right; }
    .share-pointer-label {
      display: inline-block; background: var(--w-accent); color: #fff; font-size: 12.5px; font-weight: 700;
      padding: 7px 13px; border-radius: 999px; box-shadow: 0 4px 14px rgba(0,0,0,0.45);
    }
    .share-pointer-arrow { display: block; margin: 2px auto 0; color: var(--w-accent); }
    .share-pointer.topright .share-pointer-arrow { margin-right: 18px; }
    .share-pointer.bottom { animation: nudge-down 1.4s ease-in-out infinite; }
    .share-pointer.topright { animation: nudge-up 1.4s ease-in-out infinite; }
    @keyframes nudge-down { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(7px); } }
    @keyframes nudge-up { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }
    @media (prefers-reduced-motion: reduce) {
      .share-pointer.bottom, .share-pointer.topright { animation: none; }
    }

    .done-banner {
      display: flex; align-items: center; gap: 11px; padding: 14px 16px; border-radius: 14px;
      background: var(--w-accent-wash); border: 1px solid rgba(5,107,254,0.35); margin-bottom: 16px;
      font-size: 13.5px; color: var(--w-accent); font-weight: 600;
    }
    .hidden { display: none; }
  </style>
</head>
<body>
  <div class="w-shell">
    <div class="biz-header">
      <a href="<%= backUrl %>" class="w-btn-icon" aria-label="Back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      </a>
      <div>
        <div class="w-eyebrow">Setup</div>
        <h1 class="w-title" style="font-size:20px;">Add to home screen</h1>
      </div>
    </div>
    <p class="page-sub">ReceipTap opens like a normal app — full screen, one tap from your home screen, and able to notify you when something happens.</p>

    <div class="done-banner hidden" id="already-installed">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
      You're running ReceipTap from your home screen.
    </div>

    <!-- Step 1: install -->
    <div class="w-card step" id="step-install">
      <div class="step-head">
        <div class="step-num">1</div>
        <div class="step-title">Add ReceipTap to your home screen</div>
      </div>

      <!-- Chrome/Edge: a real one-tap install. -->
      <div id="install-auto" class="hidden">
        <div class="step-text">One tap and it's on your home screen.</div>
        <button type="button" class="big-btn" id="install-btn" onclick="runInstall()">Add to home screen</button>
        <div class="status" id="install-status"></div>
      </div>

      <!-- iPhone / iPad: Apple provides no install API, so these are the steps. -->
      <div id="install-ios" class="hidden">
        <div class="step-text">On iPhone, Apple only allows this by hand — it takes about five seconds:</div>
        <div class="manual">
          <div class="manual-step">
            <div class="manual-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 16V3"/><path d="m7 8 5-5 5 5"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"/></svg>
            </div>
            <div class="manual-text">Tap the <strong>Share</strong> button at the bottom of Safari <em>(the square with an arrow)</em></div>
          </div>
          <div class="manual-step">
            <div class="manual-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            </div>
            <div class="manual-text">
              Scroll down the list and tap this exact row:
              <div class="sheet-mock">
                <div class="sheet-mock-label">Add to Home Screen</div>
                <div class="sheet-mock-icon">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M12 8v8M8 12h8"/></svg>
                </div>
              </div>
            </div>
          </div>
          <div class="manual-step">
            <div class="manual-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
            </div>
            <div class="manual-text">Tap <strong>Add</strong>, then open ReceipTap from your home screen</div>
          </div>
        </div>
        <div class="status" id="ios-safari-note"></div>
      </div>

      <!-- Anything else: no API, no known recipe. Say so rather than guess. -->
      <div id="install-other" class="hidden">
        <div class="step-text">
          Your browser installs apps from its own menu. Look for <strong>Install app</strong> or
          <strong>Add to Home screen</strong> in the browser menu (usually the ⋮ or ⋯ button).
        </div>
      </div>
    </div>

    <!-- Step 2: notifications -->
    <div class="w-card step" id="step-notify">
      <div class="step-head">
        <div class="step-num">2</div>
        <div class="step-title">Turn on notifications</div>
      </div>
      <div class="step-text" id="notify-text">
        So a reward, a receipt, or anything else from ReceipTap pops up on your phone — even when the app is closed.
      </div>
      <button type="button" class="big-btn" id="notify-btn" onclick="enablePush()">Turn on notifications</button>
      <div class="status" id="notify-status"></div>
    </div>
  </div>

  <div class="share-pointer" id="share-pointer">
    <div class="share-pointer-label" id="share-pointer-label">Tap Share down here</div>
    <svg class="share-pointer-arrow" id="share-pointer-arrow" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
  </div>

  <% if (isCustomer) { %>
    <%- include('partials/wallet-tab-bar', { activeTab: '' }) %>
  <% } %>

  <%- include('partials/push-controls') %>
  <script>
    var PUSH_CONFIGURED = ReceipTapPush.configured;
    var ALREADY_SUBSCRIBED = <%= pushSubscriptions > 0 ? 'true' : 'false' %>;
    var IS_CUSTOMER = <%= isCustomer ? 'true' : 'false' %>;

    var isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent)
      // iPadOS 13+ reports itself as a Mac; the touch points give it away.
      || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    var isSafari = /^((?!chrome|android|crios|fxios|edgios).)*safari/i.test(navigator.userAgent);
    var isStandalone = window.matchMedia('(display-mode: standalone)').matches
      || window.navigator.standalone === true;

    // ---- Step 1 ------------------------------------------------------------
    function showInstallStep() {
      // Runs twice: once now, and again if beforeinstallprompt arrives late.
      // Reset first -- otherwise the second run adds the real install button
      // underneath the "use your browser menu" fallback the first run showed.
      ['install-auto', 'install-ios', 'install-other'].forEach(function (id) {
        document.getElementById(id).classList.add('hidden');
      });

      if (isStandalone) {
        document.getElementById('already-installed').classList.remove('hidden');
        document.getElementById('step-install').classList.add('done');
        document.getElementById('step-install').querySelector('.step-num').innerHTML =
          '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg>';
        return;
      }
      if (window.__installPrompt) {
        document.getElementById('install-auto').classList.remove('hidden');
      } else if (isIOS) {
        document.getElementById('install-ios').classList.remove('hidden');
        if (isSafari) {
          showSharePointer();
          watchForInstall();
        } else {
          document.getElementById('ios-safari-note').textContent =
            'This only works in Safari on iPhone — open ReceipTap in Safari first.';
        }
      } else {
        document.getElementById('install-other').classList.remove('hidden');
      }
    }

    // Points at Safari's own Share button, which is in the browser's toolbar,
    // not in the page. iPhone puts that toolbar at the bottom; iPad puts Share
    // at the top right, so the arrow has to flip.
    function showSharePointer() {
      var isIPad = navigator.maxTouchPoints > 1 && /Mac|iPad/.test(navigator.platform || navigator.userAgent);
      var pointer = document.getElementById('share-pointer');
      var label = document.getElementById('share-pointer-label');
      var arrow = document.getElementById('share-pointer-arrow');

      if (isIPad) {
        pointer.className = 'share-pointer topright show';
        label.textContent = 'Tap Share up here';
        arrow.innerHTML = '<path d="M12 19V5"/><path d="m5 12 7-7 7 7"/>';
      } else {
        pointer.className = 'share-pointer bottom show';
        label.textContent = 'Tap Share down here';
      }

      // The wallet's own bottom bar would sit between the arrow and Safari's
      // toolbar, pointing at the wrong thing.
      var tabbar = document.querySelector('.w-tabbar');
      if (tabbar && !isIPad) tabbar.style.display = 'none';

      // Reserve the space the pointer occupies. Without this it sits on top of
      // whatever the page's last element happens to be -- on a phone that's
      // the "Turn on notifications" button, which it would cover.
      if (!isIPad) document.body.style.paddingBottom = '104px';
    }

    // A Safari tab can never see that the user just installed the site --
    // navigator.standalone stays false here no matter what. But the installed
    // copy tells the server the first time it opens, so poll for that. Only
    // while the tab is actually visible, and it stops as soon as it fires.
    function watchForInstall() {
      var timer = setInterval(async function () {
        if (document.hidden) return;
        try {
          var res = await fetch('/account/install/status');
          var data = await res.json();
          if (!data.installed) return;
          clearInterval(timer);
          markInstalled();
        } catch (err) {
          /* offline or signed out -- keep waiting, the banner is optional */
        }
      }, 3000);
    }

    function markInstalled() {
      document.getElementById('share-pointer').classList.remove('show');
      document.body.style.paddingBottom = '';
      var tabbar = document.querySelector('.w-tabbar');
      if (tabbar) tabbar.style.display = '';
      document.getElementById('install-ios').classList.add('hidden');
      document.getElementById('already-installed').classList.remove('hidden');
      document.getElementById('already-installed').lastChild.textContent =
        " That's it — ReceipTap is on your home screen. Open it from there, then turn on notifications below.";
      var step = document.getElementById('step-install');
      step.classList.add('done');
      step.querySelector('.step-num').innerHTML =
        '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg>';
      document.getElementById('step-notify').scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    // Chrome sometimes fires beforeinstallprompt after this page has rendered,
    // so re-run when the shared head script says it arrived.
    window.addEventListener('receiptap:installable', showInstallStep);
    showInstallStep();

    async function runInstall() {
      var btn = document.getElementById('install-btn');
      var status = document.getElementById('install-status');
      var prompt = window.__installPrompt;
      if (!prompt) { status.textContent = 'Your browser closed the install offer — reload the page and try again.'; return; }

      btn.disabled = true;
      prompt.prompt();
      var choice = await prompt.userChoice;
      // The event is single-use; Chrome will fire a fresh one if it wants to.
      window.__installPrompt = null;

      if (choice.outcome === 'accepted') {
        status.className = 'status good';
        status.textContent = 'Added. Open ReceipTap from your home screen from now on.';
        fetch('/account/install/installed', { method: 'POST' }).catch(function () {});
      } else {
        btn.disabled = false;
        status.textContent = 'No problem — you can add it any time.';
      }
    }

    // ---- Step 2 ------------------------------------------------------------
    var notifyBtn = document.getElementById('notify-btn');
    var notifyStatus = document.getElementById('notify-status');
    var notifyText = document.getElementById('notify-text');
    var pushSupported = ReceipTapPush.supported;

    function showNotifyStep() {
      if (!IS_CUSTOMER) {
        // Push is wired up for shopper accounts only right now.
        notifyBtn.classList.add('hidden');
        notifyText.textContent = 'Alerts for your business are coming — for now, adding ReceipTap to your home screen gets you one-tap access to your dashboard.';
        return;
      }
      if (!PUSH_CONFIGURED) {
        notifyBtn.classList.add('hidden');
        notifyStatus.textContent = 'Notifications are not switched on for this server yet.';
        return;
      }
      if (ALREADY_SUBSCRIBED) {
        notifyBtn.classList.add('hidden');
        notifyText.textContent = "Notifications are on. We'll let you know the moment something happens.";
        return;
      }
      if (!pushSupported) {
        notifyBtn.disabled = true;
        notifyStatus.textContent = isIOS && !isStandalone
          ? 'Finish step 1 first — on iPhone, notifications only work once ReceipTap is on your home screen.'
          : "This browser doesn't support notifications.";
        return;
      }
      if (Notification.permission === 'denied') {
        notifyBtn.disabled = true;
        notifyStatus.textContent = 'Notifications are blocked for this site in your browser settings.';
      }
    }
    showNotifyStep();

    async function enablePush() {
      notifyBtn.disabled = true;
      notifyStatus.className = 'status';
      notifyStatus.textContent = 'Asking your browser…';
      var result = await ReceipTapPush.enable();
      if (!result.ok) {
        notifyBtn.disabled = ReceipTapPush.permission() === 'denied';
        notifyStatus.textContent = result.reason;
        return;
      }
      notifyBtn.classList.add('hidden');
      notifyText.textContent = "Notifications are on. We'll let you know the moment something happens.";
      notifyStatus.className = 'status good';
      notifyStatus.textContent = 'You can turn these off any time from the menu in the top right of your receipts.';
    }
  </script>
</body>
</html>
