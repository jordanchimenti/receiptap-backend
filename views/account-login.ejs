<!-- views/account-login.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Log In - ReceipTap</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
  <%- include('partials/wallet-dark-theme') %>
  <style>
    .auth-shell { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; }
    .auth-card { width: 100%; max-width: 380px; background: var(--w-card); border: 1px solid var(--w-line); border-radius: 20px; padding: 36px 30px; text-align: center; }
    .auth-title { font-family: var(--font-display); font-size: 24px; font-weight: 700; margin: 4px 0 6px; }
    .auth-sub { font-size: 13.5px; color: var(--w-ink-soft); margin: 0 0 24px; }
    .auth-field { text-align: left; margin-bottom: 16px; }
    .auth-field-row { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px; }
    .auth-field label { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--w-ink-soft); }
    .auth-field a { font-size: 12.5px; font-weight: 600; color: var(--w-accent); text-decoration: none; }
    .auth-input-wrap { position: relative; }
    .auth-field input {
      width: 100%; box-sizing: border-box; background: var(--w-card-raised); border: 1px solid var(--w-line);
      color: var(--w-ink); border-radius: 12px; padding: 13px 16px; font-size: 15px; font-family: inherit;
    }
    .auth-field input:focus { outline: 2px solid var(--w-accent); outline-offset: 1px; border-color: var(--w-accent); }
    .pw-toggle {
      position: absolute; right: 4px; top: 50%; transform: translateY(-50%); background: none; border: none;
      color: var(--w-ink-soft); cursor: pointer; padding: 8px; display: flex;
    }
    .auth-pill-btn {
      display: block; width: 100%; box-sizing: border-box; background: var(--w-accent); color: #fff; border: none;
      border-radius: 999px; padding: 14px 20px; font-size: 15px; font-weight: 700; cursor: pointer; font-family: inherit;
      margin-bottom: 22px;
    }
    .auth-pill-btn:hover { background: var(--w-accent-deep); }
    .auth-divider { display: flex; align-items: center; gap: 10px; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--w-ink-soft); margin-bottom: 16px; }
    .auth-divider span.line { flex: 1; height: 1px; background: var(--w-line); }
    .auth-oauth-btn {
      display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; box-sizing: border-box;
      padding: 12px 16px; border-radius: 999px; font-size: 14.5px; font-weight: 600; text-decoration: none;
      border: 1px solid var(--w-line); margin-bottom: 10px; cursor: pointer; font-family: inherit;
    }
    .auth-oauth-btn.google { background: var(--w-card-raised); color: var(--w-ink); }
    .auth-oauth-btn.apple { background: #000; color: #fff; border-color: #000; }
    .auth-oauth-btn.microsoft { background: var(--w-card-raised); color: var(--w-ink); }
    #google-signin-btn { display: flex; justify-content: center; margin-bottom: 10px; }
    /* The logo's "Receip" wordmark is dark navy, meant for a light
       background -- rather than recolor the actual brand asset, give it a
       small paper-toned chip to sit on so it stays legible here, same
       brand-paper accent already used on the scan page's tips card. */
    .logo-chip { display: inline-block; background: var(--paper); border-radius: 12px; padding: 10px 18px; margin-bottom: 22px; }
    .logo-chip img { display: block; height: 32px; }
  </style>
</head>
<body>
  <div class="auth-shell">
    <div class="auth-card">
      <div class="logo-chip"><img src="/images/receiptap-logo.png" alt="ReceipTap" /></div>
      <div class="w-eyebrow">Sign in</div>
      <h1 class="auth-title">Welcome back</h1>
      <p class="auth-sub">Pick up where you left off.</p>

      <div class="w-error" id="error-box" style="display: none;"></div>
      <% if (error) { %><div class="w-error" style="display:block;"><%= error %></div><% } %>
      <% if (typeof deleted !== 'undefined' && deleted) { %>
        <div class="w-error" style="display:block; background: var(--w-card-raised); color: var(--w-ink-soft); border-color: var(--w-line);">Your account and its data have been deleted.</div>
      <% } %>

      <form id="login-form">
        <div class="auth-field">
          <div class="auth-field-row"><label for="email">Email</label></div>
          <input type="email" id="email" name="email" placeholder="you@example.com" required />
        </div>
        <div class="auth-field">
          <div class="auth-field-row">
            <label for="password">Password</label>
            <a href="/account/forgot-password">Forgot password?</a>
          </div>
          <div class="auth-input-wrap">
            <input type="password" id="password" name="password" placeholder="Your password" required />
            <button type="button" class="pw-toggle" id="pw-toggle" aria-label="Show password">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>
        <button class="auth-pill-btn" type="submit">Sign in</button>
      </form>

      <div class="auth-divider"><span class="line"></span>Or continue with<span class="line"></span></div>

      <div id="google-signin-btn"></div>
      <% if (appleClientId) { %>
        <a href="/account/apple/connect?redirect=<%= encodeURIComponent(redirect) %>" class="auth-oauth-btn apple">
          <svg width="16" height="16" viewBox="0 0 384 512" fill="#fff"><path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/></svg>
          Continue with Apple
        </a>
      <% } %>
      <% if (microsoftClientId) { %>
        <a href="/account/microsoft/connect?redirect=<%= encodeURIComponent(redirect) %>" class="auth-oauth-btn microsoft">
          <svg width="16" height="16" viewBox="0 0 21 21"><rect x="1" y="1" width="9" height="9" fill="#f25022"/><rect x="11" y="1" width="9" height="9" fill="#7fba00"/><rect x="1" y="11" width="9" height="9" fill="#00a4ef"/><rect x="11" y="11" width="9" height="9" fill="#ffb900"/></svg>
          Continue with Microsoft
        </a>
      <% } %>

      <p style="font-size: 13px; color: var(--w-ink-soft); margin-top: 18px;">
        Don't have an account? <a href="/account/signup?redirect=<%= encodeURIComponent(redirect) %>" style="color: var(--w-accent); font-weight: 600; text-decoration: none;">Create a free account</a>
      </p>
      <p style="font-size: 11.5px; color: var(--w-ink-soft); margin-top: 14px;">
        By continuing, you agree to our
        <a href="/legal/wallet-terms" style="color: var(--w-ink-soft); text-decoration: underline;">Terms</a>
        and
        <a href="/legal/wallet-privacy" style="color: var(--w-ink-soft); text-decoration: underline;">Privacy Policy</a>.
      </p>
    </div>
  </div>

  <script src="https://accounts.google.com/gsi/client" async defer></script>
  <script>
    const REDIRECT_TO = '<%= redirect %>';

    function showError(msg) {
      const el = document.getElementById('error-box');
      el.textContent = msg;
      el.style.display = 'block';
    }

    document.getElementById('pw-toggle').addEventListener('click', () => {
      const input = document.getElementById('password');
      input.type = input.type === 'password' ? 'text' : 'password';
    });

    document.getElementById('login-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = document.getElementById('email').value;
      const password = document.getElementById('password').value;

      const res = await fetch('/account/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password }),
      });
      const data = await res.json();
      if (!res.ok) { showError(data.error || 'Something went wrong.'); return; }
      window.location.href = REDIRECT_TO;
    });

    async function handleGoogleSignIn(response) {
      const res = await fetch('/account/google', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ credential: response.credential }),
      });
      const data = await res.json();
      if (!res.ok) { showError(data.error || 'Google sign-in failed.'); return; }
      window.location.href = REDIRECT_TO;
    }

    window.onload = function () {
      if (window.google && window.google.accounts) {
        google.accounts.id.initialize({
          client_id: '<%= googleClientId %>',
          callback: handleGoogleSignIn,
        });
        google.accounts.id.renderButton(
          document.getElementById('google-signin-btn'),
          { theme: 'outline', size: 'large', shape: 'pill', width: 320 }
        );
      }
    };
  </script>
</body>
</html>
