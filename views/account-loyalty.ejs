<!-- views/account-loyalty.ejs -->
<!-- Every stamp card this customer has, across every merchant they've saved a
     receipt from -- lets them finish a redemption here even if they're not
     looking at the original receipt anymore. Each card is drawn in the
     merchant's own Card design (see resolveCardDesign, routes/loyalty.js). -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Rewards - ReceipTap</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
  <%- include('partials/wallet-dark-theme') %>
  <style>
    .biz-header { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; }

    /* The card wears the merchant's own design (background/accent/logo, resolved
       by resolveCardDesign in routes/loyalty.js), so everything inside it is
       drawn in currentColor rather than the wallet's own ink tokens. */
    .loyalty-card { border-radius: 18px; padding: 16px; margin-bottom: 12px; }
    .stamp-head { display: flex; align-items: center; gap: 11px; margin-bottom: 14px; }
    .stamp-logo {
      width: 40px; height: 40px; border-radius: 10px; flex: none; display: flex;
      align-items: center; justify-content: center; background: rgba(255,255,255,0.18); overflow: hidden;
    }
    .stamp-logo img { width: 100%; height: 100%; object-fit: contain; }
    .stamp-monogram { font-family: var(--font-display); font-size: 18px; font-weight: 700; line-height: 1; }
    .stamp-head-text { min-width: 0; }
    .loyalty-merchant { font-weight: 700; font-size: 15px; line-height: 1.2; }
    .loyalty-sub { font-size: 12px; opacity: 0.85; margin-top: 2px; line-height: 1.45; }
    .punch-row { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
    .punch-hole {
      width: 34px; height: 34px; border-radius: 50%; border: 1.5px solid currentColor;
      display: flex; align-items: center; justify-content: center; font-size: 12.5px;
      font-weight: 700; box-sizing: border-box; opacity: 0.55;
    }
    .punch-hole.filled { opacity: 1; }
    .stamp-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 13.5px; font-weight: 600; }
    .stamp-foot-reward { display: flex; align-items: center; gap: 7px; min-width: 0; }
    .stamp-foot-reward span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .loyalty-btn {
      display: block; width: 100%; margin-top: 14px; padding: 11px 22px; border-radius: 999px;
      border: 1.5px solid currentColor; background: transparent; color: inherit; font-weight: 700;
      font-size: 13.5px; cursor: pointer; font-family: inherit;
    }
    .loyalty-error { color: var(--w-danger); font-size: 12px; margin-top: 6px; min-height: 14px; }

    /* Empty state, in the same dashed-card language the light page used. */
    /* receiptap.css's .empty-state is the light theme's -- it sets
       background: var(--paper-raised), which renders white on these dark
       pages. Override it explicitly rather than inheriting it. */
    /* Section headings sit between cards, so the gap above is larger than the
       gap below -- the heading should read as belonging to the cards under it
       rather than floating between two groups. First one loses the top gap. */
    /* Same pill tabs as views/business-emails.ejs, so the two filters in the
       app look like the same control. Those are links (server-filtered); these
       are buttons, because the filtering happens here on the page. */
    .tabs { display: flex; gap: 8px; margin-bottom: 14px; flex-wrap: wrap; }
    .tab-btn {
      font-size: 12.5px; font-weight: 700; padding: 8px 14px; border-radius: 999px;
      border: 1px solid var(--w-line); background: var(--w-card-raised);
      color: var(--w-ink-soft); font-family: inherit; cursor: pointer;
    }
    .tab-btn.active { background: var(--w-accent); border-color: var(--w-accent); color: #fff; }
    .rewards-section { margin: 0; }
    .rewards-section + .rewards-section { margin-top: 26px; }
    .rewards-section-title {
      display: flex; align-items: center; gap: 8px;
      font-size: 12.5px; font-weight: 700; letter-spacing: 0.06em;
      text-transform: uppercase; color: var(--w-ink-soft);
      margin: 0 0 10px; padding: 0 2px;
    }
    .rewards-section-count {
      font-size: 11.5px; font-weight: 700; letter-spacing: 0;
      color: var(--w-ink-soft); background: var(--w-card);
      border: 1px solid var(--w-line); border-radius: 999px;
      min-width: 20px; text-align: center; padding: 1px 7px;
    }
    .rewards-search { padding: 12px 14px; margin-bottom: 14px; }
    .rewards-search-row { display: flex; align-items: center; gap: 10px; }
    .rewards-search-icon { width: 17px; height: 17px; color: var(--w-ink-soft); flex: none; }
    .rewards-search input {
      flex: 1; min-width: 0; background: none; border: none; outline: none;
      color: var(--w-ink); font-family: inherit; font-size: 15px; padding: 4px 0;
    }
    .rewards-search input::placeholder { color: var(--w-ink-soft); }
    /* Safari draws its own clear button on type=search and it doesn't match. */
    .rewards-search input::-webkit-search-decoration,
    .rewards-search input::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; }
    .rewards-search-clear {
      display: none; background: none; border: none; padding: 4px; cursor: pointer;
      color: var(--w-ink-soft); flex: none; line-height: 0;
    }
    .rewards-search-clear svg { width: 15px; height: 15px; }
    .rewards-search.searching .rewards-search-clear { display: block; }

    .empty-state {
      background: var(--w-card);
      border: 1px dashed var(--w-line); border-radius: 18px; padding: 40px 24px; margin-top: 8px;
      text-align: center; color: var(--w-ink-soft); font-size: 13.5px; line-height: 1.6;
    }
    .empty-icon {
      width: 46px; height: 46px; border-radius: 50%; margin: 0 auto 14px;
      background: var(--w-card-raised); display: flex; align-items: center; justify-content: center;
      color: var(--w-accent);
    }

    /* --- Redemption modal --- */
    .modal-overlay {
      display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7);
      align-items: center; justify-content: center; z-index: 100; padding: 16px;
    }
    .modal-overlay.open { display: flex; }
    .modal-box {
      background: var(--w-card); border: 1px solid var(--w-line); border-radius: 18px; padding: 26px 22px;
      max-width: 340px; width: 100%; box-sizing: border-box; text-align: center;
    }
    .modal-title { font-family: var(--font-display); font-size: 19px; font-weight: 700; margin-bottom: 6px; color: var(--w-ink); }
    .modal-subtitle { font-size: 13px; color: var(--w-ink-soft); margin-bottom: 16px; line-height: 1.5; }
    .modal-box input[type=text] {
      width: 100%; padding: 12px; background: var(--w-card-raised); border: 1px solid var(--w-line);
      color: var(--w-ink); border-radius: 10px; box-sizing: border-box; font-size: 15px;
      margin-bottom: 10px; text-align: center; letter-spacing: 2px; font-weight: 600; font-family: inherit;
    }
    .modal-box input[type=text]:focus { outline: 2px solid var(--w-accent); outline-offset: 1px; border-color: var(--w-accent); }
    .modal-box button.primary {
      width: 100%; padding: 12px; background: var(--w-accent); color: #fff; border: none;
      border-radius: 999px; font-weight: 700; cursor: pointer; font-size: 14px; font-family: inherit;
    }
    .modal-box button.primary:hover { background: var(--w-accent-deep); }
    .modal-box button.secondary {
      background: var(--w-card-raised); color: var(--w-ink); border: 1px solid var(--w-line);
    }
    .modal-close { text-align: center; margin-top: 14px; font-size: 12px; color: var(--w-ink-soft); cursor: pointer; }
  </style>
</head>
<body>
  <div class="w-shell">
    <div class="biz-header">
      <a href="/account/more" class="w-btn-icon" aria-label="Back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      </a>
      <div>
        <div class="w-eyebrow">Your rewards</div>
        <h1 class="w-title" style="font-size:20px;">My Loyalty Cards</h1>
      </div>
    </div>

    <% if (cards.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 12v9H4v-9"/><path d="M2 7h20v5H2z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7Z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7Z"/></svg>
        </div>
        No stamp cards yet — save a receipt from a shop that runs one and your card starts itself.
      </div>
    <% } else { %>
      <%# Filters the cards already on the page rather than reloading. The
          whole list is rendered in one go (loyalty cards aren't paginated),
          so there is nothing for a server round-trip to fetch, and matching
          in place means the list narrows as you type. %>
      <div class="w-card rewards-search">
        <div class="rewards-search-row">
          <svg class="rewards-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input type="search" id="rewards-search" placeholder="Search by business" autocomplete="off"
                 aria-label="Search your loyalty cards by business" oninput="filterRewards()" />
          <button type="button" class="rewards-search-clear" id="rewards-clear" onclick="clearRewardsSearch()" aria-label="Clear search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
          </button>
        </div>
      </div>

      <%# Client-side, unlike the server-rendered tabs on business-emails.ejs:
          every card is already on the page (loyalty cards aren't paginated),
          so filtering here costs no round trip and composes with the search
          box -- a card shows only if its group is active AND it matches the
          query. Defaults to All so the page never opens hiding something. %>
      <div class="tabs" role="group" aria-label="Filter cards">
        <button type="button" class="tab-btn" data-tab="ready" aria-pressed="false"
                onclick="setRewardsTab('ready')">Claim rewards (<%= readyCards.length %>)</button>
        <button type="button" class="tab-btn" data-tab="progress" aria-pressed="false"
                onclick="setRewardsTab('progress')">In progress (<%= inProgressCards.length %>)</button>
        <button type="button" class="tab-btn active" data-tab="all" aria-pressed="true"
                onclick="setRewardsTab('all')">All (<%= cards.length %>)</button>
      </div>

      <div id="rewards-none" class="empty-state" style="display:none;">
        No cards match that business.
      </div>

      <%# Full cards lead: they're the only ones with something to do, and in a
          single updatedAt-ordered list a redeemable card sinks below cards that
          are barely started. Each section is hidden by filterRewards() when the
          search empties it, so a heading never sits above nothing. %>
      <% if (readyCards.length > 0) { %>
        <section class="rewards-section" data-rewards-section data-group="ready">
          <h2 class="rewards-section-title">
            Ready to redeem
            <span class="rewards-section-count"><%= readyCards.length %></span>
          </h2>
          <% readyCards.forEach(function(card) { %>
            <%- include('partials/loyalty-card', { card: card }) %>
          <% }); %>
        </section>
      <% } %>

      <% if (inProgressCards.length > 0) { %>
        <section class="rewards-section" data-rewards-section data-group="progress">
          <h2 class="rewards-section-title">
            Collecting stamps
            <span class="rewards-section-count"><%= inProgressCards.length %></span>
          </h2>
          <% inProgressCards.forEach(function(card) { %>
            <%- include('partials/loyalty-card', { card: card }) %>
          <% }); %>
        </section>
      <% } %>
    <% } %>
  </div>

  <!-- Redemption modal: shared by every card, retargeted per card on open -->
  <div class="modal-overlay" id="loyalty-modal">
    <div class="modal-box">
      <div class="modal-title">🎉 Your card is full!</div>
      <div class="modal-subtitle">Redeem your reward now, or save it for later.</div>

      <div id="loyalty-choice-step">
        <button class="primary" onclick="startLoyaltyRedeem()">Redeem</button>
        <button class="primary secondary" style="margin-top:8px;" onclick="closeLoyaltyModal()">Save</button>
      </div>

      <div id="loyalty-code-step" style="display:none;">
        <div class="modal-subtitle">Ask your cashier for the redemption code and enter it below.</div>
        <div class="loyalty-error" id="loyalty-modal-error"></div>
        <input type="text" id="loyalty-code-input" placeholder="Code" autocomplete="off" />
        <button class="primary" onclick="submitLoyaltyCode()">Submit</button>
      </div>

      <div class="modal-close" onclick="closeLoyaltyModal()">Close</div>
    </div>
  </div>

  <script>
    // Card filtering. Matches anywhere in the business name, not just the
    // start, because people search for the word they remember ("coffee")
    // rather than what the shop is filed under ("The Coffee House").
    // The whole visibility rule, kept as one pure function so it can be tested
    // without a DOM (test/loyalty-card-filter.test.js extracts and runs this
    // exact source). Two filters, one decision: the card's group has to be in
    // the active tab AND its name has to match the query.
    function rewardCardMatches(group, merchantName, tab, query) {
      var inTab = tab === 'all' || group === tab;
      if (!inTab) return false;
      if (!query) return true;
      return (merchantName || '').indexOf(query) !== -1;
    }

    function filterRewards() {
      var box = document.getElementById('rewards-search');
      if (!box) return;
      var q = box.value.trim().toLowerCase();
      var wrap = box.closest('.rewards-search');
      wrap.classList.toggle('searching', q.length > 0);

      var shown = 0;
      document.querySelectorAll('[data-rewards-section]').forEach(function (section) {
        // Two independent filters, one visibility decision: the card's group
        // has to be in the active tab AND its name has to match the query.
        var group = section.dataset.group;
        var visibleHere = 0;

        section.querySelectorAll('.loyalty-card').forEach(function (el) {
          var hit = rewardCardMatches(group, el.dataset.merchant || '', activeRewardsTab, q);
          el.style.display = hit ? '' : 'none';
          if (hit) visibleHere++;
        });

        // A section whose every card just got filtered out would otherwise
        // leave its heading and count stranded above empty space.
        section.style.display = visibleHere ? '' : 'none';
        shown += visibleHere;
      });

      // Say which filter emptied the list, rather than one message for both.
      // An untyped box that matches nothing means they have no cards at all,
      // which the page already says elsewhere -- so search only speaks up once
      // they've actually typed.
      var note = document.getElementById('rewards-none');
      if (shown > 0) {
        note.style.display = 'none';
      } else if (q) {
        note.textContent = 'No cards match that business.';
        note.style.display = '';
      } else if (activeRewardsTab === 'ready') {
        note.textContent = 'No cards are full yet — keep collecting.';
        note.style.display = '';
      } else if (activeRewardsTab === 'progress') {
        note.textContent = 'No cards in progress — every card you have is ready to claim.';
        note.style.display = '';
      } else {
        note.style.display = 'none';
      }
    }

    var activeRewardsTab = 'all';

    function setRewardsTab(tab) {
      activeRewardsTab = tab;
      document.querySelectorAll('.tab-btn').forEach(function (btn) {
        var on = btn.dataset.tab === tab;
        btn.classList.toggle('active', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      filterRewards();
    }

    function clearRewardsSearch() {
      var box = document.getElementById('rewards-search');
      box.value = '';
      filterRewards();
      box.focus();
    }
    let activeLoyaltyCardId = null;

    function openLoyaltyModal(cardId) {
      activeLoyaltyCardId = cardId;
      document.getElementById('loyalty-choice-step').style.display = 'block';
      document.getElementById('loyalty-code-step').style.display = 'none';
      document.getElementById('loyalty-modal-error').textContent = '';
      document.getElementById('loyalty-modal').classList.add('open');
    }
    function closeLoyaltyModal() {
      document.getElementById('loyalty-modal').classList.remove('open');
      activeLoyaltyCardId = null;
    }
    function startLoyaltyRedeem() {
      document.getElementById('loyalty-choice-step').style.display = 'none';
      document.getElementById('loyalty-code-step').style.display = 'block';
      document.getElementById('loyalty-code-input').focus();
    }

    async function submitLoyaltyCode() {
      const errorEl = document.getElementById('loyalty-modal-error');
      const code = document.getElementById('loyalty-code-input').value;
      errorEl.textContent = '';

      const res = await fetch(`/loyalty/${activeLoyaltyCardId}/redeem`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code }),
      });
      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        errorEl.textContent = data.error || 'Something went wrong -- please try again.';
        return;
      }
      const cardEl = document.querySelector(`[data-card-id="${activeLoyaltyCardId}"]`);
      cardEl.innerHTML = '<div class="loyalty-merchant">🎉 Reward redeemed!</div><div class="loyalty-sub">Thanks for being a loyal customer.</div>';
      closeLoyaltyModal();
      setTimeout(() => location.reload(), 1800);
    }
  </script>
</body>
</html>
