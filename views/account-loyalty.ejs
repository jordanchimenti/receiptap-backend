<!-- views/account-loyalty.ejs -->
<!-- Every loyalty punch card this customer has, across every merchant they've
     joined a program with -- lets them finish a redemption here even if
     they're not looking at the original receipt anymore. -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Rewards - ReceipTap</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
  <style>
    .wallet-shell { max-width: 520px; margin: 0 auto; padding: 24px 16px 48px; }
    .wallet-header { display: flex; align-items: center; justify-content: space-between; }
    .wallet-logo { height: 36px; }
    .back-link { font-size: 13px; color: var(--ink-soft); text-decoration: none; display: inline-block; margin: 18px 0 4px; }

    .loyalty-card {
      background: var(--paper-raised); border: 1px solid var(--line); border-radius: 14px;
      padding: 18px; margin-top: 16px; text-align: center;
    }
    .loyalty-merchant { font-weight: 700; font-size: 15px; }
    .loyalty-sub { font-size: 12.5px; color: var(--ink-soft); margin-top: 4px; line-height: 1.4; }
    .punch-row { display: flex; justify-content: center; gap: 8px; margin-top: 12px; }
    .punch-hole {
      width: 34px; height: 34px; border-radius: 50%; border: 2px dashed var(--line);
      display: flex; align-items: center; justify-content: center; font-size: 15px; color: #fff;
      box-sizing: border-box;
    }
    .punch-hole.filled { border-style: solid; border-color: var(--teal); background: var(--teal); }
    .loyalty-btn {
      display: inline-block; margin-top: 12px; padding: 10px 18px; border-radius: 8px;
      border: none; font-weight: 600; font-size: 13.5px; cursor: pointer;
    }
    .loyalty-error { color: var(--danger); font-size: 12px; margin-top: 6px; min-height: 14px; }
    .empty-state { text-align: center; color: var(--ink-soft); font-size: 13.5px; margin-top: 60px; }

    /* --- Redemption modal --- */
    .modal-overlay {
      display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5);
      align-items: center; justify-content: center; z-index: 100; padding: 16px;
    }
    .modal-overlay.open { display: flex; }
    .modal-box {
      background: var(--paper-raised); border-radius: 12px; padding: 24px;
      max-width: 340px; width: 100%; box-sizing: border-box; text-align: center;
    }
    .modal-title { font-size: 17px; font-weight: 700; margin-bottom: 4px; }
    .modal-subtitle { font-size: 13px; color: var(--ink-soft); margin-bottom: 14px; }
    .modal-box input[type=text] {
      width: 100%; padding: 10px; border: 1px solid var(--line); border-radius: 8px;
      box-sizing: border-box; font-size: 14px; margin-bottom: 10px; text-align: center;
      letter-spacing: 2px; font-weight: 600;
    }
    .modal-box button.primary {
      width: 100%; padding: 11px; background: var(--teal); color: #fff;
      border: none; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 14px;
    }
    .modal-close { text-align: center; margin-top: 14px; font-size: 12px; color: var(--ink-soft); cursor: pointer; }
  </style>
</head>
<body>
  <div class="wallet-shell">
    <div class="wallet-header">
      <img class="wallet-logo" src="/images/receiptap-logo.png" alt="ReceipTap" />
    </div>
    <a class="back-link" href="/account/receipts">&larr; Back to receipts</a>

    <div class="eyebrow" style="margin-top: 6px;">Your rewards</div>
    <h1 style="font-size: 24px;">My Loyalty Cards</h1>

    <% if (cards.length === 0) { %>
      <div class="empty-state">No loyalty cards yet — join one from a receipt at a participating business.</div>
    <% } else { %>
      <% cards.forEach(function(card) { %>
        <% var offerText = card.offerType === 'PERCENT' ? (card.offerValue + '% off') : ('$' + (card.offerValue / 100).toFixed(2) + ' off'); %>
        <div class="loyalty-card" data-card-id="<%= card.id %>">
          <div class="loyalty-merchant"><%= card.merchantName %></div>

          <div class="punch-row">
            <% for (var p = 1; p <= 5; p++) { %>
              <div class="punch-hole <%= p <= card.punches ? 'filled' : '' %>"><%= p <= card.punches ? '✓' : '' %></div>
            <% } %>
          </div>
          <div class="loyalty-sub">
            <% if (card.punches >= 5) { %>
              Card full — redeem for <%= offerText %>!
            <% } else { %>
              <% var punchesLeft = 5 - card.punches; %>
              You're <%= punchesLeft %> punch<%= punchesLeft === 1 ? '' : 'es' %> away from claiming <%= offerText %>!
            <% } %>
          </div>
          <% if (card.punches >= 5) { %>
            <button type="button" class="loyalty-btn" style="background:var(--teal); color:#fff;" onclick="openLoyaltyModal('<%= card.id %>')">Redeem Reward</button>
          <% } %>
        </div>
      <% }); %>
    <% } %>
  </div>

  <!-- Redemption modal: shared by every card, retargeted per card on open -->
  <div class="modal-overlay" id="loyalty-modal">
    <div class="modal-box">
      <div class="modal-title">🎉 Your card is full!</div>
      <div class="modal-subtitle">Redeem your reward now, or save it for later.</div>

      <div id="loyalty-choice-step">
        <button class="primary" onclick="startLoyaltyRedeem()">Redeem</button>
        <button class="primary" style="background:#999; margin-top:8px;" onclick="closeLoyaltyModal()">Save</button>
      </div>

      <div id="loyalty-code-step" style="display:none;">
        <div class="modal-subtitle">Ask your cashier for the redemption code and enter it below.</div>
        <div class="loyalty-error" id="loyalty-modal-error"></div>
        <input type="text" id="loyalty-code-input" placeholder="Code" autocomplete="off" />
        <button class="primary" onclick="submitLoyaltyCode()">Submit</button>
      </div>

      <div class="modal-close" onclick="closeLoyaltyModal()">Close</div>
    </div>
  </div>

  <script>
    let activeLoyaltyCardId = null;

    function openLoyaltyModal(cardId) {
      activeLoyaltyCardId = cardId;
      document.getElementById('loyalty-choice-step').style.display = 'block';
      document.getElementById('loyalty-code-step').style.display = 'none';
      document.getElementById('loyalty-modal-error').textContent = '';
      document.getElementById('loyalty-modal').classList.add('open');
    }
    function closeLoyaltyModal() {
      document.getElementById('loyalty-modal').classList.remove('open');
      activeLoyaltyCardId = null;
    }
    function startLoyaltyRedeem() {
      document.getElementById('loyalty-choice-step').style.display = 'none';
      document.getElementById('loyalty-code-step').style.display = 'block';
      document.getElementById('loyalty-code-input').focus();
    }

    async function submitLoyaltyCode() {
      const errorEl = document.getElementById('loyalty-modal-error');
      const code = document.getElementById('loyalty-code-input').value;
      errorEl.textContent = '';

      const res = await fetch(`/loyalty/${activeLoyaltyCardId}/redeem`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code }),
      });
      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        errorEl.textContent = data.error || 'Something went wrong -- please try again.';
        return;
      }
      const cardEl = document.querySelector(`[data-card-id="${activeLoyaltyCardId}"]`);
      cardEl.innerHTML = '<div class="loyalty-merchant">🎉 Reward redeemed!</div><div class="loyalty-sub">Thanks for being a loyal customer.</div>';
      closeLoyaltyModal();
      setTimeout(() => location.reload(), 1800);
    }
  </script>
</body>
</html>
