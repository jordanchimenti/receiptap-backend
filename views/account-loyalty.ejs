<!-- views/account-loyalty.ejs -->
<!-- Every loyalty punch card this customer has, across every merchant they've
     joined a program with -- lets them finish a redemption here even if
     they're not looking at the original receipt anymore. -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Rewards - ReceipTap</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
  <style>
    .wallet-shell { max-width: 520px; margin: 0 auto; padding: 24px 16px 48px; }
    .wallet-header { display: flex; align-items: center; justify-content: space-between; }
    .wallet-logo { height: 36px; }
    .back-link { font-size: 13px; color: var(--ink-soft); text-decoration: none; display: inline-block; margin: 18px 0 4px; }

    .loyalty-card {
      background: var(--paper-raised); border: 1px solid var(--line); border-radius: 14px;
      padding: 18px; margin-top: 16px; text-align: center;
    }
    .loyalty-merchant { font-weight: 700; font-size: 15px; }
    .loyalty-sub { font-size: 12.5px; color: var(--ink-soft); margin-top: 4px; line-height: 1.4; }
    .punch-row { display: flex; justify-content: center; gap: 8px; margin-top: 12px; }
    .punch-hole {
      width: 34px; height: 34px; border-radius: 50%; border: 2px dashed var(--line);
      display: flex; align-items: center; justify-content: center; font-size: 15px; color: #fff;
      box-sizing: border-box;
    }
    .punch-hole.filled { border-style: solid; border-color: var(--teal); background: var(--teal); }
    .loyalty-code { font-size: 32px; font-weight: 700; letter-spacing: 6px; margin: 10px 0; font-family: var(--font-mono); }
    .loyalty-btn {
      display: inline-block; margin-top: 12px; padding: 10px 18px; border-radius: 8px;
      border: none; font-weight: 600; font-size: 13.5px; cursor: pointer;
    }
    .signature-pad {
      width: 100%; max-width: 360px; height: 150px; border: 1px solid var(--line);
      border-radius: 8px; margin-top: 10px; touch-action: none; background: #fff; box-sizing: border-box;
    }
    .loyalty-error { color: var(--danger); font-size: 12px; margin-top: 6px; min-height: 14px; }
    .empty-state { text-align: center; color: var(--ink-soft); font-size: 13.5px; margin-top: 60px; }
  </style>
</head>
<body>
  <div class="wallet-shell">
    <div class="wallet-header">
      <img class="wallet-logo" src="/images/receiptap-logo.png" alt="ReceipTap" />
    </div>
    <a class="back-link" href="/account/receipts">&larr; Back to receipts</a>

    <div class="eyebrow" style="margin-top: 6px;">Your rewards</div>
    <h1 style="font-size: 24px;">My Loyalty Cards</h1>

    <% if (cards.length === 0) { %>
      <div class="empty-state">No loyalty cards yet — join one from a receipt at a participating business.</div>
    <% } else { %>
      <% cards.forEach(function(card) { %>
        <% var offerText = card.offerType === 'PERCENT' ? (card.offerValue + '% off') : ('$' + (card.offerValue / 100).toFixed(2) + ' off'); %>
        <div class="loyalty-card" data-card-id="<%= card.id %>">
          <div class="loyalty-merchant"><%= card.merchantName %></div>

          <% if (card.redemptionStatus === 'CONFIRMED') { %>
            <div class="loyalty-sub">Your merchant confirmed your <%= offerText %> reward — sign below to finish.</div>
            <canvas id="signature-pad-<%= card.id %>" class="signature-pad" width="360" height="150"></canvas>
            <div style="display:flex; gap:8px; margin-top:10px; justify-content:center;">
              <button type="button" class="loyalty-btn" style="background:#999; color:#fff;" onclick="clearSignature('<%= card.id %>')">Clear</button>
              <button type="button" class="loyalty-btn" style="background:var(--teal); color:#fff;" onclick="submitSignature('<%= card.id %>')">Submit Signature</button>
            </div>
            <div class="loyalty-error" id="signature-error-<%= card.id %>"></div>
          <% } else if (card.redemptionStatus === 'PENDING') { %>
            <div class="loyalty-sub">Show this code to your cashier:</div>
            <div class="loyalty-code"><%= card.redemptionCode %></div>
            <div class="loyalty-sub loyalty-waiting-text">Waiting for the merchant to confirm...</div>
            <button type="button" class="loyalty-btn" style="background:#999; color:#fff;" onclick="cancelRedeem('<%= card.id %>')">Cancel</button>
          <% } else { %>
            <div class="punch-row">
              <% for (var p = 1; p <= 5; p++) { %>
                <div class="punch-hole <%= p <= card.punches ? 'filled' : '' %>"><%= p <= card.punches ? '✓' : '' %></div>
              <% } %>
            </div>
            <div class="loyalty-sub">
              <% if (card.punches >= 5) { %>
                Card full — redeem for <%= offerText %>!
              <% } else { %>
                <%= card.punches %>/5 punches — collect all 5 for <%= offerText %>!
              <% } %>
            </div>
            <% if (card.punches >= 5) { %>
              <button type="button" class="loyalty-btn" style="background:var(--teal); color:#fff;" onclick="useReward('<%= card.id %>')">Use Reward</button>
            <% } %>
          <% } %>
        </div>
      <% }); %>
    <% } %>
  </div>

  <script>
    async function useReward(cardId) {
      const res = await fetch(`/loyalty/${cardId}/use-reward`, { method: 'POST' });
      if (res.ok) location.reload();
    }
    async function cancelRedeem(cardId) {
      const res = await fetch(`/loyalty/${cardId}/cancel-redeem`, { method: 'POST' });
      if (res.ok) location.reload();
    }

    // Poll every card currently showing a redemption code -- once the
    // merchant confirms (or the customer canceled from another tab), reload.
    document.querySelectorAll('.loyalty-waiting-text').forEach((el) => {
      const cardId = el.closest('[data-card-id]').dataset.cardId;
      const interval = setInterval(async () => {
        try {
          const res = await fetch(`/loyalty/${cardId}/status`);
          if (!res.ok) return;
          const data = await res.json();
          if (data.redemptionStatus !== 'PENDING') {
            clearInterval(interval);
            location.reload();
          }
        } catch (e) {
          // transient network hiccup -- just try again on the next tick
        }
      }, 3000);
    });

    // --- Signature pads: one per card currently awaiting a signature --------
    const pads = {}; // cardId -> { canvas, ctx, hasSignature }
    document.querySelectorAll('[id^="signature-pad-"]').forEach((canvas) => {
      const cardId = canvas.id.replace('signature-pad-', '');
      const ctx = canvas.getContext('2d');
      ctx.lineWidth = 2.5;
      ctx.lineCap = 'round';
      ctx.strokeStyle = '#111';
      const state = { canvas, ctx, hasSignature: false };
      pads[cardId] = state;

      let drawing = false;
      const pos = (e) => {
        const rect = canvas.getBoundingClientRect();
        const point = e.touches ? e.touches[0] : e;
        return {
          x: (point.clientX - rect.left) * (canvas.width / rect.width),
          y: (point.clientY - rect.top) * (canvas.height / rect.height),
        };
      };
      const start = (e) => { drawing = true; state.hasSignature = true; const p = pos(e); ctx.beginPath(); ctx.moveTo(p.x, p.y); };
      const move = (e) => { if (!drawing) return; e.preventDefault(); const p = pos(e); ctx.lineTo(p.x, p.y); ctx.stroke(); };
      const end = () => { drawing = false; };

      canvas.addEventListener('mousedown', start);
      canvas.addEventListener('mousemove', move);
      window.addEventListener('mouseup', end);
      canvas.addEventListener('touchstart', start);
      canvas.addEventListener('touchmove', move);
      window.addEventListener('touchend', end);
    });

    function clearSignature(cardId) {
      const state = pads[cardId];
      if (!state) return;
      state.ctx.clearRect(0, 0, state.canvas.width, state.canvas.height);
      state.hasSignature = false;
    }

    async function submitSignature(cardId) {
      const state = pads[cardId];
      const errorEl = document.getElementById(`signature-error-${cardId}`);
      if (!state || !state.hasSignature) {
        errorEl.textContent = 'Please sign above first.';
        return;
      }
      const res = await fetch(`/loyalty/${cardId}/sign`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ signatureDataUrl: state.canvas.toDataURL('image/png') }),
      });
      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        errorEl.textContent = data.error || 'Something went wrong -- please try again.';
        return;
      }
      const cardEl = state.canvas.closest('.loyalty-card');
      cardEl.innerHTML = '<div class="loyalty-merchant">🎉 Reward redeemed!</div><div class="loyalty-sub">Thanks for being a loyal customer.</div>';
      setTimeout(() => location.reload(), 1800);
    }
  </script>
</body>
</html>
