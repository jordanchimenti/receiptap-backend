<!-- views/account-notifications.ejs -->
<!-- The Alerts tab. Everything ReceipTap has told this customer, newest first.
     Right now that's "your stamp card is full" (see
     services/notificationService.js), but the type field is general and this
     page renders whatever lands in it.

     Opening the tab marks everything read -- the badge is there to pull them
     in, not to make them tap each row to clear it. Rows keep an unread tint
     for this one render so they can still see what was new. -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Alerts - ReceipTap</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
  <%- include('partials/wallet-dark-theme') %>
  <style>
    .biz-header { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; }

    .note {
      display: flex; align-items: flex-start; gap: 13px; padding: 15px 16px; border-radius: 16px;
      background: var(--w-card); border: 1px solid var(--w-line); margin-bottom: 10px;
      text-decoration: none; color: inherit;
    }
    .note.unread { border-color: rgba(5,107,254,0.4); background: var(--w-accent-wash); }
    .note-icon {
      width: 36px; height: 36px; border-radius: 10px; flex: none; display: flex; align-items: center;
      justify-content: center; background: var(--w-card-raised); color: var(--w-accent);
    }
    .note.unread .note-icon { background: rgba(5,107,254,0.18); }
    .note-icon.removed { background: rgba(255,69,58,0.12); color: var(--w-danger); }
    .note.unread .note-icon.removed { background: rgba(255,69,58,0.20); }
    /* A claimable reward is the one row here that is good news and needs
       acting on, so it gets its own colour rather than the default blue that
       every ordinary "your receipt saved" note wears. */
    .note-icon.reward { background: rgba(48,209,88,0.14); color: #30d158; }
    .note.unread .note-icon.reward { background: rgba(48,209,88,0.22); }
    .note-icon.warranty { background: var(--w-ok-wash); color: var(--w-ok); }
    .note.unread .note-icon.warranty { background: rgba(48,209,88,0.22); }
    .note-body { flex: 1; min-width: 0; }
    .note-title { font-size: 14.5px; font-weight: 700; color: var(--w-ink); }
    .note-text { font-size: 12.5px; color: var(--w-ink-soft); margin-top: 3px; line-height: 1.5; }
    .note-when { font-size: 11px; color: var(--w-ink-soft); margin-top: 6px; }
    .note-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--w-accent); flex: none; margin-top: 6px; }

    /* receiptap.css's .empty-state is the light theme's -- it sets
       background: var(--paper-raised), which renders white on these dark
       pages. Override it explicitly rather than inheriting it. */
    .empty-state {
      background: var(--w-card);
      border: 1px dashed var(--w-line); border-radius: 18px; padding: 40px 24px; margin-top: 8px;
      text-align: center; color: var(--w-ink-soft); font-size: 13.5px; line-height: 1.6;
    }
    /* Enable-push card. Only rendered when push is actually configured and
       this browser can support it -- see the script at the bottom. */
    .push-card { display: none; padding: 16px; margin-bottom: 14px; }
    .push-card.show { display: block; }
    .push-title { font-size: 14.5px; font-weight: 700; color: var(--w-ink); }
    .push-text { font-size: 12.5px; color: var(--w-ink-soft); margin-top: 5px; line-height: 1.55; }
    .push-btn {
      margin-top: 13px; padding: 11px 20px; border-radius: 999px; border: none; background: var(--w-accent);
      color: #fff; font-size: 13.5px; font-weight: 700; cursor: pointer; font-family: inherit;
    }
    .push-btn:disabled { opacity: 0.55; cursor: default; }
    .push-status { font-size: 12px; color: var(--w-ink-soft); margin-top: 10px; }

    .empty-icon {
      width: 46px; height: 46px; border-radius: 50%; margin: 0 auto 14px;
      background: var(--w-card-raised); display: flex; align-items: center; justify-content: center;
      color: var(--w-accent);
    }
  </style>
</head>
<body>
  <div class="w-shell">
    <div class="biz-header">
      <a href="/account/more" class="w-btn-icon" aria-label="Back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      </a>
      <div>
        <div class="w-eyebrow">Your wallet</div>
        <h1 class="w-title" style="font-size:20px;">Alerts</h1>
      </div>
    </div>

    <div class="w-card push-card" id="push-card">
      <div class="push-title">Get these on your phone</div>
      <div class="push-text" id="push-text">
        Turn on notifications and we'll tell you the moment a stamp card fills up — even when the app is closed.
      </div>
      <button type="button" class="push-btn" id="push-btn" onclick="enablePush()">Turn on notifications</button>
      <div class="push-status" id="push-status"></div>
    </div>

    <% if (notifications.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
        </div>
        Nothing yet. We'll tell you here the moment a stamp card fills up.
      </div>
    <% } else { %>
      <% notifications.forEach(function(note) { %>
        <a class="note <%= note.wasUnread ? 'unread' : '' %>" href="<%= note.linkUrl || '/account/loyalty' %>">
          <%# The icon says what KIND of thing happened at a glance -- a gift
              on every row made a deleted receipt look like a reward. %>
          <%
            var iconTone = note.type === 'RECEIPT_DELETED' ? 'removed'
                         : note.type === 'LOYALTY_REWARD_READY' ? 'reward'
                         : note.type === 'WARRANTY_EXPIRING' ? 'warranty'
                         : '';
          %>
          <div class="note-icon <%= iconTone %>">
            <% if (note.type === 'LOYALTY_REWARD_READY') { %>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 12v9H4v-9"/><path d="M2 7h20v5H2z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7Z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7Z"/></svg>
            <% } else if (note.type === 'RECEIPT_DELETED') { %>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v5M14 11v5"/></svg>
            <% } else if (note.type === 'WARRANTY_EXPIRING') { %>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2 4 5v6c0 5 3.4 8.5 8 11 4.6-2.5 8-6 8-11V5Z"/><path d="M9.5 12l1.8 1.8L15 10"/></svg>
            <% } else { %>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 2h12v20l-3-2-3 2-3-2-3 2Z"/><path d="M9 8h6M9 12h6"/></svg>
            <% } %>
          </div>
          <div class="note-body">
            <div class="note-title"><%= note.title %></div>
            <div class="note-text"><%= note.body %></div>
            <div class="note-when"><%= note.whenText %></div>
          </div>
          <% if (note.wasUnread) { %><div class="note-dot"></div><% } %>
        </a>
      <% }); %>
    <% } %>
  </div>

  <%- include('partials/wallet-tab-bar', { activeTab: 'notifications' }) %>
  <%- include('partials/push-controls') %>
  <script>
    // Push is entirely optional. Every branch below hides the card rather than
    // showing an error -- a browser that can't do this shouldn't be nagged.
    var PUSH_CONFIGURED = ReceipTapPush.configured;
    var ALREADY_SUBSCRIBED = <%= pushSubscriptions > 0 ? 'true' : 'false' %>;

    var pushCard = document.getElementById('push-card');
    var pushBtn = document.getElementById('push-btn');
    var pushStatus = document.getElementById('push-status');
    var pushText = document.getElementById('push-text');

    // iOS only exposes push to a site opened from the Home Screen, so telling
    // an iPhone user in Safari to "turn on notifications" is a dead end --
    // they need the install step first.
    var isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent);
    var isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
    var supported = ReceipTapPush.supported;

    if (PUSH_CONFIGURED && supported) {
      pushCard.classList.add('show');
      if (ALREADY_SUBSCRIBED) {
        pushText.textContent = "Phone notifications are on. We'll tell you the moment a stamp card fills up.";
        pushBtn.style.display = 'none';
      }
      if (Notification.permission === 'denied') {
        pushBtn.disabled = true;
        pushStatus.textContent = 'Notifications are blocked for this site in your browser settings.';
      }
    } else if (PUSH_CONFIGURED && isIOS && !isStandalone) {
      pushCard.classList.add('show');
      pushText.textContent = 'To get these on your iPhone, tap Share and then "Add to Home Screen", then open ReceipTap from there.';
      pushBtn.style.display = 'none';
    }

    async function enablePush() {
      pushBtn.disabled = true;
      pushStatus.textContent = 'Asking your browser…';
      var result = await ReceipTapPush.enable();
      if (!result.ok) {
        pushBtn.disabled = ReceipTapPush.permission() === 'denied';
        pushStatus.textContent = result.reason;
        return;
      }
      pushText.textContent = "Phone notifications are on. We'll tell you the moment a stamp card fills up.";
      pushBtn.style.display = 'none';
      pushStatus.textContent = 'You can turn these off any time from the menu in the top right of your receipts.';
    }
  </script>
</body>
</html>
