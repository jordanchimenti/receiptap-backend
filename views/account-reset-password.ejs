<!-- views/account-reset-password.ejs -->
<!-- Step 2 of the password reset: the page the emailed link opens. Same dark
     auth card as log in (partials/auth-card-styles.ejs).

     Worth knowing: this is also how an account created through Google/Apple/
     Microsoft gets its FIRST password -- those accounts have no passwordHash
     at all, so "reset" is really "set". The copy avoids saying "new password"
     for that reason. -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Set Your Password - ReceipTap</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
  <%- include('partials/wallet-dark-theme') %>
  <%- include('partials/auth-card-styles') %>
  <style>
    .expired-mark {
      width: 52px; height: 52px; border-radius: 50%; margin: 0 auto 18px; display: flex;
      align-items: center; justify-content: center; background: rgba(255,69,58,0.12); color: var(--w-danger);
    }
    .back-link { font-size: 13px; color: var(--w-ink-soft); margin: 22px 0 0; }
    .back-link a { color: var(--w-accent); font-weight: 600; text-decoration: none; }
    .pw-hint { font-size: 11.5px; color: var(--w-ink-soft); margin-top: 7px; line-height: 1.5; }
    .match-note { font-size: 12px; margin-top: 7px; min-height: 15px; }
    .match-note.bad { color: var(--w-danger); }
    .match-note.good { color: var(--w-accent); }
  </style>
</head>
<body>
  <div class="auth-shell">
    <div class="auth-card">
      <div class="logo-chip"><img src="/images/receiptap-logo.png" alt="ReceipTap" /></div>

      <% if (!valid) { %>
        <div class="expired-mark">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v6M12 16.5v.01"/></svg>
        </div>
        <div class="w-eyebrow">Reset password</div>
        <h1 class="auth-title">Link expired</h1>
        <p class="auth-sub">This link is invalid or has already been used. Reset links last 1 hour — grab a fresh one below.</p>
        <a href="/account/forgot-password" class="auth-pill-btn" style="text-decoration:none; text-align:center;">Request a new link</a>
      <% } else { %>
        <div class="w-eyebrow">Reset password</div>
        <h1 class="auth-title">Set your password</h1>
        <p class="auth-sub">Choose a password for your ReceipTap account.</p>

        <% if (error) { %><div class="w-error" style="display:block;"><%= error %></div><% } %>

        <form method="POST" action="/account/reset-password/<%= token %>" id="reset-form">
          <div class="auth-field">
            <div class="auth-field-row"><label for="password">Password</label></div>
            <div class="auth-input-wrap">
              <input type="password" id="password" name="password" placeholder="At least 8 characters" required autofocus minlength="8" />
              <button type="button" class="pw-toggle" id="pw-toggle" aria-label="Show password">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
            <div class="pw-hint">8 characters or more.</div>
          </div>

          <div class="auth-field">
            <div class="auth-field-row"><label for="confirmPassword">Confirm password</label></div>
            <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Type it again" required minlength="8" />
            <div class="match-note" id="match-note"></div>
          </div>

          <button type="submit" class="auth-pill-btn">Save password</button>
        </form>
      <% } %>

      <p class="back-link"><a href="/account/login">Back to log in</a></p>
    </div>
  </div>

  <% if (valid) { %>
    <script>
      // Same show/hide control the login page has -- more useful here, where
      // you're typing an unfamiliar password twice on a phone keyboard.
      var pwInput = document.getElementById('password');
      var confirmInput = document.getElementById('confirmPassword');
      var note = document.getElementById('match-note');

      document.getElementById('pw-toggle').addEventListener('click', function () {
        var showing = pwInput.type === 'text';
        pwInput.type = showing ? 'password' : 'text';
        this.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
      });

      // Tell them the passwords differ while they type, rather than after a
      // round trip to the server.
      function checkMatch() {
        if (!confirmInput.value) { note.textContent = ''; note.className = 'match-note'; return; }
        var matches = pwInput.value === confirmInput.value;
        note.textContent = matches ? 'Passwords match.' : "Passwords don't match yet.";
        note.className = 'match-note ' + (matches ? 'good' : 'bad');
      }
      pwInput.addEventListener('input', checkMatch);
      confirmInput.addEventListener('input', checkMatch);
    </script>
  <% } %>
</body>
</html>
