<!-- views/account-settings.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Settings - ReceipTap</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
  <style>
    .deactivate-modal-overlay {
      display: none;
      position: fixed; inset: 0; background: rgba(15, 23, 42, 0.45);
      align-items: center; justify-content: center; z-index: 100;
    }
    .deactivate-modal-overlay.open { display: flex; }
    .deactivate-modal-box {
      background: #fff; border-radius: 14px; padding: 28px; width: 440px; max-width: 90vw;
      box-shadow: 0 20px 60px rgba(0,0,0,0.25);
    }
    .deactivate-modal-box h2 { font-size: 18px; margin: 0 0 12px; color: var(--danger); }
    .deactivate-modal-box p { font-size: 13.5px; color: var(--ink-soft); margin: 0 0 12px; line-height: 1.55; }
    .deactivate-modal-box ul { margin: 0 0 16px; padding-left: 20px; }
    .deactivate-modal-box li { font-size: 13.5px; color: var(--ink-soft); margin-bottom: 8px; line-height: 1.5; }
    .deactivate-modal-box li strong { color: var(--ink); }
  </style>
</head>
<body>
  <%- include('partials/dashboard-header', { activeNav: 'account' }) %>

  <div class="topbar">
    <div>
      <h1>Settings</h1>
      <p class="sub">Business info, password, POS connection, and account controls.</p>
    </div>
  </div>

  <div class="app-body">
    <!-- Business information -->
    <div class="card" style="margin-bottom:20px;">
      <div class="card-head"><h2>Business information</h2></div>
      <div style="padding:18px 20px;">
        <% if (businessError) { %><div class="error-box" style="margin-bottom:14px;"><%= businessError %></div><% } %>
        <% if (businessSuccess) { %><div class="error-box" style="margin-bottom:14px; color:var(--teal-deep); background:var(--teal-wash);">Business info updated.</div><% } %>
        <form method="POST" action="/dashboard/settings/account/business" style="margin:0;">
          <div class="field">
            <label for="businessName">Business name</label>
            <input type="text" id="businessName" name="businessName" value="<%= merchant.businessName %>" required />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" value="<%= merchant.email %>" required />
          </div>
          <div class="field">
            <label for="businessPhone">Phone (optional)</label>
            <input type="text" id="businessPhone" name="phone" value="<%= receiptTheme ? (receiptTheme.phone || '') : '' %>" placeholder="416-555-1234" />
            <div class="hint">Shown on the receipts your customers receive. Leave blank to not show one.</div>
          </div>
          <button type="submit" class="btn btn-primary" style="width:auto;">Save</button>
        </form>
      </div>
    </div>

    <!-- Change password -->
    <div class="card" style="margin-bottom:20px;">
      <div class="card-head"><h2>Change password</h2></div>
      <div style="padding:18px 20px;">
        <% if (passwordError) { %><div class="error-box" style="margin-bottom:14px;"><%= passwordError %></div><% } %>
        <% if (passwordSuccess) { %><div class="error-box" style="margin-bottom:14px; color:var(--teal-deep); background:var(--teal-wash);">Password changed.</div><% } %>
        <form method="POST" action="/dashboard/settings/account/password" style="margin:0;">
          <div class="field">
            <label for="currentPassword">Current password</label>
            <input type="password" id="currentPassword" name="currentPassword" required />
          </div>
          <div class="field">
            <label for="newPassword">New password</label>
            <input type="password" id="newPassword" name="newPassword" required minlength="8" />
          </div>
          <div class="field">
            <label for="confirmNewPassword">Confirm new password</label>
            <input type="password" id="confirmNewPassword" name="confirmNewPassword" required minlength="8" />
          </div>
          <button type="submit" class="btn btn-primary" style="width:auto;">Change password</button>
        </form>
      </div>
    </div>

    <!-- POS connection -->
    <div class="card" style="margin-bottom:20px;">
      <div class="card-head"><h2>POS connection</h2></div>
      <div style="padding:18px 20px;">
        <% if (posError) { %><div class="error-box" style="margin-bottom:14px;"><%= posError %></div><% } %>
        <%
          const connectedPos = [
            merchant.squareMerchantId && { provider: 'square', label: 'Square' },
            merchant.cloverMerchantId && { provider: 'clover', label: 'Clover' },
            merchant.lightspeedDomainPrefix && { provider: 'lightspeed', label: `Lightspeed (${merchant.lightspeedDomainPrefix})` },
            merchant.shopifyShopDomain && { provider: 'shopify', label: `Shopify (${merchant.shopifyShopDomain})` },
          ].filter(Boolean);
        %>
        <% if (connectedPos.length) { %>
          <% connectedPos.forEach(function(pos) { %>
            <div style="display:flex; align-items:center; justify-content:space-between; padding:10px 0; border-bottom:1px solid var(--border);">
              <p style="font-size:13.5px; margin:0;">Connected via <strong><%= pos.label %></strong>.</p>
              <form method="POST" action="/dashboard/settings/account/disconnect-pos" style="margin:0;" onsubmit="return confirm('Disconnect this POS? Its sales will stop generating receipts until you reconnect.');">
                <input type="hidden" name="provider" value="<%= pos.provider %>" />
                <button type="submit" class="btn btn-secondary" style="width:auto; color:var(--danger);">Disconnect</button>
              </form>
            </div>
          <% }); %>
        <% } else { %>
          <div class="blank">
            <div class="bt">No POS connected</div>
            <div class="bd">Connect a POS from the <a href="/dashboard/pos-setup">POS connection</a> page.</div>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Danger zone -->
    <div class="card" style="margin-bottom:20px; border-color: var(--danger);">
      <div class="card-head"><h2 style="color: var(--danger);">Danger zone</h2></div>
      <div style="padding:18px 20px; display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;">
        <div>
          <div style="font-size:14px; font-weight:600; margin-bottom:2px;">Deactivate account</div>
          <div style="font-size:12.5px; color:var(--ink-soft); max-width:480px;">
            Immediately ends your access and can't be undone by you — if you
            just want to stop paying but keep using ReceipTap until your
            current period ends, <a href="/dashboard/billing">cancel your subscription</a>
            from Billing instead.
          </div>
        </div>
        <button type="button" class="btn btn-secondary" style="width:auto; color:var(--danger); border-color:var(--danger);" id="open-deactivate-modal">Deactivate account</button>
      </div>
    </div>
  </div>

  <div class="deactivate-modal-overlay" id="deactivate-modal" onclick="if (event.target === this) closeDeactivateModal();">
    <div class="deactivate-modal-box">
      <h2>Deactivate your account?</h2>
      <ul>
        <% if (['ACTIVE', 'TRIALING', 'PAST_DUE'].includes(merchant.subscriptionStatus)) { %>
          <li><strong>Your subscription is cancelled right now</strong> — even if you have paid time remaining, not at the end of your billing period.</li>
        <% } %>
        <li><strong>You're logged out immediately and can't log back in</strong> — there's no self-serve way to reactivate. Undoing this requires contacting us directly.</li>
        <li><strong>Your account data is permanently deleted in <%= purgeDays %> days.</strong></li>
      </ul>
      <p>If you just want to stop being billed but keep your receipts working until your paid period ends, use "Cancel Subscription" on the Billing page instead — this is different from that.</p>
      <form method="POST" action="/dashboard/settings/account/deactivate" style="margin:0 0 10px;">
        <button type="submit" class="btn btn-primary" style="width:100%; background: var(--danger);">Yes, deactivate my account</button>
      </form>
      <button type="button" onclick="closeDeactivateModal();" style="width:100%; background:none; border:none; padding:10px; font-size:13px; font-weight:600; color:var(--ink-soft); cursor:pointer; font-family:var(--font-body);">Never mind, take me back</button>
    </div>
  </div>

  <script>
    (function () {
      var openBtn = document.getElementById('open-deactivate-modal');
      if (openBtn) openBtn.addEventListener('click', function () {
        document.getElementById('deactivate-modal').classList.add('open');
      });
    })();
    function closeDeactivateModal() {
      document.getElementById('deactivate-modal').classList.remove('open');
    }
  </script>
</body>
</html>
