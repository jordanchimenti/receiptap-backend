<!-- views/admin-customers.ejs — owner-only view of every collected email,
     across ALL merchants. Dark theme matching the wallet dashboard, see
     partials/admin-dark-theme.ejs. -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Customers - Owner view - ReceipTap</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
  <%- include('partials/admin-dark-theme') %>
</head>
<body>

  <div class="owner-shell">
    <div class="owner-header">
      <span class="owner-eyebrow"><span class="sw"></span>Owner view — every merchant on ReceipTap</span>
      <a href="/account/business">← Back to my own dashboard</a>
    </div>

    <%- include('partials/admin-tabs', { activeTab }) %>

    <h1>Customers</h1>
    <p class="sub">Every email ReceipTap has collected across all merchants, from receipt saves and sign-ins.</p>

    <div class="card">
      <div class="card-head">
        <h2>All customers</h2>
        <span style="display:flex; align-items:center; gap:14px;">
          <span style="font-size:12.5px;color:var(--ink-soft);"><%= customers.length.toLocaleString('en-US') %> total</span>
          <a href="/admin/customers/export" class="btn btn-secondary" style="width:auto; padding:6px 12px; font-size:12.5px;">Export CSV</a>
        </span>
      </div>
      <% if (customers.length === 0) { %>
        <div class="blank">
          <div class="bt">No customers yet</div>
          <div class="bd">Once a customer saves a receipt or signs in at any merchant, they'll show up here.</div>
        </div>
      <% } else { %>
        <table class="dtable">
          <thead>
            <tr><th>Email</th><th>Name</th><th>Signed up via</th><th>Merchants</th><th>Receipts</th><th>First seen</th><th>Last activity</th></tr>
          </thead>
          <tbody>
            <% customers.forEach(function (c) { %>
              <tr>
                <td><%= c.email %></td>
                <td><%= c.name || '—' %></td>
                <td><span class="pill <%= c.signupMethod === 'Google' ? 'pill-green' : 'pill-grey' %>"><%= c.signupMethod %></span></td>
                <td class="amt"><%= c.merchantCount %></td>
                <td class="amt"><%= c.receiptCount %></td>
                <td class="when"><%= new Date(c.firstSeen).toLocaleDateString('en-US', { dateStyle: 'medium' }) %></td>
                <td class="when"><%= new Date(c.lastActivity).toLocaleDateString('en-US', { dateStyle: 'medium' }) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</body>
</html>
