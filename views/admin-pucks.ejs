<!-- views/admin-pucks.ejs — owner-only view of pucks generated one at a time
     from this admin panel (not the bulk hardware-order pucks from
     scripts/generate-batch.js). Dark theme matching the wallet dashboard,
     see partials/admin-dark-theme.ejs. -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pucks - Owner view - ReceipTap</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
  <%- include('partials/admin-dark-theme') %>
</head>
<body>

  <div class="owner-shell">
    <div class="owner-header">
      <span class="owner-eyebrow"><span class="sw"></span>Owner view — every merchant on ReceipTap</span>
      <a href="/account/business">← Back to my own dashboard</a>
    </div>

    <%- include('partials/admin-tabs', { activeTab }) %>

    <h1>Pucks</h1>
    <p class="sub">Mint a single test puck to hand-write onto a physical NFC tag. Saved for good — refreshing or coming back later won't lose it.</p>

    <% if (error) { %><div class="error-box" style="margin-bottom:18px;"><%= error %></div><% } %>

    <div class="card" style="margin-bottom:20px;">
      <div class="card-head">
        <h2>Pending puck returns</h2>
        <span style="font-size:12.5px;color:var(--ink-soft);"><%= pendingReturns.length.toLocaleString('en-US') %> awaiting return</span>
      </div>
      <% if (pendingReturns.length === 0) { %>
        <div class="blank">
          <div class="bt">No pucks currently awaiting return</div>
          <div class="bd">A row shows up here once a merchant with pucks cancels their subscription.</div>
        </div>
      <% } else { %>
        <table class="dtable">
          <thead>
            <tr><th>Merchant</th><th>Puck ID</th><th>Return deadline</th><th>Status</th><th></th></tr>
          </thead>
          <tbody>
            <% pendingReturns.forEach(function (p) { %>
              <tr>
                <td><%= p.merchantName %><br /><span style="font-size:11.5px; color:var(--ink-soft);"><%= p.merchantEmail %></span></td>
                <td style="font-family:var(--font-mono);"><%= p.id %></td>
                <td class="when"><%= new Date(p.deadline).toLocaleDateString('en-US', { dateStyle: 'medium' }) %></td>
                <td>
                  <% if (p.overdue) { %>
                    <span class="pill pill-amber">Overdue — $60 fee applies</span>
                  <% } else { %>
                    <span class="pill pill-grey">Awaiting return</span>
                  <% } %>
                </td>
                <td style="text-align:right;">
                  <form method="POST" action="/admin/pucks/<%= p.id %>/mark-returned" style="margin:0;">
                    <button type="submit" class="btn btn-secondary" style="width:auto; padding:5px 10px; font-size:12px;">Mark as returned</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>

    <div class="card" style="margin-bottom:20px;">
      <div class="card-head"><h2>Generate a puck</h2></div>
      <div style="padding: 18px 20px;">
        <p style="font-size:13px; color:var(--ink-soft); margin:0 0 14px;">Creates one new UNCLAIMED puck with a unique id and claim code.</p>
        <form method="POST" action="/admin/pucks/generate" style="margin:0;">
          <button type="submit" class="btn btn-primary" style="width:auto;">Generate puck</button>
        </form>
      </div>
    </div>

    <div class="card">
      <div class="card-head">
        <h2>Generated pucks</h2>
        <span style="display:flex; align-items:center; gap:14px;">
          <span style="font-size:12.5px;color:var(--ink-soft);"><%= total.toLocaleString('en-US') %> total</span>
          <a href="/admin/pucks/export" class="btn btn-secondary" style="width:auto; padding:6px 12px; font-size:12.5px;">Export CSV</a>
        </span>
      </div>
      <% if (pucks.length === 0) { %>
        <div class="blank">
          <div class="bt">No pucks generated yet</div>
          <div class="bd">Click "Generate puck" above to mint your first test puck.</div>
        </div>
      <% } else { %>
        <div id="nfc-unsupported-notice" style="display:none; margin:0 20px 14px; padding:10px 14px; border-radius:8px; background:#FBEAE8; color:#B4433A; font-size:12.5px;">
          Web NFC isn't available in this browser. Open this page in <strong>Chrome on an Android phone</strong> to write tags directly — it can't write from a desktop browser or Safari/iOS.
        </div>
        <div style="margin:0 20px 14px; padding:10px 14px; border-radius:8px; background:var(--app-bg); color:var(--ink-soft); font-size:12.5px;">
          <strong>Two steps per tag:</strong> "Write NFC tag" below writes the record, but Web NFC can't
          permanently lock a tag from a browser. Lock it right after with the free
          <strong>NFC Tools</strong> app ("Other" tab → "Make read-only") — otherwise it stays
          rewritable once it's out of your hands.
        </div>
        <table class="dtable">
          <thead>
            <tr><th>URL</th><th>ID</th><th>Claim code</th><th>Status</th><th>Created</th><th colspan="2"></th></tr>
          </thead>
          <tbody>
            <% pucks.forEach(function (p, i) { %>
              <tr class="<%= i >= 5 ? 'puck-row-extra' : '' %>" style="<%= i >= 5 ? 'display:none;' : '' %>">
                <td style="font-family:var(--font-mono); font-size:12.5px; word-break:break-all;"><%= p.url %></td>
                <td style="font-family:var(--font-mono);"><%= p.id %></td>
                <td style="font-family:var(--font-mono);">
                  <%= p.claimCode %>
                  <button type="button" class="copy-claimcode-btn" data-code="<%= p.claimCode %>" title="Copy claim code" style="margin-left:6px; background:none; border:none; cursor:pointer; color:var(--ink-soft); padding:2px; vertical-align:middle;">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                  </button>
                </td>
                <td><span class="pill <%= p.status === 'CLAIMED' ? 'pill-green' : 'pill-grey' %>"><%= p.status === 'CLAIMED' ? 'Claimed' : 'Unclaimed' %></span></td>
                <td class="when"><%= new Date(p.createdAt).toLocaleDateString('en-US', { dateStyle: 'medium' }) %></td>
                <td style="text-align:right;">
                  <button type="button" class="btn btn-secondary copy-url-btn" data-url="<%= p.url %>" style="width:auto; padding:5px 10px; font-size:12px;">Copy</button>
                </td>
                <td style="text-align:right; min-width:150px;">
                  <button type="button" class="btn btn-primary write-nfc-btn" data-url="<%= p.url %>" style="width:auto; padding:5px 10px; font-size:12px;">Write NFC tag</button>
                  <div class="nfc-status" style="font-size:11px; color:var(--ink-soft); margin-top:4px;"></div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>

        <% if (pucks.length > 5) { %>
          <div style="padding:12px 20px; border-top:1px solid var(--card-line); text-align:center;">
            <button type="button" id="see-more-pucks-btn" style="background:none; border:none; color:var(--teal); font-weight:600; font-size:12.5px; cursor:pointer; font-family:var(--font-body);">See more (<%= pucks.length - 5 %> more on this page)</button>
          </div>
        <% } %>

        <% if (totalPages > 1) { %>
          <div style="padding:14px 20px; display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
            <a href="?page=<%= page - 1 %>" class="page-link <%= page <= 1 ? 'disabled' : '' %>">‹ Prev</a>
            <% for (let i = 1; i <= totalPages; i++) { %>
              <a href="?page=<%= i %>" class="page-link <%= i === page ? 'active' : '' %>"><%= i %></a>
            <% } %>
            <a href="?page=<%= page + 1 %>" class="page-link <%= page >= totalPages ? 'disabled' : '' %>">Next ›</a>
          </div>
        <% } %>
      <% } %>
    </div>
  </div>

  <script>
    document.querySelectorAll('.copy-url-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        navigator.clipboard.writeText(btn.getAttribute('data-url'));
        var original = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(function () { btn.textContent = original; }, 1500);
      });
    });

    var checkIcon = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
    document.querySelectorAll('.copy-claimcode-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        navigator.clipboard.writeText(btn.getAttribute('data-code'));
        var original = btn.innerHTML;
        btn.innerHTML = checkIcon;
        btn.style.color = 'var(--teal)';
        setTimeout(function () { btn.innerHTML = original; btn.style.color = ''; }, 1500);
      });
    });

    var seeMoreBtn = document.getElementById('see-more-pucks-btn');
    if (seeMoreBtn) {
      seeMoreBtn.addEventListener('click', function () {
        document.querySelectorAll('.puck-row-extra').forEach(function (row) { row.style.display = ''; });
        seeMoreBtn.style.display = 'none';
      });
    }

    // Writes a Smart Poster NDEF record (this puck's own unique URL + a
    // fixed "ReceipTap" title) directly to a physical tag via the Web NFC
    // API -- Chrome on Android only; there is no equivalent API on iOS or
    // desktop browsers, which is why the notice below exists at all. Each
    // button writes THIS row's own URL, never a shared/generic one, so a
    // tag can never end up carrying the wrong puck's link.
    //
    // Known gap: Web NFC has no API to lock/make a tag read-only after
    // writing (unlike the vendor-encoded pucks, which ship pre-locked). A
    // tag written here stays rewritable unless locked by some other tool
    // afterward -- see the writeup for why that's a real tradeoff, not an
    // oversight.
    var writeButtons = document.querySelectorAll('.write-nfc-btn');
    if (!('NDEFReader' in window)) {
      var notice = document.getElementById('nfc-unsupported-notice');
      if (notice) notice.style.display = 'block';
      writeButtons.forEach(function (btn) { btn.disabled = true; });
    } else {
      writeButtons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var url = btn.getAttribute('data-url');
          var status = btn.parentElement.querySelector('.nfc-status');
          status.textContent = 'Hold the tag against your phone…';
          btn.disabled = true;

          var ndef = new NDEFReader();
          ndef.write({
            records: [{
              recordType: 'smart-poster',
              data: {
                records: [
                  { recordType: 'url', data: url },
                  { recordType: 'text', data: 'ReceipTap', lang: 'en' },
                ],
              },
            }],
          }).then(function () {
            status.textContent = 'Tag written ✓';
          }).catch(function (err) {
            status.textContent = 'Failed: ' + err.message;
          }).finally(function () {
            btn.disabled = false;
          });
        });
      });
    }
  </script>
</body>
</html>
