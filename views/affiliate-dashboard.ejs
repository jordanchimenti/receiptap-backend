<!-- views/affiliate-dashboard.ejs -->
<!-- Shared by both affiliate types: `portalType` is 'merchant' (embedded in
     the merchant dashboard rail, reusing their merchant login) or 'regular'
     (a standalone affiliate account with its own simple header). -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Partner Program - ReceipTap</title>
  <% if (portalType === 'regular') { %><link rel="stylesheet" href="/css/receiptap.css" /><% } %>
  <style>
    h1 { font-size: 22px; margin-bottom: 4px; }
    .standalone-shell { max-width: 640px; margin: 0 auto; padding: 24px 16px 48px; }
    .standalone-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
    .standalone-logo { height: 18px; }
    .logout-btn { background: none; border: 1px solid #ddd; border-radius: 6px; padding: 6px 12px; font-size: 12.5px; color: #666; cursor: pointer; }

    .referral-card {
      background: #f9fafb; border-radius: 10px; padding: 20px; margin-top: 18px;
    }
    .referral-link-row { display: flex; gap: 8px; margin-top: 8px; }
    .referral-link-row input {
      flex: 1; padding: 10px 12px; border: 1px solid #ddd; border-radius: 6px;
      font-size: 13px; font-family: ui-monospace, monospace; background: #fff;
    }
    .copy-btn { padding: 10px 16px; border: none; border-radius: 6px; background: #056BFE; color: #fff; font-weight: 600; font-size: 13px; cursor: pointer; }

    .rate-banner {
      display: flex; align-items: center; justify-content: space-between;
      padding: 14px 18px; border-radius: 10px; margin-top: 16px; font-size: 14px;
    }
    .rate-banner.eligible { background: #DCE7F4; color: #0350BE; }
    .rate-banner.paused { background: #fef2f2; color: #dc2626; }
    .rate-value { font-size: 20px; font-weight: 700; }
    .flat-rate-tag {
      display: inline-block; margin-top: 8px; font-size: 10.5px; font-weight: 700; letter-spacing: 0.03em;
      color: #0350BE; background: rgba(5,107,254,0.12); border-radius: 999px; padding: 3px 9px;
    }
    .rate-banner.paused .flat-rate-tag { color: #dc2626; background: rgba(220,38,38,0.1); }

    .mrc-card { background: #f9fafb; border-radius: 10px; padding: 18px 20px; margin-top: 16px; }
    .mrc-label { font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: #9ca3af; margin-bottom: 6px; }
    .mrc-value { font-size: 26px; font-weight: 700; }
    .mrc-unit { font-size: 13px; font-weight: 600; color: #888; margin-left: 2px; }
    .mrc-sub { font-size: 12.5px; color: #888; margin-top: 4px; }

    .stats-row { display: flex; gap: 16px; margin-top: 20px; }
    .stat-box { flex: 1; background: #f9fafb; border-radius: 10px; padding: 16px; text-align: center; }
    .stat-num { font-size: 22px; font-weight: 700; }
    .stat-label { font-size: 12px; color: #888; margin-top: 2px; }

    h2 { font-size: 15px; margin-top: 28px; margin-bottom: 8px; color: #555; }
    table { width: 100%; border-collapse: collapse; }
    th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid #eee; font-size: 14px; }
    th { color: #888; font-weight: 500; font-size: 12px; text-transform: uppercase; }
    .empty { text-align: center; color: #888; margin-top: 20px; font-size: 13.5px; }
    .status-pill { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 11.5px; font-weight: 600; }
    .status-pill.active, .status-pill.paid { background: #DCE7F4; color: #0350BE; }
    .status-pill.pending { background: #DCE7F4; color: #0350BE; }
    .status-pill.other { background: #f4f4f5; color: #666; }

    .code-message { margin-top: 10px; font-size: 12.5px; padding: 8px 10px; border-radius: 6px; }
    .code-message.error { background: #fef2f2; color: #dc2626; }
    .code-message.success { background: #DCE7F4; color: #0350BE; }
    .custom-code-form { margin-top: 14px; }
    .custom-code-form label { font-size: 12px; color: #888; display: block; margin-bottom: 6px; }
    .custom-code-row { display: flex; align-items: center; gap: 6px; }
    .custom-code-prefix { font-size: 12.5px; color: #999; font-family: ui-monospace, monospace; white-space: nowrap; }
    .custom-code-row input {
      flex: 1; min-width: 0; padding: 9px 10px; border: 1px solid #ddd; border-radius: 6px;
      font-size: 13px; font-family: ui-monospace, monospace; text-transform: uppercase;
    }
  </style>
</head>
<body>
  <% if (portalType === 'merchant') { %>
    <%- include('partials/dashboard-header', { activeNav: 'referrals', isDemoAccount: isDemoAccount }) %>
    <div class="topbar">
      <div>
        <h1>Partner Program</h1>
        <p class="sub">Refer other businesses to ReceipTap and earn a recurring commission.</p>
      </div>
    </div>
    <div class="app-body">
  <% } else { %>
    <div class="standalone-shell">
      <div class="standalone-header">
        <img class="standalone-logo" src="/images/receiptap-logo.png" alt="ReceipTap" />
        <form method="POST" action="/affiliate/logout">
          <button type="submit" class="logout-btn">Log out</button>
        </form>
      </div>
      <div class="eyebrow"><%= programName %></div>
      <h1>Welcome, <%= affiliateName %></h1>
  <% } %>

  <%# Earnings first, matching views/business-referrals.ejs. What a
      partner opens this page to see is what they are making -- the
      link, the rate and payout setup are set once and rarely revisited. %>
  <div class="mrc-card">
    <div class="mrc-label">Monthly recurring commission</div>
    <% if (monthlyRecurringCommission !== null) { %>
      <div class="mrc-value">$<%= monthlyRecurringCommission %><span class="mrc-unit">/mo</span></div>
      <div class="mrc-sub"><%= activeReferralCount %> active referral<%= activeReferralCount === 1 ? '' : 's' %> at <%= rate %>% each</div>
    <% } else { %>
      <div class="mrc-value">—</div>
      <div class="mrc-sub">Not available right now.</div>
    <% } %>
  </div>

  <div class="referral-card">
    <strong>Your referral link</strong>
    <div class="referral-link-row">
      <input type="text" id="referral-url" value="<%= referralUrl %>" readonly />
      <button type="button" class="copy-btn" onclick="copyReferralLink()">Copy</button>
    </div>

    <% if (typeof codeError !== 'undefined' && codeError) { %>
      <div class="code-message error"><%= codeError %></div>
    <% } %>
    <% if (typeof codeSuccess !== 'undefined' && codeSuccess) { %>
      <div class="code-message success">Your link is updated.</div>
    <% } %>

    <form method="POST" action="/affiliate/referral-code" class="custom-code-form">
      <% if (portalType === 'merchant') { %><input type="hidden" name="redirectTo" value="<%= redirectTo %>" /><% } %>
      <label for="referralCode">Customize the code at the end of your link</label>
      <div class="custom-code-row">
        <span class="custom-code-prefix">/signup?ref=</span>
        <input
          type="text" id="referralCode" name="referralCode"
          value="<%= referralCode %>" maxlength="20"
          pattern="[A-Za-z0-9]{3,20}" title="Letters and numbers only, 3-20 characters"
        />
        <button type="submit" class="copy-btn">Save</button>
      </div>
    </form>
  </div>

  <% if (portalType === 'merchant') { %>
    <div class="rate-banner eligible">
      <div>
        <div class="rate-value"><%= rate %>% commission</div>
        <div>
          You're earning on every referral. The Partner Program is free — you keep earning on the
          businesses you refer whether or not your own ReceipTap subscription is active.
        </div>
        <div class="flat-rate-tag">One flat rate for every ReceipTap partner — no tiers</div>
      </div>
    </div>
  <% } else { %>
    <div class="rate-banner eligible">
      <div>
        <div class="rate-value"><%= rate %>% commission</div>
        <div>On every payment your referred merchants make, for as long as they stay subscribed.</div>
        <div class="flat-rate-tag">Same rate every ReceipTap merchant-affiliate earns too</div>
      </div>
    </div>
  <% } %>

  <% if (typeof connectError !== 'undefined' && connectError) { %>
    <div class="rate-banner paused" style="margin-top:12px;">
      <div>Couldn't start Stripe onboarding — please try again in a moment.</div>
    </div>
  <% } %>

  <div class="referral-card" style="margin-top:16px;">
    <% var connectStripeUrl = '/affiliate/connect-stripe/start' + (portalType === 'merchant' ? '?next=' + encodeURIComponent(redirectTo) : ''); %>
    <% if (stripeConnectOnboarded) { %>
      <strong>✅ Payouts connected</strong>
      <div style="font-size:13px; color:#666; margin-top:4px;">
        Commissions will be sent directly to your bank account via Stripe.
        <a href="<%= connectStripeUrl %>" style="color:#056BFE; font-weight:600;">Update details</a>
      </div>
    <% } else { %>
      <strong>Connect a payout account</strong>
      <div style="font-size:13px; color:#666; margin:4px 0 10px;">
        You'll need to connect a bank account with Stripe before any commission can be paid out. Stripe collects your details directly — this app never sees them.
      </div>
      <a href="<%= connectStripeUrl %>" class="copy-btn" style="display:inline-block; text-decoration:none;">Connect with Stripe</a>
    <% } %>
  </div>

  <div class="referral-card" style="margin-top:16px;">
    <strong>Payout schedule</strong>
    <div style="font-size:13px; color:#666; margin:4px 0 10px;">
      Commissions accumulate as they come in and get paid out together on this schedule, rather than one at a time.
    </div>
    <form method="POST" action="/affiliate/payout-frequency">
      <% if (portalType === 'merchant') { %><input type="hidden" name="redirectTo" value="<%= redirectTo %>" /><% } %>
      <select name="payoutFrequency" onchange="this.form.submit()" style="padding:9px 12px; border:1px solid #ddd; border-radius:6px; font-size:13.5px;">
        <option value="WEEKLY" <%= payoutFrequency === 'WEEKLY' ? 'selected' : '' %>>Weekly</option>
        <option value="MONTHLY" <%= payoutFrequency === 'MONTHLY' ? 'selected' : '' %>>Monthly</option>
      </select>
    </form>
  </div>

  <div class="stats-row">
    <div class="stat-box">
      <div class="stat-num"><%= referredMerchants.length %></div>
      <div class="stat-label">Referred merchants</div>
    </div>
    <div class="stat-box">
      <div class="stat-num">$<%= pendingTotal %></div>
      <div class="stat-label">Pending</div>
    </div>
    <div class="stat-box">
      <div class="stat-num">$<%= paidTotal %></div>
      <div class="stat-label">Paid out</div>
    </div>
    <div class="stat-box">
      <div class="stat-num"><%= churnRate !== null ? churnRate + '%' : '—' %></div>
      <div class="stat-label">Churn rate</div>
    </div>
  </div>

  <h2>Referred Merchants</h2>
  <% if (referredMerchants.length === 0) { %>
    <div class="empty">No referrals yet — share your link to get started.</div>
  <% } else { %>
    <table>
      <thead><tr><th>Business</th><th>Status</th><th>Joined</th></tr></thead>
      <tbody>
        <% referredMerchants.forEach(function(m) { %>
          <tr>
            <td><%= m.businessName %></td>
            <td><span class="status-pill <%= m.subscriptionStatus === 'ACTIVE' ? 'active' : 'other' %>"><%= m.subscriptionStatus %></span></td>
            <td><%= m.joinedAt %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>

  <h2>Commissions</h2>
  <% if (commissions.length === 0) { %>
    <div class="empty">No commissions yet — these appear automatically once a referred merchant makes a payment.</div>
  <% } else { %>
    <table>
      <thead><tr><th>Date</th><th>Merchant</th><th>Rate</th><th class="total-col">Amount</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% commissions.forEach(function(c) { %>
          <tr>
            <td><%= c.date %></td>
            <td><%= c.merchantName %></td>
            <td><%= c.rate %>%</td>
            <td>$<%= c.amount %></td>
            <td><span class="status-pill <%= c.status === 'PAID' ? 'paid' : (c.status === 'PENDING' ? 'pending' : 'other') %>"><%= c.status %></span></td>
            <td><% if (c.status === 'PAID') { %><a href="/affiliate/commissions/<%= c.id %>/invoice" style="color:#056BFE; font-weight:600; font-size:12.5px; text-decoration:none;">Invoice</a><% } %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>

  <% if (portalType === 'merchant') { %>
    </div>
  <% } else { %>
    </div>
  <% } %>

  <script>
    function copyReferralLink() {
      const input = document.getElementById('referral-url');
      input.select();
      navigator.clipboard.writeText(input.value).catch(() => document.execCommand('copy'));
    }
  </script>
</body>
</html>
