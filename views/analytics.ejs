<!-- views/analytics.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Analytics - ReceipTap</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
</head>
<body>
  <%- include('partials/dashboard-header', { activeNav: 'analytics' }) %>

  <div class="topbar">
    <div>
      <h1>Analytics</h1>
      <p class="sub">Track performance and insights across your business.</p>
    </div>
    <div class="topbar-right">
      <form method="get" class="field" style="margin:0;">
        <select name="days" onchange="this.form.submit()">
          <option value="7" <%= days === 7 ? 'selected' : '' %>>Last 7 days</option>
          <option value="30" <%= days === 30 ? 'selected' : '' %>>Last 30 days</option>
          <option value="90" <%= days === 90 ? 'selected' : '' %>>Last 90 days</option>
        </select>
      </form>
      <a class="btn btn-secondary" href="/dashboard/analytics/export?days=<%= days %>" style="width:auto;">Export CSV</a>
      <%- include('partials/avatar-menu', { merchant }) %>
    </div>
  </div>

  <div class="app-body">

    <!-- Stats ------------------------------------------------------------ -->
    <div class="stat-grid cols-5">
      <div class="card stat">
        <div class="tile tile-blue">
          <svg viewBox="0 0 24 24" stroke="currentColor"><path d="M6 2h12v20l-3-2-3 2-3-2-3 2Z"/><path d="M9 8h6M9 12h6"/></svg>
        </div>
        <div class="label">Total Receipts</div>
        <div class="value"><%= stats.totalReceipts.toLocaleString('en-US') %></div>
        <div class="foot <%= (stats.totalReceiptsDelta !== null && stats.totalReceiptsDelta >= 0) ? 'up' : '' %>">
          <% if (stats.totalReceiptsDelta === null) { %>No prior period to compare
          <% } else { %><%= stats.totalReceiptsDelta >= 0 ? '↑' : '↓' %> <%= Math.abs(stats.totalReceiptsDelta) %>% vs previous period<% } %>
        </div>
      </div>

      <div class="card stat">
        <div class="tile tile-indigo">
          <svg viewBox="0 0 24 24" stroke="currentColor"><circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5"/><path d="M16 5.5a3.2 3.2 0 0 1 0 6M18 20c0-2.4-.9-4.2-2.3-5.3"/></svg>
        </div>
        <div class="label">Total Customers</div>
        <div class="value"><%= stats.totalCustomers.toLocaleString('en-US') %></div>
        <div class="foot <%= (stats.totalCustomersDelta !== null && stats.totalCustomersDelta >= 0) ? 'up' : '' %>">
          <% if (stats.totalCustomersDelta === null) { %>No prior period to compare
          <% } else { %><%= stats.totalCustomersDelta >= 0 ? '↑' : '↓' %> <%= Math.abs(stats.totalCustomersDelta) %>% vs previous period<% } %>
        </div>
      </div>

      <div class="card stat">
        <div class="tile tile-green">
          <svg viewBox="0 0 24 24" stroke="currentColor"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>
        </div>
        <div class="label">Receipts Claimed</div>
        <div class="value"><%= stats.receiptsClaimed.toLocaleString('en-US') %></div>
        <div class="foot <%= (stats.receiptsClaimedDelta !== null && stats.receiptsClaimedDelta >= 0) ? 'up' : '' %>">
          <% if (stats.receiptsClaimedDelta === null) { %>No prior period to compare
          <% } else { %><%= stats.receiptsClaimedDelta >= 0 ? '↑' : '↓' %> <%= Math.abs(stats.receiptsClaimedDelta) %>% vs previous period<% } %>
        </div>
      </div>

      <div class="card stat">
        <div class="tile tile-amber">
          <svg viewBox="0 0 24 24" stroke="currentColor"><path d="M12 2v20"/><path d="M17 6.5C17 4.6 14.8 3.5 12 3.5S7 4.6 7 6.5s2.2 2.8 5 3.3 5 1.4 5 3.3-2.2 3-5 3-5-1.1-5-3"/></svg>
        </div>
        <div class="label">Avg. Spend</div>
        <div class="value">$<%= Number(stats.avgSpend).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></div>
        <div class="foot <%= (stats.avgSpendDelta !== null && stats.avgSpendDelta >= 0) ? 'up' : '' %>">
          <% if (stats.avgSpendDelta === null) { %>No prior period to compare
          <% } else { %><%= stats.avgSpendDelta >= 0 ? '↑' : '↓' %> <%= Math.abs(stats.avgSpendDelta) %>% vs previous period<% } %>
        </div>
      </div>

      <div class="card stat">
        <div class="tile tile-blue">
          <svg viewBox="0 0 24 24" stroke="currentColor"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
        </div>
        <div class="label">Claim Rate</div>
        <div class="value"><%= stats.claimRate %>%</div>
        <div class="foot <%= (stats.claimRateDelta !== null && stats.claimRateDelta >= 0) ? 'up' : '' %>">
          <% if (stats.claimRateDelta === null) { %>No prior period to compare
          <% } else { %><%= stats.claimRateDelta >= 0 ? '↑' : '↓' %> <%= Math.abs(stats.claimRateDelta) %> pts vs previous period<% } %>
        </div>
      </div>
    </div>

    <!-- Receipts over time + POS source ------------------------------------ -->
    <div class="col-2">
      <div class="card">
        <div class="card-head">
          <h2>Receipts Over Time</h2>
        </div>
        <% if (stats.totalReceipts === 0 && stats.receiptsClaimed === 0 && dayLabels.length && curByDay.every(function(n){ return n === 0; })) { %>
          <div class="blank">
            <div class="bt">No receipts in this period</div>
            <div class="bd">Once sales come in, receipt volume for this period will chart here.</div>
          </div>
        <% } else { %>
          <div class="chart-pad">
            <canvas id="receipts-chart" height="90"></canvas>
          </div>
        <% } %>
      </div>

      <div class="card">
        <div class="card-head">
          <h2>Receipts by POS Source</h2>
        </div>
        <% if (posBreakdown.length === 0) { %>
          <div class="blank">
            <div class="bt">No receipts in this period</div>
            <div class="bd">Once sales come in, their POS source will break down here.</div>
          </div>
        <% } else { %>
          <div class="donut-wrap">
            <canvas id="pos-chart"></canvas>
            <div class="legend">
              <% posBreakdown.forEach(function (p) { %>
                <div class="legend-row">
                  <span class="lk"><span class="sw" style="background:<%= p.color %>;"></span><%= p.label %></span>
                  <span class="lv"><%= p.count.toLocaleString('en-US') %></span>
                </div>
              <% }); %>
            </div>
          </div>
          <% if (posBreakdown.length === 1) { %>
            <div class="status-note">All receipts currently route through <%= posBreakdown[0].label %>.</div>
          <% } %>
        <% } %>
      </div>
    </div>

    <!-- Customer growth + recent activity ----------------------------------- -->
    <div class="col-2">
      <div class="card">
        <div class="card-head">
          <h2>Customer Growth</h2>
        </div>
        <% if (weekBuckets.every(function(n){ return n === 0; })) { %>
          <div class="blank">
            <div class="bt">No new customers in this period</div>
            <div class="bd">New customers who claim a receipt to their wallet will show up here, by week.</div>
          </div>
        <% } else { %>
          <div class="chart-pad">
            <canvas id="growth-chart" height="90"></canvas>
          </div>
        <% } %>
      </div>

      <div class="card">
        <div class="card-head">
          <h2>Recent Activity</h2>
          <span class="live-badge"><span class="live-dot"></span>Live</span>
        </div>
        <div id="activity-list">
          <% if (activity.length === 0) { %>
            <div class="blank">
              <div class="bt">No activity yet</div>
              <div class="bd">Receipts and new customers will appear here as they happen.</div>
            </div>
          <% } else { %>
            <% activity.forEach(function (a) { %>
              <div class="card-row">
                <span><%= a.text %></span>
                <span class="when"><%= a.when %></span>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>
    </div>

  </div>

  <script>
    const dayLabels = <%- JSON.stringify(dayLabels) %>;
    const curByDay = <%- JSON.stringify(curByDay) %>;
    const prevByDay = <%- JSON.stringify(prevByDay) %>;
    const posBreakdown = <%- JSON.stringify(posBreakdown) %>;
    const weekLabels = <%- JSON.stringify(weekLabels) %>;
    const weekBuckets = <%- JSON.stringify(weekBuckets) %>;

    const shortLabels = dayLabels.map(d => {
      const dt = new Date(d + 'T00:00:00');
      return dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    });

    if (document.getElementById('receipts-chart')) {
      new Chart(document.getElementById('receipts-chart'), {
        type: 'line',
        data: {
          labels: shortLabels,
          datasets: [
            {
              label: 'This Period',
              data: curByDay,
              borderColor: '#056BFE',
              backgroundColor: 'rgba(5,107,254,0.08)',
              fill: true,
              tension: 0.3,
              pointRadius: 2,
            },
            {
              label: 'Previous Period',
              data: prevByDay,
              borderColor: '#B6BCCE',
              borderDash: [5, 4],
              backgroundColor: 'transparent',
              fill: false,
              tension: 0.3,
              pointRadius: 0,
            },
          ],
        },
        options: {
          responsive: true,
          plugins: { legend: { display: true, position: 'top' } },
          scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } },
        },
      });
    }

    if (document.getElementById('pos-chart')) {
      new Chart(document.getElementById('pos-chart'), {
        type: 'doughnut',
        data: {
          labels: posBreakdown.map(p => p.label),
          datasets: [{ data: posBreakdown.map(p => p.count), backgroundColor: posBreakdown.map(p => p.color), borderWidth: 0 }],
        },
        options: {
          responsive: true,
          maintainAspectRatio: true,
          plugins: { legend: { display: false }, tooltip: { enabled: true } },
          cutout: '68%',
        },
      });
    }

    if (document.getElementById('growth-chart')) {
      new Chart(document.getElementById('growth-chart'), {
        type: 'bar',
        data: {
          labels: weekLabels,
          datasets: [{ label: 'New customers', data: weekBuckets, backgroundColor: '#056BFE' }],
        },
        options: {
          responsive: true,
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } },
        },
      });
    }

    // Recent Activity genuinely polls the server every ~20s -- the "Live"
    // badge reflects real auto-refresh, not a decorative animation.
    function renderActivity(events) {
      const list = document.getElementById('activity-list');
      if (!events.length) {
        list.innerHTML = '<div class="blank"><div class="bt">No activity yet</div><div class="bd">Receipts and new customers will appear here as they happen.</div></div>';
        return;
      }
      list.innerHTML = events.map(e =>
        `<div class="card-row"><span>${escapeHtml(e.text)}</span><span class="when">${escapeHtml(e.when)}</span></div>`
      ).join('');
    }

    function escapeHtml(s) {
      const div = document.createElement('div');
      div.textContent = s;
      return div.innerHTML;
    }

    async function refreshActivity() {
      try {
        const res = await fetch('/dashboard/analytics/activity');
        if (!res.ok || !(res.headers.get('content-type') || '').includes('application/json')) return;
        const { events } = await res.json();
        renderActivity(events);
      } catch (e) {
        console.warn('activity refresh failed', e);
      }
    }

    setInterval(refreshActivity, 20000);
  </script>
</body>
</html>
