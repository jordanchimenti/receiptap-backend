<!-- views/business-account.ejs -->
<!-- The wallet's generic Settings page -- distinct from Business Settings
     (views/business-settings.ejs), which is the customer-facing/compliance
     stuff (profile shown on receipts, mailing address). This is the
     merchant's own account: photo, name, login email, phone, and password.
     Same locals as GET /account/business/account in
     routes/account-business.js. Posts to routes/account-settings.js with a
     hidden redirectTo field so they land back here instead of the real
     dashboard -- see settingsRedirectTarget() there.

     Merchant Profile reuses the exact same multer instance
     (uploadProfilePhoto, exported from routes/billing.js) the real
     dashboard's Billing page "Your profile" card already uses for
     photo/name -- this form adds email and an optional phone on top of
     that, posting to a new route (POST .../account/profile) since the real
     dashboard's version doesn't have those two fields and isn't being
     changed. -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Settings - ReceipTap Business</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
  <%- include('partials/wallet-dark-theme') %>
  <style>
    .biz-header { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; }
    .panel { padding: 18px; margin-bottom: 16px; }
    .panel h2 { font-size: 14.5px; margin: 0 0 14px; }
    .w-field { margin-bottom: 14px; }
    .w-field:last-child { margin-bottom: 0; }
    .w-field label { display: block; font-size: 12.5px; font-weight: 600; color: var(--w-ink-soft); margin-bottom: 6px; }
    .w-field input {
      width: 100%; box-sizing: border-box; background: var(--w-card-raised); border: 1px solid var(--w-line);
      color: var(--w-ink); border-radius: 10px; padding: 11px 13px; font-size: 14.5px; font-family: inherit;
    }
    .banner { padding: 11px 14px; border-radius: 10px; font-size: 13px; margin-bottom: 14px; }
    .banner.success { background: rgba(5,107,254,0.12); border: 1px solid rgba(5,107,254,0.35); color: var(--w-accent); }
    .banner.error { background: rgba(255,69,58,0.12); border: 1px solid rgba(255,69,58,0.35); color: var(--w-danger); }

    .logout-btn {
      display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%;
      background: none; border: 1px solid var(--w-danger); color: var(--w-danger); border-radius: 999px;
      padding: 13px; font-size: 14.5px; font-weight: 700; cursor: pointer; font-family: inherit;
    }

    .photo-row { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; }
    .photo-avatar { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; border: 1px solid var(--w-line); flex-shrink: 0; }
    .photo-avatar-placeholder {
      width: 56px; height: 56px; border-radius: 50%; background: var(--w-accent-wash); color: var(--w-accent);
      display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 20px; text-transform: uppercase; flex-shrink: 0;
    }
    .photo-input-wrap { flex: 1; min-width: 0; }
    .photo-input-wrap input[type="file"] { font-size: 12.5px; color: var(--w-ink-soft); width: 100%; }
    .photo-hint { font-size: 11.5px; color: var(--w-ink-soft); margin-top: 4px; }
  </style>
</head>
<body>
  <div class="w-shell">
    <div class="biz-header">
      <a href="/account/business/more" class="w-btn-icon" aria-label="Back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      </a>
      <div>
        <div class="w-eyebrow">Business</div>
        <h1 class="w-title" style="font-size:20px;">Settings</h1>
      </div>
    </div>

    <div class="w-card panel">
      <h2>Merchant profile</h2>
      <% if (profileError) { %><div class="banner error"><%= profileError %></div><% } %>
      <% if (profileSuccess) { %><div class="banner success">Profile updated.</div><% } %>
      <form method="POST" action="/dashboard/settings/account/profile" enctype="multipart/form-data">
        <input type="hidden" name="redirectTo" value="/account/business/account" />
        <div class="photo-row">
          <% if (merchant.profilePhotoUrl) { %>
            <img class="photo-avatar" src="<%= merchant.profilePhotoUrl %>" alt="Your photo" />
          <% } else { %>
            <div class="photo-avatar-placeholder"><%= (merchant.ownerName || merchant.businessName || '?').charAt(0) %></div>
          <% } %>
          <div class="photo-input-wrap">
            <input type="file" name="profilePhoto" accept="image/png,image/jpeg,image/webp" />
            <div class="photo-hint">PNG, JPG, or WEBP — up to 2MB.</div>
          </div>
        </div>
        <div class="w-field"><label for="ownerName">Name</label><input type="text" id="ownerName" name="ownerName" value="<%= merchant.ownerName || '' %>" placeholder="Your first and last name" /></div>
        <div class="w-field"><label for="profileEmail">Email</label><input type="email" id="profileEmail" name="email" value="<%= merchant.email %>" required /></div>
        <div class="w-field"><label for="ownerPhone">Phone (optional)</label><input type="text" id="ownerPhone" name="ownerPhone" value="<%= merchant.ownerPhone || '' %>" placeholder="416-555-1234" /></div>
        <button type="submit" class="w-btn" style="margin-top:4px;">Save changes</button>
      </form>
    </div>

    <div class="w-card panel">
      <h2>Change password</h2>
      <% if (passwordError) { %><div class="banner error"><%= passwordError %></div><% } %>
      <% if (passwordSuccess) { %><div class="banner success">Password changed.</div><% } %>
      <form method="POST" action="/dashboard/settings/account/password">
        <input type="hidden" name="redirectTo" value="/account/business/account" />
        <div class="w-field"><label for="currentPassword">Current password</label><input type="password" id="currentPassword" name="currentPassword" required /></div>
        <div class="w-field"><label for="newPassword">New password</label><input type="password" id="newPassword" name="newPassword" required minlength="8" /></div>
        <div class="w-field"><label for="confirmNewPassword">Confirm new password</label><input type="password" id="confirmNewPassword" name="confirmNewPassword" required minlength="8" /></div>
        <button type="submit" class="w-btn" style="margin-top:4px;">Change password</button>
      </form>
    </div>

    <div class="w-card panel">
      <form method="POST" action="/logout">
        <button type="submit" class="logout-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Log out
        </button>
      </form>
    </div>
  </div>
</body>
</html>
