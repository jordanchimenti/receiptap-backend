<!-- views/business-loyalty.ejs -->
<!-- The merchant's stamp card, reached from More -> Loyalty (directly under
     Receipt design). Same dark wallet chrome as views/business-receipt-design.ejs.
     Locals come from computeLoyaltyPageData()/saveLoyaltyProgram() in
     routes/loyalty.js; the routes are mounted in routes/account-business.js
     with the rest of the Business section.

     There is no signup step anywhere on this page, deliberately: a customer
     with a ReceipTap account is enrolled by their first receipt from this
     merchant (see awardLoyaltyStamps), so the merchant configures the rules
     and nothing else. -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Stamp Card - ReceipTap Business</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
  <%- include('partials/wallet-dark-theme') %>
  <style>
    .biz-header { display: flex; align-items: center; gap: 12px; margin-bottom: 6px; }
    .page-sub { font-size: 13px; color: var(--w-ink-soft); line-height: 1.55; margin: 0 0 18px 44px; }
    .banner { padding: 11px 14px; border-radius: 10px; font-size: 13px; margin-bottom: 16px; }
    .banner.success { background: rgba(5,107,254,0.12); border: 1px solid rgba(5,107,254,0.35); color: var(--w-accent); }
    .banner.error { background: rgba(255,69,58,0.12); border: 1px solid rgba(255,69,58,0.35); color: var(--w-danger); }

    .panel { padding: 18px; margin-bottom: 16px; }
    .panel h2 { font-size: 14.5px; margin: 0 0 14px; }
    .panel-sub { font-size: 12px; color: var(--w-ink-soft); line-height: 1.55; margin: -8px 0 14px; }

    .w-field { margin-bottom: 14px; }
    .w-field:last-child { margin-bottom: 0; }
    .w-field label { display: block; font-size: 12.5px; font-weight: 600; color: var(--w-ink-soft); margin-bottom: 6px; }
    .w-field input[type="text"], .w-field input[type="email"], .w-field input[type="number"] {
      width: 100%; box-sizing: border-box; background: var(--w-card-raised); border: 1px solid var(--w-line);
      color: var(--w-ink); border-radius: 10px; padding: 11px 13px; font-size: 14.5px; font-family: inherit;
    }
    .w-field input[type="color"] { width: 56px; height: 38px; border: 1px solid var(--w-line); border-radius: 8px; padding: 2px; background: var(--w-card-raised); }
    .w-field input[type="file"] { font-size: 13px; color: var(--w-ink-soft); }
    .hint { font-size: 11.5px; color: var(--w-ink-soft); margin-top: 6px; line-height: 1.55; }

    /* ---- Program active: title/sub on the left, switch on the right ---- */
    .toggle-row { display: flex; align-items: center; gap: 14px; }
    .toggle-row-text { flex: 1; min-width: 0; }
    .toggle-row-title { font-size: 14.5px; font-weight: 700; }
    .toggle-row-sub { font-size: 12px; color: var(--w-ink-soft); margin-top: 3px; line-height: 1.45; }
    .sw { position: relative; flex: none; width: 44px; height: 26px; }
    .sw input {
      appearance: none; -webkit-appearance: none; margin: 0; cursor: pointer;
      width: 44px; height: 26px; border-radius: 999px; background: #3a3a3a; border: none;
      transition: background 0.18s ease;
    }
    .sw input:checked { background: var(--w-accent); }
    .sw input::after {
      content: ''; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%;
      background: #fff; transition: transform 0.18s ease;
    }
    .sw input:checked::after { transform: translateX(18px); }
    .sw input:focus-visible { outline: 2px solid var(--w-accent); outline-offset: 2px; }

    /* ---- "What earns a stamp?" -- radios drawn as full-width rows ------ */
    .rule-list { display: flex; flex-direction: column; gap: 10px; }
    .rule { display: block; cursor: pointer; }
    /* Direct child only -- `.rule input` would also swallow the text/number
       field a rule reveals when it's chosen. */
    .rule > input { position: absolute; opacity: 0; pointer-events: none; }
    .rule-box {
      display: flex; align-items: flex-start; gap: 12px; padding: 13px 14px; border-radius: 12px;
      border: 1px solid var(--w-line); background: var(--w-card-raised); transition: border-color 0.15s ease, background 0.15s ease;
    }
    .rule > input:checked + .rule-box { border-color: var(--w-accent); background: var(--w-accent-wash); }
    .rule > input:focus-visible + .rule-box { outline: 2px solid var(--w-accent); outline-offset: 2px; }
    .rule-icon { flex: none; width: 20px; height: 20px; color: var(--w-ink-soft); margin-top: 1px; }
    .rule > input:checked + .rule-box .rule-icon { color: var(--w-accent); }
    .rule-name { font-size: 14px; font-weight: 700; color: var(--w-ink); }
    .rule > input:checked + .rule-box .rule-name { color: var(--w-accent); }
    .rule-sub { font-size: 11.5px; color: var(--w-ink-soft); margin-top: 3px; line-height: 1.45; }
    /* The extra input a rule needs (product name, dollars per stamp) lives
       inside its own row and only appears once that rule is chosen. */
    .rule-extra { margin-top: 12px; display: none; }
    .rule > input:checked + .rule-box .rule-extra { display: block; }
    .rule-extra input { width: 100%; box-sizing: border-box; background: var(--w-card); border: 1px solid var(--w-line);
      color: var(--w-ink); border-radius: 9px; padding: 9px 11px; font-size: 13.5px; font-family: inherit; }
    .rule-body { flex: 1; min-width: 0; }

    /* ---- Head-start bonus: three-way segmented control ----------------- */
    .seg { display: flex; gap: 10px; }
    .seg label { flex: 1; cursor: pointer; }
    .seg label > input { position: absolute; opacity: 0; pointer-events: none; }
    .seg-box {
      text-align: center; padding: 12px 6px; border-radius: 11px; border: 1px solid var(--w-line);
      background: var(--w-card-raised); font-size: 13px; font-weight: 700; color: var(--w-ink-soft);
    }
    .seg label > input:checked + .seg-box { border-color: var(--w-accent); background: var(--w-accent-wash); color: var(--w-accent); }
    .seg label > input:focus-visible + .seg-box { outline: 2px solid var(--w-accent); outline-offset: 2px; }

    .color-row { display: flex; gap: 24px; align-items: flex-start; }
    .color-row .w-field { margin-bottom: 0; }
    .upload-btn {
      display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px; border-radius: 10px;
      border: 1px solid var(--w-line); background: var(--w-card-raised); color: var(--w-ink);
      font-size: 13.5px; font-weight: 700; cursor: pointer; font-family: inherit;
    }
    .logo-current { display: flex; align-items: center; gap: 10px; margin-top: 10px; font-size: 12px; color: var(--w-ink-soft); }
    .logo-current img { width: 34px; height: 34px; border-radius: 8px; object-fit: contain; background: rgba(255,255,255,0.06); }

    .save-btn {
      display: block; width: 100%; padding: 15px; border-radius: 999px; border: none; cursor: pointer;
      background: var(--w-accent); color: #fff; font-size: 15px; font-weight: 700; font-family: inherit;
      margin-bottom: 22px;
    }

    /* ---- Live preview of the card as it lands in a customer's wallet --- */
    .preview-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; color: var(--w-ink-soft); margin-bottom: 10px; }
    .stamp-card { border-radius: 16px; padding: 16px; margin-bottom: 16px; }
    .stamp-head { display: flex; align-items: center; gap: 11px; margin-bottom: 14px; }
    .stamp-logo {
      width: 40px; height: 40px; border-radius: 10px; flex: none; display: flex; align-items: center; justify-content: center;
      background: rgba(255,255,255,0.18); overflow: hidden;
    }
    .stamp-logo img { width: 100%; height: 100%; object-fit: contain; }
    .stamp-monogram { font-family: var(--font-display); font-size: 18px; font-weight: 700; line-height: 1; }
    .stamp-biz { font-size: 15px; font-weight: 700; line-height: 1.2; }
    .stamp-rule { font-size: 12px; opacity: 0.85; margin-top: 2px; }
    .stamp-row { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
    .stamp {
      width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
      font-size: 12.5px; font-weight: 700; border: 1.5px solid currentColor; opacity: 0.55;
    }
    .stamp.filled { opacity: 1; }
    .stamp-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 13.5px; font-weight: 600; }
    .stamp-foot-reward { display: flex; align-items: center; gap: 7px; min-width: 0; }
    .stamp-foot-reward span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .redeem-row { display: flex; gap: 10px; align-items: stretch; }
    .redeem-row input { flex: 1; min-width: 0; }
    .redeem-btn {
      flex: none; padding: 0 18px; border-radius: 10px; border: 1px solid var(--w-line);
      background: var(--w-accent-wash); color: var(--w-accent); font-size: 13.5px; font-weight: 700;
      cursor: pointer; font-family: inherit; display: flex; align-items: center; gap: 7px;
    }
    .code-input { text-transform: uppercase; letter-spacing: 0.08em; }

    .panel-head-count { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
    .panel-head-count h2 { margin: 0; }
    .panel-head-count .count { font-size: 14.5px; font-weight: 700; color: var(--w-ink-soft); }
    .members-empty { font-size: 12.5px; color: var(--w-ink-soft); text-align: center; line-height: 1.6; padding: 6px 0 2px; }
  </style>
</head>
<body>
  <div class="w-shell">
    <div class="biz-header">
      <a href="/account/business/more" class="w-btn-icon" aria-label="Back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      </a>
      <div>
        <div class="w-eyebrow">Loyalty</div>
        <h1 class="w-title" style="font-size:20px;">Stamp card</h1>
      </div>
    </div>
    <p class="page-sub">Reward repeat customers. Anyone with a ReceipTap account starts collecting the moment they save a receipt from you — there's nothing for them to sign up for.</p>

    <% if (saved) { %><div class="banner success">Stamp card saved.</div><% } %>
    <% if (error) { %><div class="banner error"><%= error %></div><% } %>

    <form method="POST" action="/account/business/loyalty" enctype="multipart/form-data">
      <div class="w-card panel">
        <div class="toggle-row">
          <div class="toggle-row-text">
            <div class="toggle-row-title">Program active</div>
            <div class="toggle-row-sub">Customers only earn stamps while this is on.</div>
          </div>
          <span class="sw"><input type="checkbox" name="enabled" id="enabled" <%= program.enabled ? 'checked' : '' %> /></span>
        </div>
      </div>

      <div class="w-card panel">
        <h2>What earns a stamp?</h2>
        <div class="rule-list">
          <label class="rule">
            <input type="radio" name="earnRule" value="ORDER" <%= program.earnRule === 'ORDER' ? 'checked' : '' %> />
            <div class="rule-box">
              <svg class="rule-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
              <div class="rule-body">
                <div class="rule-name">Per order</div>
                <div class="rule-sub">One stamp every purchase, whatever they buy</div>
              </div>
            </div>
          </label>

          <label class="rule">
            <input type="radio" name="earnRule" value="VISIT" <%= program.earnRule === 'VISIT' ? 'checked' : '' %> />
            <div class="rule-box">
              <svg class="rule-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="m9 16 2 2 4-4"/></svg>
              <div class="rule-body">
                <div class="rule-name">Per visit</div>
                <div class="rule-sub">One stamp per day, even with repeat visits</div>
              </div>
            </div>
          </label>

          <label class="rule">
            <input type="radio" name="earnRule" value="ITEM" <%= program.earnRule === 'ITEM' ? 'checked' : '' %> />
            <div class="rule-box">
              <svg class="rule-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><path d="M6 2v3M10 2v3M14 2v3"/></svg>
              <div class="rule-body">
                <div class="rule-name">Per item</div>
                <div class="rule-sub">A stamp for each matching product (e.g. coffee)</div>
                <div class="rule-extra" onclick="event.preventDefault();">
                  <input type="text" name="earnItemName" value="<%= program.earnItemName %>" maxlength="60" placeholder="Product name, e.g. Latte" oninput="renderPreview()" />
                </div>
              </div>
            </div>
          </label>

          <label class="rule">
            <input type="radio" name="earnRule" value="AMOUNT" <%= program.earnRule === 'AMOUNT' ? 'checked' : '' %> />
            <div class="rule-box">
              <svg class="rule-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 1v22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              <div class="rule-body">
                <div class="rule-name">Per amount spent</div>
                <div class="rule-sub">A stamp for every $X on the receipt</div>
                <div class="rule-extra" onclick="event.preventDefault();">
                  <input type="number" name="earnAmountDollars" value="<%= program.earnAmountDollars %>" min="0.01" step="0.01" placeholder="10.00" oninput="renderPreview()" />
                </div>
              </div>
            </div>
          </label>
        </div>

        <div class="hint">Only whole stamps are awarded — a $27 receipt on “every $10” earns 2.</div>
      </div>

      <div class="w-card panel">
        <h2>The reward</h2>
        <div class="w-field">
          <label for="stampsRequired">Stamps needed for a reward</label>
          <input type="number" name="stampsRequired" id="stampsRequired" min="1" max="50" value="<%= program.stampsRequired %>" oninput="renderPreview()" />
        </div>
        <div class="w-field">
          <label for="rewardLabel">Reward</label>
          <input type="text" name="rewardLabel" id="rewardLabel" maxlength="60" value="<%= program.rewardLabel %>" placeholder="Free reward" oninput="renderPreview()" />
          <div class="hint">Printed exactly as you write it, on receipts and in the customer's wallet — “Free coffee”, “10% off”, “$5 off”.</div>
        </div>
        <div class="w-field">
          <label>Head-start bonus</label>
          <div class="seg">
            <% [0, 1, 2].forEach(function(n) { %>
              <label>
                <input type="radio" name="headStartStamps" value="<%= n %>" <%= program.headStartStamps === n ? 'checked' : '' %> onchange="renderPreview()" />
                <div class="seg-box"><%= n === 0 ? 'None' : (n + ' stamp' + (n === 1 ? '' : 's')) %></div>
              </label>
            <% }); %>
          </div>
          <div class="hint">Give new customers a running start: their first card arrives with these stamps already filled. A card that's already underway gets finished far more often than one starting at zero.</div>
        </div>
        <div class="w-field">
          <label for="redemptionCode">Redemption code</label>
          <input type="text" name="redemptionCode" id="redemptionCode" class="code-input" maxlength="40" value="<%= program.redemptionCode %>" placeholder="REWARD" />
          <div class="hint">Your staff's code. A customer with a full card types it on their own phone, or your staff enters it below to redeem at the counter. Change it any time.</div>
        </div>
      </div>

      <div class="w-card panel">
        <h2>Card design</h2>
        <div class="panel-sub">How the card looks in the customer's wallet. Starts from your receipt branding — change anything here and the card stops following it.</div>
        <div class="w-field">
          <label for="logoFile" class="upload-btn" style="display:inline-flex;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 9l5-5 5 5"/><path d="M12 4v12"/></svg>
            Upload logo
          </label>
          <input type="file" name="logoFile" id="logoFile" accept="image/png,image/jpeg,image/webp,image/svg+xml" style="display:none;" onchange="onLogoPicked(this)" />
          <% if (program.cardLogoUrl) { %>
            <div class="logo-current"><img src="<%= program.cardLogoUrl %>" alt="" /> Current logo</div>
          <% } else if (card.logoIsInherited) { %>
            <div class="logo-current"><img src="<%= card.logoUrl %>" alt="" /> Using your receipt logo</div>
          <% } %>
          <div class="hint">
            PNG, JPG, WEBP, or SVG — up to 2MB.
            <% if (card.logoIsInherited) { %>
              Upload one here only if you want the card to differ from your receipt.
            <% } else if (!program.cardLogoUrl) { %>
              With none set, the card shows your initial — add a logo on Receipt design and it's used here automatically.
            <% } %>
          </div>
        </div>
        <div class="color-row">
          <div class="w-field">
            <label for="cardBackground">Background</label>
            <input type="color" name="cardBackground" id="cardBackground" value="<%= program.cardBackground %>" oninput="renderPreview()" />
          </div>
          <div class="w-field">
            <label for="cardAccent">Accent</label>
            <input type="color" name="cardAccent" id="cardAccent" value="<%= program.cardAccent %>" oninput="renderPreview()" />
          </div>
        </div>
      </div>

      <div class="save-bar"><button type="submit" class="save-btn">Save stamp card</button></div>
    </form>

    <div class="preview-eyebrow">PREVIEW</div>
    <div class="stamp-card" id="preview-card">
      <div class="stamp-head">
        <div class="stamp-logo" id="preview-logo">
          <% if (card.logoUrl) { %><img src="<%= card.logoUrl %>" alt="" /><% } else { %>
            <span class="stamp-monogram"><%= card.monogram %></span>
          <% } %>
        </div>
        <div>
          <div class="stamp-biz"><%= card.businessName %></div>
          <div class="stamp-rule" id="preview-rule"><%= earnRuleText %></div>
        </div>
      </div>
      <div class="stamp-row" id="preview-stamps"></div>
      <div class="stamp-foot">
        <div class="stamp-foot-reward">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 12v9H4v-9"/><path d="M2 7h20v5H2z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7Z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7Z"/></svg>
          <span id="preview-reward"><%= program.rewardLabel %></span>
        </div>
        <div id="preview-count"></div>
      </div>
    </div>

    <div class="w-card panel">
      <h2>Redeem a reward</h2>
      <div class="panel-sub">For redeeming at the counter. The customer can also do it themselves from their wallet.</div>
      <% if (redeemMessage) { %><div class="banner success" style="margin-bottom:14px;"><%= redeemMessage %></div><% } %>
      <% if (redeemError) { %><div class="banner error" style="margin-bottom:14px;"><%= redeemError %></div><% } %>
      <form method="POST" action="/account/business/loyalty/redeem">
        <div class="w-field">
          <label for="redeemEmail">Customer's email</label>
          <input type="email" name="email" id="redeemEmail" placeholder="them@example.com" autocomplete="off" />
        </div>
        <div class="w-field">
          <label for="redeemCode">Your redemption code</label>
          <div class="redeem-row">
            <input type="text" name="code" id="redeemCode" class="code-input" placeholder="ENTER CODE" autocomplete="off" />
            <button type="submit" class="redeem-btn">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
              Confirm
            </button>
          </div>
        </div>
      </form>
    </div>

    <div class="w-card panel">
      <div class="panel-head-count">
        <h2>Members</h2>
        <div class="count"><%= memberCount %></div>
      </div>
      <% if (memberCount === 0) { %>
        <div class="members-empty">No members yet. Cards start themselves when customers save a receipt from you.</div>
      <% } else { %>
        <div class="members-empty"><%= memberCount %> customer<%= memberCount === 1 ? ' is' : 's are' %> collecting stamps with you.</div>
      <% } %>
    </div>
  </div>

  <script>
    // The preview is drawn from the live form values rather than the saved
    // program, so the merchant sees the card change as they type -- including
    // how many stamps a head-start bonus actually pre-fills.
    function checkedValue(name) {
      const el = document.querySelector(`input[name="${name}"]:checked`);
      return el ? el.value : null;
    }

    function ruleText() {
      const rule = checkedValue('earnRule');
      if (rule === 'VISIT') return '1 stamp per visit (once a day)';
      if (rule === 'ITEM') {
        const item = document.querySelector('input[name="earnItemName"]').value.trim();
        return item ? `1 stamp per ${item}` : '1 stamp per matching item';
      }
      if (rule === 'AMOUNT') {
        const amount = parseFloat(document.querySelector('input[name="earnAmountDollars"]').value);
        return `1 stamp per $${(Number.isFinite(amount) && amount > 0 ? amount : 10).toFixed(2)} spent`;
      }
      return '1 stamp per order';
    }

    function renderPreview() {
      const card = document.getElementById('preview-card');
      const background = document.getElementById('cardBackground').value;
      const accent = document.getElementById('cardAccent').value;
      card.style.background = background;
      card.style.color = accent;

      const required = Math.min(Math.max(parseInt(document.getElementById('stampsRequired').value, 10) || 1, 1), 50);
      // Show a card partway through so the filled and empty states are both
      // visible -- but never fewer stamps than the head start actually grants.
      const headStart = parseInt(checkedValue('headStartStamps'), 10) || 0;
      const filled = Math.min(Math.max(headStart, Math.ceil(required * 0.3)), required);

      const row = document.getElementById('preview-stamps');
      row.innerHTML = '';
      for (let i = 1; i <= required; i++) {
        const dot = document.createElement('div');
        dot.className = i <= filled ? 'stamp filled' : 'stamp';
        dot.textContent = i <= filled ? '✓' : String(i);
        row.appendChild(dot);
      }

      document.getElementById('preview-rule').textContent = ruleText();
      document.getElementById('preview-reward').textContent =
        document.getElementById('rewardLabel').value.trim() || 'Free reward';
      document.getElementById('preview-count').textContent = `${filled} / ${required}`;
    }

    function onLogoPicked(input) {
      const file = input.files && input.files[0];
      if (!file) return;
      const holder = document.getElementById('preview-logo');
      holder.innerHTML = '';
      const img = document.createElement('img');
      img.src = URL.createObjectURL(file);
      holder.appendChild(img);
    }

    document.querySelectorAll('input[name="earnRule"]').forEach((el) => el.addEventListener('change', renderPreview));
    renderPreview();
  </script>
</body>
