<!-- views/business-overview.ejs -->
<!-- Dark reskin of views/dashboard-overview.ejs's content, single-column
     for mobile. Same locals (merchant, stats, pucks, recent) --
     see computeOverviewData() in routes/merchant-dashboard.js. -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Overview - ReceipTap Business</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
  <%- include('partials/wallet-dark-theme') %>
  <style>
    .biz-header { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }

    .setup-card { padding: 18px; margin-bottom: 18px; }
    .setup-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
    .setup-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--w-accent); }
    .setup-pct { font-size: 13px; font-weight: 700; color: var(--w-ink-soft); }
    .setup-bar { height: 6px; border-radius: 999px; background: var(--w-card-raised); overflow: hidden; margin-bottom: 16px; }
    .setup-bar-fill { height: 100%; background: var(--w-accent); border-radius: 999px; }
    .setup-row { display: flex; align-items: flex-start; gap: 12px; padding: 9px 0; }
    .setup-check {
      width: 22px; height: 22px; border-radius: 50%; flex-shrink: 0; margin-top: 1px;
      display: flex; align-items: center; justify-content: center; border: 1.5px solid var(--w-line);
    }
    .setup-check svg { width: 12px; height: 12px; }
    .setup-row.done .setup-check { background: rgba(5,107,254,0.15); border-color: transparent; color: var(--w-accent); }
    .setup-row-body { flex: 1; min-width: 0; }
    .setup-row-title { font-size: 13.5px; font-weight: 700; color: var(--w-ink); }
    .setup-row.done .setup-row-title { color: var(--w-ink-soft); text-decoration: line-through; }
    .setup-row-sub { font-size: 12px; color: var(--w-ink-soft); margin-top: 2px; line-height: 1.4; }
    .setup-row-chevron { color: var(--w-ink-soft); flex-shrink: 0; margin-top: 3px; }
    a.setup-row { text-decoration: none; }

    /* Get started card -- the pre-launch companion to Setup progress above.
       Setup progress tracks the whole account; this one is only about getting
       hardware issuing receipts, and it goes away for good once it is. */
    .gs-card { padding: 22px 20px; margin-bottom: 18px; }
    .gs-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--w-accent); }
    .gs-title { font-size: 20px; font-weight: 700; margin: 8px 0 6px; }
    .gs-lede { font-size: 13.5px; color: var(--w-ink-soft); line-height: 1.55; margin: 0 0 18px; }
    a.gs-step { display: flex; gap: 13px; align-items: flex-start; padding: 10px 0; text-decoration: none; color: inherit; }
    /* Tinted tiles, not neutral ones. A step still to do is the thing being
       asked for, so it carries the brand colour; a grey tile read as disabled,
       which is the opposite of the intent. */
    .gs-step-icon {
      width: 40px; height: 40px; border-radius: 12px; flex-shrink: 0;
      background: var(--w-accent-wash); color: var(--w-accent);
      display: flex; align-items: center; justify-content: center;
    }
    .gs-step-icon svg { width: 19px; height: 19px; }
    /* Brand blue for done too, but solid-filled rather than the "to do"
       tiles' light wash -- a flat wash-on-wash blue would have made "done"
       and "to do" hard to tell apart at a glance, even with different icons. */
    .gs-step.done .gs-step-icon { background: var(--w-accent); color: #fff; }
    .gs-step-body { flex: 1; min-width: 0; padding-top: 2px; }
    .gs-step-title { font-size: 14px; font-weight: 700; color: var(--w-ink); }
    .gs-step.done .gs-step-title { color: var(--w-ink-soft); }
    .gs-step-sub { font-size: 12.5px; color: var(--w-ink-soft); line-height: 1.45; margin-top: 2px; }
    .gs-cta {
      display: flex; align-items: center; justify-content: center; gap: 9px;
      background: var(--w-ink); color: #0a0a0a; text-decoration: none;
      font-size: 15px; font-weight: 700; padding: 15px; border-radius: 999px; margin-top: 18px;
    }
    .gs-cta svg { width: 17px; height: 17px; }
    .gs-note { font-size: 12px; color: var(--w-ink-soft); line-height: 1.5; margin-top: 14px; text-align: center; }
    .gs-secondary {
      display: block; text-align: center; font-size: 13px; color: var(--w-ink-soft);
      text-decoration: none; margin-top: 14px;
    }

    .hero-card {
      padding: 20px 22px; margin-bottom: 18px;
      background: radial-gradient(120% 140% at 100% 0%, rgba(5,107,254,0.35) 0%, var(--w-card) 65%);
      border-color: rgba(5,107,254,0.3);
    }
    .hero-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--w-ink-soft); }
    .hero-value { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 34px; font-weight: 700; margin: 4px 0; }
    .hero-sub { font-size: 13px; color: var(--w-ink-soft); }
    .hero-divider { height: 1px; background: var(--w-line); margin: 16px 0; }
    .hero-substats { display: flex; }
    .hero-substat { flex: 1; }
    .hero-substat + .hero-substat { border-left: 1px solid var(--w-line); padding-left: 16px; margin-left: 16px; }
    .hero-substat-label { font-size: 10.5px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--w-ink-soft); margin-bottom: 3px; }
    .hero-substat-value { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 17px; font-weight: 700; }
    .hero-substat-sub { font-size: 11px; color: var(--w-ink-soft); }

    .panel { padding: 18px; margin-bottom: 16px; }
    .panel-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
    .panel-head h2 { font-size: 15px; margin: 0; }
    .panel-head a { font-size: 12.5px; font-weight: 600; color: var(--w-accent); text-decoration: none; }
    .blank { text-align: center; padding: 20px 10px; }
    .blank-title { font-size: 13.5px; font-weight: 700; margin-bottom: 4px; }
    .blank-sub { font-size: 12.5px; color: var(--w-ink-soft); line-height: 1.5; margin-bottom: 14px; }


    .puck-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .puck-card { background: var(--w-card-raised); border: 1px solid var(--w-line); border-radius: 12px; padding: 12px; text-decoration: none; color: var(--w-ink); }
    .puck-name { font-size: 12.5px; font-weight: 700; margin-bottom: 6px; }
    .puck-badge { font-size: 10.5px; font-weight: 700; padding: 2px 8px; border-radius: 999px; display: inline-block; }
    .puck-badge.linked { background: rgba(5,107,254,0.2); color: var(--w-accent); }
    .puck-badge.pairing { background: rgba(5,107,254,0.12); color: var(--w-accent); }
    .puck-badge.needs { background: var(--w-card-raised); color: var(--w-ink-soft); border: 1px solid var(--w-line); }
    .puck-date { font-size: 11px; color: var(--w-ink-soft); margin-top: 6px; }

    .qa-row { display: flex; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--w-line); text-decoration: none; color: var(--w-ink); font-size: 13.5px; font-weight: 600; }
    .qa-row:last-child { border-bottom: none; }
    .qa-icon { width: 30px; height: 30px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .qa-icon svg { width: 15px; height: 15px; }
  </style>
</head>
<body>
  <%
    var name = (merchant.ownerName || merchant.businessName || 'there').split(' ')[0];
  %>
  <div class="w-shell">
    <div class="biz-header">
      <div>
        <div class="w-eyebrow">Business</div>
        <h1 class="w-title" style="font-size:20px;">Welcome back, <%= name %></h1>
      </div>
    </div>

    <div class="w-card hero-card">
      <div class="hero-eyebrow">Today</div>
      <div class="hero-value">$<%= Number(stats.todayRevenue).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></div>
      <div class="hero-sub"><%= stats.todayReceipts %> receipt<%= stats.todayReceipts === 1 ? '' : 's' %> issued</div>
      <div class="hero-divider"></div>
      <div class="hero-substats">
        <div class="hero-substat">
          <div class="hero-substat-label">Devices</div>
          <div class="hero-substat-value"><%= stats.pucksLinked %>/<%= stats.pucksActive %></div>
          <div class="hero-substat-sub">linked</div>
        </div>
        <div class="hero-substat">
          <div class="hero-substat-label">This month</div>
          <div class="hero-substat-value">$<%= Number(stats.monthRevenue).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) %></div>
          <div class="hero-substat-sub"><%= stats.monthLabel %></div>
        </div>
      </div>
    </div>

    <div class="w-card setup-card">
      <div class="setup-head">
        <div class="setup-eyebrow">Setup progress</div>
        <div class="setup-pct"><%= setup.percent %>%</div>
      </div>
      <div class="setup-bar"><div class="setup-bar-fill" style="width: <%= setup.percent %>%;"></div></div>

      <a class="setup-row done" href="/account/business/settings">
        <div class="setup-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
        <div class="setup-row-body">
          <div class="setup-row-title">Create your account</div>
          <div class="setup-row-sub">View your business information.</div>
        </div>
        <div class="setup-row-chevron"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></div>
      </a>

      <%# Address + tax registration number -- the two things every receipt
          this merchant issues needs for a customer's CRA/IRS claim to hold
          up (see lib/receiptMissingFields.js). Without a tax number here,
          every single receipt silently comes up short on that one field. %>
      <% if (setup.businessProfileComplete) { %>
        <a class="setup-row done" href="/account/business/settings">
          <div class="setup-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
          <div class="setup-row-body">
            <div class="setup-row-title">Complete your business profile</div>
            <div class="setup-row-sub">Address and tax number are on file.</div>
          </div>
          <div class="setup-row-chevron"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></div>
        </a>
      <% } else { %>
        <a class="setup-row" href="/account/business/settings">
          <div class="setup-check"></div>
          <div class="setup-row-body">
            <div class="setup-row-title">Complete your business profile</div>
            <div class="setup-row-sub">Add your business address and tax registration number so every receipt you issue holds up for your customers' taxes.</div>
          </div>
          <div class="setup-row-chevron"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></div>
        </a>
      <% } %>

      <% if (setup.billingAdded) { %>
        <a class="setup-row done" href="/account/business/billing">
          <div class="setup-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
          <div class="setup-row-body">
            <div class="setup-row-title">Start your subscription</div>
            <div class="setup-row-sub">Manage your subscription and billing.</div>
          </div>
          <div class="setup-row-chevron"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></div>
        </a>
      <% } else { %>
        <a class="setup-row" href="/account/business/billing">
          <div class="setup-check"></div>
          <div class="setup-row-body">
            <div class="setup-row-title">Start your subscription</div>
            <div class="setup-row-sub">A card is required to start your free trial.</div>
          </div>
          <div class="setup-row-chevron"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></div>
        </a>
      <% } %>

      <% if (setup.puckSetUp) { %>
        <a class="setup-row done" href="/account/business/pucks">
          <div class="setup-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
          <div class="setup-row-body">
            <div class="setup-row-title">Set up your first ReceipTap</div>
            <div class="setup-row-sub">Manage your ReceipTaps.</div>
          </div>
          <div class="setup-row-chevron"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></div>
        </a>
      <% } else { %>
        <a class="setup-row" href="/account/business/pucks">
          <div class="setup-check"></div>
          <div class="setup-row-body">
            <div class="setup-row-title">Set up your first ReceipTap</div>
            <div class="setup-row-sub">Tap the puck with your phone, or type its activation code, to add it to this account.</div>
          </div>
          <div class="setup-row-chevron"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></div>
        </a>
      <% } %>

      <% if (setup.receiptCustomized) { %>
        <a class="setup-row done" href="/account/business/receipt-design">
          <div class="setup-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
          <div class="setup-row-body">
            <div class="setup-row-title">Customize your receipt</div>
            <div class="setup-row-sub">Edit your receipt design.</div>
          </div>
          <div class="setup-row-chevron"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></div>
        </a>
      <% } else { %>
        <a class="setup-row" href="/account/business/receipt-design">
          <div class="setup-check"></div>
          <div class="setup-row-body">
            <div class="setup-row-title">Customize your receipt</div>
            <div class="setup-row-sub">Add your logo, colours, and links customers see on every tap.</div>
          </div>
          <div class="setup-row-chevron"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></div>
        </a>
      <% } %>

      <%# Same /account/install page the shopper wallet links to -- it's one
          app, and the install steps don't differ by account type. %>
      <% if (setup.homeScreenAdded) { %>
        <a class="setup-row done" href="/account/install">
          <div class="setup-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
          <div class="setup-row-body">
            <div class="setup-row-title">Add ReceipTap to your home screen</div>
            <div class="setup-row-sub">One tap to your dashboard.</div>
          </div>
          <div class="setup-row-chevron"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></div>
        </a>
      <% } else { %>
        <a class="setup-row" href="/account/install">
          <div class="setup-check"></div>
          <div class="setup-row-body">
            <div class="setup-row-title">Add ReceipTap to your home screen</div>
            <div class="setup-row-sub">Open your dashboard like an app, straight from your phone.</div>
          </div>
          <div class="setup-row-chevron"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></div>
        </a>
      <% } %>

      <%# Done once the receipt banner is actually switched on (that's what
          starts earning, not merely visiting a page). Either way this row goes
          to the Partner Program: the landing page while they're deciding, and
          their own referral link and earnings once they're in. %>
      <% if (setup.partnerProgramOn) { %>
        <a class="setup-row done" href="/account/business/referrals">
          <div class="setup-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
          <div class="setup-row-body">
            <div class="setup-row-title">Join the Partner Program</div>
            <div class="setup-row-sub">See your referral link and earnings.</div>
          </div>
          <div class="setup-row-chevron"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></div>
        </a>
      <% } else { %>
        <a class="setup-row" href="/partner-program?from=%2Faccount%2Fbusiness%2Freferrals">
          <div class="setup-check"></div>
          <div class="setup-row-body">
            <div class="setup-row-title">Join the Partner Program</div>
            <div class="setup-row-sub">Earn <%= merchantAffiliateRate %>% recurring on every business you refer. Free to join.</div>
          </div>
          <div class="setup-row-chevron"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></div>
        </a>
      <% } %>
    </div>

    <%# Get started: claim a ReceipTap, connect a POS, link the ReceipTap to a
        register. That third step is the one merchants miss -- claimed hardware
        on a connected POS still issues nothing until it's pointed at a till.
        (See getStarted in computeOverviewData.)

        Shown in the same shape whatever the state -- steps tick off rather
        than the card changing form. The steps are not one-time either: adding
        a second ReceipTap next month needs claiming and linking again, so the
        card stays useful after the first setup. %>
      <div class="w-card gs-card">
        <div class="gs-eyebrow">Get started</div>
        <h2 class="gs-title">Set up your ReceipTap</h2>
        <p class="gs-lede">Claim your ReceipTap, connect your POS, then link it to a register to start issuing digital receipts.</p>

        <% var gsSteps = [
             { done: getStarted.claimed,
               title: 'Claim your ReceipTap',
               sub: 'Tap & hold your phone, then enter the claim code.',
               href: '/account/business/claim',
               icon: '<path d="M5 8a9 9 0 0 1 0 8"/><path d="M9 6a13 13 0 0 1 0 12"/><path d="M13 4a17 17 0 0 1 0 16"/>' },
             { done: getStarted.posConnected,
               title: 'Connect your POS',
               sub: 'Enter your POS login on POS connection.',
               href: '/account/business/pos',
               icon: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M7 20h10"/><path d="M12 16v4"/>' },
             { done: getStarted.linked,
               title: 'Link it to a register',
               sub: 'Select your ReceipTap ID in the dropdown menu.',
               href: '/account/business/pos',
               icon: '<path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/>' }
           ]; %>

        <%# By request: this card always shows every step in its plain,
            not-done look -- no checkmark, no strikethrough -- even once
            it's actually complete. The CTA button below still reflects
            real progress (label/link), only the per-step icon/title
            styling is frozen. %>
        <% gsSteps.forEach(function (step) { %>
          <a class="gs-step" href="<%= step.href %>">
            <div class="gs-step-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%- step.icon %></svg>
            </div>
            <div class="gs-step-body">
              <div class="gs-step-title"><%= step.title %></div>
              <div class="gs-step-sub"><%= step.sub %></div>
            </div>
          </a>
        <% }); %>

        <a class="gs-cta" href="<%= getStarted.complete ? '/account/business/claim' : getStarted.nextHref %>">
          <%= !getStarted.claimed ? 'Set up ReceipTap'
              : !getStarted.posConnected ? 'Connect your POS'
              : !getStarted.linked ? 'Link it to a register'
              : 'Add another ReceipTap' %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
        </a>

        <% if (!getStarted.claimed) { %>
          <a class="gs-secondary" href="/account/business/claim">Already have a code? Claim a ReceipTap</a>
        <% } %>

        <%# Once everything is linked the note is the only thing left worth
            saying -- the steps above are the answer to "how do I add another". %>
        <% if (getStarted.complete) { %>
          <div class="gs-note">Adding another ReceipTap? Claim it, then link it to the register it sits on.</div>
        <% } %>
      </div>

    <div class="w-card panel">
      <div class="panel-head"><h2>Your ReceipTaps</h2><a href="/account/business/pucks">See all</a></div>
      <% if (pucks.length === 0) { %>
        <div class="blank">
          <div class="blank-title">No ReceipTaps on this account</div>
          <div class="blank-sub">Each puck ships with a six-character activation code on its insert card.</div>
        </div>
      <% } else { %>
        <div class="puck-grid">
          <% pucks.forEach(function (p) { %>
            <a class="puck-card" href="/account/business/pucks?selected=<%= p.id %>">
              <div class="puck-name">ReceipTap <%= p.id.slice(0, 4).toUpperCase() %></div>
              <% if (p.linked) { %><span class="puck-badge linked">Linked</span>
              <% } else if (p.pairing) { %><span class="puck-badge pairing">Pairing…</span>
              <% } else { %><span class="puck-badge needs">Needs linking</span><% } %>
              <div class="puck-date">Added <%= p.claimedAt ? new Date(p.claimedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '—' %></div>
            </a>
          <% }); %>
        </div>
      <% } %>
    </div>

    <div class="w-card panel">
      <div class="panel-head"><h2>Quick actions</h2></div>
      <a class="qa-row" href="/account/business/analytics">
        <span class="qa-icon" style="background:rgba(5,107,254,0.15); color:var(--w-accent);"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg></span>
        See what's selling
      </a>
      <a class="qa-row" href="/account/business/emails">
