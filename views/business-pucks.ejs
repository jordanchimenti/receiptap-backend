<!-- views/business-pucks.ejs -->
<!-- Dark reskin of views/pucks-list.ejs's content, adapted for mobile: a
     flat list with each puck's status/location/connection shown inline,
     rather than the desktop version's master-detail two-pane and
     By-Location tab. Same underlying data -- see computePucksData() in
     routes/merchant-dashboard.js. -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ReceipTaps - ReceipTap Business</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
  <%- include('partials/wallet-dark-theme') %>
  <style>
    .biz-header { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; }
    /* Moved with the card from views/business-overview.ejs. */
    .status-panel { padding: 18px; margin-bottom: 16px; }
    .panel-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
    .panel-head h2 { font-size: 15px; margin: 0; }
    .panel-total { font-size: 12.5px; font-weight: 600; color: var(--w-ink-soft); }
    .stackbar { display: flex; height: 8px; border-radius: 999px; overflow: hidden; background: var(--w-card-raised); margin-bottom: 14px; }
    .legend-row { display: flex; justify-content: space-between; align-items: center; font-size: 13px; margin-bottom: 8px; }
    .legend-row:last-child { margin-bottom: 0; }
    .legend-key { display: flex; align-items: center; gap: 8px; color: var(--w-ink-soft); }
    .sw { width: 8px; height: 8px; border-radius: 50%; }
    /* receiptap.css also has a `.status-note`, styled for the LIGHT theme --
       a pale --ok-wash background with dark teal text. It was quietly winning
       here (the rule below never set a background), which is why this callout
       rendered as a pale blue box on a dark card. Set explicitly so it belongs
       to the page it's on. Same collision as .empty-state and .nav. */
    .status-note {
      font-size: 12.5px; line-height: 1.5; margin: 14px 0 0; padding: 12px 14px;
      border-radius: 10px; background: var(--w-card-raised); color: var(--w-ink-soft);
    }
    .status-note.warn { background: var(--w-accent-wash); color: var(--w-accent); }
    .stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px; }
    .stat-card { padding: 14px 16px; }
    .stat-label { font-size: 11px; color: var(--w-ink-soft); margin-bottom: 4px; }
    .stat-value { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 20px; font-weight: 700; }

    .search-card { padding: 14px 16px; margin-bottom: 12px; }
    .search-card .w-field { margin-bottom: 0; }
    .chips { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
    .chip {
      font-size: 12px; font-weight: 600; padding: 6px 13px; border-radius: 999px;
      text-decoration: none; border: 1px solid var(--w-line); color: var(--w-ink-soft); background: var(--w-card-raised);
    }
    .chip.active { background: var(--w-accent); border-color: var(--w-accent); color: #fff; }

    .puck-row { padding: 14px 16px; border-bottom: 1px solid var(--w-line); }
    .puck-row:last-child { border-bottom: none; }
    .puck-row-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
    .puck-id { font-size: 13.5px; font-weight: 700; font-family: var(--font-mono); }
    .puck-badge { font-size: 10.5px; font-weight: 700; padding: 3px 9px; border-radius: 999px; }
    .puck-badge.linked { background: rgba(5,107,254,0.2); color: var(--w-accent); }
    .puck-badge.pairing { background: rgba(5,107,254,0.12); color: var(--w-accent); }
    .puck-badge.needs { background: var(--w-card-raised); color: var(--w-ink-soft); border: 1px solid var(--w-line); }
    .puck-meta { font-size: 12px; color: var(--w-ink-soft); line-height: 1.6; }
    .unassign-btn { background: none; border: none; color: var(--w-danger); font-size: 12px; font-weight: 600; cursor: pointer; padding: 0; margin-top: 6px; font-family: inherit; }

    .empty { text-align: center; padding: 30px 10px; color: var(--w-ink-soft); font-size: 13.5px; }
    .pager { display: flex; justify-content: space-between; align-items: center; margin-top: 14px; font-size: 13px; }
    .pager a { color: var(--w-accent); font-weight: 600; text-decoration: none; }
    .pager span { color: var(--w-ink-soft); }

    .recent-card { padding: 16px; margin-top: 18px; }
    .recent-item { display: flex; justify-content: space-between; font-size: 12.5px; padding: 6px 0; color: var(--w-ink-soft); }
    .recent-item span:first-child { color: var(--w-ink); font-weight: 600; }
  </style>
</head>
<body>
  <div class="w-shell">
    <div class="biz-header">
      <div>
        <div class="w-eyebrow">Business</div>
        <h1 class="w-title" style="font-size:20px;">ReceipTaps</h1>
      </div>
      <a href="/account/business/pucks/order" class="w-btn-icon" aria-label="Order a ReceipTap" style="margin-left:auto;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
      </a>
    </div>
    <a href="/account/business/orders" style="display:block; text-align:center; font-size:12.5px; color: var(--w-accent); text-decoration:none; margin: -10px 0 16px;">Order history</a>

    <%# Moved here from the Dashboard: the breakdown belongs beside the list of
        devices it describes, where "1 needs linking" is one glance away from
        which one. The four summary tiles took its place on the Dashboard.

        The status chips below filter this same list, so the counts and the
        filters now read as one control rather than two. %>
    <% var pct = function (n) { return stats.total ? (n / stats.total) * 100 : 0; }; %>
    <div class="w-card panel status-panel">
      <div class="panel-head"><h2>ReceipTap status</h2><span class="panel-total"><%= stats.total %> total</span></div>
      <!-- Same brand blue throughout, just varied in shade/opacity so the
           3 segments stay visually distinguishable. -->
      <div class="stackbar">
        <span style="width: <%= pct(stats.linked) %>%; background: var(--w-accent);"></span>
        <span style="width: <%= pct(stats.pairing) %>%; background: rgba(5,107,254,0.55);"></span>
        <span style="width: <%= pct(stats.needsLinking) %>%; background: rgba(5,107,254,0.22);"></span>
      </div>
      <div class="legend-row"><span class="legend-key"><span class="sw" style="background:var(--w-accent);"></span>Linked to a register</span><span><%= stats.linked %></span></div>
      <div class="legend-row"><span class="legend-key"><span class="sw" style="background:rgba(5,107,254,0.55);"></span>Pairing right now</span><span><%= stats.pairing %></span></div>
      <div class="legend-row"><span class="legend-key"><span class="sw" style="background:rgba(5,107,254,0.22);"></span>Needs linking</span><span><%= stats.needsLinking %></span></div>
      <% if (stats.total === 0) { %>
        <div class="status-note warn">No ReceipTaps activated yet.</div>
      <% } else if (stats.needsLinking > 0) { %>
        <div class="status-note warn"><%= stats.needsLinking %> <%= stats.needsLinking === 1 ? 'ReceipTap needs' : 'ReceipTaps need' %> linking to a register before receipts reach it.</div>
      <% } else { %>
        <div class="status-note">Everything is linked. Receipts are routed automatically.</div>
      <% } %>
    </div>

    <form class="w-card search-card" method="GET" action="/account/business/pucks">
      <div class="w-field"><input type="text" name="search" placeholder="Search by ID or claim code" value="<%= filters.search %>" /></div>
    </form>

    <div class="chips">
      <a class="chip <%= !filters.status ? 'active' : '' %>" href="/account/business/pucks?search=<%= encodeURIComponent(filters.search) %>">All</a>
      <a class="chip <%= filters.status === 'linked' ? 'active' : '' %>" href="/account/business/pucks?search=<%= encodeURIComponent(filters.search) %>&status=linked">Linked</a>
      <a class="chip <%= filters.status === 'pairing' ? 'active' : '' %>" href="/account/business/pucks?search=<%= encodeURIComponent(filters.search) %>&status=pairing">Pairing</a>
      <a class="chip <%= filters.status === 'needsLinking' ? 'active' : '' %>" href="/account/business/pucks?search=<%= encodeURIComponent(filters.search) %>&status=needsLinking">Needs linking</a>
    </div>

    <% if (pucks.length === 0) { %>
      <div class="w-card empty">No ReceipTaps match.</div>
    <% } else { %>
      <div class="w-card">
        <% pucks.forEach(function(p) { %>
          <div class="puck-row">
            <div class="puck-row-top">
              <div class="puck-id">ReceipTap <%= p.id.slice(0, 4).toUpperCase() %></div>
              <% if (p.linked) { %><span class="puck-badge linked">Linked</span>
              <% } else if (p.pairing) { %><span class="puck-badge pairing">Pairing…</span>
              <% } else { %><span class="puck-badge needs">Needs linking</span><% } %>
            </div>
            <div class="puck-meta">
              Location: <%= p.location %><br />
              Connected to: <%= p.connectedTo %><br />
              Added <%= p.claimedAt ? new Date(p.claimedAt).toLocaleDateString('en-US', { dateStyle: 'medium' }) : 'not yet activated' %>
            </div>
            <% if (p.linked) { %>
              <form method="POST" action="/account/business/pucks/<%= p.id %>/unassign">
                <button type="submit" class="unassign-btn">Unassign</button>
              </form>
            <% } %>
          </div>
        <% }); %>
      </div>
      <% if (totalPages > 1) { %>
        <div class="pager">
          <% if (page > 1) { %><a href="/account/business/pucks?page=<%= page - 1 %>&search=<%= encodeURIComponent(filters.search) %>&status=<%= filters.status %>">← Previous</a><% } else { %><span></span><% } %>
          <span>Page <%= page %> of <%= totalPages %></span>
          <% if (page < totalPages) { %><a href="/account/business/pucks?page=<%= page + 1 %>&search=<%= encodeURIComponent(filters.search) %>&status=<%= filters.status %>">Next →</a><% } else { %><span></span><% } %>
        </div>
      <% } %>
    <% } %>

    <% if (recentActivations.length > 0) { %>
      <div class="w-card recent-card">
        <div class="panel-head" style="margin-bottom:10px;"><h2 style="font-size:14px;margin:0;">Recently activated</h2></div>
        <% recentActivations.forEach(function(p) { %>
          <div class="recent-item"><span>ReceipTap <%= p.id.slice(0, 4).toUpperCase() %></span><span><%= p.when %></span></div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <%- include('partials/business-tab-bar', { active: 'pucks' }) %>
</body>
</html>
