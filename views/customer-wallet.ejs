<!-- views/customer-wallet.ejs -->
<!-- The customer's cross-merchant receipt wallet: monthly summary, category
     filter chips, account menu, and every saved receipt from every store --
     both real POS-tap transactions and receipts the customer scanned/
     uploaded themselves. -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= isFullWallet ? 'My Wallet' : 'Dashboard' %> - ReceipTap</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
  <%- include('partials/wallet-dark-theme') %>
  <style>
    .wallet-header { display: flex; align-items: flex-start; justify-content: space-between; }

    .summary-card {
      padding: 20px 22px; margin: 18px 0 10px; display: flex; align-items: center; justify-content: space-between;
      background: radial-gradient(120% 140% at 100% 0%, var(--w-accent-wash) 0%, var(--w-card) 60%);
      border-color: rgba(5,107,254,0.3);
    }
    .summary-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--w-ink-soft); }
    .summary-num { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-weight: 700; font-size: 26px; margin-top: 4px; }
    .summary-num.accent { color: var(--w-accent); }
    .summary-stat:last-child { text-align: right; }

    /* Colour, radius and weight all come from .w-btn. This only adds the
       breathing room either side -- 16px above so it clears the summary card,
       22px below so it doesn't crowd the receipts under it. */
    .rules-card { padding: 16px; margin-bottom: 16px; }
    .rules-card summary {
      display: flex; align-items: center; justify-content: space-between; gap: 10px;
      font-size: 13px; font-weight: 700; color: var(--w-ink); cursor: pointer; list-style: none;
    }
    .rules-card summary::-webkit-details-marker { display: none; }
    .rules-count { font-size: 11.5px; font-weight: 600; color: var(--w-ink-soft); }
    .rules-sub { font-size: 12.5px; color: var(--w-ink-soft); line-height: 1.5; margin: 12px 0 14px; }
    .rules-filter {
      display: block; text-align: center; margin-bottom: 14px; padding: 9px 12px;
      border-radius: 999px; border: 1px solid var(--w-line); background: var(--w-card-raised);
      color: var(--w-ink-soft); font-size: 12.5px; font-weight: 700; text-decoration: none;
    }
    .rules-filter.active { border-color: var(--w-accent); color: var(--w-accent); background: var(--w-accent-wash); }
    .rule-row {
      display: flex; align-items: center; gap: 10px; padding: 9px 0;
      border-bottom: 1px solid var(--w-line); font-size: 14px; cursor: pointer;
    }
    .rule-row:last-of-type { border-bottom: none; }
    .rule-row input { width: 18px; height: 18px; accent-color: var(--w-accent); flex: none; }
    .wallet-cta { margin: 8px 0 22px; border-radius: 14px; }
    .section-row { display: flex; align-items: center; justify-content: space-between; margin: 4px 0 12px; }
    .section-label { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--w-ink-soft); }
    .export-pill {
      display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 600;
      color: var(--w-ink); background: var(--w-card-raised); border: 1px solid var(--w-line);
      border-radius: 999px; padding: 7px 14px; text-decoration: none;
    }
    /* A plain link, not another .w-btn -- the CTA above the list already
       carries the primary "go to My Wallet" action, and a second full-width
       blue button right after five rows would out-compete it for attention. */
    .more-receipts {
      display: block; text-align: center; margin-top: -6px; padding: 12px;
      color: var(--w-accent); font-size: 13.5px; font-weight: 600; text-decoration: none;
    }

    .chips { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
    .chip {
      font-size: 12.5px; font-weight: 600; padding: 7px 14px; border-radius: 999px;
      text-decoration: none; border: 1px solid var(--w-line); color: var(--w-ink-soft);
      background: var(--w-card-raised);
    }
    .chip.active { background: var(--w-accent); border-color: var(--w-accent); color: #fff; }
    .chip-divider { width: 1px; align-self: stretch; background: var(--w-line); margin: 0 2px; }

    .day-heading {
      font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
      color: var(--w-ink-soft); padding: 14px 18px 6px;
    }
    .day-heading:first-child { padding-top: 0; }

    /* The divider moved to .receipt-line, which now wraps the link AND the
       deductible strip -- left on .receipt-row it drew a line between a
       receipt and its own toggle.

       display: block is not decorative -- receiptap.css has its OWN
       unrelated .receipt-line (the itemized rows on a receipt detail page,
       display: flex; justify-content: space-between) that loads before this
       block. Without overriding it here, this wrapper inherits that flex
       row and squeezes .receipt-row and .ded-strip into side-by-side
       columns instead of stacking them, cramming the total into half the
       width it needs. */
    .receipt-line { display: block; border-bottom: 1px solid var(--w-line); }
    .receipt-line:last-child { border-bottom: none; }
    .receipt-row {
      display: flex; justify-content: space-between; align-items: flex-start;
      padding: 16px 18px 10px; text-decoration: none; color: var(--w-ink);
    }
    /* Sits directly under the badges row -- category, warranty -- rather
       than in the row's corner, so it reads as "more about this purchase"
       the way the badges above it do, not as a second control competing
       with the total. */
    .ded-strip { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 10px; padding: 0 18px 14px; }
    .ded-toggle {
      display: inline-flex; align-items: center; gap: 7px;
      font-size: 11.5px; font-weight: 700; font-family: inherit; cursor: pointer;
      padding: 5px 11px; border-radius: 999px;
      border: 1px solid var(--w-line); background: var(--w-card-raised); color: var(--w-ink-soft);
    }
    .ded-toggle .ded-dot {
      /* Hollow, not filled -- a filled dot in a muted colour still reads as
         "on" at a glance. Off has to look visibly empty next to on's solid
         accent-filled dot below. */
      width: 8px; height: 8px; border-radius: 50%;
      background: transparent; border: 1px solid var(--w-ink-soft);
    }
    .ded-toggle.on { border-color: var(--w-ok); color: var(--w-ok); background: var(--w-ok-wash); }
    .ded-toggle.on .ded-dot { background: var(--w-ok); border-color: var(--w-ok); }
    .ded-toggle[disabled] { opacity: 0.5; cursor: default; }
    .ded-note { font-size: 11px; color: var(--w-ink-soft); }
    .receipt-row:hover { background: var(--w-card-raised); }
    .merchant-name { font-weight: 600; font-size: 15px; }
    .receipt-date { font-size: 12.5px; color: var(--w-ink-soft); margin-top: 2px; }
    .receipt-total {
      font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-weight: 700; font-size: 15.5px;
      border-top: none; margin-top: 0; padding-top: 0; color: var(--w-ink);
      /* .receipt-row is align-items: flex-start so the left column (name,
         date, badges) stacks from the top -- align-self overrides just the
         total to center against the row's full height instead of pinning
         to the top alongside the merchant name. */
      align-self: center;
    }
    .badges { display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap; }
    .badge { font-size: 11px; font-weight: 600; padding: 3px 9px; border-radius: 999px; }
    .badge-category { background: var(--w-accent-wash); color: var(--w-accent); }
    .badge-tax { background: rgba(5,107,254,0.15); color: var(--w-accent); }
    .badge-scanned { background: var(--w-card-raised); color: var(--w-ink-soft); border: 1px solid var(--w-line); }
    /* Neutral, like badge-scanned -- a payment method is a fact about the
       receipt, not a status worth calling out in colour the way the category
       or warranty badges are. */
    .badge-payment {
      background: var(--w-card-raised); color: var(--w-ink-soft); border: 1px solid var(--w-line);
      font-family: var(--font-mono); font-variant-numeric: tabular-nums;
    }
    /* Green, same token as the marked-deductible toggle -- a receipt still
       under warranty is a similarly unambiguous "good news, covered" fact. */
    .badge-warranty { background: var(--w-ok-wash); color: var(--w-ok); }

    .warranty-badge {
      font-family: inherit; font-size: 11px; font-weight: 600; padding: 3px 9px; border-radius: 999px;
      border: 1px solid var(--w-line); background: var(--w-card-raised); color: var(--w-ink-soft); cursor: pointer;
    }
    .warranty-edit {
      display: none; align-items: center; gap: 6px;
    }
    .warranty-edit.open { display: flex; }
    .warranty-edit input {
      width: 56px; font-family: inherit; font-size: 12.5px; padding: 4px 7px;
      border-radius: 8px; border: 1px solid var(--w-line); background: var(--w-bg); color: var(--w-ink);
    }
    .warranty-edit button {
      font-family: inherit; font-size: 11px; font-weight: 700; padding: 4px 9px; border-radius: 999px;
      border: 1px solid var(--w-line); background: var(--w-card-raised); color: var(--w-ink-soft); cursor: pointer;
    }
    .warranty-edit button[type="submit"] { border-color: var(--w-accent); color: var(--w-accent); }
    .warranty-edit-hint { font-size: 10.5px; color: var(--w-ink-soft); }

    .search-card { padding: 16px; margin-bottom: 16px; }
    .search-row { display: flex; gap: 10px; }
    .search-row .w-field { flex: 1; margin-bottom: 0; }
    .search-card summary { font-size: 13px; font-weight: 600; color: var(--w-ink-soft); cursor: pointer; list-style: none; }
    .search-card details[open] summary { margin-bottom: 14px; }
    .clear-search { text-align: center; font-size: 12.5px; margin-top: 10px; }
    .clear-search a { color: var(--w-ink-soft); }

    .empty-state {
      text-align: center; padding: 48px 20px; background: var(--w-card); border: 1px solid var(--w-line);
      color: var(--w-ink-soft);
    }
    .empty-icon {
      width: 64px; height: 64px; border-radius: 16px; background: var(--w-card-raised);
      display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;
    }
    .empty-title { font-size: 18px; font-weight: 700; margin-bottom: 6px; color: var(--w-ink); }
    .empty-sub { font-size: 13.5px; color: var(--w-ink-soft); line-height: 1.5; max-width: 300px; margin: 0 auto 22px; }

    .fab {
      /* Clears the tab bar, which is now taller by the home-indicator inset. */
      /* Sits just above the 75px tab bar. */
      position: fixed; right: 20px; bottom: 95px;
      width: 52px; height: 52px; border-radius: 50%;
      background: var(--w-accent); color: #fff; display: flex; align-items: center; justify-content: center;
      text-decoration: none; box-shadow: 0 6px 20px rgba(5,107,254,0.4); font-size: 24px; font-weight: 300;
    }
    /* ---- Setup progress (mirrors views/business-overview.ejs) ---------- */
    .setup-card { padding: 18px; margin-bottom: 18px; }
    .setup-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
    .setup-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--w-accent); }
    .setup-pct { font-size: 13px; font-weight: 700; color: var(--w-ink-soft); }
    .setup-bar { height: 6px; border-radius: 999px; background: var(--w-card-raised); overflow: hidden; margin-bottom: 16px; }
    .setup-bar-fill { height: 100%; background: var(--w-accent); border-radius: 999px; }
    .setup-row { display: flex; align-items: flex-start; gap: 12px; padding: 9px 0; text-decoration: none; }
    .setup-check {
      width: 22px; height: 22px; border-radius: 50%; flex-shrink: 0; margin-top: 1px;
      display: flex; align-items: center; justify-content: center; border: 1.5px solid var(--w-line);
    }
    .setup-check svg { width: 12px; height: 12px; }
    .setup-row.done .setup-check { background: rgba(5,107,254,0.15); border-color: transparent; color: var(--w-accent); }
    .setup-row-body { flex: 1; min-width: 0; }
    .setup-row-title { font-size: 13.5px; font-weight: 700; color: var(--w-ink); }
    .setup-row.done .setup-row-title { color: var(--w-ink-soft); text-decoration: line-through; }
    .setup-row-sub { font-size: 12px; color: var(--w-ink-soft); margin-top: 2px; line-height: 1.4; }
    .setup-row-chevron { color: var(--w-ink-soft); flex-shrink: 0; margin-top: 3px; }
    .badge-auto { background: rgba(5,107,254,0.14); color: var(--w-accent); }
    /* --- Account menu (the "J" circle) --- */
    .acct-wrap { position: relative; }
    .acct-menu {
      display: none; position: absolute; right: 0; top: calc(100% + 8px); z-index: 90;
      width: 254px; background: var(--w-card); border: 1px solid var(--w-line); border-radius: 14px;
      box-shadow: 0 14px 40px rgba(0,0,0,0.55); overflow: hidden; text-align: left;
    }
    .acct-menu.open { display: block; }
    /* Catches taps anywhere else so the menu closes, without needing a
       document-wide click handler that fights the button's own onclick. */
    .acct-backdrop { display: none; position: fixed; inset: 0; z-index: 80; }
    .acct-backdrop.open { display: block; }
    .acct-email {
      padding: 12px 14px; font-size: 12px; color: var(--w-ink-soft);
      border-bottom: 1px solid var(--w-line); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .acct-toggle { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-bottom: 1px solid var(--w-line); }
    .acct-toggle-text { flex: 1; min-width: 0; }
    .acct-toggle-title { font-size: 13.5px; font-weight: 700; color: var(--w-ink); }
    .acct-toggle-sub { font-size: 11.5px; color: var(--w-ink-soft); margin-top: 2px; line-height: 1.4; }
    .acct-item {
      display: flex; align-items: center; gap: 10px; width: 100%; box-sizing: border-box;
      padding: 12px 14px; font-size: 13.5px; font-weight: 600; color: var(--w-ink);
      text-decoration: none; background: none; border: none; cursor: pointer; font-family: inherit;
      border-bottom: 1px solid var(--w-line);
    }
    .acct-item:last-child { border-bottom: none; }
    .acct-item svg { color: var(--w-ink-soft); flex: none; }
    .acct-item.danger { color: var(--w-danger); }
    .acct-item.danger svg { color: var(--w-danger); }
    .sw { position: relative; flex: none; width: 40px; height: 24px; }
    .sw input {
      appearance: none; -webkit-appearance: none; margin: 0; cursor: pointer;
      width: 40px; height: 24px; border-radius: 999px; background: #3a3a3a; border: none; transition: background 0.18s ease;
    }
    .sw input:checked { background: var(--w-accent); }
    .sw input:disabled { opacity: 0.45; cursor: default; }
    .sw input::after {
      content: ''; position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%;
      background: #fff; transition: transform 0.18s ease;
    }
    .sw input:checked::after { transform: translateX(16px); }
  </style>
</head>
<body>
  <div class="w-shell">
    <div class="wallet-header">
      <div>
        <div class="w-eyebrow">ReceipTap</div>
        <h1 class="w-title"><%= isFullWallet ? 'My Wallet' : 'Dashboard' %></h1>
      </div>
      <%# Was a plain link to Settings. It's a menu now, because turning phone
          notifications back OFF had nowhere to live -- every surface could
          switch them on and none could switch them off. %>
      <div class="acct-wrap">
        <button type="button" class="w-btn-icon" id="acct-btn" onclick="toggleAccountMenu()"
                aria-haspopup="true" aria-expanded="false" aria-label="Account menu"
                style="text-transform:uppercase; cursor:pointer;">
          <%= (customerEmail || '?').charAt(0) %>
        </button>

        <div class="acct-menu" id="acct-menu" role="menu">
          <div class="acct-email"><%= customerEmail %></div>

          <div class="acct-toggle" id="push-row">
            <div class="acct-toggle-text">
              <div class="acct-toggle-title">Phone notifications</div>
              <div class="acct-toggle-sub" id="push-sub">Alerts on this device</div>
            </div>
            <span class="sw"><input type="checkbox" id="push-switch" onchange="onPushToggle(this)" /></span>
          </div>

          <a class="acct-item" href="/account/notifications" role="menuitem">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
            Alerts
          </a>
          <%# Under Alerts, as the menu reads top to bottom: the two places a
              customer goes to look at something, before the two that change
              things (Settings, Log out). The wallet is where this menu lives
              today, so from here it's a link to the current page -- it earns
              its keep the moment this menu appears on Alerts or Settings too. %>
          <a class="acct-item" href="/account/wallet" role="menuitem">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7a2 2 0 0 1 2-2h13a1 1 0 0 1 1 1v2"/><path d="M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-3"/><path d="M21 11h-5a2 2 0 0 0 0 4h5v-4Z"/></svg>
            My Wallet
          </a>
          <a class="acct-item" href="/account/settings" role="menuitem">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"/></svg>
            Settings
          </a>

          <form method="POST" action="/account/logout" style="margin:0;">
            <button type="submit" class="acct-item danger" role="menuitem">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
              Log out
            </button>
          </form>
        </div>
      </div>
      <div class="acct-backdrop" id="acct-backdrop" onclick="closeAccountMenu()"></div>
    </div>

    <% if (!isFullWallet) { %>
    <div class="w-card summary-card">
      <div class="summary-stat">
        <div class="summary-eyebrow">This month</div>
        <div class="summary-num">$<%= summary.monthTotal %></div>
      </div>
      <div class="summary-stat">
        <div class="summary-eyebrow">Receipts</div>
        <div class="summary-num accent"><%= summary.receiptCount %></div>
      </div>
    </div>

    <%# The way into the full history, directly under the month summary: the
        two things a customer wants off this page are "what did I spend" and
        "show me everything". Built on .w-btn rather than a hand-rolled colour,
        so it can't drift from the brand blue every other primary button uses. %>
    <a class="w-btn wallet-cta" href="/account/wallet">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M3 7a2 2 0 0 1 2-2h13a1 1 0 0 1 1 1v2"/><path d="M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-3"/><path d="M21 11h-5a2 2 0 0 0 0 4h5v-4Z"/></svg>
      My Wallet
    </a>

    <% } %>

    <%# Search, category chips and the tax filter belong to the full wallet.
        The home page is a summary -- a search box over five rows is noise, and
        the wallet page is one tap away. %>
    <% if (isFullWallet) { %>
    <% if (categories.length > 0) { %>
      <%# Time only. Category and tax filters moved to the panels below -- as
          one row these were three different questions ("what kind", "is it
          claimable", "when") wearing the same control, and the row grew by one
          chip for every category a customer ever shopped in. %>
      <div class="chips">
        <% var range = filters.from + '|' + filters.to; %>
        <a class="chip <%= !filters.from && !filters.to ? 'active' : '' %>"
           href="/account/wallet<%= filters.category ? '?category=' + encodeURIComponent(filters.category) : '' %>">All</a>
        <% [
             { key: 'today',     label: 'Today'      },
             { key: 'thisWeek',  label: 'This week'  },
             { key: 'thisMonth', label: 'This month' },
           ].forEach(function (q) { var r = quickFilters[q.key]; %>
          <a class="chip <%= range === r.from + '|' + r.to ? 'active' : '' %>"
             href="/account/wallet?from=<%= r.from %>&to=<%= r.to %><%= filters.category ? '&category=' + encodeURIComponent(filters.category) : '' %>"><%= q.label %></a>
        <% }); %>
      </div>
    <% } %>

    <form class="w-card search-card" method="GET" action="/account/wallet">
      <details <%= (filters.search || filters.from || filters.to || filters.category) ? 'open' : '' %>>
        <summary>Search by store, category or date</summary>
        <div class="w-field">
          <label>Business name</label>
          <input type="text" name="search" placeholder="e.g. Tip Top Tint" value="<%= filters.search %>" />
        </div>
        <%# Category was a chip per category, which meant the filter row grew
            without limit as a customer shopped in more places. A select holds
            any number of them in fixed space, and only offers categories this
            customer actually has receipts in. %>
        <% if (categories.length > 0) { %>
          <div class="w-field">
            <label for="category-filter">Category</label>
            <select id="category-filter" name="category">
              <option value="">All categories</option>
              <% categories.forEach(function (cat) { %>
                <option value="<%= cat %>" <%= filters.category === cat ? 'selected' : '' %>><%= cat %></option>
              <% }); %>
            </select>
          </div>
        <% } %>
        <div class="search-row">
          <div class="w-field">
            <label>From</label>
            <input type="date" name="from" value="<%= filters.from %>" />
          </div>
          <div class="w-field">
            <label>To</label>
            <input type="date" name="to" value="<%= filters.to %>" />
          </div>
        </div>
        <button class="w-btn" type="submit" style="margin-top: 12px;">Search</button>
        <% if (filters.search || filters.from || filters.to || filters.category) { %>
          <div class="clear-search"><a href="/account/wallet">Clear search</a></div>
        <% } %>
      </details>
    </form>

    <%# Which categories count as deductible is the customer's call, not the
        model's: it turns on who is filing and what the purchase was for,
        neither of which is on the receipt. The model categorises; this decides
        what those categories mean for THIS person. A single receipt can still
        disagree via its own toggle -- a category rule can't tell a laptop from
        a birthday gift bought at the same shop. %>
    <details class="w-card rules-card" id="deductible-rules" <%= (rulesSaved || filters.deductible) ? 'open' : '' %>>
      <summary>
        Tax deductible categories
        <span class="rules-count">
          <%= deductibleCategories.length ? deductibleCategories.length + ' selected' : 'none yet' %>
        </span>
      </summary>
      <% if (rulesSaved) { %><div class="banner success" style="margin:12px 0 0;">Saved.</div><% } %>
      <p class="rules-sub">
        Pick the categories you can claim. Receipts in them are marked deductible
        automatically. Nothing here is tax advice — what you can actually claim
        depends on your situation and where you file.
      </p>
      <%# The "show me only those" filter lives here rather than up in the time
          chips: it's the same subject as the checkboxes under it, and this is
          the two-tap path to a tax export -- filter, then Export. %>
      <a class="rules-filter <%= filters.deductible ? 'active' : '' %>"
         href="/account/wallet<%= filters.deductible ? '' : '?deductible=1' %>">
        <%= filters.deductible ? 'Showing deductible only — show everything' : 'Show only deductible receipts' %>
      </a>
      <form method="POST" action="/account/receipts/deductible-categories">
        <% allCategories.forEach(function (cat) { %>
          <label class="rule-row">
            <input type="checkbox" name="categories" value="<%= cat %>"
                   <%= deductibleCategories.indexOf(cat) !== -1 ? 'checked' : '' %> />
            <span><%= cat %></span>
          </label>
        <% }); %>
        <button type="submit" class="w-btn" style="margin-top:14px;">Save categories</button>
      </form>
    </details>
    <% } %>

    <% if (receipts.length === 0 && (filters.search || filters.from || filters.to || filters.category)) { %>
      <div class="w-card empty-state">
        <div class="empty-title">No receipts match</div>
        <div class="empty-sub">Try a different filter, store name, or date range.</div>
      </div>
    <% } else if (receipts.length === 0 && !isFullWallet && totalReceiptCount > 0) { %>
      <%# Not the same as "no receipts yet" -- this customer has a history,
          just nothing THIS month. "Add first receipt" would be wrong advice
          to give someone who's already added several. %>
      <div class="w-card empty-state">
        <div class="empty-title">No receipts this month</div>
        <div class="empty-sub">Your past receipts are still in your wallet.</div>
        <a href="/account/wallet" class="w-btn" style="width:auto; padding:12px 24px;">View My Wallet</a>
      </div>
    <% } else if (receipts.length === 0) { %>
      <div class="w-card empty-state">
        <div class="empty-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#8d8d8d" stroke-width="1.8"><path d="M6 2h12v20l-3-2-3 2-3-2-3 2Z"/><path d="M9 8h6M9 12h6"/></svg>
        </div>
        <div class="empty-title">No receipts yet</div>
        <div class="empty-sub">Tap a ReceipTap puck at checkout, or scan a paper receipt, to start building your history.</div>
        <a href="/account/receipts/scan" class="w-btn" style="width:auto; padding:12px 24px;">+ Add first receipt</a>
      </div>
    <% } else { %>
      <div class="section-row">
        <div class="section-label"><%= isFullWallet ? 'All receipts' : 'Recent receipts' %></div>
        <%# Export belongs with the full list: on the home page it would offer
            to export five rows while the filters that shape it live elsewhere. %>
        <% if (isFullWallet) { %>
        <a class="export-pill" href="/account/receipts/export?search=<%= encodeURIComponent(filters.search) %>&from=<%= encodeURIComponent(filters.from) %>&to=<%= encodeURIComponent(filters.to) %>&category=<%= encodeURIComponent(filters.category) %>&deductible=<%= filters.deductible ? '1' : '' %>">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12M7 10l5 5 5-5M4 21h16"/></svg>
          Export<%= filters.deductible ? ' tax receipts' : (filters.search || filters.from || filters.to || filters.category) ? ' (filtered)' : '' %>
        </a>
        <% } %>
      </div>

      <%- include('partials/receipt-list', { receipts: receipts }) %>

      <%# A second way to "My Wallet" -- the CTA card above the summary makes
          the same trip, but sits above the list rather than after it, where
          someone who scrolled through what's shown and wants more expects a
          next step. Same condition as that card's own "all N" badge: only
          shown when there's actually somewhere further to go. %>
      <% if (!isFullWallet && totalReceiptCount > receiptsShown) { %>
        <a class="more-receipts" href="/account/wallet">See all <%= totalReceiptCount %> receipts</a>
      <% } %>
    <% } %>

      <%# Setup progress sits BELOW the receipts, not above them. A checklist
          at 100% was the first thing between a customer and the receipts they
          opened the app for. Still on the home page only -- the wallet is the
          full history and nothing else. %>
      <% if (!isFullWallet) { %>
      <div class="w-card setup-card">
        <div class="setup-head">
          <div class="setup-eyebrow">Setup progress</div>
          <div class="setup-pct"><%= setup.percent %>%</div>
        </div>
        <div class="setup-bar"><div class="setup-bar-fill" style="width: <%= setup.percent %>%;"></div></div>

        <a class="setup-row <%= setup.walletCreated ? 'done' : '' %>" href="/account/settings">
          <% if (setup.walletCreated) { %><div class="setup-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div><% } else { %><div class="setup-check"></div><% } %>
          <div class="setup-row-body">
            <div class="setup-row-title">Create your wallet</div>
            <div class="setup-row-sub"><%= setup.walletCreated ? "View your account details." : "View your account details." %></div>
          </div>
          <div class="setup-row-chevron"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></div>
        </a>
        <a class="setup-row <%= setup.canSignInAnywhere ? 'done' : '' %>" href="/account/settings">
          <% if (setup.canSignInAnywhere) { %><div class="setup-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div><% } else { %><div class="setup-check"></div><% } %>
          <div class="setup-row-body">
            <div class="setup-row-title">Set a password</div>
            <div class="setup-row-sub"><%= setup.canSignInAnywhere ? "You can sign in from any device." : "So you can sign in on any device, not just this one." %></div>
          </div>
          <div class="setup-row-chevron"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></div>
        </a>
        <%# One step, not two: tapping a ReceipTap and scanning a paper receipt
            are different routes to the same milestone -- a receipt in the wallet.
            Links at the scan page when it's still to do, since that screen offers
            both the camera and a file upload. %>
        <a class="setup-row <%= setup.firstReceipt ? 'done' : '' %>" href="<%= setup.firstReceipt ? '/account/receipts' : '/account/receipts/scan' %>">
          <% if (setup.firstReceipt) { %><div class="setup-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div><% } else { %><div class="setup-check"></div><% } %>
          <div class="setup-row-body">
            <div class="setup-row-title">Scan, save or upload your first receipt</div>
            <div class="setup-row-sub"><%= setup.firstReceipt ? "Your receipts are all in one place." : "Tap a ReceipTap at checkout, or snap a paper receipt yourself." %></div>
          </div>
          <div class="setup-row-chevron"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></div>
        </a>
        <a class="setup-row <%= setup.homeScreenAdded ? 'done' : '' %>" href="/account/install">
          <% if (setup.homeScreenAdded) { %><div class="setup-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div><% } else { %><div class="setup-check"></div><% } %>
          <div class="setup-row-body">
            <div class="setup-row-title">Add ReceipTap to your home screen</div>
            <div class="setup-row-sub"><%= setup.homeScreenAdded ? "One tap to your receipts, and alerts on your phone." : "Open it like an app, and get alerts on your phone." %></div>
          </div>
          <div class="setup-row-chevron"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></div>
        </a>
        <a class="setup-row <%= setup.partnerProgram ? 'done' : '' %>" href="/partner-program">
          <% if (setup.partnerProgram) { %><div class="setup-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div><% } else { %><div class="setup-check"></div><% } %>
          <div class="setup-row-body">
            <div class="setup-row-title">Join our Partner Program</div>
            <div class="setup-row-sub"><%= setup.partnerProgram ? "You're a ReceipTap partner — earn " + affiliateRate + "% for as long as they stay." : "Earn " + affiliateRate + "% recurring commission on every business you refer. Free to join." %></div>
          </div>
          <div class="setup-row-chevron"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></div>
        </a>
      </div>
      <% } %>
  </div>

  <a href="/account/receipts/scan" class="fab" aria-label="Scan a receipt">+</a>

  <%- include('partials/wallet-tab-bar', { activeTab: 'receipts' }) %>
  <%- include('partials/image-viewer') %>
  <%- include('partials/push-controls') %>
  <script>
    // Marking receipts before a tax export means working down the list, so
    // this posts in place rather than reloading the page each time. The button
    // is disabled while in flight so a double-tap can't send two opposite
    // writes and land on whichever reply arrives last.
    async function toggleDeductible(btn) {
      if (btn.disabled) return;
      var next = btn.getAttribute('aria-pressed') !== 'true';
      btn.disabled = true;
      try {
        var res = await fetch(
          '/account/receipts/' + btn.dataset.kind + '/' + btn.dataset.id + '/deductible',
          {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ deductible: next }),
          }
        );
        if (!res.ok) throw new Error('save failed');
        var data = await res.json();
        btn.setAttribute('aria-pressed', data.deductible ? 'true' : 'false');
        btn.classList.toggle('on', Boolean(data.deductible));
        var note = btn.parentElement.querySelector('.ded-note');
        // Say who decided, so a row the customer has ruled on is
        // distinguishable from one still carrying the AI's guess.
        if (note) {
          note.textContent =
            data.source === 'receipt' ? 'you marked this'
            : data.source === 'category' ? (data.category || 'category') + ' is deductible'
            : '';
        }
      } catch (err) {
        // Leave the button showing what the server still believes rather than
        // a state that was never saved, and say so in place -- a modal dialog
        // would block the page mid-list for a recoverable failure.
        var failNote = btn.parentElement.querySelector('.ded-note');
        if (failNote) failNote.textContent = "couldn't save — tap to retry";
      } finally {
        btn.disabled = false;
      }
    }

    // Swaps the badge for its sibling .warranty-edit form -- see the comment
    // in views/partials/receipt-list.ejs on why this is two elements
    // (button + form) rather than one, an <input> injected into the badge.
    function openWarrantyEdit(btn) {
      btn.style.display = 'none';
      var form = btn.nextElementSibling;
      form.classList.add('open');
      form.querySelector('input').focus();
    }

    function closeWarrantyEdit(cancelBtn) {
      var form = cancelBtn.closest('.warranty-edit');
      form.classList.remove('open');
      form.previousElementSibling.style.display = '';
    }

    // Mirrors warrantyBadgeText() in routes/customer-account.js in miniature
    // -- just enough to redraw the badge from the save response without a
    // page reload, same as toggleDeductible's note-text logic above.
    function warrantyBadgeLabel(warrantyExpiresAt, months) {
      if (warrantyExpiresAt) {
        var expiry = new Date(warrantyExpiresAt);
        if (expiry > new Date()) {
          return 'Warranty until ' + expiry.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
        }
        return 'Warranty expired';
      }
      return months === 0 ? 'No warranty' : 'Add warranty';
    }

    async function saveWarranty(event, form) {
      event.preventDefault();
      var input = form.querySelector('input[name="months"]');
      var badge = form.previousElementSibling;
      var submitBtn = form.querySelector('button[type="submit"]');
      submitBtn.disabled = true;
      try {
        var res = await fetch(
          '/account/receipts/' + form.dataset.kind + '/' + form.dataset.id + '/warranty',
          {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ months: input.value === '' ? 'clear' : input.value }),
          }
        );
        if (!res.ok) throw new Error('save failed');
        var data = await res.json();
        badge.textContent = warrantyBadgeLabel(data.warrantyExpiresAt, data.warrantyMonths);
        input.value = data.warrantyMonths === null ? '' : data.warrantyMonths;
        form.classList.remove('open');
        badge.style.display = '';
      } catch (err) {
        // Leave the form open showing what was actually typed rather than a
        // state that was never saved -- same recover-in-place reasoning as
        // toggleDeductible above, no modal.
        var hint = form.querySelector('.warranty-edit-hint');
        if (hint) hint.textContent = "couldn't save — try again";
      } finally {
        submitBtn.disabled = false;
      }
      return false;
    }

    var acctMenu = document.getElementById('acct-menu');
    var acctBackdrop = document.getElementById('acct-backdrop');
    var acctBtn = document.getElementById('acct-btn');
    var pushSwitch = document.getElementById('push-switch');
    var pushSub = document.getElementById('push-sub');

    function toggleAccountMenu() {
      acctMenu.classList.contains('open') ? closeAccountMenu() : openAccountMenu();
    }
    function openAccountMenu() {
      acctMenu.classList.add('open');
      acctBackdrop.classList.add('open');
      acctBtn.setAttribute('aria-expanded', 'true');
      refreshPushSwitch();
    }
    function closeAccountMenu() {
      acctMenu.classList.remove('open');
      acctBackdrop.classList.remove('open');
      acctBtn.setAttribute('aria-expanded', 'false');
    }
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeAccountMenu(); });

    // Read the real state every time the menu opens rather than trusting a
    // value rendered at page load -- they may have turned notifications off in
    // Safari's own settings since, and a switch that lies is worse than none.
    async function refreshPushSwitch() {
      if (!ReceipTapPush.configured || !ReceipTapPush.supported) {
        pushSwitch.disabled = true;
        pushSub.textContent = "This browser can't show notifications.";
        return;
      }
      if (ReceipTapPush.permission() === 'denied') {
        pushSwitch.disabled = true;
        pushSwitch.checked = false;
        pushSub.textContent = 'Blocked in your browser settings.';
        return;
      }
      pushSwitch.disabled = false;
      var on = await ReceipTapPush.isOn();
      pushSwitch.checked = on;
      pushSub.textContent = on ? 'On for this device' : 'Off — turn on to get alerts here';
    }

    async function onPushToggle(input) {
      input.disabled = true;
      pushSub.textContent = input.checked ? 'Turning on…' : 'Turning off…';
      try {
        var result = input.checked ? await ReceipTapPush.enable() : await ReceipTapPush.disable();
        if (!result.ok) {
          input.checked = false;
          pushSub.textContent = result.reason;
          input.disabled = ReceipTapPush.permission() === 'denied';
          return;
        }
      } catch (err) {
        input.checked = !input.checked;
        pushSub.textContent = "That didn't work — " + err.message;
      }
      input.disabled = false;
      await refreshPushSwitch();
    }
  </script>
</body>
</html>
