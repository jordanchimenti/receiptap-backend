<!-- views/landing.ejs — public marketing landing page at / -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ReceipTap — Tap-to-receive digital receipts for your store</title>
  <meta name="description" content="Replace paper receipts with a tap. Customers get their receipt on their phone; you get their email, a Google review funnel, and repeat-customer analytics. Works with Square, with more POS integrations on the way." />
  <meta property="og:title" content="ReceipTap — Tap-to-receive digital receipts for your store" />
  <meta property="og:description" content="The receipt goes to their phone. The relationship goes to you. Email capture, a Google review funnel, and repeat-customer analytics from sales you're already making." />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="/images/receiptap-logo.png" />
  <link rel="stylesheet" href="/css/receiptap.css" />
  <style>
    /* receiptap.css sets html/body height:100% for the dashboard's sidebar layout --
       that caps body at viewport height on this page too, which breaks position:sticky
       for anything that scrolls past it (its containing block never grows). */
    body { height: auto; min-height: 100%; }

    .nav {
      display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 18px 6vw;
      position: sticky; top: 0; z-index: 50; background: var(--paper);
      border-bottom: 1px solid transparent; transition: box-shadow 0.2s ease, border-color 0.2s ease, background 0.2s ease;
    }
    .nav.scrolled { border-bottom-color: var(--line); background: rgba(250,248,243,0.94); backdrop-filter: blur(6px); }
    /* Logo is a wide ~5:1 horizontal lockup -- 80px tall would render it
       ~400px wide, dwarfing the nav links next to it. */
    .nav img { height: 34px; }
    .nav-links { display: flex; align-items: center; gap: 18px; }
    .nav-links a { font-size: 14px; font-weight: 500; text-decoration: none; color: var(--ink-soft); }
    .nav-cta { background: var(--teal); color: #fff !important; padding: 9px 16px; border-radius: 8px; font-weight: 600; }

    /* ---------- Hero: dark, full-bleed, floating product card ---------- */
    .hero-dark {
      background: #14131F;
      background-image: radial-gradient(circle, rgba(255,255,255,0.07) 1px, transparent 1.4px);
      background-size: 24px 24px;
      position: relative; overflow: hidden;
    }
    .hero-inner {
      display: flex; align-items: center; gap: 6vw; padding: 9vh 6vw 11vh;
      max-width: 1200px; margin: 0 auto; position: relative; z-index: 1;
    }
    .hero-copy { flex: 1.1; }
    .hero-visual { flex: 1; display: flex; justify-content: center; }
    .hero-dark h1 {
      font-size: clamp(32px, 4.6vw, 56px); line-height: 1.06; letter-spacing: -0.02em;
      margin-bottom: 20px; color: var(--paper);
    }
    .hero-dark h1 em { font-style: normal; color: var(--teal); }
    .hero-dark .hero-sub {
      font-size: 17px; color: rgba(250,248,243,0.72); line-height: 1.6; max-width: 460px; margin-bottom: 30px;
    }
    .cta-main {
      display: inline-block; background: var(--teal); color: #fff; font-size: 16px; font-weight: 700;
      padding: 15px 28px; border-radius: 10px; text-decoration: none; text-align: center;
    }
    .cta-main:hover { background: var(--teal-deep); }
    .cta-fine-dark { font-size: 12.5px; color: rgba(250,248,243,0.5); margin-top: 12px; }

    /* Real receipt demo: the puck stays as the signature brand motif, the
       phone below it auto-scrolls through the actual receipt.ejs page --
       not a mockup, a live iframe of the real product. */
    .receipt-demo { display: flex; flex-direction: column; align-items: center; }
    .puck {
      width: 64px; height: 64px; margin: 0 auto; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      border: 3px solid var(--teal); position: relative; z-index: 2;
    }
    .puck::after {
      content: '⌁'; color: var(--teal); font-size: 22px;
      position: relative; z-index: 1;
    }
    .puck::before {
      content: ''; position: absolute; top: -3px; left: -3px; right: -3px; bottom: -3px;
      border: 3px solid var(--teal); border-radius: 50%;
      animation: pulse-ring 1.8s ease-out infinite;
    }
    @keyframes pulse-ring {
      0% { transform: scale(0.6); opacity: 1; }
      80%, 100% { transform: scale(1.8); opacity: 0; }
    }
    @media (prefers-reduced-motion: reduce) {
      .puck::before { animation: none; opacity: 0; }
    }

    /* ---------- Trust strip ---------- */
    .trust-strip { padding: 20px 6vw; border-bottom: 1px solid var(--line); }
    .trust-inner {
      max-width: 1000px; margin: 0 auto; display: flex; flex-wrap: wrap; justify-content: center;
      gap: 10px 30px; font-size: 13px; font-weight: 500; color: var(--ink-soft);
    }
    .trust-inner span::before { content: '✓ '; color: var(--teal); font-weight: 700; }

    .section { padding: 88px 6vw; max-width: 1100px; margin: 0 auto; }
    .section-eyebrow { font-size: 12px; font-weight: 700; color: var(--teal-deep); text-transform: uppercase; letter-spacing: 0.07em; margin-bottom: 8px; }
    .section h2 { font-size: clamp(24px, 3vw, 34px); letter-spacing: -0.015em; margin-bottom: 14px; }
    .section-lead { font-size: 15.5px; color: var(--ink-soft); line-height: 1.6; max-width: 560px; }

    /* ---------- Problem: editorial rows, not boxed cards ---------- */
    .problem-rows { margin-top: 40px; }
    .problem-row {
      display: flex; align-items: center; gap: 44px; padding: 34px 0;
      border-top: 1px solid var(--line);
    }
    .problem-row:last-child { border-bottom: 1px solid var(--line); }
    .problem-row .p-num {
      font-family: var(--font-display); font-size: clamp(46px, 6.4vw, 80px); font-weight: 700;
      color: var(--teal); line-height: 1; flex: 0 0 auto; min-width: 150px;
    }
    .problem-row h3 { font-size: 18px; margin: 0 0 6px; }
    .problem-row p { font-size: 14px; color: var(--ink-soft); line-height: 1.6; max-width: 520px; margin: 0; }

    /* ---------- How it works: horizontal timeline ---------- */
    .how-band { background: var(--paper-raised); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .timeline { display: flex; gap: 28px; margin-top: 48px; position: relative; }
    .timeline::before { content: ''; position: absolute; left: 0; right: 0; top: 20px; height: 2px; background: var(--line); }
    .tl-step { flex: 1; position: relative; }
    .tl-num {
      width: 40px; height: 40px; border-radius: 50%; background: var(--teal); color: #fff;
      display: flex; align-items: center; justify-content: center; font-weight: 700;
      font-family: var(--font-display); margin-bottom: 20px; box-shadow: 0 0 0 6px var(--paper-raised);
      position: relative; z-index: 1;
    }
    .tl-step h3 { font-size: 16.5px; margin-bottom: 8px; }
    .tl-step p { font-size: 13.5px; color: var(--ink-soft); line-height: 1.6; margin: 0; }

    /* ---------- Hero phone showcase (auto-scrolling receipt demo) ---------- */
    .phone-frame {
      width: 300px; margin: -6px auto 0; background: #2B2A27; border-radius: 40px;
      padding: 14px; box-shadow: 0 30px 70px -18px rgba(0,0,0,0.6); position: relative;
      border: 1px solid rgba(255,255,255,0.1);
    }
    .phone-notch {
      position: absolute; top: 14px; left: 50%; transform: translateX(-50%);
      width: 90px; height: 18px; background: #2B2A27; border-radius: 0 0 14px 14px; z-index: 2;
    }
    .phone-screen { width: 100%; height: 560px; border: none; border-radius: 26px; display: block; overflow: hidden; }
    .phone-cta { margin-top: 22px; text-align: center; }
    .phone-cta-label { font-size: 12.5px; color: rgba(250,248,243,0.55); margin-bottom: 8px; }
    .phone-cta-btn {
      display: inline-block; background: var(--teal); color: #fff; font-size: 14px; font-weight: 700;
      padding: 10px 22px; border-radius: 8px; text-decoration: none;
    }
    .phone-cta-btn:hover { background: var(--teal-deep); }

    /* ---------- Pricing: two-tone card ---------- */
    .price-card2 {
      max-width: 440px; margin: 40px auto 0; border-radius: 22px; overflow: hidden;
      border: 1px solid var(--line); box-shadow: 0 24px 60px -24px rgba(28,27,25,0.3);
    }
    .pc-top { background: var(--ink); color: var(--paper); padding: 34px 32px 28px; text-align: center; }
    .pc-top .price { font-family: var(--font-display); font-size: 46px; font-weight: 700; }
    .pc-top .price small { font-size: 15px; color: rgba(250,248,243,0.62); font-weight: 400; font-family: var(--font-body); }
    .pc-top .pc-sub { font-size: 13px; color: rgba(250,248,243,0.62); margin-top: 6px; }
    .pc-bottom { background: var(--paper-raised); padding: 28px 32px 32px; text-align: left; }
    .pc-bottom ul { list-style: none; padding: 0; margin: 0 0 22px; }
    .pc-bottom li { font-size: 13.5px; padding: 7px 0 7px 24px; position: relative; }
    .pc-bottom li::before { content: '✓'; position: absolute; left: 0; color: var(--teal); font-weight: 700; }
    .cta-fine { font-size: 12.5px; color: var(--ink-soft); margin-top: 10px; text-align: center; }

    .pricing-row { display: flex; gap: 28px; justify-content: center; align-items: stretch; flex-wrap: wrap; margin-top: 40px; }
    .pricing-row .price-card2 { margin: 0; flex: 1 1 380px; max-width: 420px; display: flex; flex-direction: column; }

    /* Live GoodAPI impact embed -- dark background behind the iframe so the
       section doesn't flash white while their page loads. Height is tuned to
       end right after GoodAPI's own region cards (globe + the actual "N
       trees planted" / "N bottles recovered" numbers), measured against
       their real page (cards end ~1350px down, next section starts ~1571px)
       -- not just the globe, so the count is always visible. */
    .impact-frame {
      max-width: 900px; margin: 32px auto 0; border-radius: 20px; overflow: hidden;
      box-shadow: 0 20px 60px rgba(0,0,0,0.18); background: #0b1410;
    }
    .impact-frame iframe { width: 100%; height: 1420px; border: 0; display: block; }
    /* Bigger than .section h2's shared clamp() on purpose -- this is the one
       headline meant to hit like a big stat, not match the rest of the page's
       section headers. Weight contrast on the number, since h2 elsewhere has
       no explicit weight of its own to contrast against. */
    h2.impact-title { font-size: clamp(38px, 7vw, 68px); line-height: 1.08; font-weight: 500; }
    .impact-title strong { font-weight: 800; }
    .impact-subhead { font-size: 17px; font-weight: 600; color: var(--ink); margin: 10px 0 0; }
    .impact-link {
      display: inline-block; margin-top: 16px; font-size: 13.5px; font-weight: 600;
      color: var(--teal); text-decoration: none;
    }
    .impact-link:hover { text-decoration: underline; }
    .pricing-row .price-card2 .pc-bottom { flex: 1; display: flex; flex-direction: column; }
    .pricing-row .price-card2 .cta-main { margin-top: auto; }
    .pc-top--demo { background: var(--paper-raised); color: var(--ink); border-bottom: 1px solid var(--line); }
    .pc-top--demo .pc-sub { color: var(--ink-soft); }

    /* ---------- FAQ: two columns ---------- */
    .faq-grid { column-count: 2; column-gap: 48px; margin-top: 26px; }
    .faq-item { border-bottom: 1px solid var(--line); padding: 4px 0; break-inside: avoid; }
    .faq-item summary { font-size: 15px; font-weight: 600; padding: 14px 0; cursor: pointer; list-style: none; }
    .faq-item summary::after { content: '+'; float: right; color: var(--teal); font-weight: 700; }
    .faq-item[open] summary::after { content: '–'; }
    .faq-item p { font-size: 14px; color: var(--ink-soft); line-height: 1.6; margin: 0 0 16px; }

    /* ---------- Final CTA: dark bookend ---------- */
    .final-band {
      background: #14131F;
      background-image: radial-gradient(circle, rgba(255,255,255,0.07) 1px, transparent 1.4px);
      background-size: 24px 24px;
      text-align: center; padding: 96px 6vw;
    }
    .final-band h2 { color: var(--paper); font-size: clamp(24px, 3vw, 34px); margin-bottom: 12px; }
    .final-band p { color: #B7B4AC; font-size: 15px; margin-bottom: 26px; }

    footer { padding: 28px 6vw; display: flex; justify-content: space-between; align-items: center; font-size: 12.5px; color: var(--ink-soft); }

    /* ---------- Sticky trial CTA: appears once scrolled past the hero ---------- */
    .sticky-cta {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
      background: var(--paper-raised); border-top: 1px solid var(--line);
      box-shadow: 0 -8px 24px -12px rgba(28,27,25,0.18);
      padding: 12px 6vw; display: flex; align-items: center; justify-content: center; gap: 18px;
      transform: translateY(100%); transition: transform 0.25s ease;
    }
    .sticky-cta.visible { transform: translateY(0); }
    .sticky-cta-text { font-size: 13.5px; color: var(--ink-soft); font-weight: 500; }
    .sticky-cta .cta-main { padding: 11px 22px; font-size: 14.5px; white-space: nowrap; }
    @media (max-width: 560px) {
      .sticky-cta-text { display: none; }
    }

    @media (max-width: 860px) {
      .hero-inner { flex-direction: column; padding-top: 5vh; }
      .hero-copy { text-align: center; }
      .hero-sub { margin-left: auto; margin-right: auto; }
      .phone-frame { width: 260px; }
      .phone-screen { height: 480px; }
      .problem-row { flex-direction: column; align-items: flex-start; gap: 12px; }
      .timeline { flex-direction: column; gap: 28px; }
      .timeline::before { display: none; }
      .faq-grid { column-count: 1; }
      /* Cards stack to a single column on narrow screens, so this needs more
         height than the desktop ratio would suggest -- generous on purpose
         since a cross-origin iframe can't be measured precisely at every
         width; worth a real-phone check once trees are actually planted. */
      .impact-frame iframe { height: 1700px; }
      footer { flex-direction: column; gap: 10px; text-align: center; }
    }
  </style>
</head>
<body>

  <nav class="nav">
    <a href="/"><img src="/images/receiptap-logo.png" alt="ReceipTap" /></a>
    <div class="nav-links">
      <a href="/partner-program">Partner Program</a>
      <a href="/account/login">Customer wallet</a>
      <a href="/login">Log in</a>
      <a href="/signup" class="nav-cta">Start free trial</a>
    </div>
  </nav>

  <header class="hero-dark">
    <div class="hero-inner">
      <div class="hero-copy">
        <h1>The receipt goes to their phone.<br /><em>The relationship</em> goes to you.</h1>
        <p class="hero-sub">
          ReceipTap replaces paper receipts with a tap. Your customers get every receipt on
          their phone — and you get their email, a Google review funnel, and repeat-customer
          analytics from sales you were already making.
        </p>
        <a class="cta-main" href="/signup">Start your 30-day free trial</a>
        <div class="cta-fine-dark">$49.99 USD/month after trial · cancel anytime before it ends and pay nothing</div>
      </div>
      <div class="hero-visual">
        <div class="receipt-demo">
          <div class="puck"></div>
          <div class="phone-frame">
            <div class="phone-notch"></div>
            <iframe id="demo-iframe" class="phone-screen" src="/demo/receipt" title="ReceipTap receipt demo" scrolling="no"></iframe>
          </div>
          <div class="phone-cta">
            <div class="phone-cta-label">Want this for your own business?</div>
            <a class="phone-cta-btn" href="/signup?next=/dashboard/settings/receipt">Customize your receipt &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <div class="trust-strip">
    <div class="trust-inner">
      <span>No app for customers</span>
      <span>Works with Square</span>
      <span>Live in an afternoon</span>
      <span>Cancel anytime during trial</span>
    </div>
  </div>

  <section class="section">
    <div class="section-eyebrow">The problem with paper</div>
    <h2>Every paper receipt is a dead end.</h2>
    <div class="problem-rows">
      <div class="problem-row">
        <div class="p-num">90%</div>
        <div>
          <h3>Thrown away or lost</h3>
          <p>Most paper receipts are in the trash — or a pocket — within a day. When your customer needs it for a return or warranty, it's gone.</p>
        </div>
      </div>
      <div class="problem-row">
        <div class="p-num">$0</div>
        <div>
          <h3>Nothing comes back to you</h3>
          <p>A paper receipt tells you nothing about who bought, whether they've been in before, or how to reach them again. The sale ends at the register.</p>
        </div>
      </div>
      <div class="problem-row">
        <div class="p-num">∞</div>
        <div>
          <h3>Endless thermal paper</h3>
          <p>Rolls, jams, replacements, and BPA-coated paper nobody wants to touch. A cost with no upside, forever.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="how-band">
    <div class="section">
      <div class="section-eyebrow">How it works</div>
      <h2>Live in an afternoon. No new hardware at the register.</h2>
      <div class="timeline">
        <div class="tl-step">
          <div class="tl-num">1</div>
          <h3>Connect your POS</h3>
          <p>Link your Square account in a couple of clicks. Sales start flowing into ReceipTap automatically — nothing changes about how you ring people up.</p>
        </div>
        <div class="tl-step">
          <div class="tl-num">2</div>
          <h3>Put the puck on your counter</h3>
          <p>The ReceipTap puck sits next to your register. No wiring into your till, no software to install on it.</p>
        </div>
        <div class="tl-step">
          <div class="tl-num">3</div>
          <h3>Customers tap. That's it.</h3>
          <p>After paying, they tap their phone on the puck and their receipt appears — no app to download, no account required to receive it.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="pricing" style="text-align: center;">
    <div class="section-eyebrow">Pricing</div>
    <h2>Start free, upgrade when you're ready.</h2>
    <div class="pricing-row">
      <div class="price-card2">
        <div class="pc-top pc-top--demo">
          <div style="font-size: 15px; font-weight: 700; margin-bottom: 10px;">Design your custom receipt</div>
          <div class="price">Free</div>
          <div class="pc-sub">no card required</div>
        </div>
        <div class="pc-bottom">
          <ul>
            <li>Design and preview your branded receipt</li>
            <li>Try your logo, colors, and Google review link</li>
            <li>No POS connection or live receipts on this tier</li>
          </ul>
          <a class="cta-main" href="/signup?demo=1" style="width: 100%; box-sizing: border-box;">Start free demo</a>
          <div class="cta-fine">No card, no time limit — upgrade whenever you're ready</div>
        </div>
      </div>
      <div class="price-card2">
        <div class="pc-top">
          <div class="price">$49.99<small> USD / month</small></div>
          <div class="pc-sub">per location · 30-day free trial</div>
        </div>
        <div class="pc-bottom">
          <ul>
            <li>Unlimited digital receipts</li>
            <li>Square POS integration</li>
            <li>Email capture + Google review funnel</li>
            <li>Repeat-customer & revenue analytics</li>
            <li>AI receipt categorization for your customers</li>
            <li>Cancel anytime — trial ends, no charge</li>
          </ul>
          <a class="cta-main" href="/signup" style="width: 100%; box-sizing: border-box;">Start 30-day free trial</a>
          <div class="cta-fine">Card required to start · charged only when the trial ends</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="text-align: center;">
    <div class="section-eyebrow">In partnership with GoodAPI</div>
    <h2 class="impact-title"><strong>300 billion</strong> paper receipts hit landfill every year.</h2>
    <p class="impact-subhead">Every ReceipTap replaces a customer's paper receipt. Every monthly subscription plants a real tree.</p>
    <p class="section-lead" style="margin: 0 auto;">
      An estimated 300 billion paper receipts are printed worldwide every year, most headed
      straight to landfill. ReceipTap replaces yours entirely — and plants a real, verified
      tree every month you stay subscribed, through our partner GoodAPI. Drag the globe below
      to see exactly where.
    </p>
    <div class="impact-frame">
      <iframe
        src="<%= goodApiImpactUrl %>"
        title="ReceipTap's live environmental impact, verified by GoodAPI"
        loading="lazy"
      ></iframe>
    </div>
    <a class="impact-link" href="<%= goodApiImpactUrl %>" target="_blank" rel="noopener">
      View the full live impact report &rarr;
    </a>
  </section>

  <section class="section" style="max-width: 900px;">
    <div class="section-eyebrow">Questions</div>
    <h2>What store owners ask us</h2>
    <div class="faq-grid">
      <details class="faq-item">
        <summary>Do my customers need to download an app?</summary>
        <p>No. They tap the puck and the receipt opens on their phone instantly. Creating a wallet account (to keep all their receipts in one place) is optional.</p>
      </details>
      <details class="faq-item">
        <summary>Which POS systems does it work with?</summary>
        <p>Square today. Clover support is built and rolling out soon. If you use something else, tell us — it directly shapes what we build next.</p>
      </details>
      <details class="faq-item">
        <summary>Does it change how I ring up sales?</summary>
        <p>No. ReceipTap listens to sales your POS already records. Your checkout flow, your staff's routine, and your register stay exactly as they are.</p>
      </details>
      <details class="faq-item">
        <summary>What if I cancel during the trial?</summary>
        <p>You pay nothing. The card you add at signup is only charged when the 30-day trial ends, and you can cancel anytime before then from your dashboard.</p>
      </details>
      <details class="faq-item">
        <summary>Can I still print paper receipts for people who want them?</summary>
        <p>Yes. ReceipTap runs alongside your printer, not instead of it — customers who want paper still get paper.</p>
      </details>
    </div>
  </section>

  <section class="final-band">
    <h2>Your next sale can be the start of a relationship.</h2>
    <p>Set up in an afternoon. Free for 30 days. Cancel anytime.</p>
    <a class="cta-main" href="/signup">Start your free trial</a>
  </section>

  <footer>
    <span>© 2026 ReceipTap</span>
    <span>
      <a href="/login" style="color: inherit;">Merchant log in</a> ·
      <a href="/account/login" style="color: inherit;">Customer wallet</a> ·
      <a href="/partner-program" style="color: inherit;">Partner Program</a> ·
      <a href="/legal/terms" style="color: inherit;">Terms</a> ·
      <a href="/legal/privacy" style="color: inherit;">Privacy</a> ·
      <a href="/legal/dpa" style="color: inherit;">DPA</a>
    </span>
  </footer>

  <div class="sticky-cta" id="sticky-cta">
    <span class="sticky-cta-text">Free for 30 days. Cancel anytime.</span>
    <a class="cta-main" href="/signup">Start your 30-day free trial</a>
  </div>

  <script>
    const nav = document.querySelector('.nav');
    window.addEventListener('scroll', () => {
      nav.classList.toggle('scrolled', window.scrollY > 8);
    }, { passive: true });
  </script>

  <script>
    // Shows the sticky trial CTA once the visitor has scrolled past the
    // halfway point of the hero header -- before that, the same CTA is
    // already on screen inside the hero itself, so showing this one too
    // would just be a duplicate.
    (function () {
      const bar = document.getElementById('sticky-cta');
      const hero = document.querySelector('.hero-dark');
      if (!bar || !hero) return;

      function updateVisibility() {
        const threshold = hero.offsetHeight / 2;
        bar.classList.toggle('visible', window.scrollY > threshold);
      }
      window.addEventListener('scroll', updateVisibility, { passive: true });
      window.addEventListener('resize', updateVisibility);
      updateVisibility();
    })();
  </script>

  <script>
    // Slowly auto-scrolls the demo receipt iframe from top to bottom and
    // back, so a visitor sees the partner banner, the receipt, the save
    // buttons, the Google review card, the loyalty card, and social links
    // in one pass without having to scroll it themselves.
    (function () {
      const iframe = document.getElementById('demo-iframe');
      if (!iframe || matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      // setInterval, not requestAnimationFrame -- rAF is tied to the paint
      // cycle and browsers can suspend it much more aggressively (some
      // background/inactive-tab situations stop it outright), where a timer
      // keeps ticking. This is a decorative background animation, not
      // something that needs to be frame-perfect.
      let intervalId = null;

      function startTour() {
        if (intervalId) return;
        const win = iframe.contentWindow;
        const doc = iframe.contentDocument;
        if (!win || !doc || !doc.body) return;

        const distance = doc.body.scrollHeight - iframe.clientHeight;
        if (distance <= 0) return;

        const startHoldMs = 1800; // pause at the top before scrolling begins
        const scrollMs = 10000;
        const endHoldMs = 2200;
        const cycleMs = startHoldMs + scrollMs + endHoldMs;
        let startTime = Date.now();

        intervalId = setInterval(() => {
          const elapsed = (Date.now() - startTime) % cycleMs;
          if (elapsed <= startHoldMs) {
            win.scrollTo(0, 0);
          } else if (elapsed <= startHoldMs + scrollMs) {
            win.scrollTo(0, distance * ((elapsed - startHoldMs) / scrollMs));
          } else {
            win.scrollTo(0, distance);
          }
          if (Date.now() - startTime >= cycleMs) startTime = Date.now();
        }, 60);
      }

      function stopTour() {
        if (intervalId) clearInterval(intervalId);
        intervalId = null;
      }

      iframe.addEventListener('load', () => setTimeout(startTour, 400));

      if ('IntersectionObserver' in window) {
        new IntersectionObserver((entries) => {
          entries.forEach((entry) => (entry.isIntersecting ? startTour() : stopTour()));
        }, { threshold: 0.3 }).observe(iframe);
      }
    })();
  </script>

</body>
</html>
