  <script>
    // Drives the demo receipt's internal scroll position from the visitor's
    // own page scroll -- normal passive scrolling (no preventDefault, no
    // wheel/touch hijacking), just reading where .scrolly-wrap sits relative
    // to the viewport each frame and mapping that 0-1 progress onto the
    // iframe's scrollTop. Each .scrolly-step's data-target is a selector
    // resolved INSIDE the iframe's own (same-origin) document, so the steps
    // stay in sync with wherever that element actually renders rather than
    // an assumed pixel offset.
    (function () {
      const wrap = document.getElementById('scrolly-wrap');
      const sticky = wrap && wrap.querySelector('.scrolly-sticky');
      const iframe = document.getElementById('demo-iframe');
      const steps = Array.prototype.slice.call(document.querySelectorAll('.scrolly-step'));
      if (!wrap || !sticky || !iframe || !steps.length) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return; // CSS fallback shows a static list + phone

      // One viewport of scroll per step -- set from JS so it always matches
      // the real step count instead of a hand-maintained CSS number.
      wrap.style.height = (steps.length * 100) + 'vh';

      // .nav is ALSO position:sticky/top:0 and sits earlier in the document,
      // so it permanently occupies the top of the viewport once scrolled
      // past -- without this offset, .scrolly-sticky's own top:0 pins its
      // content underneath the nav instead of below it, pushing the phone
      // and CTA off the bottom of the screen (most visible on mobile, where
      // the nav wraps to two lines and is tallest).
      function applyNavOffset() {
        const nav = document.querySelector('.nav');
        const navHeight = nav ? nav.getBoundingClientRect().height : 0;
        sticky.style.top = navHeight + 'px';
        sticky.style.height = 'calc(100vh - ' + navHeight + 'px)';
      }
      applyNavOffset();

      let targets = null; // per-step scrollTop (px) inside the iframe doc
      let maxScroll = 0;

      function resolveTargets() {
        const doc = iframe.contentDocument;
        if (!doc || !doc.body) return false;
        maxScroll = Math.max(0, doc.body.scrollHeight - iframe.clientHeight);
        targets = steps.map(function (step) {
          const sel = step.getAttribute('data-target');
          const el = sel && doc.querySelector(sel);
          return el ? Math.min(maxScroll, Math.max(0, el.offsetTop - 24)) : 0;
        });
        return true;
      }

      let ticking = false;
      function update() {
        ticking = false;
        if (!targets) return;
        const rect = wrap.getBoundingClientRect();
        const total = rect.height - sticky.getBoundingClientRect().height;
        if (total <= 0) return;
        const progress = Math.min(1, Math.max(0, -rect.top / total));
        const rawIndex = progress * (steps.length - 1);
        const activeIndex = Math.round(rawIndex);

        steps.forEach(function (step, i) { step.classList.toggle('active', i === activeIndex); });

        const lower = Math.floor(rawIndex);
        const upper = Math.min(steps.length - 1, lower + 1);
        const frac = rawIndex - lower;
        const scrollTarget = targets[lower] + (targets[upper] - targets[lower]) * frac;
        if (iframe.contentWindow) iframe.contentWindow.scrollTo(0, scrollTarget);
      }

      function onScroll() {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      }

      iframe.addEventListener('load', function () {
        setTimeout(function () {
          if (!resolveTargets()) return;
          steps[0].classList.add('active');
          update();
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', function () {
            applyNavOffset();
            resolveTargets();
            update();
          });
        }, 300);
      });
    })();
  </script>

