<!-- views/landing.ejs — public marketing landing page at / -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ReceipTap — Tap-to-receive digital receipts for your store</title>
  <meta name="description" content="Replace paper receipts with a tap. Customers get their receipt on their phone; you get their email, a Google review funnel, and repeat-customer analytics. Works with Square, Clover, Lightspeed, and Shopify POS." />
  <meta property="og:title" content="ReceipTap — Tap-to-receive digital receipts for your store" />
  <meta property="og:description" content="Turn every checkout into a long lasting connection. Email capture, a Google review funnel, and repeat-customer analytics from sales you're already making." />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="/images/receiptap-logo.png" />
  <link rel="stylesheet" href="/css/receiptap.css" />
  <style>
    /* receiptap.css sets html/body height:100% for the dashboard's sidebar layout --
       that caps body at viewport height on this page too, which breaks position:sticky
       for anything that scrolls past it (its containing block never grows). */
    body { height: auto; min-height: 100%; }

    .nav {
      display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 18px 6vw;
      position: sticky; top: 0; z-index: 50; background: var(--paper);
      border-bottom: 1px solid transparent; transition: box-shadow 0.2s ease, border-color 0.2s ease, background 0.2s ease;
    }
    .nav.scrolled { border-bottom-color: var(--line); background: rgba(250,248,243,0.94); backdrop-filter: blur(6px); }
    /* Logo is a wide ~5:1 horizontal lockup -- 80px tall would render it
       ~400px wide, dwarfing the nav links next to it. */
    .nav img { height: 34px; }
    .nav-links { display: flex; align-items: center; gap: 18px; }
    .nav-links a { font-size: 14px; font-weight: 500; text-decoration: none; color: var(--ink-soft); }
    .nav-cta { background: var(--teal); color: #fff !important; padding: 9px 16px; border-radius: 8px; font-weight: 600; }

    /* ---------- Hero: light, full-bleed, floating product card ---------- */
    .hero-dark {
      background: var(--paper);
      background-image: radial-gradient(circle, rgba(0,0,0,0.06) 1px, transparent 1.4px);
      background-size: 24px 24px;
      position: relative;
    }
    .hero-inner {
      display: grid; grid-template-columns: 1.1fr 1fr; grid-template-areas: "text visual";
      align-items: center; gap: 6vw; padding: 9vh 6vw 11vh;
      max-width: 1200px; margin: 0 auto; position: relative; z-index: 1;
    }
    .hero-text { grid-area: text; }
    .hero-visual { grid-area: visual; display: flex; justify-content: center; }
    .hero-dark h1 {
      font-size: clamp(32px, 4.6vw, 56px); line-height: 1.06; letter-spacing: -0.02em;
      margin-bottom: 20px; color: var(--ink);
    }
    .hero-dark h1 em { font-style: normal; color: var(--teal); }
    .hero-dark .hero-sub {
      font-size: 17px; color: var(--ink-soft); line-height: 1.6; max-width: 460px; margin-bottom: 30px;
    }
    .cta-main {
      display: inline-block; background: var(--teal); color: #fff; font-size: 16px; font-weight: 700;
      padding: 15px 28px; border-radius: 10px; text-decoration: none; text-align: center;
    }
    .cta-main:hover { background: var(--teal-deep); }

    /* Real hardware photo, floating on the hero -- background removed from
       the source photo (see public/images/receiptap-puck-hardware.png) so
       it sits directly on the dark hero rather than showing a white box. */
    .hero-hardware {
      width: min(360px, 78vw); height: auto; display: block;
      filter: drop-shadow(0 30px 60px rgba(0,0,0,0.45));
    }
    /* Real receipt demo (moved out of the hero, see .phone-showcase below):
       auto-scrolls through the actual receipt.ejs page -- not a mockup, a
       live iframe of the real product. */
    .receipt-demo { display: flex; flex-direction: column; align-items: center; }
    @media (prefers-reduced-motion: reduce) {
      .pos-track.is-ready { animation: none; }
    }

    /* ---------- Phone demo, moved out of the hero to its own band right
       after the POS logo strip -- same dark background as .hero-dark so the
       existing .phone-frame/.phone-cta styling (built for a dark surface)
       still reads correctly without redefining it. ---------- */
    .phone-showcase {
      background: #14131F;
      background-image: radial-gradient(circle, rgba(255,255,255,0.07) 1px, transparent 1.4px);
      background-size: 24px 24px;
      padding: 72px 6vw; text-align: center;
    }
    .phone-showcase-inner { max-width: 640px; margin: 0 auto; }

    /* ---------- Scroll-scrubbed receipt tour: height is set from JS (one
       viewport per step -- see the script near the bottom) so it always
       matches the actual number of .scrolly-step elements. The 450vh here
       is only a no-JS/pre-hydration fallback. .scrolly-sticky pins for the
       whole scroll of .scrolly-wrap, then releases naturally once the wrap
       ends -- this is a normal, passive-scroll page (no preventDefault/
       scroll-jacking), it just reads scroll position to drive progress. */
    .scrolly-wrap { position: relative; height: 450vh; }
    .scrolly-sticky {
      position: sticky; top: 0; height: 100vh;
      display: flex; align-items: center; overflow: hidden;
    }
    .scrolly-inner {
      width: 100%; max-width: 1100px; margin: 0 auto; padding: 0 6vw;
      display: grid; grid-template-columns: 1fr 1fr; grid-template-areas: "steps visual";
      align-items: center; gap: 6vw; text-align: left;
    }
    .scrolly-steps { grid-area: steps; }
    .scrolly-step {
      opacity: 0.3; transition: opacity 0.3s ease; padding: 14px 0 14px 20px;
      border-left: 2px solid rgba(255,255,255,0.14); margin-bottom: 10px;
    }
    .scrolly-step.active { opacity: 1; border-left-color: var(--teal); }
    .scrolly-step-num {
      display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px;
      border-radius: 50%; background: rgba(255,255,255,0.1); color: rgba(250,248,243,0.75);
      font-size: 12px; font-weight: 700; margin-bottom: 10px;
    }
    .scrolly-step.active .scrolly-step-num { background: var(--teal); color: #fff; }
    .scrolly-step h3 { color: var(--paper); font-size: 18px; margin: 0 0 6px; }
    .scrolly-step p { color: rgba(250,248,243,0.62); font-size: 14px; line-height: 1.55; margin: 0; }
    .receipt-demo { grid-area: visual; }
    @media (prefers-reduced-motion: reduce) {
      .scrolly-wrap { height: auto !important; }
      .scrolly-sticky { position: static; height: auto; }
      .scrolly-step { opacity: 1; }
    }

    /* ---------- Trust strip: sliding POS logo marquee ---------- */
    .pos-strip { padding: 28px 0; border-bottom: 1px solid var(--line); }
    .pos-strip-label {
      text-align: center; font-size: 11px; font-weight: 700; letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--ink-soft); margin-bottom: 18px;
    }
    /* Mask fades logos in/out at the edges instead of a hard clip, since the
       track scrolls continuously behind it. */
    .pos-track-wrap {
      overflow: hidden;
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
      mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    }
    /* Cloned to however many copies actually fill the screen (see the script
       below the track) -- a fixed 2 copies left blank space visible for most
       of the loop on any screen wider than one copy (basically every
       desktop), since the track ran out of content before the scroll
       finished. --pos-shift is set by that same script to exactly one
       copy's real measured width, so the shift is always precise regardless
       of screen size or how many copies end up cloned. */
    .pos-track {
      display: flex; align-items: center; width: max-content;
      will-change: transform; backface-visibility: hidden; -webkit-backface-visibility: hidden;
    }
    /* translate3d (not translateX) so mobile browsers promote this to its
       own compositor layer instead of repainting each frame -- without it,
       the mask on .pos-track-wrap was making the scroll choppy on mobile. */
    .pos-track.is-ready { animation: pos-scroll 21s linear infinite; }
    .pos-group { display: flex; align-items: center; flex-shrink: 0; }
    .pos-track img { height: 28px; width: auto; display: block; opacity: 0.8; margin-right: 64px; }
    @keyframes pos-scroll {
      from { transform: translate3d(0, 0, 0); }
      to { transform: translate3d(calc(-1 * var(--pos-shift, 0px)), 0, 0); }
    }

    .section { padding: 88px 6vw; max-width: 1100px; margin: 0 auto; }
    .section-eyebrow { font-size: 12px; font-weight: 700; color: var(--teal-deep); text-transform: uppercase; letter-spacing: 0.07em; margin-bottom: 8px; }
    .section h2 { font-size: clamp(24px, 3vw, 34px); letter-spacing: -0.015em; margin-bottom: 14px; }
    .section-lead { font-size: 15.5px; color: var(--ink-soft); line-height: 1.6; max-width: 560px; }

    /* ---------- Problem: editorial rows, not boxed cards ---------- */
    .problem-rows { margin-top: 40px; }
    .problem-row {
      display: flex; align-items: center; gap: 44px; padding: 34px 0;
      border-top: 1px solid var(--line);
    }
    .problem-row:last-child { border-bottom: 1px solid var(--line); }
    .problem-row .p-num {
      font-family: var(--font-display); font-size: clamp(46px, 6.4vw, 80px); font-weight: 700;
      color: var(--teal); line-height: 1; flex: 0 0 auto; min-width: 150px;
    }
    .problem-row h3 { font-size: 18px; margin: 0 0 6px; }
    .problem-row p { font-size: 14px; color: var(--ink-soft); line-height: 1.6; max-width: 520px; margin: 0; }

    /* ---------- How it works: horizontal timeline ---------- */
    .how-band { background: var(--paper-raised); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .timeline { display: flex; gap: 28px; margin-top: 48px; position: relative; }
    .timeline::before { content: ''; position: absolute; left: 0; right: 0; top: 20px; height: 2px; background: var(--line); }
    .tl-step { flex: 1; position: relative; }
    .tl-num {
      width: 40px; height: 40px; border-radius: 50%; background: var(--teal); color: #fff;
      display: flex; align-items: center; justify-content: center; font-weight: 700;
      font-family: var(--font-display); margin-bottom: 20px; box-shadow: 0 0 0 6px var(--paper-raised);
      position: relative; z-index: 1;
    }
    .tl-step h3 { font-size: 16.5px; margin-bottom: 8px; }
    .tl-step p { font-size: 13.5px; color: var(--ink-soft); line-height: 1.6; margin: 0; }

    /* ---------- Hero phone showcase (auto-scrolling receipt demo) ---------- */
    .phone-frame {
      width: 300px; margin: -6px auto 0; position: relative;
      background: linear-gradient(155deg, #4a4a4d 0%, #232326 22%, #18181a 50%, #232326 78%, #4a4a4d 100%);
      border-radius: 54px; padding: 5px;
      box-shadow: 0 30px 70px -18px rgba(0,0,0,0.6), inset 0 0 0 1px rgba(255,255,255,0.15);
    }
    .phone-frame::before,
    .phone-frame::after {
      content: ''; position: absolute; left: -3px; width: 3px; background: #3a3a3d; border-radius: 2px 0 0 2px;
      box-shadow: inset 1px 0 1px rgba(255,255,255,0.12);
    }
    .phone-frame::before { top: 108px; height: 32px; }
    .phone-frame::after { top: 152px; height: 56px; }
    .phone-power-btn {
      position: absolute; right: -3px; top: 126px; width: 3px; height: 74px; background: #3a3a3d;
      border-radius: 0 2px 2px 0; box-shadow: inset -1px 0 1px rgba(255,255,255,0.12);
    }
    .phone-inner {
      background: #000; border-radius: 49px; padding: 3px; position: relative;
    }
    .dynamic-island {
      position: absolute; top: 15px; left: 50%; transform: translateX(-50%);
      width: 84px; height: 24px; background: #000; border-radius: 16px; z-index: 2;
      box-shadow: inset 0 0 0 1px rgba(255,255,255,0.06);
    }
    .phone-screen { width: 100%; height: 560px; border: none; border-radius: 46px; display: block; overflow: hidden; }
    .phone-cta { margin-top: 22px; text-align: center; }
    .phone-cta-label { font-size: 12.5px; color: rgba(250,248,243,0.55); margin-bottom: 8px; }
    .phone-cta-btn {
      display: inline-block; background: var(--teal); color: #fff; font-size: 14px; font-weight: 700;
      padding: 10px 22px; border-radius: 8px; text-decoration: none;
    }
    .phone-cta-btn:hover { background: var(--teal-deep); }

    /* ---------- Pricing: two-tone card ---------- */
    .price-card2 {
      max-width: 440px; margin: 40px auto 0; border-radius: 22px; overflow: hidden;
      border: 1px solid var(--line); box-shadow: 0 24px 60px -24px rgba(28,27,25,0.3);
    }
    .pc-top { background: var(--ink); color: var(--paper); padding: 34px 32px 28px; text-align: center; }
    .pc-top .price { font-family: var(--font-display); font-size: 46px; font-weight: 700; }
    .pc-top .price small { font-size: 15px; color: rgba(250,248,243,0.62); font-weight: 400; font-family: var(--font-body); }
    .pc-top .pc-sub { font-size: 13px; color: rgba(250,248,243,0.62); margin-top: 6px; }
    .pc-bottom { background: var(--paper-raised); padding: 28px 32px 32px; text-align: left; }
    .pc-bottom ul { list-style: none; padding: 0; margin: 0 0 22px; }
    .pc-bottom li { font-size: 13.5px; padding: 7px 0 7px 24px; position: relative; }
    .pc-bottom li::before { content: '✓'; position: absolute; left: 0; color: var(--teal); font-weight: 700; }
    .cta-fine { font-size: 12.5px; color: var(--ink-soft); margin-top: 10px; text-align: center; }

    .pricing-row { display: flex; gap: 28px; justify-content: center; align-items: stretch; flex-wrap: wrap; margin-top: 40px; }
    .pricing-row .price-card2 { margin: 0; flex: 1 1 380px; max-width: 420px; display: flex; flex-direction: column; }

    /* Live GoodAPI impact embed -- dark background behind the iframe so the
       section doesn't flash white while their page loads. Height is tuned to
       end right after GoodAPI's own region cards (globe + the actual "N
       trees planted" / "N bottles recovered" numbers), measured against
       their real page (cards end ~1350px down, next section starts ~1571px)
       -- not just the globe, so the count is always visible. */
    .impact-frame {
      max-width: 900px; margin: 32px auto 0; border-radius: 20px; overflow: hidden;
      box-shadow: 0 20px 60px rgba(0,0,0,0.18); background: #0b1410;
    }
    .impact-frame iframe { width: 100%; height: 1420px; border: 0; display: block; }
    /* Matches .section h2's shared size/weight -- consistent with every
       other section header on the page. Weight contrast on the number only. */
    .impact-title strong { font-weight: 800; }
    .impact-subhead { font-size: 17px; font-weight: 600; color: var(--ink); margin: 10px 0 0; }
    .impact-link {
      display: inline-block; margin-top: 16px; font-size: 13.5px; font-weight: 600;
      color: var(--teal); text-decoration: none;
    }
    .impact-link:hover { text-decoration: underline; }
    .pricing-row .price-card2 .pc-bottom { flex: 1; display: flex; flex-direction: column; }
    .pricing-row .price-card2 .cta-main { margin-top: auto; }
    .pc-top--demo { background: var(--paper-raised); color: var(--ink); border-bottom: 1px solid var(--line); }
    .pc-top--demo .pc-sub { color: var(--ink-soft); }

    /* ---------- FAQ: two columns ---------- */
    .faq-grid { column-count: 2; column-gap: 48px; margin-top: 26px; }
    .faq-item { border-bottom: 1px solid var(--line); padding: 4px 0; break-inside: avoid; }
    .faq-item summary { font-size: 15px; font-weight: 600; padding: 14px 0; cursor: pointer; list-style: none; }
    .faq-item summary::after { content: '+'; float: right; color: var(--teal); font-weight: 700; }
    .faq-item[open] summary::after { content: '–'; }
    .faq-item p { font-size: 14px; color: var(--ink-soft); line-height: 1.6; margin: 0 0 16px; }

    /* ---------- Final CTA: dark bookend ---------- */
    .final-band {
      background: #14131F;
      background-image: radial-gradient(circle, rgba(255,255,255,0.07) 1px, transparent 1.4px);
      background-size: 24px 24px;
      text-align: center; padding: 96px 6vw;
    }
    .final-band h2 { color: var(--paper); font-size: clamp(24px, 3vw, 34px); margin-bottom: 12px; }
    .final-band p { color: #B7B4AC; font-size: 15px; margin-bottom: 26px; }

    footer { padding: 28px 6vw; display: flex; justify-content: space-between; align-items: center; font-size: 12.5px; color: var(--ink-soft); }

    @media (max-width: 860px) {
      .hero-inner {
        grid-template-columns: 1fr; grid-template-areas: "text" "visual";
        padding-top: 5vh;
      }
      .hero-text { text-align: center; }
      .hero-sub { margin-left: auto; margin-right: auto; }
      /* Explanations move above the phone instead of beside it, and only the
         active step renders (rather than the full dimmed list) so a single
         pinned screen has room for both without clipping. */
      .scrolly-inner {
        grid-template-columns: 1fr; grid-template-areas: "steps" "visual";
        gap: 12px; text-align: center;
      }
      .scrolly-step { display: none; border-left: none; padding: 0; margin-bottom: 0; }
      .scrolly-step.active { display: block; opacity: 1; }
      .scrolly-step-num { width: 20px; height: 20px; margin: 0 auto 6px; }
      .scrolly-step h3 { font-size: 15px; margin-bottom: 4px; }
      .scrolly-step p { font-size: 12.5px; max-width: 320px; margin: 0 auto; line-height: 1.4; }
      .phone-frame { width: 200px; }
      .phone-screen { height: 360px; }
      .phone-cta { margin-top: 8px; }
      .phone-cta-label { margin-bottom: 5px; }
      .problem-row { flex-direction: column; align-items: flex-start; gap: 12px; }
      .timeline { flex-direction: column; gap: 28px; }
      .timeline::before { display: none; }
      .faq-grid { column-count: 1; }
      /* Cards stack to a single column on narrow screens, so this needs more
         height than the desktop ratio would suggest -- generous on purpose
         since a cross-origin iframe can't be measured precisely at every
         width; worth a real-phone check once trees are actually planted. */
      .impact-frame iframe { height: 1700px; }
      footer { flex-direction: column; gap: 10px; text-align: center; }
    }
  </style>
</head>
<body>

  <nav class="nav">
    <a href="/"><img src="/images/receiptap-logo.png" alt="ReceipTap" /></a>
    <div class="nav-links">
      <a href="/partner-program">Partner Program</a>
      <a href="/account/login">Customer wallet</a>
      <a href="/login">Log in</a>
      <a href="/signup" class="nav-cta">Start free trial</a>
    </div>
  </nav>

  <header class="hero-dark">
    <div class="hero-inner">
      <div class="hero-text">
        <h1>Turn every checkout into<br /><em>a long lasting connection.</em></h1>
        <p class="hero-sub">
          Go beyond the transaction with our digital receipts built for engagement.
        </p>
      </div>
      <div class="hero-visual">
        <img class="hero-hardware" src="/images/receiptap-puck-hardware.png" alt="ReceipTap NFC puck" />
      </div>
    </div>
  </header>

  <div class="pos-strip">
    <div class="pos-strip-label">Works with the POS you already use</div>
    <div class="pos-track-wrap">
      <div class="pos-track" id="pos-track">
        <div class="pos-group">
          <img src="/images/pos-logos/square.svg" alt="Square" height="28" />
          <img src="/images/pos-logos/clover.svg" alt="Clover" height="28" />
          <img src="/images/pos-logos/lightspeed.svg" alt="Lightspeed" height="28" />
          <img src="/images/pos-logos/shopify.svg" alt="Shopify" height="28" />
        </div>
      </div>
    </div>
  </div>
  <script>
    // Clones the one real logo group enough times to always more than cover
    // the visible strip twice over, then points the CSS animation at exactly
    // that group's own measured width -- see the CSS comment on .pos-track
    // for why a fixed 2-copies-at-50% version left blank space on wide
    // screens. Re-measures on resize since the group's rendered width (and
    // how many copies are needed) depends on viewport width.
    (function () {
      var track = document.getElementById('pos-track');
      var firstGroup = track && track.querySelector('.pos-group');
      if (!track || !firstGroup) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      function setup() {
        track.classList.remove('is-ready');
        track.innerHTML = '';
        track.appendChild(firstGroup);
        var wrapWidth = track.parentElement.getBoundingClientRect().width;
        var groupWidth = firstGroup.getBoundingClientRect().width;
        if (!groupWidth) return; // logos not measurable yet -- the load handler below retries
        var copiesNeeded = Math.ceil((wrapWidth * 2) / groupWidth) + 1;
        for (var i = 1; i < copiesNeeded; i++) {
          track.appendChild(firstGroup.cloneNode(true));
        }
        track.style.setProperty('--pos-shift', groupWidth + 'px');
        track.classList.add('is-ready');
      }

      // Logos are external image files -- measuring before they've actually
      // loaded reads every width as 0.
      var images = firstGroup.querySelectorAll('img');
      Promise.all(Array.prototype.map.call(images, function (img) {
        return img.complete ? Promise.resolve() : new Promise(function (res) {
          img.onload = res;
          img.onerror = res;
        });
      })).then(setup);

      var resizeTimer;
      window.addEventListener('resize', function () {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(setup, 200);
      });
    })();
  </script>

  <div class="phone-showcase">
    <div class="phone-showcase-inner">
      <div class="section-eyebrow" style="color: var(--teal);">See it in action</div>
    </div>

    <div class="scrolly-wrap" id="scrolly-wrap">
      <div class="scrolly-sticky">
        <div class="scrolly-inner">
          <div class="scrolly-steps" id="scrolly-steps">
            <div class="scrolly-step" data-target=".brand-row">
              <div class="scrolly-step-num">1</div>
              <h3>Your branding, instantly</h3>
              <p>Their logo and business name appear the second a customer taps — no app required.</p>
            </div>
            <div class="scrolly-step" data-target="table">
              <div class="scrolly-step-num">2</div>
              <h3>Every item, itemized</h3>
              <p>Item names, quantities, and prices — broken down automatically, no manual entry.</p>
            </div>
            <div class="scrolly-step" data-target=".actions">
              <div class="scrolly-step-num">3</div>
              <h3>Save it anywhere</h3>
              <p>One tap saves the receipt to Photos, as a PDF, or straight into their ReceipTap wallet.</p>
            </div>
            <div class="scrolly-step" data-target=".google-review-card">
              <div class="scrolly-step-num">4</div>
              <h3>Google reviews, on autopilot</h3>
              <p>Right when the experience is freshest, one tap sends them to leave a review.</p>
            </div>
            <div class="scrolly-step" data-target=".loyalty-card">
              <div class="scrolly-step-num">5</div>
              <h3>Loyalty that brings them back</h3>
              <p>Stamps collect automatically with every visit — no punch card to lose.</p>
            </div>
          </div>
          <div class="receipt-demo">
            <div class="phone-frame">
              <span class="phone-power-btn"></span>
              <div class="phone-inner">
