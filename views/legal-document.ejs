<!-- views/legal-document.ejs -->
<!-- All three documents have real content now, rendered from
     partials/legal-privacy-content.ejs, partials/legal-terms-content.ejs,
     and partials/legal-dpa-content.ejs -- see routes/legal.js for the
     `documentType`/`entity`/`retention` locals all three depend on. The
     "coming soon" fallback below is now unreachable for TERMS/PRIVACY/DPA;
     it's kept only in case a fourth document type is ever added here
     before its own content is written. -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= doc.label %> - ReceipTap</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
</head>
<body>
  <% if (documentType === 'PRIVACY') { %>
    <%- include('partials/legal-privacy-content', { doc, entity, retention }) %>
  <% } else if (documentType === 'TERMS') { %>
    <%- include('partials/legal-terms-content', { doc, entity, retention }) %>
  <% } else if (documentType === 'DPA') { %>
    <%- include('partials/legal-dpa-content', { doc, entity, retention }) %>
  <% } else if (documentType === 'SHOPPER_TERMS') { %>
    <%- include('partials/legal-shopper-terms-content', { doc, entity, retention }) %>
  <% } else if (documentType === 'SHOPPER_PRIVACY') { %>
    <%- include('partials/legal-shopper-privacy-content', { doc, entity, retention }) %>
  <% } else { %>
    <div class="centered-shell">
      <div class="auth-card">
        <img src="/images/receiptap-logo.png" alt="ReceipTap" style="height: 27px; margin-bottom: 20px;" />
        <h1 style="font-size: 22px; margin-bottom: 6px;"><%= doc.label %></h1>
        <p style="font-size: 13.5px; color: var(--ink-soft); line-height: 1.5; margin: 8px 0 4px;">
          This page is coming soon.
        </p>
        <p style="font-size: 12px; color: var(--ink-soft);">
          Version <%= doc.version %> &middot; last updated <%= doc.lastUpdated %>
        </p>
      </div>
    </div>
  <% } %>
  <%- include('partials/back-affordance', { backFallback: '/' }) %>
</body>
</html>
