<!-- views/legal-reaccept.ejs -->
<!-- Shown when middleware/legalReacceptance.js finds a stale acceptance.
     No policy text -- just the same single-checkbox pattern as signup
     (views/signup.ejs), naming whichever document(s) actually changed
     (changedLabel, built in routes/legal.js from getStaleDocumentTypes()).
     The checkbox's own wording always names all three regardless of which
     one changed -- ticking it is still acceptance of all three, same
     reasoning as signup (see legalAcceptanceService.js). Only the
     document(s) that were actually stale get a new LegalAcceptance row on
     submit, though -- see routes/legal.js. -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Updated Terms - ReceipTap</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
</head>
<body>
  <div class="centered-shell">
    <div class="auth-card">
      <img src="/images/receiptap-logo.png" alt="ReceipTap" style="height: 48px; margin-bottom: 20px;" />
      <h1 style="font-size: 22px; margin-bottom: 6px;">Our <%= changedLabel %> <%= changedLabel.includes(' and ') || changedLabel.includes(',') ? 'have' : 'has' %> been updated</h1>
      <p style="font-size: 13.5px; color: var(--ink-soft); margin: 8px 0 24px; line-height: 1.5;">
        Please review and agree below to keep using your dashboard.
      </p>

      <div class="error-box" id="error-box" style="<%= error ? '' : 'display: none;' %>"><%= error %></div>

      <form method="POST" action="/legal/reaccept">
        <input type="hidden" name="next" value="<%= next %>" />

        <div style="display:flex; flex-direction:column; gap:8px; margin-bottom:18px;">
          <div style="display:flex; align-items:flex-start; gap:8px;">
            <input type="checkbox" id="acceptAll" name="acceptAll" required style="margin-top:2px;" />
            <label for="acceptAll" style="font-size:13px; color:var(--ink-soft); line-height:1.4; font-weight:400;">
              I agree to the <a href="/legal/terms" target="_blank" rel="noopener" style="color:var(--teal-deep); font-weight:600; text-decoration:none;">Terms of Service</a> (v<%= documents.TERMS.version %>), which include the <a href="/legal/dpa" target="_blank" rel="noopener" style="color:var(--teal-deep); font-weight:600; text-decoration:none;">Data Processing Agreement</a> (v<%= documents.DPA.version %>), and I have read the <a href="/legal/privacy" target="_blank" rel="noopener" style="color:var(--teal-deep); font-weight:600; text-decoration:none;">Privacy Policy</a> (v<%= documents.PRIVACY.version %>).
            </label>
          </div>
        </div>

        <button type="submit" class="btn btn-primary">Continue to dashboard</button>
      </form>

      <form method="POST" action="/logout" style="margin-top: 20px; text-align: center;">
        <button type="submit" style="background:none; border:none; padding:0; font-size:13px; color:var(--teal-deep); font-weight:600; cursor:pointer;">Log out instead</button>
      </form>
    </div>
  </div>
</body>
</html>
