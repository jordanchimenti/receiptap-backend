<!-- views/login.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Log In - ReceipTap</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
</head>
<body>
  <div class="centered-shell">
    <div class="auth-card">
      <img src="/images/receiptap-logo.png" alt="ReceipTap" style="height: 60px; margin-bottom: 20px;" />
      <h1 style="font-size: 22px; margin-bottom: 6px;">Log in to ReceipTap</h1>
      <p style="font-size: 13.5px; color: var(--ink-soft); margin: 8px 0 24px; line-height: 1.5;">
        Manage your receipts, POS connections, and locations.
      </p>

      <div class="error-box" id="error-box" style="<%= error ? '' : 'display: none;' %>"><%= error %></div>
      <% if (typeof deactivated !== 'undefined' && deactivated) { %>
        <div class="error-box" style="color: var(--ink-soft); background: var(--paper);">Your account has been deactivated. Contact support if this was a mistake.</div>
      <% } %>

      <% if (googleClientId) { %>
        <div id="google-signin-btn" style="display: flex; justify-content: center; margin-bottom: 14px;"></div>
        <div style="display: flex; align-items: center; gap: 10px; font-size: 12px; color: var(--ink-soft); margin: 14px 0;">
          <span style="flex: 1; height: 1px; background: var(--line);"></span>
          or
          <span style="flex: 1; height: 1px; background: var(--line);"></span>
        </div>
      <% } %>

      <form method="POST" action="/login">
        <input type="hidden" name="redirect" value="<%= redirect %>" />
        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required autofocus />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required />
        </div>
        <button type="submit" class="btn btn-primary">Log in</button>
      </form>

      <p style="font-size: 13px; margin-top: 14px; text-align: center;">
        <a href="/forgot-password" style="color: var(--teal-deep); font-weight: 600; text-decoration: none;">Forgot password?</a>
      </p>

      <p style="font-size: 13px; color: var(--ink-soft); margin-top: 12px; text-align: center;">
        New here? <a href="/signup" style="color: var(--teal-deep); font-weight: 600; text-decoration: none;">Create a merchant account</a>
      </p>
    </div>
  </div>

  <% if (googleClientId) { %>
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <script>
      async function handleGoogleSignIn(response) {
        const res = await fetch('/merchant/google', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ credential: response.credential }),
        });
        const data = await res.json();
        if (!res.ok) {
          const el = document.getElementById('error-box');
          el.textContent = data.error || 'Google sign-in failed.';
          el.style.display = 'block';
          return;
        }
        window.location.href = data.redirect;
      }

      window.onload = function () {
        if (window.google && window.google.accounts) {
          google.accounts.id.initialize({
            client_id: '<%= googleClientId %>',
            callback: handleGoogleSignIn,
          });
          google.accounts.id.renderButton(
            document.getElementById('google-signin-btn'),
            { theme: 'outline', size: 'large', width: 280 }
          );
        }
      };
    </script>
  <% } %>
</body>
</html>
