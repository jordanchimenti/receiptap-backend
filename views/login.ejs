<!-- views/login.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Log In - ReceipTap</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
</head>
<body>
  <div class="centered-shell">
    <div class="auth-card">
      <img src="/images/receiptap-logo.png" alt="ReceipTap" style="height: 60px; margin-bottom: 20px;" />
      <h1 style="font-size: 22px; margin-bottom: 6px;">Log in to ReceipTap</h1>
      <p style="font-size: 13.5px; color: var(--ink-soft); margin: 8px 0 24px; line-height: 1.5;">
        Manage your receipts, POS connections, and locations.
      </p>

      <% if (error) { %><div class="error-box"><%= error %></div><% } %>

      <form method="POST" action="/login">
        <input type="hidden" name="redirect" value="<%= redirect %>" />
        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required autofocus />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required />
        </div>
        <button type="submit" class="btn btn-primary">Log in</button>
      </form>

      <p style="font-size: 13px; color: var(--ink-soft); margin-top: 20px; text-align: center;">
        New here? <a href="/signup" style="color: var(--teal-deep); font-weight: 600; text-decoration: none;">Create a merchant account</a>
      </p>
    </div>
  </div>
</body>
</html>
