<!-- views/loyalty-redeem.ejs -->
<!-- Where a merchant confirms a customer's in-person reward redemption:
     customer reads a 4-digit code off their phone, merchant types it here,
     sees who it belongs to and what the offer is, and confirms it. The
     customer's own screen (polling) then shows them a signature pad. -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Redeem a Reward</title>
  <style>
    h1 { font-size: 22px; }
    .redeem-card {
      background: #f9fafb; border-radius: 10px; padding: 20px; max-width: 420px; margin-top: 16px;
    }
    label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; }
    input[type=text] {
      width: 100%; padding: 12px 14px; border: 1px solid #ddd; border-radius: 8px;
      box-sizing: border-box; font-size: 22px; letter-spacing: 4px; text-align: center;
      font-family: ui-monospace, monospace;
    }
    button {
      margin-top: 14px; width: 100%; padding: 12px; background: #2563eb; color: #fff;
      border: none; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 14px;
    }
    .banner { padding: 10px 14px; border-radius: 8px; font-size: 13px; margin-bottom: 16px; max-width: 420px; }
    .banner.error { background: #fef2f2; color: #dc2626; }
    .banner.success { background: #ecfdf5; color: #047857; }
    .lookup-result { margin-top: 18px; padding-top: 18px; border-top: 1px solid #e5e7eb; }
    .lookup-name { font-weight: 700; font-size: 16px; }
    .lookup-offer { font-size: 14px; color: #555; margin-top: 4px; }
    .confirm-btn { background: #059669; }
  </style>
</head>
<body>
  <%- include('partials/dashboard-header', { activeNav: 'loyalty' }) %>

  <div class="topbar">
    <div>
      <h1>Redeem a Reward</h1>
      <p class="sub">Enter the code your customer reads off their phone.</p>
    </div>
  </div>

  <div class="app-body">
    <% if (confirmed) { %>
      <div class="banner success">Confirmed! Ask the customer to sign on their phone now.</div>
    <% } %>
    <% if (error) { %>
      <div class="banner error"><%= error %></div>
    <% } %>

    <div class="redeem-card">
      <form method="GET" action="/dashboard/loyalty/redeem">
        <label>Redemption code</label>
        <input type="text" name="code" value="<%= code %>" maxlength="4" inputmode="numeric" autofocus placeholder="0000" />
        <button type="submit">Look Up</button>
      </form>

      <% if (lookup) { %>
        <div class="lookup-result">
          <div class="lookup-name"><%= lookup.customerName %></div>
          <div class="lookup-offer">Reward: <%= lookup.offerText %></div>
          <form method="POST" action="/dashboard/loyalty/redeem/confirm">
            <input type="hidden" name="cardId" value="<%= lookup.cardId %>" />
            <button type="submit" class="confirm-btn">Confirm Redemption</button>
          </form>
        </div>
      <% } %>
    </div>
  </div>
</body>
</html>
