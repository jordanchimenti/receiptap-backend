<!-- views/no-live-receipt.ejs -->
<!-- Shown when a customer taps a claimed puck but no sale is currently live
     at that register (either nothing has been rung in recently, or the
     3-minute window on the last sale has already expired). -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ReceipTap</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
</head>
<body>
  <div style="min-height: 100vh; display: flex; flex-direction: column;">

    <!-- Top: merchant acquisition pitch -->
    <div style="text-align: center; padding: 20px 16px 16px;">
      <p style="font-size: 14px; color: var(--ink); margin: 0 0 4px; line-height: 1.4;">
        Interested in digital receipts for your business?
      </p>
      <a href="/signup" style="font-size: 14px; font-weight: 700; color: var(--teal); text-decoration: underline;">Try ReceipTap FREE</a>
    </div>

    <!-- Middle: the actual "no receipt waiting" message -->
    <div style="flex: 1; display: flex; align-items: center; justify-content: center; padding: 20px;">
      <div class="auth-card">
        <% if (logoUrl) { %>
          <img src="<%= logoUrl %>" alt="<%= businessName %>" style="height: 54px; margin-bottom: 18px; border-radius: 8px;" />
        <% } else { %>
          <img src="/images/receiptap-logo.png" alt="ReceipTap" style="height: 54px; margin-bottom: 18px;" />
        <% } %>
        <h1 style="font-size: 20px; margin-bottom: 6px;">Thanks for visiting <%= businessName %>!</h1>
        <p style="font-size: 13.5px; color: var(--ink-soft); margin: 8px 0 4px; line-height: 1.5;">
          There's no receipt waiting for this tap right now.
        </p>
        <p style="font-size: 13.5px; color: var(--ink-soft); margin: 0; line-height: 1.5;">
          If you just paid, ask your cashier to tap it for you within a couple minutes of ringing up your sale.
        </p>
      </div>
    </div>

    <!-- Bottom: powered-by mark -->
    <div style="text-align: center; padding: 16px;">
      <span style="font-size: 12px; color: var(--ink-soft); vertical-align: middle;">Powered by</span>
      <img src="/images/receiptap-logo.png" alt="ReceipTap" style="height: 16px; vertical-align: middle; margin-left: 5px;" />
    </div>

  </div>
</body>
</html>
