  /* The two halves either side of the raised scan button -- plain flex rows,
     not individually centered, so Dashboard alone on the left and
     Alerts/More together on the right still read as one continuous bar
     rather than three disconnected groups. */
  .w-tab-side { display: flex; flex: 1; justify-content: space-around; }
  .w-tab {
    display: flex; flex-direction: column; align-items: center; gap: 3px; text-decoration: none;
    color: var(--w-ink-soft); font-size: 11px; font-weight: 600; background: none; border: none; cursor: pointer;
    font-family: inherit;
  }
  /* Raised out of the bar rather than sitting in its row -- position:
     relative on an inline flex item so it can carry a negative top offset
     without taking .w-tabbar out of normal flow the way position:absolute
     would. -39px puts this circle's own centre exactly on the bar's flat
     top edge -- concentric with the notch cutout above, which is centred
     there too, so the ring gap around the button reads as one even width
     all the way round rather than wider at the top than at the sides.
     A radial (not linear) gradient reads as a glossy sphere rather than a
     flat disc, and the ::before halo is a much wider, softer glow than a
     box-shadow can produce -- it has its own box to blur within rather
     than being confined to the button's own edge. */
  .w-tab-fab {
    position: relative; top: -39px; flex: none; width: 58px; height: 58px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center; color: #fff;
    background: radial-gradient(circle at 32% 28%, #4d9dff 0%, var(--w-accent) 55%, var(--w-accent-deep) 100%);
    text-decoration: none;
  }
  .w-tab-fab::before {
    /* -60px (a wider prior attempt at fixing the rim below) made the glow
       bleed noticeably far up into the page above the bar -- since the
       button sits low on the screen, that upper half was fully visible
       while the lower half stayed mostly hidden behind the opaque bar
       either side of the notch, so the whole thing read as one big
       lopsided, "stretched" shape rather than a contained glow. Back to
       the original -26px footprint; only the gradient below changed. */
    content: ''; position: absolute; inset: -26px; border-radius: 50%; z-index: -1;
    /* A 3-stop fade still reads as a lit disc with a rim, because opacity
       drops at close to a constant rate right up to the edge where it
       suddenly stops -- the eye reads that remaining rate-of-change as a
       boundary. Approximating a smooth (roughly Gaussian) falloff with
       several stops that decelerate near the edge removes the rim; the
       glow thins out instead of switching off, within the same footprint. */
    background: radial-gradient(circle,
      rgba(5,107,254,0.55) 0%,
      rgba(5,107,254,0.40) 22%,
      rgba(5,107,254,0.25) 42%,
      rgba(5,107,254,0.12) 60%,
      rgba(5,107,254,0.05) 76%,
      rgba(5,107,254,0.015) 90%,
      transparent 100%);
  }
  .w-tab-fab svg { width: 26px; height: 26px; }
  /* Every tap that navigates costs a server round trip, so without this the
     app looks frozen between the tap and the new page. These give the press
     an immediate visual answer -- the work still takes as long, but it stops
     feeling like nothing happened.

     touch-action: manipulation also drops the ~300ms wait some mobile browsers
     keep in case a tap turns into a double-tap zoom. */
  a, button, .w-tab, .menu-row, .setup-row, .receipt-row, label[for] {
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  a:active, button:active, .w-tab:active,
  .menu-row:active, .setup-row:active, .receipt-row:active {
    opacity: 0.62;
    transition: opacity 0.04s ease;
  }
  @media (prefers-reduced-motion: reduce) {
