<!-- views/partner-program-merchant.ejs — public landing page for the Merchant Partner Program -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Merchant Partner Program — ReceipTap</title>
  <meta name="description" content="Refer other merchants to ReceipTap and earn a recurring commission for as long as they stay subscribed." />
  <link rel="stylesheet" href="/css/receiptap.css" />
  <style>
    .nav { display: flex; align-items: center; justify-content: space-between; padding: 18px 6vw; }
    .nav img { height: 40px; }
    .nav-links { display: flex; align-items: center; gap: 18px; }
    .nav-links a { font-size: 14px; font-weight: 500; text-decoration: none; color: var(--ink-soft); }
    .nav-cta { background: var(--teal); color: #fff !important; padding: 9px 16px; border-radius: 8px; font-weight: 600; }

    .hero { padding: 6vh 6vw 8vh; max-width: 760px; margin: 0 auto; text-align: center; }
    .eyebrow { font-size: 12px; font-weight: 700; color: var(--teal-deep); text-transform: uppercase; letter-spacing: 0.07em; margin-bottom: 10px; }
    .hero h1 { font-size: clamp(28px, 4.2vw, 46px); line-height: 1.1; letter-spacing: -0.02em; margin-bottom: 16px; }
    .hero h1 em { font-style: normal; color: var(--teal); }
    .hero-sub { font-size: 16px; color: var(--ink-soft); line-height: 1.55; max-width: 520px; margin: 0 auto 28px; }
    .cta-row { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
    .cta-main {
      display: inline-block; background: var(--teal); color: #fff; font-size: 15.5px; font-weight: 700;
      padding: 14px 26px; border-radius: 10px; text-decoration: none;
    }
    .cta-main:hover { background: var(--teal-deep); }
    .cta-secondary {
      display: inline-block; background: var(--paper-raised); color: var(--ink); font-size: 15.5px; font-weight: 700;
      padding: 14px 26px; border-radius: 10px; text-decoration: none; border: 1px solid var(--line);
    }

    .rate-band { background: var(--paper-raised); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 44px 6vw; text-align: center; }
    .rate-value { font-family: var(--font-mono); font-size: 48px; font-weight: 600; color: var(--teal); }
    .rate-band p { font-size: 14.5px; color: var(--ink-soft); max-width: 460px; margin: 8px auto 0; line-height: 1.55; }

    .section { padding: 56px 6vw; max-width: 900px; margin: 0 auto; }
    .section h2 { font-size: clamp(22px, 3vw, 30px); letter-spacing: -0.015em; margin-bottom: 28px; text-align: center; }
    .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
    .step { background: var(--paper-raised); border: 1px solid var(--line); border-radius: 16px; padding: 24px; }
    .step .s-num {
      width: 30px; height: 30px; border-radius: 50%; background: var(--teal); color: #fff;
      font-weight: 700; font-size: 14px; display: flex; align-items: center; justify-content: center; margin-bottom: 14px;
    }
    .step h3 { font-size: 15.5px; margin-bottom: 6px; }
    .step p { font-size: 13.5px; color: var(--ink-soft); line-height: 1.55; margin: 0; }

    .cross-link { text-align: center; padding: 0 6vw 56px; font-size: 13.5px; color: var(--ink-soft); }
    .cross-link a { color: var(--teal-deep); font-weight: 600; text-decoration: none; }

    footer { padding: 28px 6vw; display: flex; justify-content: space-between; align-items: center; font-size: 12.5px; color: var(--ink-soft); }

    @media (max-width: 720px) {
      .steps { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

  <nav class="nav">
    <a href="/"><img src="/images/receiptap-logo.png" alt="ReceipTap" /></a>
    <div class="nav-links">
      <a href="/partner-program/affiliate">Affiliate Partner Program</a>
      <a href="/login">Log in</a>
      <a href="/signup" class="nav-cta">Start free trial</a>
    </div>
  </nav>

  <header class="hero">
    <div class="eyebrow">Merchant Partner Program</div>
    <h1>Refer other <em>businesses</em>.<br />Earn on every sale they make.</h1>
    <p class="hero-sub">
      You already know other business owners who'd love ReceipTap. Send them your link — when they
      subscribe, you earn a recurring commission for as long as they stay a customer.
    </p>
    <div class="cta-row">
      <a class="cta-main" href="/login">Log in to get your referral link</a>
      <a class="cta-secondary" href="/signup">New here? Start your free trial</a>
    </div>
  </header>

  <section class="rate-band">
    <div class="rate-value"><%= rate %>%</div>
    <p>Recurring commission on every referred merchant's subscription payment, for as long as both of you stay subscribed.</p>
  </section>

  <section class="section">
    <h2>How it works</h2>
    <div class="steps">
      <div class="step">
        <div class="s-num">1</div>
        <h3>Log in to your dashboard</h3>
        <p>Every ReceipTap merchant already has a referral link waiting under "Partner Program" — no separate signup needed.</p>
      </div>
      <div class="step">
        <div class="s-num">2</div>
        <h3>Share your link</h3>
        <p>Send it to other business owners. When they sign up through it, they're tracked as your referral automatically.</p>
      </div>
      <div class="step">
        <div class="s-num">3</div>
        <h3>Get paid</h3>
        <p>Connect a payout account once, and your commission is sent automatically every time they pay their subscription.</p>
      </div>
    </div>
  </section>

  <div class="cross-link">
    Not a merchant, but well-connected to businesses that could be?
    <a href="/partner-program/affiliate">See the Affiliate Partner Program instead →</a>
  </div>

  <footer>
    <span>© 2026 ReceipTap</span>
    <span><a href="/login" style="color: inherit;">Merchant log in</a> · <a href="/" style="color: inherit;">Home</a></span>
  </footer>

</body>
</html>
