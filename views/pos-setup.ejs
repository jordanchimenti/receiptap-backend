<!-- views/pos-setup.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Connect Your POS</title>
  <style>
    .connect-btn { display: inline-block; background: #111; color: #fff; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; margin-top: 12px; }
    .location-row { display: flex; justify-content: space-between; align-items: center; padding: 14px; background: #f9fafb; border-radius: 8px; margin-bottom: 8px; }
    select { padding: 6px 10px; border-radius: 6px; border: 1px solid #ddd; }
    .connected-badge { color: #059669; font-weight: 600; font-size: 13px; }
    .connected-row { display: flex; align-items: center; gap: 12px; }
    .disconnect-btn { background: none; border: none; color: #dc2626; font-size: 13px; font-weight: 600; cursor: pointer; padding: 0; text-decoration: underline; }
  </style>
</head>
<body>
  <%- include('partials/dashboard-header', { activeNav: 'pos' }) %>

  <div class="topbar">
    <div>
      <h1>Connect Your Point of Sale</h1>
    </div>
  </div>

  <div class="app-body">

  <h2 style="margin-top:0;">Square</h2>
  <% if (!connected) { %>
    <p>Connect your Square account so ReceipTap can automatically generate receipts from your sales.</p>
    <a class="connect-btn" href="/oauth/square/connect">Connect Square</a>
    <p><a href="/dashboard/pos-setup/guide#square">How to connect &amp; assign a puck &rarr;</a></p>
  <% } else { %>
    <div class="connected-row">
      <div class="connected-badge">✅ Square Connected</div>
      <%- include('partials/disconnect-pos-form', { provider: 'square' }) %>
    </div>
    <p>Assign a ReceipTap puck to each register:</p>

    <% locations.forEach(function(loc) { %>
      <div class="location-row">
        <div><strong><%= loc.name %></strong> <div style="font-size:13px;color:#888;"><%= loc.address ? loc.address.address_line_1 : '' %></div></div>
        <select onchange="assignPuck('<%= loc.id %>', this.value)">
          <option value="">Select a puck...</option>
          <% pucks.forEach(function(p) { %>
            <option value="<%= p.id %>" <%= p.posLocationId === loc.id ? 'selected' : '' %>><%= p.id %></option>
          <% }); %>
        </select>
      </div>
    <% }); %>
  <% } %>

  <h2>Clover</h2>
  <% if (!cloverConnected) { %>
    <p>Connect your Clover account so ReceipTap can automatically generate receipts from your sales.</p>
    <a class="connect-btn" href="/oauth/clover/connect">Connect Clover</a>
    <p><a href="/dashboard/pos-setup/guide#clover">How to connect &amp; assign a puck &rarr;</a></p>
  <% } else { %>
    <div class="connected-row">
      <div class="connected-badge">✅ Clover Connected</div>
      <%- include('partials/disconnect-pos-form', { provider: 'clover' }) %>
    </div>
    <p>A Clover connection is one store, so just assign a puck to it:</p>

    <div class="location-row">
      <div><strong>Register</strong></div>
      <select onchange="assignCloverPuck(this.value)">
        <option value="">Select a puck...</option>
        <% pucks.forEach(function(p) { %>
          <option value="<%= p.id %>" <%= p.posLocationId === cloverMerchantId ? 'selected' : '' %>><%= p.id %></option>
        <% }); %>
      </select>
    </div>
  <% } %>

  <h2>Lightspeed</h2>
  <% if (!lightspeedConnected) { %>
    <p>Connect your Lightspeed Retail account so ReceipTap can automatically generate receipts from your sales.</p>
    <a class="connect-btn" href="/oauth/lightspeed/connect">Connect Lightspeed</a>
    <p><a href="/dashboard/pos-setup/guide#lightspeed">How to connect &amp; assign a puck &rarr;</a></p>
  <% } else { %>
    <div class="connected-row">
      <div class="connected-badge">✅ Lightspeed Connected</div>
      <%- include('partials/disconnect-pos-form', { provider: 'lightspeed' }) %>
    </div>
    <p>A Lightspeed connection is one store, so just assign a puck to it:</p>

    <div class="location-row">
      <div><strong>Register</strong></div>
      <select onchange="assignLightspeedPuck(this.value)">
        <option value="">Select a puck...</option>
        <% pucks.forEach(function(p) { %>
          <option value="<%= p.id %>" <%= p.posLocationId === lightspeedDomainPrefix ? 'selected' : '' %>><%= p.id %></option>
        <% }); %>
      </select>
    </div>
  <% } %>

  <h2>Shopify</h2>
  <% if (!shopifyConnected) { %>
    <p>Connect your Shopify POS account so ReceipTap can automatically generate receipts from in-person sales.</p>
    <form onsubmit="event.preventDefault(); connectShopify();" style="display:flex; gap:8px; align-items:center; margin-top:12px;">
      <input type="text" id="shopify-domain" placeholder="yourstorename.myshopify.com" style="padding:8px 12px; border-radius:6px; border:1px solid #ddd; min-width:260px;" />
      <button type="submit" class="connect-btn" style="margin-top:0;">Connect Shopify</button>
    </form>
    <p><a href="/dashboard/pos-setup/guide#shopify">How to connect &amp; assign a puck &rarr;</a></p>
  <% } else { %>
    <div class="connected-row">
      <div class="connected-badge">✅ Shopify Connected (<%= shopifyShopDomain %>)</div>
      <%- include('partials/disconnect-pos-form', { provider: 'shopify' }) %>
    </div>
    <p>A Shopify connection is one store, so just assign a puck to it:</p>

    <div class="location-row">
      <div><strong>Register</strong></div>
      <select onchange="assignShopifyPuck(this.value)">
        <option value="">Select a puck...</option>
        <% pucks.forEach(function(p) { %>
          <option value="<%= p.id %>" <%= p.posLocationId === shopifyShopDomain ? 'selected' : '' %>><%= p.id %></option>
        <% }); %>
      </select>
    </div>
  <% } %>

  </div>

  <script>
    function connectShopify() {
      const domain = document.getElementById('shopify-domain').value.trim().toLowerCase();
      if (!domain) return;
      window.location.href = '/oauth/shopify/connect?shop=' + encodeURIComponent(domain);
    }

    async function assignShopifyPuck(puckId) {
      if (!puckId) return;
      await fetch('/dashboard/pos-setup/assign-shopify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ puckId }),
      });
      alert('Puck assigned to your Shopify store.');
    }

    async function assignPuck(locationId, puckId) {
      if (!puckId) return;
      await fetch('/dashboard/pos-setup/assign', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ puckId, locationId }),
      });
      alert('Puck assigned to this register.');
    }

    async function assignCloverPuck(puckId) {
      if (!puckId) return;
      await fetch('/dashboard/pos-setup/assign-clover', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ puckId }),
      });
      alert('Puck assigned to your Clover store.');
    }

    async function assignLightspeedPuck(puckId) {
      if (!puckId) return;
      await fetch('/dashboard/pos-setup/assign-lightspeed', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ puckId }),
      });
      alert('Puck assigned to your Lightspeed store.');
    }
  </script>
</body>
</html>
