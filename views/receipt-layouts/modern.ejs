<!-- views/receipt-layouts/modern.ejs -->
<!-- Layout: Modern — bold accent-colored header band, big emphasized total -->
<style>
  .layout-modern {
    max-width: 420px; margin: 0 auto; background: #fff; border-radius: 16px;
    overflow: hidden; box-shadow: 0 4px 16px rgba(0,0,0,0.12); box-sizing: border-box;
  }
  .layout-modern .header-band {
    background: var(--accent); color: #fff; padding: 28px 24px 22px; text-align: center;
  }
  .layout-modern .brand-row { display: flex; margin-bottom: 10px; }
  .layout-modern .powered-by { display: inline-flex; align-items: center; gap: 5px; font-size: 10px; color: rgba(255,255,255,0.75); text-decoration: none; }
  .layout-modern .powered-wordmark { font-weight: 700; font-size: 12px; letter-spacing: 0.01em; color: #fff; }
  .layout-modern .merchant-logo { max-height: 60px; max-width: 190px; object-fit: contain; display: block; margin: 12px auto 12px; filter: brightness(0) invert(1); }
  .layout-modern .logo-placeholder {
    height: 36px; width: 120px; margin: 10px auto 10px; display: flex; align-items: center; justify-content: center;
    border: 1px dashed rgba(255,255,255,0.5); border-radius: 6px; background: rgba(255,255,255,0.1);
    font-size: 10px; color: rgba(255,255,255,0.8); text-transform: uppercase; letter-spacing: 0.04em;
  }
  .layout-modern .business-name { font-size: 21px; font-weight: 800; margin-bottom: 4px; }
  .layout-modern .location { font-size: 12px; opacity: 0.8; margin-bottom: 4px; }
  .layout-modern .meta-light { font-size: 12px; opacity: 0.85; }
  .layout-modern .header-text { font-size: 13px; opacity: 0.9; margin-top: 10px; }
  .layout-modern .body-content { padding: 20px 24px; }
  .layout-modern .item-row {
    display: flex; justify-content: space-between; padding: 8px 0;
    border-bottom: 1px solid #f2f2f2; font-size: 14px; color: var(--primary);
  }
  .layout-modern .item-row.spacious { padding: 15px 0; }
  .layout-modern .item-name { font-weight: 500; }
  .layout-modern .item-qty { color: #999; font-size: 12px; }
  .layout-modern .totals-block { margin-top: 14px; }
  .layout-modern .totals-row { display: flex; justify-content: space-between; font-size: 13px; padding: 3px 0; color: #666; }
  .layout-modern .total-big {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-top: 10px; padding-top: 12px; border-top: 2px solid var(--primary);
  }
  .layout-modern .total-big .label { font-size: 13px; color: #666; }
  .layout-modern .total-big .amount { font-size: 26px; font-weight: 800; color: var(--primary); }
  .layout-modern .payment-pill {
    display: inline-block; margin-top: 12px; font-size: 12px; color: #666;
    background: #f4f4f5; padding: 4px 10px; border-radius: 20px;
  }
</style>
<div class="layout-modern">
  <div class="header-band">
    <div class="brand-row">
      <a class="powered-by" href="/">
        <span>Powered by</span>
        <span class="powered-wordmark">ReceipTap</span>
      </a>
    </div>
    <% if (theme.showLogo !== false && theme.logoUrl) { %>
      <img class="merchant-logo" src="<%= theme.logoUrl %>" alt="<%= merchant.businessName %>" />
    <% } else if (typeof isPreview !== 'undefined' && isPreview) { %>
      <div class="logo-placeholder"><%= typeof logoPlaceholderText !== 'undefined' ? logoPlaceholderText : 'Custom Logo' %></div>
    <% } %>
    <% if (theme.showBusinessName !== false) { %>
      <div class="business-name"><%= theme.displayName || merchant.businessName %></div>
    <% } %>
    <% if (theme.showPhone !== false && theme.phone) { %>
      <div class="location"><%= theme.phone %></div>
    <% } %>
    <% if (theme.showBusinessEmail !== false && merchant.businessEmail) { %>
      <div class="location"><%= merchant.businessEmail %></div>
    <% } %>
    <% if (theme.showWebsite !== false && merchant.website) { %>
      <div class="location"><%= merchant.website %></div>
    <% } %>
    <% if (theme.showDateTime !== false) { %>
      <div class="meta-light"><%= transaction.date %></div>
    <% } %>
    <% if (theme.showReceiptNumber !== false) { %>
      <div class="meta-light">
        Receipt #<%= transaction.id %><% if (transaction.orderNumber && transaction.orderNumber !== transaction.id) { %> &middot; Order #<%= transaction.orderNumber %><% } %>
      </div>
    <% } %>
    <% if (theme.showRegister && transaction.posDeviceId) { %>
      <div class="meta-light">Register <%= transaction.posDeviceId %></div>
    <% } %>
    <% if (theme.headerText) { %>
      <div class="header-text"><%= theme.headerText %></div>
    <% } %>
  </div>
  <div class="body-content">
    <% transaction.lineItems.forEach(function(item) { %>
      <div class="item-row <%= theme.itemLayout === 'spacious' ? 'spacious' : '' %>">
        <div>
          <div class="item-name"><%= item.name %></div>
          <% var showQty = theme.showItemQuantity !== false;
             var showUnit = theme.showItemUnitPrice !== false && item.unitPrice !== undefined
                            && (theme.itemLayout === 'detailed' || theme.itemLayout === 'spacious' || item.quantity > 1); %>
          <% if (showQty || showUnit) { %>
            <div class="item-qty">
              <% if (showQty) { %>Qty <%= item.quantity %><% } %><% if (showQty && showUnit) { %> &middot; <% } %><% if (showUnit) { %>$<%= (item.unitPrice / 100).toFixed(2) %> each<% } %>
            </div>
          <% } %>
        </div>
        <% if (theme.showItemLineTotal !== false) { %><div>$<%= (item.total / 100).toFixed(2) %></div><% } %>
      </div>
    <% }); %>
    <div class="totals-block">
      <% if (theme.showSubtotal !== false) { %>
        <div class="totals-row"><span>Subtotal</span><span>$<%= transaction.subtotal %></span></div>
      <% } %>
      <% if (theme.showDiscounts !== false && transaction.discount && parseFloat(transaction.discount) > 0) { %>
        <div class="totals-row"><span>Discount</span><span>-$<%= transaction.discount %></span></div>
      <% } %>
      <% if (theme.showTax !== false) { %>
        <div class="totals-row"><span><%= theme.taxLabel || 'Tax' %></span><span>$<%= transaction.tax %></span></div>
      <% } %>
      <% if (theme.showTotal !== false) { %>
        <% if (theme.totalProminent === false) { %>
          <div class="totals-row" style="font-weight:700; color:#111;"><span>Total</span><span>$<%= transaction.total %></span></div>
        <% } else { %>
          <div class="total-big"><span class="label">Total</span><span class="amount">$<%= transaction.total %></span></div>
        <% } %>
      <% } %>
    </div>
    <% if (theme.showPaymentMethod !== false) { %>
      <div class="payment-pill">
        <%= transaction.paymentMethod ? transaction.paymentMethod + ' — Paid' : 'Paid' %>
      </div>
    <% } %>
    <%# Only ever rendered from what the POS actually reported -- each of these
        is null unless the provider sent it, so a receipt never shows a card
        tail or approval code that was inferred. %>
    <% if (theme.showCardTail !== false && transaction.cardBrand && transaction.cardLast4 && !transaction.paymentMethod) { %>
            <div style="font-size:12px; color:#888; margin-top:4px;"><%= transaction.cardBrand %> ••••<%= transaction.cardLast4 %></div>
    <% } %>
    <% if (theme.showApprovalCode && transaction.authCode) { %>
            <div style="font-size:12px; color:#888; margin-top:4px;">Approval <%= transaction.authCode %></div>
    <% } %>
    <% if (theme.showTenderChange !== false && transaction.amountTenderedCents !== null && transaction.amountTenderedCents !== undefined) { %>
            <div style="font-size:12px; color:#888; margin-top:4px;">Tendered $<%= (transaction.amountTenderedCents / 100).toFixed(2) %></div>
    <% } %>
    <% if (theme.showTenderChange !== false && transaction.changeDueCents !== null && transaction.changeDueCents !== undefined) { %>
            <div style="font-size:12px; color:#888; margin-top:4px;">Change $<%= (transaction.changeDueCents / 100).toFixed(2) %></div>
    <% } %>

    <% if (theme.showTaxNumber !== false && theme.gstHstNumber) { %>
      <div style="font-size:12px; color:#888; margin-top:8px;">GST/HST #<%= theme.gstHstNumber %></div>
    <% } %>
    <% if (theme.showAddress !== false && businessAddressLines.length > 0) { %>
      <div style="font-size:12px; color:#888; margin-top:6px;"><% businessAddressLines.forEach(function(line, i) { %><%= line %><% if (i < businessAddressLines.length - 1) { %><br /><% } %><% }); %></div>
    <% } %>
    <% if (theme.returnPolicy) { %>
      <div style="font-size:12px; color:#888; margin-top:6px;"><%= theme.returnPolicy %></div>
    <% } %>
    <% if (theme.footerLegal) { %>
      <div style="font-size:12px; color:#888; margin-top:6px;"><%= theme.footerLegal %></div>
    <% } %>
    <div style="font-size:12px; font-weight:600; color:#666; margin-top:12px;">
      <% if (typeof isMerchantCopy !== 'undefined' && isMerchantCopy) { %>
        Merchant Copy — for business records only
      <% } else { %>
        Customer Copy — please retain for your records
      <% } %>
    </div>
  </div>
</div>
