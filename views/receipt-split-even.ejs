<!-- views/receipt-split-even.ejs -->
<!-- Split the Bill, step 3 ("Split evenly"): pick how many people are
     splitting and divide the real saved subtotal/tax/tip evenly across
     them. Everything computed here comes from the ScannedReceipt row
     Confirm Items already saved -- nothing invented.

     No invite links or guest-facing page -- "Split $X" creates the real
     SplitGroup (see the schema comment on that model), recording the
     host's own one share so the rest is what's left to collect, and takes
     the host straight to "Collecting". -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Split Evenly - ReceipTap</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
  <%- include('partials/wallet-dark-theme') %>
  <style>
    .split-header { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; }
    .split-merchant { font-size: 24px; font-weight: 700; margin: 4px 0 6px; }
    .split-date-row { display: flex; align-items: center; gap: 7px; color: var(--w-ink-soft); font-size: 13.5px; padding-bottom: 16px; border-bottom: 1px solid var(--w-line); margin-bottom: 26px; }

    .split-step-label { text-align: center; font-size: 15px; font-weight: 700; margin-bottom: 4px; }
    .split-step-sub { text-align: center; font-size: 12.5px; color: var(--w-ink-soft); margin-bottom: 22px; }

    .headcount-pill {
      display: flex; align-items: center; background: var(--w-card); border: 1px solid var(--w-line);
      border-radius: 18px; padding: 8px; margin-bottom: 12px;
    }
    .headcount-btn {
      width: 42px; height: 42px; border-radius: 12px; border: none; flex-shrink: 0; cursor: pointer;
      background: var(--w-card-raised); color: var(--w-ink); font-size: 18px; font-weight: 700;
      display: flex; align-items: center; justify-content: center;
    }
    .headcount-btn.plus { background: var(--w-accent); color: #fff; }
    .headcount-avatars { flex: 1; display: flex; justify-content: center; align-items: flex-end; gap: 14px; flex-wrap: wrap; padding: 0 8px; }
    .avatar-col { display: flex; flex-direction: column; align-items: center; gap: 5px; }
    .avatar-col-label { font-size: 10px; font-weight: 700; letter-spacing: 0.04em; color: #b592f7; text-transform: uppercase; }
    .avatar-circle {
      width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff;
    }
    .avatar-circle.you { background: linear-gradient(140deg, #35d0ff, var(--w-accent-deep)); }
    .avatar-circle.guest { background: var(--w-card-raised); border: 1.5px solid var(--w-line); color: var(--w-ink-soft); }
    .split-ways-label { text-align: center; font-size: 15px; font-weight: 700; color: var(--w-accent); margin-bottom: 26px; }

    .tip-eyebrow { font-size: 13px; color: var(--w-ink-soft); margin: 0 2px 6px; }
    .tip-row { display: flex; align-items: baseline; justify-content: space-between; margin: 0 2px 12px; }
    .tip-row-label { font-size: 15.5px; font-weight: 700; }
    .tip-row-value { font-size: 15.5px; font-weight: 700; color: var(--w-accent); font-variant-numeric: tabular-nums; }
    .tip-options { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 26px; }
    .tip-option {
      background: var(--w-card-raised); border: 1.5px solid var(--w-line); border-radius: 10px;
      color: var(--w-ink); font-size: 13.5px; font-weight: 700; font-family: inherit;
      padding: 11px 4px; cursor: pointer; text-align: center;
    }
    .tip-option.active { border-color: var(--w-accent); color: var(--w-accent); background: var(--w-accent-wash); }
    .tip-custom-row { display: none; gap: 8px; margin-top: 10px; }
    .tip-custom-row.open { display: flex; }
    .tip-mode-btn {
      flex-shrink: 0; width: 54px; background: var(--w-card-raised); border: 1.5px solid var(--w-line);
      border-radius: 10px; color: var(--w-ink); font-size: 13.5px; font-weight: 700; cursor: pointer;
    }
    .tip-mode-btn.active { border-color: var(--w-accent); color: var(--w-accent); background: var(--w-accent-wash); }
    .tip-custom-input {
      flex: 1; background: var(--w-card-raised); border: 1.5px solid var(--w-line); border-radius: 10px;
      color: var(--w-ink); font-size: 14.5px; font-family: inherit; padding: 10px 12px;
    }
    .tip-custom-input:focus { outline: none; border-color: var(--w-accent); }

    .total-card { background: var(--w-card); border: 1px solid var(--w-line); border-radius: 16px; padding: 16px; margin-bottom: 24px; }
    .total-card-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
    .total-card-title { font-size: 15.5px; font-weight: 700; }
    .total-photo {
      flex-shrink: 0; width: 56px; height: 56px; border-radius: 12px; overflow: hidden; position: relative;
      border: none; padding: 0; cursor: pointer;
    }
    .total-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .total-photo-label {
      position: absolute; inset: auto 0 0 0; background: rgba(0,0,0,0.6); color: #fff;
      font-size: 10px; font-weight: 700; text-align: center; padding: 3px 0;
    }
    .total-row { display: flex; align-items: center; justify-content: space-between; padding: 6px 0; font-size: 14px; color: var(--w-ink-soft); }
    .total-row.grand { border-top: 1px solid var(--w-line); margin-top: 6px; padding-top: 14px; font-size: 16px; font-weight: 700; color: var(--w-ink); }
    .total-row.grand span:last-child { color: var(--w-accent); font-variant-numeric: tabular-nums; }
    .per-person-label { font-size: 13.5px; font-weight: 700; margin: 16px 0 4px; }
    .breakdown-note { font-size: 11.5px; color: var(--w-ink-soft); margin-top: 12px; }

    .split-continue-btn {
      width: 100%; border: none; border-radius: 14px; padding: 16px; font-size: 16px; font-weight: 700;
      color: #fff; cursor: pointer; font-family: inherit;
      background: linear-gradient(90deg, var(--w-accent-deep), var(--w-accent) 55%, #35d0ff);
      box-shadow: 0 6px 24px rgba(5,107,254,0.35);
      margin-bottom: max(16px, env(safe-area-inset-bottom));
    }
  </style>
</head>
<body data-no-pull-refresh>
  <div class="w-shell">
    <div class="split-header">
      <a href="/account/receipts/scanned/<%= receipt.id %>/split" class="w-btn-icon" aria-label="Back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      </a>
    </div>
    <div class="split-merchant"><%= receipt.merchantName %></div>
    <div class="split-date-row">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
      <%= receipt.purchaseDate ? receipt.purchaseDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) : 'Date not recorded' %>
    </div>

    <div class="split-step-label">Step 3: How many people are splitting?</div>
    <div class="split-step-sub">Select the total number of people splitting (including you)</div>

    <div class="headcount-pill">
      <button type="button" class="headcount-btn" id="headcount-minus" aria-label="Fewer people">&minus;</button>
      <div class="headcount-avatars" id="headcount-avatars"></div>
      <button type="button" class="headcount-btn plus" id="headcount-plus" aria-label="More people">+</button>
    </div>
    <div class="split-ways-label" id="split-ways-label">Split 2 Ways</div>

    <div class="tip-eyebrow">How much did you tip on the receipt?</div>
    <div class="tip-row">
      <span class="tip-row-label">Receipt Tip</span>
      <span class="tip-row-value" id="tip-summary">0% (<%= receipt.currency || 'CA' %>$0)</span>
    </div>
    <div class="tip-options">
      <button type="button" class="tip-option" data-tip-preset="15">15%</button>
      <button type="button" class="tip-option" data-tip-preset="20">20%</button>
      <button type="button" class="tip-option" data-tip-preset="25">25%</button>
      <button type="button" class="tip-option" id="tip-custom-toggle">%&nbsp;/&nbsp;<%= receipt.currency || 'CA' %>$</button>
    </div>
    <div class="tip-custom-row" id="tip-custom-row">
      <button type="button" class="tip-mode-btn active" id="tip-mode-percent">%</button>
      <button type="button" class="tip-mode-btn" id="tip-mode-amount"><%= receipt.currency || 'CA' %>$</button>
      <input type="number" inputmode="decimal" min="0" step="0.01" class="tip-custom-input" id="tip-custom-input" placeholder="Enter %" />
    </div>

    <div class="total-card">
      <div class="total-card-head">
        <div class="total-card-title">Receipt Total</div>
        <button type="button" class="total-photo" aria-label="View receipt photo"
                onclick="openImageViewer('/account/receipts/scanned/<%= receipt.id %>/image', '<%= receipt.merchantName.replace(/'/g, "\\'") %>')">
          <img src="/account/receipts/scanned/<%= receipt.id %>/image" alt="Receipt photo" />
          <span class="total-photo-label">View</span>
        </button>
      </div>
      <div class="total-row"><span>Subtotal</span><span id="total-subtotal"><%= receipt.currency || 'CA' %>$0.00</span></div>
      <div class="total-row" id="discount-row" style="display:none;"><span>Discount</span><span id="total-discount"></span></div>
      <div class="total-row"><span>Tax</span><span id="total-tax"><%= receipt.currency || 'CA' %>$0.00</span></div>
      <div class="total-row grand"><span>Total (Split Evenly)</span><span id="total-grand"><%= receipt.currency || 'CA' %>$0.00</span></div>

      <div class="per-person-label">Per person (including you):</div>
      <div class="total-row"><span>Subtotal</span><span id="per-person-subtotal"><%= receipt.currency || 'CA' %>$0.00</span></div>
      <div class="total-row"><span>Tax</span><span id="per-person-tax"><%= receipt.currency || 'CA' %>$0.00</span></div>
      <div class="breakdown-note">This total will be split evenly among you and your guests</div>
    </div>

    <form method="POST" action="/account/receipts/scanned/<%= receipt.id %>/split/even" id="split-even-form">
      <input type="hidden" name="peopleCount" id="people-count-input" />
      <input type="hidden" name="tip" id="tip-input" />
      <input type="hidden" name="perPersonSubtotal" id="per-person-subtotal-input" />
      <input type="hidden" name="perPersonTax" id="per-person-tax-input" />
      <input type="hidden" name="perPersonTotal" id="per-person-total-input" />
      <button type="submit" class="split-continue-btn" id="split-submit-btn">Split <%= receipt.currency || 'CA' %>$<%= money(receipt.total) %></button>
    </form>
  </div>

  <%- include('partials/image-viewer') %>

  <script>
    const currencyPrefix = <%- JSON.stringify(receipt.currency || 'CA') %> + '$';
    const subtotalDollars = <%- JSON.stringify((receipt.subtotal != null ? receipt.subtotal : receipt.total) / 100) %>;
    const taxDollars = <%- JSON.stringify((receipt.tax || 0) / 100) %>;
    const receiptTipDollars = <%- JSON.stringify((receipt.tip || 0) / 100) %>;
    const receiptTotalDollars = <%- JSON.stringify(receipt.total / 100) %>;

    function money(n) { return currencyPrefix + (Math.round((n + Number.EPSILON) * 100) / 100).toFixed(2); }

    let peopleCount = 2;
    const avatarsEl = document.getElementById('headcount-avatars');

    function renderAvatars() {
      let html = `<div class="avatar-col"><div class="avatar-col-label">You</div><div class="avatar-circle you"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6"/></svg></div></div>`;
      for (let i = 1; i < peopleCount; i++) {
        html += `<div class="avatar-col"><div class="avatar-col-label">&nbsp;</div><div class="avatar-circle guest"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6"/></svg></div></div>`;
      }
      avatarsEl.innerHTML = html;
      document.getElementById('split-ways-label').textContent = 'Split ' + peopleCount + (peopleCount === 1 ? ' Way' : ' Ways');
    }

    document.getElementById('headcount-minus').addEventListener('click', () => {
      if (peopleCount > 1) { peopleCount--; renderAvatars(); recompute(); }
    });
    document.getElementById('headcount-plus').addEventListener('click', () => {
      if (peopleCount < 20) { peopleCount++; renderAvatars(); recompute(); }
    });

    // --- Tip ---
    let tipMode = 'percent';
    let tipValue = 0;
    if (receiptTipDollars > 0 && subtotalDollars > 0) {
      tipMode = 'percent';
      tipValue = Math.round((receiptTipDollars / subtotalDollars) * 100);
    }

    function setTipPreset(pct, btn) {
      tipMode = 'percent'; tipValue = pct;
      document.querySelectorAll('.tip-option[data-tip-preset]').forEach((b) => b.classList.remove('active'));
      if (btn) btn.classList.add('active');
      document.getElementById('tip-custom-toggle').classList.remove('active');
      document.getElementById('tip-custom-row').classList.remove('open');
      recompute();
    }
    document.querySelectorAll('.tip-option[data-tip-preset]').forEach((btn) => {
      btn.addEventListener('click', () => setTipPreset(Number(btn.dataset.tipPreset), btn));
    });

    const tipCustomToggle = document.getElementById('tip-custom-toggle');
    const tipCustomRow = document.getElementById('tip-custom-row');
    const tipCustomInput = document.getElementById('tip-custom-input');
    const tipModePercentBtn = document.getElementById('tip-mode-percent');
    const tipModeAmountBtn = document.getElementById('tip-mode-amount');

    tipCustomToggle.addEventListener('click', () => {
      document.querySelectorAll('.tip-option[data-tip-preset]').forEach((b) => b.classList.remove('active'));
      tipCustomToggle.classList.add('active');
      tipCustomRow.classList.add('open');
      tipCustomInput.focus();
    });
    tipModePercentBtn.addEventListener('click', () => {
      tipMode = 'percent'; tipModePercentBtn.classList.add('active'); tipModeAmountBtn.classList.remove('active');
      tipCustomInput.placeholder = 'Enter %'; tipValue = Number(tipCustomInput.value) || 0; recompute();
    });
    tipModeAmountBtn.addEventListener('click', () => {
      tipMode = 'amount'; tipModeAmountBtn.classList.add('active'); tipModePercentBtn.classList.remove('active');
      tipCustomInput.placeholder = 'Enter ' + currencyPrefix; tipValue = Number(tipCustomInput.value) || 0; recompute();
    });
    tipCustomInput.addEventListener('input', () => { tipValue = Number(tipCustomInput.value) || 0; recompute(); });

    function recompute() {
      const tipDollars = tipMode === 'percent' ? subtotalDollars * (tipValue / 100) : tipValue;
      const tipPct = subtotalDollars > 0 ? (tipDollars / subtotalDollars) * 100 : 0;

      // A deal/discount printed on the receipt isn't captured in its own
      // field -- subtotal/tax are only ever what the receipt prints as
      // separate lines (services/scanReceiptService.js) -- so subtotal+tax
      // alone can overstate the real total whenever the receipt had one.
      // receiptTotalDollars is always the true, printed total; this is that
      // gap, shown and split evenly same as everything else here.
      const discountDollars = Math.max(0, (subtotalDollars + taxDollars) - receiptTotalDollars);
      const total = subtotalDollars - discountDollars + taxDollars + tipDollars;

      const perPersonSubtotal = subtotalDollars / peopleCount;
      const perPersonDiscount = discountDollars / peopleCount;
      const perPersonTax = taxDollars / peopleCount;
      const perPersonTotal = total / peopleCount;

      document.getElementById('tip-summary').textContent = Math.round(tipPct) + '% (' + money(tipDollars) + ')';
      document.getElementById('total-subtotal').textContent = money(subtotalDollars);
      const discountRow = document.getElementById('discount-row');
      if (discountDollars > 0.004) {
        discountRow.style.display = '';
        document.getElementById('total-discount').textContent = '-' + money(discountDollars);
      } else {
        discountRow.style.display = 'none';
      }
      document.getElementById('total-tax').textContent = money(taxDollars);
      document.getElementById('total-grand').textContent = money(total);
      document.getElementById('per-person-subtotal').textContent = money(perPersonSubtotal - perPersonDiscount);
      document.getElementById('per-person-tax').textContent = money(perPersonTax);
      document.getElementById('split-submit-btn').textContent = 'Split ' + money(total);

      document.getElementById('people-count-input').value = peopleCount;
      document.getElementById('tip-input').value = tipDollars.toFixed(2);
      document.getElementById('per-person-subtotal-input').value = perPersonSubtotal.toFixed(2);
      document.getElementById('per-person-tax-input').value = perPersonTax.toFixed(2);
      document.getElementById('per-person-total-input').value = perPersonTotal.toFixed(2);
    }

    document.querySelector(`.tip-option[data-tip-preset="${tipValue}"]`)?.classList.add('active');

    renderAvatars();
    recompute();
  </script>
</body>
</html>
