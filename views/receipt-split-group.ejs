<!-- views/receipt-split-group.ejs -->
<!-- Split the Bill, "Create group": captures a group name/description for
     this receipt. Continue creates the real SplitGroup (see the schema
     comment on that model) with this name/description and takes the host
     straight to "Collecting" -- nothing's been claimed yet, so the whole
     receipt is left to collect. A group spanning multiple receipts is
     future work; this one is always exactly one receipt. -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create Group - ReceipTap</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
  <%- include('partials/wallet-dark-theme') %>
  <style>
    .split-header { display: flex; align-items: center; margin-bottom: 34px; }
    .split-header-title { flex: 1; text-align: center; font-size: 17px; font-weight: 700; }
    .split-header-close {
      width: 38px; height: 38px; border-radius: 50%; border: none; background: none; color: var(--w-ink-soft);
      display: flex; align-items: center; justify-content: center; cursor: pointer; text-decoration: none;
    }

    .group-title { font-family: var(--font-display); font-size: 26px; font-weight: 700; text-align: center; margin-bottom: 6px; }
    .group-sub { text-align: center; font-size: 13.5px; color: var(--w-ink-soft); margin-bottom: 30px; }

    .group-field { margin-bottom: 22px; }
    .group-field label { display: block; font-size: 13px; font-weight: 700; margin-bottom: 8px; }
    .group-field input, .group-field textarea {
      width: 100%; box-sizing: border-box; background: var(--w-card-raised); border: 1px solid var(--w-line);
      color: var(--w-ink); border-radius: 12px; padding: 13px 14px; font-size: 15px; font-family: inherit; resize: vertical;
    }
    .group-field input:focus, .group-field textarea:focus { outline: none; border-color: var(--w-accent); }
    .group-field textarea { min-height: 90px; }

    .split-continue-btn {
      width: 100%; border: none; border-radius: 14px; padding: 16px; font-size: 16px; font-weight: 700;
      color: #fff; cursor: pointer; font-family: inherit; display: flex; align-items: center; justify-content: center; gap: 8px;
      background: linear-gradient(90deg, var(--w-accent-deep), var(--w-accent) 55%, #35d0ff);
      box-shadow: 0 6px 24px rgba(5,107,254,0.35);
      margin-bottom: max(16px, env(safe-area-inset-bottom));
    }
  </style>
</head>
<body data-no-pull-refresh>
  <div class="w-shell">
    <div class="split-header">
      <a href="/account/receipts/scanned/<%= receipt.id %>/split" class="w-btn-icon" aria-label="Back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      </a>
      <div class="split-header-title">Create Group</div>
      <a href="/account/receipts/scanned/<%= receipt.id %>" class="split-header-close" aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </a>
    </div>

    <div class="group-title">Group Details</div>
    <div class="group-sub">Tell us more about this group</div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="w-error"><%= error %></div>
    <% } %>

    <form method="POST" action="/account/receipts/scanned/<%= receipt.id %>/split/group">
      <div class="group-field">
        <label for="groupName">Group Name</label>
        <input type="text" id="groupName" name="groupName" maxlength="200" value="<%= receipt.merchantName %>" required />
      </div>
      <div class="group-field">
        <label for="groupDescription">Description (Optional)</label>
        <textarea id="groupDescription" name="groupDescription" maxlength="400">Receipt from <%= receipt.merchantName %><% if (receipt.purchaseDate) { %> on <%= receipt.purchaseDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) %><% } %></textarea>
      </div>

      <button type="submit" class="split-continue-btn">
        Continue
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </button>
    </form>
  </div>
</body>
</html>
