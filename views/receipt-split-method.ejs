<!-- views/receipt-split-method.ejs -->
<!-- Split the Bill, step 2 ("Smart Scan"): pick a split method for the
     receipt Confirm Items just saved. Everything on this card (merchant,
     date, total, the real photo behind the icon button) is read straight
     off the saved ScannedReceipt row -- nothing here is invented.

     This picker itself saves nothing; it's just navigation to whichever
     step-3 screen actually computes and records the split. -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Smart Scan - ReceipTap</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
  <%- include('partials/wallet-dark-theme') %>
  <style>
    .split-header {
      display: flex; align-items: center; gap: 14px; margin-bottom: 20px;
    }
    .split-header-title { flex: 1; text-align: center; font-size: 17px; font-weight: 700; margin-right: 38px; }

    .receipt-summary-card {
      background: linear-gradient(155deg, #2a1a52 0%, #1a1030 60%, #100a20 100%);
      border: 1px solid rgba(139, 92, 246, 0.28); border-radius: 20px;
      padding: 20px; display: flex; align-items: flex-start; justify-content: space-between;
      box-shadow: 0 12px 32px rgba(88, 40, 200, 0.18);
    }
    .receipt-summary-eyebrow { font-size: 10.5px; font-weight: 700; letter-spacing: 0.08em; color: #b9a5f0; text-transform: uppercase; }
    .receipt-summary-merchant { font-size: 21px; font-weight: 700; margin: 3px 0 18px; }
    .receipt-summary-cols { display: flex; gap: 34px; }
    .receipt-summary-label { font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em; color: #9d8cc4; text-transform: uppercase; margin-bottom: 4px; }
    .receipt-summary-value { font-size: 15px; font-weight: 700; }
    .receipt-photo-btn {
      width: 44px; height: 44px; border-radius: 13px; flex-shrink: 0; border: none; cursor: pointer;
      background: linear-gradient(140deg, #a970ff, #6f3fd6); color: #fff;
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 6px 18px rgba(140, 80, 255, 0.4);
    }

    .split-step-label { text-align: center; font-size: 13px; font-weight: 700; color: var(--w-ink-soft); margin: 30px 0 16px; }

    .split-tile {
      display: flex; align-items: center; gap: 14px; width: 100%; text-decoration: none;
      border-radius: 20px; padding: 18px; box-sizing: border-box; margin-bottom: 4px;
      box-shadow: 0 10px 28px var(--tile-shadow, rgba(0,0,0,0.25));
    }
    .split-tile-icon {
      width: 46px; height: 46px; border-radius: 13px; flex-shrink: 0;
      background: rgba(255,255,255,0.22); display: flex; align-items: center; justify-content: center; color: #fff;
    }
    .split-tile-text { flex: 1; color: #fff; }
    .split-tile-title { font-size: 17px; font-weight: 700; }
    .split-tile-sub { font-size: 12.5px; opacity: 0.85; margin-top: 2px; }
    .split-tile-chevron { color: rgba(255,255,255,0.85); flex-shrink: 0; }

    .split-tile.items { background: linear-gradient(115deg, #7b2ff7, #a970ff); --tile-shadow: rgba(123, 47, 247, 0.35); }
    .split-tile.even { background: linear-gradient(115deg, var(--w-accent-deep), var(--w-accent) 55%, #35d0ff); --tile-shadow: rgba(5, 107, 254, 0.35); }
    .split-tile.group { background: linear-gradient(115deg, #0d9c5c, #34d399); --tile-shadow: rgba(13, 156, 92, 0.32); }

    .split-or-row { display: flex; align-items: center; gap: 12px; margin: 18px 0; color: var(--w-ink-soft); font-size: 11px; font-weight: 700; letter-spacing: 0.08em; }
    .split-or-row::before, .split-or-row::after { content: ''; flex: 1; height: 1px; background: var(--w-line); }
    .split-group-note { text-align: center; font-size: 12.5px; color: var(--w-ink-soft); margin-bottom: 14px; }
  </style>
</head>
<body data-no-pull-refresh>
  <div class="w-shell">
    <div class="split-header">
      <a href="/account/receipts/scanned/<%= receipt.id %>" class="w-btn-icon" aria-label="Back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      </a>
      <div class="split-header-title">Smart Scan</div>
    </div>

    <div class="receipt-summary-card">
      <div>
        <div class="receipt-summary-eyebrow">Receipt from</div>
        <div class="receipt-summary-merchant"><%= receipt.merchantName %></div>
        <div class="receipt-summary-cols">
          <div>
            <div class="receipt-summary-label">Date</div>
            <div class="receipt-summary-value"><%= receipt.purchaseDate ? receipt.purchaseDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) : 'Not recorded' %></div>
          </div>
          <div>
            <div class="receipt-summary-label">Total</div>
            <div class="receipt-summary-value"><%= receipt.currency || 'CA' %>$<%= money(receipt.total) %></div>
          </div>
        </div>
      </div>
      <button type="button" class="receipt-photo-btn" aria-label="View receipt photo"
              onclick="openImageViewer('/account/receipts/scanned/<%= receipt.id %>/image', '<%= receipt.merchantName.replace(/'/g, "\\'") %>')">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h3l2-2h6l2 2h3a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1Z"/><circle cx="12" cy="13" r="3.5"/></svg>
      </button>
    </div>

    <div class="split-step-label">Step 2: Pick your split method</div>

    <a href="/account/receipts/scanned/<%= receipt.id %>/split/items" class="split-tile items">
      <span class="split-tile-icon">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
      </span>
      <span class="split-tile-text">
        <div class="split-tile-title">Pick items</div>
        <div class="split-tile-sub">Review items and let friends claim theirs</div>
      </span>
      <svg class="split-tile-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
    </a>

    <div class="split-or-row">OR</div>

    <a href="/account/receipts/scanned/<%= receipt.id %>/split/even" class="split-tile even">
      <span class="split-tile-icon">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </span>
      <span class="split-tile-text">
        <div class="split-tile-title">Split evenly</div>
        <div class="split-tile-sub">Divide the total evenly for everyone</div>
      </span>
      <svg class="split-tile-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
    </a>

    <div class="split-or-row">OR</div>
    <div class="split-group-note">Add to group now, pay later</div>

    <a href="/account/receipts/scanned/<%= receipt.id %>/split/group" class="split-tile group">
      <span class="split-tile-icon">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
      </span>
      <span class="split-tile-text">
        <div class="split-tile-title">Create group</div>
        <div class="split-tile-sub">Settle up everything later</div>
      </span>
      <svg class="split-tile-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
    </a>
  </div>

  <%- include('partials/image-viewer') %>
</body>
</html>
