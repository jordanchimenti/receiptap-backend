<!-- views/receipt.ejs -->
<!-- One shared template for every merchant — appearance driven entirely by `theme`, data by `transaction` -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= theme.displayName || merchant.businessName %> - Receipt</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <style>
    :root {
      --primary: <%= theme.primaryColor %>;
      --accent: <%= theme.accentColor %>;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #f4f4f5;
      margin: 0;
      padding: 24px 16px;
    }
    .action-button {
      display: block;
      width: 100%;
      text-align: center;
      background: var(--accent);
      color: #fff;
      text-decoration: none;
      padding: 12px;
      border-radius: 8px;
      font-weight: 600;
      margin-top: 10px;
      box-sizing: border-box;
    }
    .footer-text { text-align: center; font-size: 12px; color: #999; margin-top: 20px; }
    .google-review-card {
      display: flex;
      align-items: center;
      gap: 12px;
      background: #fff;
      border: 1px solid #dadce0;
      border-radius: 8px;
      padding: 12px 16px;
      margin-top: 10px;
      text-decoration: none;
      box-sizing: border-box;
    }
    .google-g { width: 28px; height: 28px; flex-shrink: 0; }
    .google-review-title { font-size: 14px; font-weight: 600; color: #3c4043; }
    .google-stars { color: #fbbc05; font-size: 13px; letter-spacing: 1px; margin-top: 1px; }

    .loyalty-card {
      background: #fff;
      border: 1px solid #dadce0;
      border-radius: 8px;
      padding: 14px 16px;
      margin-top: 10px;
      box-sizing: border-box;
      text-align: center;
    }
    .loyalty-title { font-size: 14px; font-weight: 700; color: #222; }
    .loyalty-sub { font-size: 12.5px; color: #666; margin-top: 4px; line-height: 1.4; }
    .loyalty-card .action-button { margin-top: 10px; }
    .punch-row { display: flex; justify-content: center; gap: 8px; margin-top: 10px; }
    .punch-hole {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      border: 2px dashed #ccc;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      color: #fff;
      box-sizing: border-box;
    }
    .punch-hole.filled { border-style: solid; border-color: var(--accent); background: var(--accent); }
    .loyalty-code {
      font-size: 32px;
      font-weight: 700;
      letter-spacing: 6px;
      margin: 10px 0;
      font-family: var(--font-mono, monospace);
    }
    .loyalty-error { color: #dc2626; font-size: 12px; margin-top: 6px; min-height: 14px; }
    #loyalty-code-input {
      width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 8px;
      box-sizing: border-box; font-size: 14px; margin-bottom: 10px; text-align: center;
      letter-spacing: 2px; font-weight: 600;
    }

    .social-links {
      display: flex;
      justify-content: center;
      gap: 14px;
      margin-top: 14px;
    }
    .social-link {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: #fff;
      border: 1px solid #e5e5e5;
      text-decoration: none;
      box-sizing: border-box;
    }
    .social-link svg { width: 22px; height: 22px; }

    /* --- Email gate modal --- */
    .modal-overlay {
      display: none;
      position: fixed; inset: 0;
      background: rgba(0,0,0,0.5);
      align-items: center; justify-content: center;
      z-index: 100;
      padding: 16px;
    }
    .modal-overlay.open { display: flex; }
    .modal-box {
      background: #fff; border-radius: 12px; padding: 24px;
      max-width: 340px; width: 100%; box-sizing: border-box;
    }
    .modal-title { font-size: 17px; font-weight: 700; margin-bottom: 4px; }
    .modal-subtitle { font-size: 13px; color: #666; margin-bottom: 18px; }
    #google-signin-btn { display: flex; justify-content: center; margin-bottom: 14px; }
    .modal-divider { display: flex; align-items: center; gap: 10px; font-size: 12px; color: #999; margin: 14px 0; }
    .modal-divider::before, .modal-divider::after { content: ''; flex: 1; height: 1px; background: #eee; }
    .modal-box input[type=email] {
      width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 8px;
      box-sizing: border-box; font-size: 14px; margin-bottom: 10px;
    }
    .modal-box button.primary {
      width: 100%; padding: 11px; background: var(--accent); color: #fff;
      border: none; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 14px;
    }
    .modal-error { color: #dc2626; font-size: 12px; margin-bottom: 8px; display: none; }
    .modal-close { text-align: center; margin-top: 14px; font-size: 12px; color: #999; cursor: pointer; }

    .partner-banner {
      text-align: center;
      background: #fff;
      border-bottom: 1px solid #e5e5e5;
      padding: 14px 16px;
      margin: -24px -16px 16px;
    }
    .partner-banner p {
      margin: 0 0 2px;
      font-size: 13.5px;
      color: #333;
      line-height: 1.4;
    }
    .partner-banner a {
      font-weight: 700;
      font-size: 13.5px;
      color: var(--accent);
      text-decoration: none;
    }

    /* --- Print styling, so "Save as PDF" via the browser print dialog looks clean --- */
    @media print {
      body { background: #fff; padding: 0; }
      .layout-classic, .layout-modern, .layout-minimal { box-shadow: none; max-width: 100%; }
      .actions, .google-review-card, .modal-overlay, .partner-banner { display: none !important; }
    }
  </style>
</head>
<body>
  <% if (!isMerchantCopy && typeof partnerReferralUrl !== 'undefined' && partnerReferralUrl) { %>
    <div class="partner-banner">
      <p>Interested in digital receipts for your business?</p>
      <a href="<%= partnerReferralUrl %>">Try ReceipTap FREE</a>
    </div>
  <% } %>
  <%- include('receipt-layouts/' + (theme.layoutId || 'classic'), { merchant, theme, transaction, isPreview: typeof isPreview !== 'undefined' ? isPreview : false, isMerchantCopy }) %>

  <div class="actions" style="max-width:420px; margin: 10px auto 0;">
    <button class="action-button" style="border:none; cursor:pointer;" onclick="handleSaveClick('photo')">
      Save to Photos
    </button>
    <button class="action-button save-receipt-btn" style="background:#111; border:none; cursor:pointer;" onclick="handleSaveClick('pdf')">
      Save as PDF
    </button>
    <% if (!isMerchantCopy && theme.showGoogleReview && theme.googleReviewUrl) { %>
      <a class="google-review-card" href="<%= theme.googleReviewUrl %>">
        <svg class="google-g" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
          <path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/>
          <path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/>
          <path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z"/>
          <path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"/>
        </svg>
        <div class="google-review-text">
          <div class="google-review-title">Rate us on Google</div>
          <div class="google-stars">★★★★★</div>
        </div>
      </a>
    <% } %>
    <% if (!isMerchantCopy && typeof loyaltyProgram !== 'undefined' && loyaltyProgram && loyaltyProgram.enabled) { %>
      <% var loyaltyOfferText = loyaltyProgram.offerType === 'PERCENT' ? (loyaltyProgram.offerValue + '% off') : ('$' + (loyaltyProgram.offerValue / 100).toFixed(2) + ' off'); %>
      <div class="loyalty-card" id="loyalty-card" <% if (loyaltyCard) { %>data-card-id="<%= loyaltyCard.id %>"<% } %>>
        <% if (!loyaltyCard) { %>
          <div class="loyalty-title">🎁 Join our Loyalty Program</div>
          <div class="loyalty-sub">Collect 5 punches and get <%= loyaltyOfferText %> your next order!</div>
          <button type="button" class="action-button" style="background:var(--accent); border:none; cursor:pointer;" onclick="handleSaveClick('loyalty-join')">Join Now</button>
        <% } else { %>
          <div class="loyalty-title">🎁 Loyalty Rewards</div>
          <div class="punch-row">
            <% for (var p = 1; p <= 5; p++) { %>
              <div class="punch-hole <%= p <= loyaltyCard.punches ? 'filled' : '' %>"><%= p <= loyaltyCard.punches ? '✓' : '' %></div>
            <% } %>
          </div>
          <div class="loyalty-sub">
            <% if (loyaltyCard.punches >= 5) { %>
              Card full — redeem for <%= loyaltyOfferText %>!
            <% } else { %>
              <% var punchesLeft = 5 - loyaltyCard.punches; %>
              You're <%= punchesLeft %> punch<%= punchesLeft === 1 ? '' : 'es' %> away from claiming <%= loyaltyOfferText %>!
            <% } %>
          </div>
          <% if (loyaltyCard.punches >= 5) { %>
            <button type="button" class="action-button" style="background:var(--accent); border:none; cursor:pointer;" onclick="openLoyaltyModal()">Redeem Reward</button>
          <% } %>
        <% } %>
      </div>
    <% } %>
    <% if (!isMerchantCopy && (theme.instagramUrl || theme.facebookUrl || theme.tiktokUrl || theme.xUrl || theme.youtubeUrl || theme.linkedinUrl)) { %>
      <div class="social-links">
        <% if (theme.instagramUrl) { %>
          <a class="social-link" href="<%= theme.instagramUrl %>" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="#E1306C" d="M12 0C8.74 0 8.333.014 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.014 8.333 0 8.74 0 12s.014 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.986 8.74 24 12 24s3.667-.014 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.014-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.014 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.76 6.162 6.162 6.162 3.405 0 6.162-2.76 6.162-6.162 0-3.405-2.76-6.162-6.162-6.162zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405c0 .795-.646 1.44-1.44 1.44-.795 0-1.44-.646-1.44-1.44 0-.794.646-1.439 1.44-1.439.793-.001 1.44.645 1.44 1.439z"/></svg>
          </a>
        <% } %>
        <% if (theme.facebookUrl) { %>
          <a class="social-link" href="<%= theme.facebookUrl %>" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="#1877F2" d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.191.302-.263.637-.283 1.121-.014.235-.024.407-.024 1.017v.911h3.911l-.427 3.667h-3.484v7.98H9.101z"/></svg>
          </a>
        <% } %>
        <% if (theme.tiktokUrl) { %>
          <a class="social-link" href="<%= theme.tiktokUrl %>" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="#000000" d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
          </a>
        <% } %>
        <% if (theme.xUrl) { %>
          <a class="social-link" href="<%= theme.xUrl %>" target="_blank" rel="noopener noreferrer" aria-label="X">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="#000000" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        <% } %>
        <% if (theme.youtubeUrl) { %>
          <a class="social-link" href="<%= theme.youtubeUrl %>" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="#FF0000" d="M23.498 6.186a2.999 2.999 0 0 0-2.113-2.117C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.385.524A2.999 2.999 0 0 0 .502 6.186 31.31 31.31 0 0 0 0 12a31.31 31.31 0 0 0 .502 5.814 2.999 2.999 0 0 0 2.113 2.117c1.88.524 9.385.524 9.385.524s7.505 0 9.385-.524a2.999 2.999 0 0 0 2.113-2.117A31.31 31.31 0 0 0 24 12a31.31 31.31 0 0 0-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        <% } %>
        <% if (theme.linkedinUrl) { %>
          <a class="social-link" href="<%= theme.linkedinUrl %>" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="#0A66C2" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        <% } %>
      </div>
    <% } %>
    <% if (!isMerchantCopy && theme.showWarranty) { %>
      <a class="action-button" style="background:#555;" href="/receipt/<%= transaction.id %>/warranty">Register Warranty</a>
    <% } %>
    <% if (theme.footerText) { %>
      <div class="footer-text"><%= theme.footerText %></div>
    <% } %>
  </div>

  <!-- Email-gate modal: shown before the receipt can be saved as PDF/Files -->
  <div class="modal-overlay" id="save-modal">
    <div class="modal-box">
      <div class="modal-title">Save Your Receipt</div>
      <div class="modal-subtitle">Save this receipt and we'll automatically organize it by spending category and flag possible tax deductions — free, powered by AI.</div>

      <div id="google-signin-btn"></div>

      <div class="modal-divider">or</div>

      <div class="modal-error" id="modal-error"></div>
      <input type="email" id="modal-email-input" placeholder="you@example.com" />
      <button class="primary" onclick="submitEmailCapture()">Continue</button>

      <div class="modal-close" onclick="closeSaveModal()">Cancel</div>
    </div>
  </div>

  <!-- Loyalty redemption modal: pops up automatically once a card hits 5/5 -->
  <% if (!isMerchantCopy && loyaltyCard && loyaltyCard.punches >= 5) { %>
    <div class="modal-overlay" id="loyalty-modal">
      <div class="modal-box">
        <div class="modal-title">🎉 Your card is full!</div>
        <div class="modal-subtitle">You've earned <%= loyaltyOfferText %>. Redeem it now, or save it for later in your account.</div>

        <div id="loyalty-choice-step">
          <button class="primary" onclick="startLoyaltyRedeem()">Redeem</button>
          <button class="primary" style="background:#999; margin-top:8px;" onclick="closeLoyaltyModal()">Save</button>
        </div>

        <div id="loyalty-code-step" style="display:none;">
          <div class="modal-subtitle" style="margin-bottom:10px;">Ask your cashier for the redemption code and enter it below.</div>
          <div class="modal-error" id="loyalty-modal-error"></div>
          <input type="text" id="loyalty-code-input" placeholder="Code" autocomplete="off" />
          <button class="primary" onclick="submitLoyaltyCode('<%= loyaltyCard.id %>')">Submit</button>
        </div>

        <div class="modal-close" onclick="closeLoyaltyModal()">Close</div>
      </div>
    </div>
  <% } %>

  <script src="https://accounts.google.com/gsi/client" async defer></script>
  <script>
    const TRANSACTION_ID = '<%= transaction.id %>';
    const ALREADY_SIGNED_UP = <%= typeof alreadySignedUp !== 'undefined' ? Boolean(alreadySignedUp) : false %>;
    const IS_MERCHANT_COPY = <%= typeof isMerchantCopy !== 'undefined' && isMerchantCopy ? 'true' : 'false' %>;

    let pendingAction = null; // 'photo' | 'pdf' -- which button triggered the signup gate

    function openSaveModal() {
      document.getElementById('save-modal').classList.add('open');
    }
    function closeSaveModal() {
      document.getElementById('save-modal').classList.remove('open');
      document.getElementById('modal-error').style.display = 'none';
    }

    function showModalError(msg) {
      const el = document.getElementById('modal-error');
      el.textContent = msg;
      el.style.display = 'block';
    }

    // Returning customers we already recognize skip the signup gate entirely --
    // just silently link this (possibly different merchant's) receipt to their
    // existing wallet, then run the action they actually clicked for.
    function handleSaveClick(action) {
      // A merchant viewing their own merchant-copy record is already
      // authenticated as themselves -- no email/Google capture gate makes
      // sense here, and there's no customer wallet to link this to.
      if (IS_MERCHANT_COPY) {
        runAction(action);
        return;
      }
      if (ALREADY_SIGNED_UP) {
        fetch(`/receipt/${TRANSACTION_ID}/save`, { method: 'POST' })
          .then(() => runAction(action))
          .catch(() => runAction(action)); // link failing shouldn't block the save/print/photo itself
      } else {
        pendingAction = action;
        openSaveModal();
      }
    }

    function runAction(action) {
      if (action === 'pdf') {
        // Native print dialog -- both iOS and Android offer "Save as PDF" / "Save to Files" here
        setTimeout(() => window.print(), 200);
      } else if (action === 'photo') {
        saveToPhotos();
      } else if (action === 'loyalty-join') {
        joinLoyalty();
      }
    }

    // --- Loyalty punch card -----------------------------------------------
    async function joinLoyalty() {
      const res = await fetch(`/receipt/${TRANSACTION_ID}/loyalty/join`, { method: 'POST' });
      if (res.ok) location.reload(); // server re-renders the punch card at 1/5
    }

    // --- Loyalty redemption modal -------------------------------------------
    function openLoyaltyModal() {
      document.getElementById('loyalty-choice-step').style.display = 'block';
      document.getElementById('loyalty-code-step').style.display = 'none';
      document.getElementById('loyalty-modal').classList.add('open');
    }
    function closeLoyaltyModal() {
      document.getElementById('loyalty-modal').classList.remove('open');
    }
    function startLoyaltyRedeem() {
      document.getElementById('loyalty-choice-step').style.display = 'none';
      document.getElementById('loyalty-code-step').style.display = 'block';
      document.getElementById('loyalty-code-input').focus();
    }

    async function submitLoyaltyCode(cardId) {
      const errorEl = document.getElementById('loyalty-modal-error');
      const code = document.getElementById('loyalty-code-input').value;
      errorEl.style.display = 'none';

      const res = await fetch(`/loyalty/${cardId}/redeem`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code }),
      });
      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        errorEl.textContent = data.error || 'Something went wrong -- please try again.';
        errorEl.style.display = 'block';
        return;
      }
      document.getElementById('loyalty-card').innerHTML =
        '<div class="loyalty-title">🎉 Reward redeemed!</div><div class="loyalty-sub">Thanks for being a loyal customer.</div>';
      closeLoyaltyModal();
      setTimeout(() => location.reload(), 1800); // reload to a fresh, empty card
    }

    // Rasterizes the receipt (buttons hidden) to a PNG and hands it to the
    // OS share sheet, where "Save Image" writes straight to Photos -- falls
    // back to a plain download if the browser has no Web Share file support.
    async function saveToPhotos() {
      const actions = document.querySelector('.actions');
      actions.style.display = 'none';
      try {
        const canvas = await html2canvas(document.body, { backgroundColor: '#f4f4f5' });
        canvas.toBlob(async (blob) => {
          const file = new File([blob], 'receipt.png', { type: 'image/png' });
          if (navigator.canShare && navigator.canShare({ files: [file] })) {
            try {
              await navigator.share({ files: [file], title: 'Receipt' });
            } catch (err) {
              // User canceled the share sheet -- not an error worth surfacing
            }
          } else {
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'receipt.png';
            a.click();
            URL.revokeObjectURL(url);
          }
        }, 'image/png');
      } finally {
        actions.style.display = '';
      }
    }

    // After email is captured (either path), close the modal and run
    // whichever action the customer actually clicked.
    function proceedToSave() {
      closeSaveModal();
      runAction(pendingAction);
    }

    async function submitEmailCapture() {
      const email = document.getElementById('modal-email-input').value.trim();
      if (!email) { showModalError('Enter your email to continue.'); return; }

      const res = await fetch(`/receipt/${TRANSACTION_ID}/capture-email`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = await res.json();
      if (!res.ok) { showModalError(data.error || 'Something went wrong.'); return; }

      proceedToSave();
    }

    async function handleGoogleSignIn(response) {
      const res = await fetch(`/receipt/${TRANSACTION_ID}/capture-email-google`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ credential: response.credential }),
      });
      const data = await res.json();
      if (!res.ok) { showModalError(data.error || 'Google sign-in failed.'); return; }

      proceedToSave();
    }

    window.onload = function () {
      if (window.google && window.google.accounts) {
        google.accounts.id.initialize({
          client_id: '<%= googleClientId %>',
          callback: handleGoogleSignIn,
        });
        google.accounts.id.renderButton(
          document.getElementById('google-signin-btn'),
          { theme: 'outline', size: 'large', width: 280 }
        );
      }
      if (document.getElementById('loyalty-modal')) openLoyaltyModal();
    };
  </script>
  <% if (typeof isPreview !== 'undefined' && isPreview) { %>
    <!-- Settings-page preview only: lets the Receipt Settings tab push a
         just-picked (not-yet-saved) logo file in here instantly, without a
         server round trip. Real customer receipts never load this script. -->
    <script>
      window.addEventListener('message', function (event) {
        if (event.origin !== window.location.origin) return;
        if (!event.data || event.data.type !== 'receiptap-logo-preview') return;

        const existingLogo = document.querySelector('.merchant-logo');
        const placeholder = document.querySelector('.logo-placeholder');

        if (event.data.dataUrl) {
          if (existingLogo) {
            existingLogo.src = event.data.dataUrl;
          } else if (placeholder) {
            const img = document.createElement('img');
            img.className = 'merchant-logo';
            img.src = event.data.dataUrl;
            img.alt = 'Logo preview';
            placeholder.replaceWith(img);
          }
        } else if (existingLogo) {
          const div = document.createElement('div');
          div.className = 'logo-placeholder';
          div.textContent = 'Custom Logo';
          existingLogo.replaceWith(div);
        }
      });
    </script>
  <% } %>
</body>
</html>
