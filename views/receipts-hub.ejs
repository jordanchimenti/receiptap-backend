<!-- views/receipts-hub.ejs -->
<!-- One dashboard page, two tabs, both scoped to the logged-in merchant -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Receipts</title>
  <style>
    body { font-family: -apple-system, sans-serif; max-width: 800px; margin: 40px auto; color: #111; }
    h1 { font-size: 22px; margin-bottom: 4px; }
    .tabs { display: flex; gap: 4px; margin: 20px 0 0; border-bottom: 2px solid #eee; }
    .tab-button {
      padding: 10px 18px; border: none; background: none; cursor: pointer;
      font-size: 14px; font-weight: 600; color: #888; border-bottom: 2px solid transparent;
      margin-bottom: -2px;
    }
    .tab-button.active { color: #111; border-bottom-color: #2563eb; }
    .tab-panel { display: none; padding-top: 16px; }
    .tab-panel.active { display: block; }
    table { width: 100%; border-collapse: collapse; }
    th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid #eee; font-size: 14px; }
    th { color: #888; font-weight: 500; font-size: 12px; text-transform: uppercase; }
    .total-col { text-align: right; }
    .empty { text-align: center; color: #888; margin-top: 30px; font-size: 14px; }
    .export-link { float: right; font-size: 13px; margin-top: 2px; }
  </style>
</head>
<body>
  <%- include('partials/dashboard-header', { activeNav: 'receipts' }) %>
  <h1>Receipts</h1>

  <div class="tabs">
    <button class="tab-button active" onclick="showTab('customer')">Customer Receipts</button>
    <button class="tab-button" onclick="showTab('merchant')">Merchant Receipts</button>
  </div>

  <!-- Customer Receipts = receipts THIS business issued to its customers -->
  <div id="tab-customer" class="tab-panel active">
    <a class="export-link" href="/dashboard/receipts/export">Export CSV</a>
    <a class="export-link" href="/dashboard/receipts/pdf-export" style="margin-right:16px;">Export PDF Copies</a>
    <% if (customerReceipts.length === 0) { %>
      <div class="empty">No sales recorded yet.</div>
    <% } else { %>
      <table>
        <thead><tr><th>Date</th><th>Transaction ID</th><th>Payment</th><th class="total-col">Total</th></tr></thead>
        <tbody>
          <% customerReceipts.forEach(function(t) { %>
            <tr>
              <td><%= t.date %></td>
              <td><%= t.id %></td>
              <td><%= t.paymentMethod || '—' %></td>
              <td class="total-col">$<%= t.total %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>

  <!-- Merchant Receipts = receipts THIS business received as a purchaser elsewhere -->
  <div id="tab-merchant" class="tab-panel">
    <a class="export-link" href="/dashboard/expenses/export">Export CSV</a>
    <% if (merchantReceipts.length === 0) { %>
      <div class="empty">No purchases saved yet. When you buy from another ReceipTap-enabled business, tap "Save as Business Expense" on the receipt.</div>
    <% } else { %>
      <table>
        <thead><tr><th>Date</th><th>Purchased From</th><th class="total-col">Total</th></tr></thead>
        <tbody>
          <% merchantReceipts.forEach(function(t) { %>
            <tr>
              <td><%= t.date %></td>
              <td><%= t.soldByName %></td>
              <td class="total-col">$<%= t.total %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>

  <script>
    function showTab(name) {
      document.querySelectorAll('.tab-panel').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.tab-button').forEach(el => el.classList.remove('active'));
      document.getElementById('tab-' + name).classList.add('active');
      event.target.classList.add('active');
    }
  </script>
</body>
</html>
