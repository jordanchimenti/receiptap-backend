<!-- views/receipts-hub.ejs -->
<!-- One dashboard page, two tabs, both scoped to the logged-in merchant -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Receipts</title>
  <style>
    h1 { font-size: 22px; margin-bottom: 4px; }
    .tabs { display: flex; gap: 4px; margin: 20px 0 0; border-bottom: 2px solid #eee; }
    .tab-button {
      padding: 10px 18px; border: none; background: none; cursor: pointer;
      font-size: 14px; font-weight: 600; color: #888; border-bottom: 2px solid transparent;
      margin-bottom: -2px;
    }
    .tab-button.active { color: #111; border-bottom-color: #056BFE; }
    .tab-panel { display: none; padding-top: 16px; }
    .tab-panel.active { display: block; }
    table { width: 100%; border-collapse: collapse; }
    th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid #eee; font-size: 14px; }
    th { color: #888; font-weight: 500; font-size: 12px; text-transform: uppercase; }
    .total-col { text-align: right; }
    .empty { text-align: center; color: #888; margin-top: 30px; font-size: 14px; }
    .export-link { float: right; font-size: 13px; margin-top: 2px; }
    .date-filters { display: flex; align-items: flex-end; gap: 8px; margin: 16px 0; }
    .date-filters .field { display: flex; flex-direction: column; gap: 3px; }
    .date-filters label { font-size: 12px; color: #888; }
    .date-filters input { padding: 6px 10px; border: 1px solid #ddd; border-radius: 6px; font-size: 13px; }
    .date-filters button { padding: 7px 14px; border: none; border-radius: 6px; background: #056BFE; color: #fff; font-size: 13px; font-weight: 600; cursor: pointer; }
    .date-filters .clear-link { font-size: 13px; color: #888; }
    .view-btn {
      display: inline-block; padding: 5px 12px; border-radius: 6px; background: #056BFE;
      color: #fff; text-decoration: none; font-size: 12.5px; font-weight: 600;
    }
    .view-btn:hover { background: #0350BE; }
  </style>
</head>
<body>
  <%- include('partials/dashboard-header', { activeNav: 'receipts' }) %>

  <div class="topbar">
    <div>
      <h1>Receipts</h1>
      <p class="sub">Everything your business has issued and received.</p>
    </div>
  </div>

  <div class="app-body">

  <div class="tabs">
    <button class="tab-button <%= activeTab === 'customer' ? 'active' : '' %>" onclick="showTab('customer')">Customer Receipts</button>
    <button class="tab-button <%= activeTab === 'merchant' ? 'active' : '' %>" onclick="showTab('merchant')">Merchant Receipts</button>
  </div>

  <form class="date-filters" method="get" id="date-filter-form">
    <input type="hidden" name="tab" id="tab-input" value="<%= activeTab %>" />
    <div class="field">
      <label>From</label>
      <input type="date" name="from" value="<%= filters.from %>" />
    </div>
    <div class="field">
      <label>To</label>
      <input type="date" name="to" value="<%= filters.to %>" />
    </div>
    <button type="submit">Filter</button>
    <% if (filters.from || filters.to) { %>
      <a class="clear-link" href="/dashboard/receipts-hub?tab=<%= activeTab %>">Clear dates</a>
    <% } %>
  </form>

  <!-- Customer Receipts = receipts THIS business issued to its customers -->
  <div id="tab-customer" class="tab-panel <%= activeTab === 'customer' ? 'active' : '' %>">
    <a class="export-link" href="/dashboard/receipts/export?from=<%= encodeURIComponent(filters.from) %>&to=<%= encodeURIComponent(filters.to) %>">Export CSV</a>
    <a class="export-link" href="/dashboard/receipts/pdf-export?from=<%= encodeURIComponent(filters.from) %>&to=<%= encodeURIComponent(filters.to) %>" style="margin-right:16px;">Export PDF Copies</a>
    <% if (customerReceipts.length === 0) { %>
      <div class="empty">No sales recorded yet.</div>
    <% } else { %>
      <table>
        <thead><tr><th>Date</th><th>Transaction ID</th><th>Payment</th><th class="total-col">Total</th><th></th></tr></thead>
        <tbody>
          <% customerReceipts.forEach(function(t) { %>
            <tr>
              <td><%= t.date %></td>
              <td><%= t.id %></td>
              <td><%= t.paymentMethod || '—' %></td>
              <td class="total-col">$<%= t.total %></td>
              <td><a class="view-btn" href="/receipt/<%= t.id %>" target="_blank" rel="noopener noreferrer">View</a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>

  <!-- Merchant Receipts = this business's own merchant-copy record of every
       sale it made, plus anything it bought as a customer elsewhere -->
  <div id="tab-merchant" class="tab-panel <%= activeTab === 'merchant' ? 'active' : '' %>">
    <a class="export-link" href="/dashboard/expenses/export?from=<%= encodeURIComponent(filters.from) %>&to=<%= encodeURIComponent(filters.to) %>">Export CSV</a>
    <% if (merchantReceipts.length === 0) { %>
      <div class="empty">No merchant records yet.</div>
    <% } else { %>
      <table>
        <thead><tr><th>Date</th><th>Transaction ID</th><th>Payment</th><th class="total-col">Total</th><th></th></tr></thead>
        <tbody>
          <% merchantReceipts.forEach(function(t) { %>
            <tr>
              <td><%= t.date %></td>
              <td><%= t.id %></td>
              <td><%= t.paymentMethod || '—' %></td>
              <td class="total-col">$<%= t.total %></td>
              <td><a class="view-btn" href="/receipt/<%= t.id %><%= t.kind === 'own-sale' ? '?copy=merchant' : '' %>" target="_blank" rel="noopener noreferrer">View</a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>

  </div>

  <script>
    function showTab(name) {
      document.querySelectorAll('.tab-panel').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.tab-button').forEach(el => el.classList.remove('active'));
      document.getElementById('tab-' + name).classList.add('active');
      event.target.classList.add('active');
      // Keep the date-filter form's hidden tab field in sync, so filtering
      // dates re-submits to whichever tab the merchant is actually looking at
      document.getElementById('tab-input').value = name;
    }
  </script>
</body>
</html>
