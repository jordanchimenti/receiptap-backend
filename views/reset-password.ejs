<!-- views/reset-password.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reset Password - ReceipTap</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
</head>
<body>
  <div class="centered-shell">
    <div class="auth-card">
      <img src="/images/receiptap-logo.png" alt="ReceipTap" style="height: 34px; margin-bottom: 20px;" />

      <% if (!valid) { %>
        <h1 style="font-size: 22px; margin-bottom: 6px;">Link expired</h1>
        <p style="font-size: 13.5px; color: var(--ink-soft); margin: 8px 0 24px; line-height: 1.5;">
          This password reset link is invalid or has expired. Request a new one below.
        </p>
        <a href="/forgot-password" class="btn btn-primary" style="display: block; text-align: center;">Request a new link</a>
      <% } else { %>
        <h1 style="font-size: 22px; margin-bottom: 6px;">Set a new password</h1>
        <p style="font-size: 13.5px; color: var(--ink-soft); margin: 8px 0 24px; line-height: 1.5;">
          Choose a new password for your account.
        </p>

        <% if (error) { %><div class="error-box"><%= error %></div><% } %>

        <form method="POST" action="/reset-password/<%= token %>">
          <div class="field">
            <label for="password">New password</label>
            <input type="password" id="password" name="password" required autofocus minlength="8" />
          </div>
          <div class="field">
            <label for="confirmPassword">Confirm new password</label>
            <input type="password" id="confirmPassword" name="confirmPassword" required minlength="8" />
          </div>
          <button type="submit" class="btn btn-primary">Reset password</button>
        </form>
      <% } %>

      <p style="font-size: 13px; color: var(--ink-soft); margin-top: 20px; text-align: center;">
        <a href="/login" style="color: var(--teal-deep); font-weight: 600; text-decoration: none;">Back to log in</a>
      </p>
    </div>
  </div>
</body>
</html>
