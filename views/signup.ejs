<!-- views/signup.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign Up - ReceipTap</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
</head>
<body>
  <div class="centered-shell">
    <div class="auth-card">
      <img src="/images/receiptap-logo.png" alt="ReceipTap" style="height: 60px; margin-bottom: 20px;" />
      <h1 style="font-size: 22px; margin-bottom: 6px;">Create your ReceipTap account</h1>
      <p style="font-size: 13.5px; color: var(--ink-soft); margin: 8px 0 24px; line-height: 1.5;">
        One account per business. You'll connect your POS next.
      </p>

      <div class="error-box" id="error-box" style="<%= error ? '' : 'display: none;' %>"><%= error %></div>

      <% if (googleClientId) { %>
        <div id="google-signin-btn" style="display: flex; justify-content: center; margin-bottom: 14px;"></div>
        <div style="display: flex; align-items: center; gap: 10px; font-size: 12px; color: var(--ink-soft); margin: 14px 0;">
          <span style="flex: 1; height: 1px; background: var(--line);"></span>
          or
          <span style="flex: 1; height: 1px; background: var(--line);"></span>
        </div>
      <% } %>

      <form method="POST" action="/signup">
        <input type="hidden" name="refCode" value="<%= typeof refCode !== 'undefined' ? refCode : '' %>" />
        <input type="hidden" name="next" value="<%= typeof next !== 'undefined' ? next : '' %>" />
        <div class="field">
          <label for="ownerName">Your name</label>
          <input type="text" id="ownerName" name="ownerName" required autofocus />
        </div>
        <div class="field">
          <label for="businessName">Business name</label>
          <input type="text" id="businessName" name="businessName" required />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required minlength="8" />
        </div>

        <div style="display:flex; flex-direction:column; gap:8px; margin: 14px 0 18px;">
          <div style="display:flex; align-items:flex-start; gap:8px;">
            <input type="checkbox" id="acceptTerms" name="acceptTerms" required style="margin-top:2px;" />
            <label for="acceptTerms" style="font-size:13px; color:var(--ink-soft); line-height:1.4; font-weight:400;">
              I agree to the <a href="/legal/terms" target="_blank" rel="noopener" style="color:var(--teal-deep); font-weight:600; text-decoration:none;">Terms of Service</a>
            </label>
          </div>
          <div style="display:flex; align-items:flex-start; gap:8px;">
            <input type="checkbox" id="acceptPrivacy" name="acceptPrivacy" required style="margin-top:2px;" />
            <label for="acceptPrivacy" style="font-size:13px; color:var(--ink-soft); line-height:1.4; font-weight:400;">
              I agree to the <a href="/legal/privacy" target="_blank" rel="noopener" style="color:var(--teal-deep); font-weight:600; text-decoration:none;">Privacy Policy</a>
            </label>
          </div>
          <div style="display:flex; align-items:flex-start; gap:8px;">
            <input type="checkbox" id="acceptDpa" name="acceptDpa" required style="margin-top:2px;" />
            <label for="acceptDpa" style="font-size:13px; color:var(--ink-soft); line-height:1.4; font-weight:400;">
              I agree to the <a href="/legal/dpa" target="_blank" rel="noopener" style="color:var(--teal-deep); font-weight:600; text-decoration:none;">Data Processing Agreement</a>
            </label>
          </div>
        </div>

        <button type="submit" class="btn btn-primary">Create account</button>
      </form>

      <p style="font-size: 13px; color: var(--ink-soft); margin-top: 20px; text-align: center;">
        Already have an account? <a href="/login" style="color: var(--teal-deep); font-weight: 600; text-decoration: none;">Log in</a>
      </p>
    </div>
  </div>

  <% if (googleClientId) { %>
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <script>
      const REF_CODE = '<%= typeof refCode !== 'undefined' ? refCode : '' %>';
      const NEXT_PATH = '<%= typeof next !== 'undefined' ? next : '' %>';

      // Google's button skips our own <form> entirely (it's Google's widget,
      // not a submit we control), so the "required" checkboxes never get a
      // chance to block it the normal browser way -- checked by hand here
      // instead. This is a convenience check only; /merchant/google enforces
      // the same rule server-side for any NEW account, since a client-side
      // check alone can always be bypassed.
      function consentChecked() {
        return document.getElementById('acceptTerms').checked
          && document.getElementById('acceptPrivacy').checked
          && document.getElementById('acceptDpa').checked;
      }

      async function handleGoogleSignIn(response) {
        if (!consentChecked()) {
          const el = document.getElementById('error-box');
          el.textContent = 'Please accept the Terms of Service, Privacy Policy, and Data Processing Agreement first.';
          el.style.display = 'block';
          return;
        }

        const res = await fetch('/merchant/google', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            credential: response.credential,
            refCode: REF_CODE,
            next: NEXT_PATH,
            acceptTerms: true,
            acceptPrivacy: true,
            acceptDpa: true,
          }),
        });
        const data = await res.json();
        if (!res.ok) {
          const el = document.getElementById('error-box');
          el.textContent = data.error || 'Google sign-in failed.';
          el.style.display = 'block';
          return;
        }
        window.location.href = data.redirect;
      }

      window.onload = function () {
        if (window.google && window.google.accounts) {
          google.accounts.id.initialize({
            client_id: '<%= googleClientId %>',
            callback: handleGoogleSignIn,
          });
          google.accounts.id.renderButton(
            document.getElementById('google-signin-btn'),
            { theme: 'outline', size: 'large', width: 280 }
          );
        }
      };
    </script>
  <% } %>
</body>
</html>
