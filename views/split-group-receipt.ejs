<!-- views/split-group-receipt.ejs -->
<!-- The one receipt inside a Split the Bill group, with each item's real
     claim status (`paid`, set when a recorded cash payment covers it -- see
     the SplitGroup schema comment) instead of the plain totals-only view at
     scanned-receipt.ejs. -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= receipt.merchantName %> - ReceipTap</title>
  <link rel="stylesheet" href="/css/receiptap.css" />
  <%- include('partials/wallet-dark-theme') %>
  <style>
    .gr-header { display: flex; align-items: flex-start; gap: 14px; margin-bottom: 22px; }
    .gr-header-text { flex: 1; min-width: 0; }
    .gr-merchant { font-size: 20px; font-weight: 700; }
    .gr-sub { font-size: 12.5px; color: var(--w-ink-soft); margin-top: 3px; }
    .gr-sub .status { font-weight: 700; }
    .gr-sub .status.open { color: #eab308; }
    .gr-sub .status.done { color: var(--w-ok); }
    .gr-menu-wrap { position: relative; flex-shrink: 0; }
    .gr-menu-btn { width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--w-line); background: var(--w-card-raised); color: var(--w-ink); display: flex; align-items: center; justify-content: center; cursor: pointer; }
    .gr-menu {
      display: none; position: absolute; top: 44px; right: 0; z-index: 10;
      background: var(--w-card); border: 1px solid var(--w-line); border-radius: 14px; overflow: hidden;
      min-width: 200px; box-shadow: 0 12px 30px rgba(0,0,0,0.4);
    }
    .gr-menu.open { display: block; }
    .gr-menu a, .gr-menu button {
      display: flex; align-items: center; gap: 10px; width: 100%; box-sizing: border-box; padding: 13px 15px;
      background: none; border: none; text-decoration: none; font-family: inherit; font-size: 14px; font-weight: 700;
      cursor: pointer; text-align: left;
    }
    .gr-menu a { color: var(--w-ok); }
    .gr-menu button { color: var(--w-danger); }

    .gr-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--w-ink-soft); margin: 22px 2px 10px; }
    .gr-photo-card {
      display: flex; align-items: center; gap: 12px; background: var(--w-card); border: 1px solid var(--w-line);
      border-radius: 14px; padding: 12px; text-decoration: none; color: inherit; cursor: pointer;
    }
    .gr-photo-thumb { width: 52px; height: 52px; border-radius: 10px; overflow: hidden; position: relative; flex-shrink: 0; }
    .gr-photo-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .gr-photo-thumb-label { position: absolute; inset: auto 0 0 0; background: rgba(0,0,0,0.6); color: #fff; font-size: 9px; font-weight: 700; text-align: center; padding: 2px 0; }
    .gr-photo-title { font-size: 14px; font-weight: 700; }
    .gr-photo-sub { font-size: 12px; color: var(--w-ink-soft); margin-top: 1px; }

    .gr-items-card { background: var(--w-card); border: 1px solid var(--w-line); border-radius: 14px; padding: 4px 16px; }
    .gr-item-row { display: flex; align-items: center; justify-content: space-between; padding: 13px 0; }
    .gr-item-row + .gr-item-row { border-top: 1px solid var(--w-line); }
    .gr-item-name { font-size: 14.5px; font-weight: 700; }
    .gr-item-status { font-size: 12px; margin-top: 2px; }
    .gr-item-status.unclaimed { color: #eab308; }
    .gr-item-status.paid { color: var(--w-ok); }
    .gr-item-amount { font-size: 14.5px; font-weight: 700; font-variant-numeric: tabular-nums; }
    .gr-item-amount.unclaimed { color: #eab308; }
    .gr-item-amount.paid { color: var(--w-ok); }

    .gr-totals-card { background: var(--w-card); border: 1px solid var(--w-line); border-radius: 14px; padding: 14px 16px; margin-top: 20px; }
    .gr-total-row { display: flex; align-items: center; justify-content: space-between; padding: 6px 0; font-size: 14px; color: var(--w-ink-soft); }
    .gr-total-row.grand { border-top: 1px solid var(--w-line); margin-top: 4px; padding-top: 12px; font-size: 16px; font-weight: 700; color: var(--w-ink); }

    .gr-edit-btn {
      display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; text-decoration: none;
      background: linear-gradient(115deg, var(--w-accent-deep), var(--w-accent) 55%, #35d0ff); color: #fff; font-weight: 700; font-size: 15px;
      padding: 15px; border-radius: 14px; margin: 24px 0 max(16px, env(safe-area-inset-bottom));
      box-shadow: 0 8px 24px rgba(5, 107, 254, 0.3);
    }
  </style>
</head>
<body data-no-pull-refresh>
  <div class="w-shell">
    <div class="gr-header">
      <a href="/account/receipts/scanned/<%= receipt.id %>/group" class="w-btn-icon" aria-label="Back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      </a>
      <div class="gr-header-text">
        <div class="gr-merchant"><%= receipt.merchantName %></div>
        <div class="gr-sub">
          <%= receipt.purchaseDate ? receipt.purchaseDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', timeZone: 'UTC' }) : 'Undated' %>
          &nbsp;&middot;&nbsp;<span class="status <%= leftToCollectCents > 0 ? 'open' : 'done' %>"><%= leftToCollectCents > 0 ? 'Open' : 'Settled' %></span>
        </div>
        <div class="gr-sub">Uploaded by <%= hostName %></div>
      </div>
      <div class="gr-menu-wrap">
        <button type="button" class="gr-menu-btn" id="gr-menu-btn" aria-label="More options">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg>
        </button>
        <div class="gr-menu" id="gr-menu">
          <a href="/account/receipts/scanned/<%= receipt.id %>/group/pay">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="3"/></svg>
            Mark as paid in cash
          </a>
          <form method="POST" action="/account/receipts/scanned/<%= receipt.id %>/delete"
                onsubmit="return confirm('Delete this receipt and its photo? This also removes the split group. This cannot be undone.');" style="margin:0;">
            <button type="submit">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2m-8 0 1 13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1l1-13"/></svg>
              Delete receipt
            </button>
          </form>
        </div>
      </div>
    </div>

    <div class="gr-eyebrow">Receipt image</div>
    <button type="button" class="gr-photo-card" style="border:1px solid var(--w-line); font-family:inherit; text-align:left;"
            onclick="openImageViewer('/account/receipts/scanned/<%= receipt.id %>/image', '<%= receipt.merchantName.replace(/'/g, "\\'") %>')">
      <div class="gr-photo-thumb">
        <img src="/account/receipts/scanned/<%= receipt.id %>/image" alt="Receipt photo" />
        <span class="gr-photo-thumb-label">View</span>
      </div>
      <div>
        <div class="gr-photo-title">Original receipt</div>
        <div class="gr-photo-sub">Tap to open</div>
      </div>
    </button>

    <div class="gr-eyebrow">Items</div>
    <div class="gr-items-card">
      <% items.forEach(function (it) { %>
        <div class="gr-item-row">
          <div>
            <div class="gr-item-name"><%= it.description %></div>
            <div class="gr-item-status <%= it.paid ? 'paid' : 'unclaimed' %>"><%= it.paid ? 'Paid' : 'Unclaimed' %></div>
          </div>
          <div class="gr-item-amount <%= it.paid ? 'paid' : 'unclaimed' %>"><%= receipt.currency || 'CA' %>$<%= (Math.round((it.amount + Number.EPSILON) * 100) / 100).toFixed(2) %></div>
        </div>
      <% }); %>
    </div>

    <div class="gr-totals-card">
      <% if (receipt.subtotal !== null) { %><div class="gr-total-row"><span>Subtotal</span><span><%= receipt.currency || 'CA' %>$<%= money(receipt.subtotal) %></span></div><% } %>
      <% if (receipt.tax !== null) { %><div class="gr-total-row"><span>Tax</span><span><%= receipt.currency || 'CA' %>$<%= money(receipt.tax) %></span></div><% } %>
      <div class="gr-total-row grand"><span>Total</span><span><%= receipt.currency || 'CA' %>$<%= money(receipt.total) %></span></div>
    </div>

    <a href="/account/receipts/scanned/<%= receipt.id %>/group/receipt/edit" class="gr-edit-btn">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
      Edit Receipt
    </a>
  </div>

  <%- include('partials/image-viewer') %>

  <script>
    const menuBtn = document.getElementById('gr-menu-btn');
    const menu = document.getElementById('gr-menu');
    menuBtn.addEventListener('click', (e) => { e.stopPropagation(); menu.classList.toggle('open'); });
    document.addEventListener('click', () => menu.classList.remove('open'));
  </script>
</body>
</html>
