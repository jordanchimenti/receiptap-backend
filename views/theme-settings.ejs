<!-- views/theme-settings.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Receipt Settings</title>
  <style>
    body { font-family: -apple-system, sans-serif; max-width: 520px; margin: 40px auto; color: #111; }
    h1 { font-size: 22px; }
    h2 { font-size: 15px; margin-top: 28px; margin-bottom: 8px; color: #555; }
    label { display: block; font-size: 13px; font-weight: 600; margin-top: 14px; margin-bottom: 4px; }
    input[type=text], input[type=url] { width: 100%; padding: 9px 10px; border: 1px solid #ddd; border-radius: 6px; box-sizing: border-box; font-size: 14px; }
    input[type=color] { width: 60px; height: 36px; border: 1px solid #ddd; border-radius: 6px; padding: 2px; }
    .toggle-row { display: flex; align-items: center; gap: 8px; margin-top: 14px; }
    .toggle-row label { margin: 0; font-weight: 500; }
    .hint { font-size: 12px; color: #888; margin-top: 4px; }
    .banner { padding: 10px 14px; border-radius: 8px; font-size: 13px; margin-bottom: 16px; }
    .banner.success { background: #ecfdf5; color: #047857; }
    .banner.error { background: #fef2f2; color: #dc2626; }
    button { margin-top: 24px; width: 100%; padding: 12px; background: #2563eb; color: #fff; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; }
    .google-section { background: #f9fafb; border-radius: 8px; padding: 14px; margin-top: 20px; }
    .google-g-small { width: 18px; height: 18px; vertical-align: middle; margin-right: 6px; }

    .layout-picker { display: flex; gap: 12px; overflow-x: auto; padding-bottom: 8px; margin-bottom: 8px; }
    .layout-option { flex: 0 0 auto; width: 150px; cursor: pointer; }
    .layout-option-frame {
      width: 150px; height: 220px; border: 2px solid #e5e7eb; border-radius: 10px;
      overflow: hidden; position: relative; background: #f4f4f5;
    }
    .layout-option.selected .layout-option-frame { border-color: #2563eb; box-shadow: 0 0 0 2px rgba(37,99,235,0.15); }
    .layout-option-frame iframe {
      width: 420px; height: 620px; border: none;
      transform: scale(0.357); transform-origin: top left;
      pointer-events: none;
    }
    .layout-option-label { text-align: center; font-size: 13px; font-weight: 600; margin-top: 8px; }
  </style>
</head>
<body>
  <%- include('partials/dashboard-header', { activeNav: 'settings' }) %>
  <h1>Receipt Settings</h1>

  <% if (saved) { %><div class="banner success">Settings saved.</div><% } %>
  <% if (error) { %><div class="banner error"><%= error %></div><% } %>

  <form method="POST" action="/dashboard/settings/receipt">

    <h2 style="margin-top:0;">Receipt Layout</h2>
    <div class="layout-picker">
      <% ['classic', 'modern', 'minimal'].forEach(function(id) { %>
        <div class="layout-option <%= (theme.layoutId || 'classic') === id ? 'selected' : '' %>" onclick="selectLayout('<%= id %>')">
          <div class="layout-option-frame">
            <iframe src="/dashboard/settings/receipt/preview/<%= id %>" scrolling="no"></iframe>
          </div>
          <div class="layout-option-label"><%= id.charAt(0).toUpperCase() + id.slice(1) %></div>
        </div>
      <% }); %>
    </div>
    <input type="hidden" name="layoutId" id="layoutId-input" value="<%= theme.layoutId || 'classic' %>" />

    <h2>Branding</h2>
    <label>Logo URL</label>
    <input type="url" name="logoUrl" value="<%= theme.logoUrl || '' %>" placeholder="https://yoursite.com/logo.png" />

    <label>Primary color</label>
    <input type="color" name="primaryColor" value="<%= theme.primaryColor || '#111111' %>" />

    <label>Accent color</label>
    <input type="color" name="accentColor" value="<%= theme.accentColor || '#2563eb' %>" />

    <label>Header message</label>
    <input type="text" name="headerText" value="<%= theme.headerText || '' %>" placeholder="Thanks for shopping with us!" />

    <label>Footer message</label>
    <input type="text" name="footerText" value="<%= theme.footerText || '' %>" placeholder="Returns accepted within 14 days." />

    <div class="google-section">
      <h2 style="margin-top:0;">
        <svg class="google-g-small" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
          <path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/>
          <path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/>
          <path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z"/>
          <path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"/>
        </svg>
        Google Review Link
      </h2>
      <label>Your Google review link</label>
      <input type="url" name="googleReviewUrl" value="<%= theme.googleReviewUrl || '' %>" placeholder="https://g.page/r/your-business/review" />
      <div class="hint">
        Find yours: search your business on Google, click your Business Profile,
        click "Ask for reviews," and copy the link it gives you — or go to
        <strong>business.google.com</strong> → your location → "Get more reviews."
      </div>
      <div class="toggle-row">
        <input type="checkbox" id="showGoogleReview" name="showGoogleReview" <%= theme.showGoogleReview ? 'checked' : '' %> />
        <label for="showGoogleReview">Show "Rate us on Google" on receipts</label>
      </div>
    </div>

    <h2>Other receipt options</h2>
    <div class="toggle-row">
      <input type="checkbox" id="showWalletSave" name="showWalletSave" <%= theme.showWalletSave ? 'checked' : '' %> />
      <label for="showWalletSave">Show "Add to Apple/Google Wallet"</label>
    </div>
    <div class="toggle-row">
      <input type="checkbox" id="showWarranty" name="showWarranty" <%= theme.showWarranty ? 'checked' : '' %> />
      <label for="showWarranty">Show "Register Warranty"</label>
    </div>
    <div class="toggle-row">
      <input type="checkbox" id="showLoyalty" name="showLoyalty" <%= theme.showLoyalty ? 'checked' : '' %> />
      <label for="showLoyalty">Show "Join Loyalty Program"</label>
    </div>

    <button type="submit">Save Settings</button>
  </form>

  <script>
    function selectLayout(id) {
      document.getElementById('layoutId-input').value = id;
      document.querySelectorAll('.layout-option').forEach(el => el.classList.remove('selected'));
      event.currentTarget.classList.add('selected');
    }

    // Live-update the 3 preview thumbnails as the merchant edits colors/text,
    // so they can see how each layout looks with THEIR branding before saving.
    function refreshPreviews() {
      const primaryColor = document.querySelector('[name=primaryColor]').value;
      const accentColor = document.querySelector('[name=accentColor]').value;
      const headerText = document.querySelector('[name=headerText]').value;
      const params = new URLSearchParams({ primaryColor, accentColor, headerText });

      document.querySelectorAll('.layout-option-frame iframe').forEach(iframe => {
        const layoutId = iframe.src.split('/preview/')[1].split('?')[0];
        iframe.src = `/dashboard/settings/receipt/preview/${layoutId}?${params}`;
      });
    }

    let refreshTimer;
    ['primaryColor', 'accentColor', 'headerText'].forEach(name => {
      const el = document.querySelector(`[name=${name}]`);
      el.addEventListener('input', () => {
        clearTimeout(refreshTimer);
        refreshTimer = setTimeout(refreshPreviews, 400); // debounce so it doesn't refresh on every keystroke
      });
    });
  </script>
</body>
</html>
