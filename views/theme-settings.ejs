<!-- views/theme-settings.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Receipt Settings</title>
  <style>
    h1 { font-size: 22px; }
    h2 { font-size: 15px; margin-top: 28px; margin-bottom: 8px; color: #555; }
    label { display: block; font-size: 13px; font-weight: 600; margin-top: 14px; margin-bottom: 4px; }
    input[type=text], input[type=url] { width: 100%; padding: 9px 10px; border: 1px solid #ddd; border-radius: 6px; box-sizing: border-box; font-size: 14px; }
    input[type=color] { width: 60px; height: 36px; border: 1px solid #ddd; border-radius: 6px; padding: 2px; }
    .toggle-row { display: flex; align-items: center; gap: 8px; margin-top: 14px; }
    .toggle-row label { margin: 0; font-weight: 500; }
    .hint { font-size: 12px; color: #888; margin-top: 4px; }
    .banner { padding: 10px 14px; border-radius: 8px; font-size: 13px; margin-bottom: 16px; }
    .banner.success { background: #ecfdf5; color: #047857; }
    .banner.error { background: #fef2f2; color: #dc2626; }
    button { margin-top: 24px; width: 100%; padding: 12px; background: #2563eb; color: #fff; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; }
    .google-section { background: #f9fafb; border-radius: 8px; padding: 14px; margin-top: 20px; }
    .google-g-small { width: 18px; height: 18px; vertical-align: middle; margin-right: 6px; }

    .layout-picker { display: flex; gap: 20px; margin-bottom: 8px; }
    .layout-option { flex: 1 1 0; min-width: 0; max-width: 280px; cursor: pointer; }
    .layout-option-frame {
      width: 100%; aspect-ratio: 420 / 620; border: 2px solid #e5e7eb; border-radius: 10px;
      overflow: hidden; position: relative; background: #f4f4f5;
    }
    .layout-option.selected .layout-option-frame { border-color: #2563eb; box-shadow: 0 0 0 2px rgba(37,99,235,0.15); }
    .layout-option-frame iframe {
      width: 420px; height: 620px; border: none;
      transform-origin: top left;
      pointer-events: none;
    }
    .layout-option-label { text-align: center; font-size: 13px; font-weight: 600; margin-top: 8px; }
    .expand-btn-overlay {
      position: absolute; bottom: 6px; left: 50%; transform: translateX(-50%);
      width: auto; margin: 0;
      background: rgba(255,255,255,0.92); border: 1px solid #ddd; border-radius: 6px;
      padding: 3px 10px; font-size: 11px; color: #555; cursor: pointer; z-index: 2;
    }
    .expand-btn-overlay:hover { background: #fff; }

    /* --- Full-size preview modal --- */
    .preview-modal-overlay {
      display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.55);
      align-items: center; justify-content: center; z-index: 200; padding: 24px;
    }
    .preview-modal-overlay.open { display: flex; }
    .preview-modal-box {
      background: #fff; border-radius: 14px; padding: 16px 16px 20px;
      max-height: 90vh; display: flex; flex-direction: column; align-items: center;
      position: relative;
    }
    .preview-modal-head { display: flex; align-items: center; width: 420px; max-width: 100%; margin-bottom: 10px; }
    .preview-modal-title { font-size: 15px; font-weight: 700; }
    .preview-modal-close {
      position: absolute; top: 12px; right: 12px;
      width: 44px; height: 44px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      border: none; background: #f4f4f5; padding: 0;
      cursor: pointer; color: #555; z-index: 3;
    }
    .preview-modal-close:hover { background: #e5e7eb; }
    .preview-modal-frame-wrap { width: 420px; max-width: 100%; height: 70vh; overflow-y: auto; border: 1px solid #e5e7eb; border-radius: 10px; }
    .preview-modal-frame-wrap iframe { width: 100%; height: 620px; border: none; }
  </style>
</head>
<body>
  <%- include('partials/dashboard-header', { activeNav: 'settings', isDemoAccount: merchant.isDemoAccount }) %>

  <div class="topbar">
    <div>
      <h1>Receipt Settings</h1>
      <p class="sub">Customize how your receipts look and what they include.</p>
    </div>
  </div>

  <div class="app-body">

  <% if (merchant.isDemoAccount) { %>
    <div style="background:#eef2ff; border-radius:10px; padding:14px 18px; margin-bottom:16px; display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;">
      <div>
        <strong style="font-size:13.5px; color:#3730a3;">See it as a customer would</strong>
        <div style="font-size:12.5px; color:#4338ca; margin-top:2px;">
          Sends a test receipt using your real saved design — no POS or real sale needed.
        </div>
      </div>
      <button type="button" id="test-sale-btn" onclick="sendTestReceipt()" style="width:auto; margin:0; padding:10px 18px; background:#4338ca;">Send test receipt</button>
    </div>
    <div id="test-sale-result" style="display:none; background:#f9fafb; border-radius:10px; padding:18px; margin-bottom:16px; text-align:center;">
      <img id="test-sale-qr" src="" alt="Scan to open your test receipt on your phone" style="width:160px; height:160px; border-radius:8px;" />
      <div style="font-size:12.5px; color:#888; margin-top:8px;">Scan with your phone, or</div>
      <a id="test-sale-link" href="#" target="_blank" style="font-size:13.5px; color:#2563eb; font-weight:600; text-decoration:none;">open it in a new tab &rarr;</a>
    </div>
    <div id="test-sale-error" class="banner error" style="display:none;"></div>
  <% } %>

  <% if (saved) { %><div class="banner success">Settings saved.</div><% } %>
  <% if (error) { %><div class="banner error"><%= error %></div><% } %>

  <form method="POST" action="/dashboard/settings/receipt" enctype="multipart/form-data">

    <h2 style="margin-top:0;">Receipt Layout</h2>
    <div class="layout-picker">
      <% ['classic', 'modern', 'minimal'].forEach(function(id) { %>
        <div class="layout-option <%= (theme.layoutId || 'classic') === id ? 'selected' : '' %>" data-layout-id="<%= id %>">
          <div class="layout-option-frame" onclick="selectLayout('<%= id %>')">
            <iframe src="/dashboard/settings/receipt/preview/<%= id %>" scrolling="no"></iframe>
            <button type="button" class="expand-btn-overlay" onclick="event.stopPropagation(); openPreviewModal('<%= id %>');">View</button>
          </div>
          <div class="layout-option-label">
            <%= id.charAt(0).toUpperCase() + id.slice(1) %>
          </div>
        </div>
      <% }); %>
    </div>
    <input type="hidden" name="layoutId" id="layoutId-input" value="<%= theme.layoutId || 'classic' %>" />

    <h2>Branding</h2>
    <label>Upload your logo</label>
    <input type="file" name="logoFile" accept="image/png,image/jpeg,image/webp,image/svg+xml" />
    <div class="hint">PNG, JPG, WEBP, or SVG — up to 2MB.</div>

    <label>Primary color</label>
    <input type="color" name="primaryColor" value="<%= theme.primaryColor || '#111111' %>" />

    <label>Accent color</label>
    <input type="color" name="accentColor" value="<%= theme.accentColor || '#2563eb' %>" />

    <label>Business name on receipts</label>
    <input type="text" name="displayName" value="<%= theme.displayName || '' %>" placeholder="<%= merchant.businessName %>" />
    <div class="hint">Shown to customers on receipts instead of your account name (<%= merchant.businessName %>). Leave blank to just use your account name.</div>

    <label>Business location</label>
    <input type="text" name="location" value="<%= theme.location || '' %>" placeholder="123 Main St, Springfield" />
    <div class="hint">Shown on receipts under your business name. Leave blank to not show a location.</div>

    <label>Business phone</label>
    <input type="text" name="phone" value="<%= theme.phone || '' %>" placeholder="(555) 123-4567" />
    <div class="hint">Shown on receipts under your address. Leave blank to not show a phone number.</div>

    <label>Header message</label>
    <input type="text" name="headerText" value="<%= theme.headerText || '' %>" placeholder="Thanks for shopping with us!" />

    <label>Footer message</label>
    <input type="text" name="footerText" value="<%= theme.footerText || '' %>" placeholder="Returns accepted within 14 days." />

    <div class="google-section">
      <h2 style="margin-top:0;">🍁 Tax &amp; Compliance</h2>

      <label>GST/HST number</label>
      <input type="text" name="gstHstNumber" value="<%= theme.gstHstNumber || '' %>" placeholder="123456789 RT0001" />
      <div class="hint">
        Required on receipts for purchases of $30 or more if you want customers to be able to claim
        an input tax credit. Leave blank if you're not GST/HST registered.
      </div>

      <label>Tax label</label>
      <input type="text" name="taxLabel" value="<%= theme.taxLabel || 'Tax' %>" placeholder="GST/HST" style="max-width:220px;" />
      <div class="hint">What the tax line on your receipt is called — e.g. "GST/HST" or "GST/HST + PST".</div>

      <label>Return/refund policy</label>
      <input type="text" name="returnPolicy" value="<%= theme.returnPolicy || '' %>" placeholder="Returns accepted within 30 days with receipt." />
      <div class="hint">Shown on receipts as your return policy, separate from the general footer message above.</div>
    </div>

    <div class="google-section">
      <h2 style="margin-top:0;">
        <svg class="google-g-small" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
          <path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/>
          <path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/>
          <path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z"/>
          <path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"/>
        </svg>
        Google Review Link
      </h2>
      <label>Your Google review link</label>
      <input type="url" name="googleReviewUrl" value="<%= theme.googleReviewUrl || '' %>" placeholder="https://g.page/r/your-business/review" />
      <div class="hint">
        Find yours: search your business on Google, click your Business Profile,
        click "Ask for reviews," and copy the link it gives you — or go to
        <strong>business.google.com</strong> → your location → "Get more reviews."
      </div>
      <div class="toggle-row">
        <input type="checkbox" id="showGoogleReview" name="showGoogleReview" <%= theme.showGoogleReview ? 'checked' : '' %> />
        <label for="showGoogleReview">Show "Rate us on Google" on receipts</label>
      </div>
    </div>

    <div class="google-section">
      <h2 style="margin-top:0;">🎁 Loyalty Program</h2>
      <label>Reward customers after 5 punches</label>
      <div style="display:flex; gap:10px; align-items:center; margin-top:4px;">
        <select name="loyaltyOfferType" id="loyaltyOfferType" style="padding:9px 10px; border:1px solid #ddd; border-radius:6px; font-size:14px;">
          <option value="PERCENT" <%= loyalty.offerType === 'PERCENT' ? 'selected' : '' %>>% off</option>
          <option value="AMOUNT" <%= loyalty.offerType === 'AMOUNT' ? 'selected' : '' %>>$ off</option>
        </select>
        <input type="number" name="loyaltyOfferValue" id="loyaltyOfferValue" min="1" step="<%= loyalty.offerType === 'AMOUNT' ? '0.01' : '1' %>" value="<%= loyalty.offerValue %>" style="width:110px; padding:9px 10px; border:1px solid #ddd; border-radius:6px; box-sizing:border-box; font-size:14px;" />
        <span style="font-size:13px; color:#555;">their next order</span>
      </div>
      <div class="hint">Example: "10" with "% off" gives customers 10% off once they've collected all 5 punches.</div>

      <label>Redemption code</label>
      <input type="text" name="loyaltyRedemptionCode" id="loyaltyRedemptionCode" value="<%= loyalty.redemptionCode %>" maxlength="40" style="max-width:220px;" placeholder="e.g. REWARD5" />
      <div class="hint">
        Once a customer fills all 5 punches, they redeem it themselves by typing in this code —
        tell your staff what it is. Change it any time; the new code takes effect immediately.
      </div>

      <div class="toggle-row">
        <input type="checkbox" id="loyaltyEnabled" name="loyaltyEnabled" <%= loyalty.enabled ? 'checked' : '' %> />
        <label for="loyaltyEnabled">Show the loyalty punch card on receipts</label>
      </div>
    </div>

    <div class="google-section">
      <h2 style="margin-top:0;">🤝 Partner Program</h2>
      <div class="hint">
        Promote ReceipTap to other business owners right on your receipts. If someone signs up
        through your link, you earn a <strong><%= merchantAffiliateRate %>% recurring commission</strong>
        on their subscription — see your
        <a href="/dashboard/referrals" target="_blank">Partner Program dashboard</a> for details.
      </div>
      <div class="toggle-row">
        <input type="checkbox" id="showPartnerProgram" name="showPartnerProgram" <%= theme.showPartnerProgram ? 'checked' : '' %> />
        <label for="showPartnerProgram">Show a "Interested in digital receipts for your business? Try ReceipTap FREE" banner at the top of receipts</label>
      </div>
    </div>

    <h2>Social Media Links</h2>
    <div class="hint" style="margin-bottom: 10px;">
      Add your social profiles and customers will see clickable icons on their receipt. Leave any blank to hide that icon.
    </div>
    <label>Instagram</label>
    <input type="url" name="instagramUrl" value="<%= theme.instagramUrl || '' %>" placeholder="https://instagram.com/yourbusiness" />

    <label>Facebook</label>
    <input type="url" name="facebookUrl" value="<%= theme.facebookUrl || '' %>" placeholder="https://facebook.com/yourbusiness" />

    <label>TikTok</label>
    <input type="url" name="tiktokUrl" value="<%= theme.tiktokUrl || '' %>" placeholder="https://tiktok.com/@yourbusiness" />

    <label>X (Twitter)</label>
    <input type="url" name="xUrl" value="<%= theme.xUrl || '' %>" placeholder="https://x.com/yourbusiness" />

    <label>YouTube</label>
    <input type="url" name="youtubeUrl" value="<%= theme.youtubeUrl || '' %>" placeholder="https://youtube.com/@yourbusiness" />

    <label>LinkedIn</label>
    <input type="url" name="linkedinUrl" value="<%= theme.linkedinUrl || '' %>" placeholder="https://linkedin.com/company/yourbusiness" />

    <h2>Other receipt options</h2>
    <div class="toggle-row">
      <input type="checkbox" id="showWarranty" name="showWarranty" <%= theme.showWarranty ? 'checked' : '' %> />
      <label for="showWarranty">Show "Register Warranty"</label>
    </div>

    <button type="submit">Save Settings</button>
  </form>

  </div>

  <!-- Full-size preview: same live data as the thumbnails, just readable -->
  <div class="preview-modal-overlay" id="preview-modal" onclick="if (event.target === this) closePreviewModal();">
    <div class="preview-modal-box">
      <button type="button" class="preview-modal-close" onclick="closePreviewModal();">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
      <div class="preview-modal-head">
        <div class="preview-modal-title" id="preview-modal-title">Preview</div>
      </div>
      <div class="preview-modal-frame-wrap">
        <iframe id="preview-modal-frame" scrolling="yes"></iframe>
      </div>
    </div>
  </div>

  <script>
    // The preview iframes are always rendered at their true 420x620 size,
    // then scaled down to fit however wide each thumbnail actually rendered
    // -- keeps them proportioned at any window width instead of a fixed
    // pixel size that overflows on narrower screens.
    function resizeLayoutPreviews() {
      document.querySelectorAll('.layout-option-frame').forEach(frame => {
        const scale = frame.clientWidth / 420;
        frame.querySelector('iframe').style.transform = `scale(${scale})`;
      });
    }
    window.addEventListener('resize', resizeLayoutPreviews);
    resizeLayoutPreviews();

    // Demo tier only -- see the button's `<% if (merchant.isDemoAccount) %>`
    // guard above; the server independently rejects this for anyone else.
    async function sendTestReceipt() {
      const btn = document.getElementById('test-sale-btn');
      const errorBox = document.getElementById('test-sale-error');
      errorBox.style.display = 'none';
      btn.disabled = true;
      btn.textContent = 'Sending…';
      try {
        const res = await fetch('/dashboard/settings/receipt/test-sale', { method: 'POST' });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Something went wrong.');

        document.getElementById('test-sale-qr').src = data.qrDataUrl;
        document.getElementById('test-sale-link').href = data.receiptUrl;
        document.getElementById('test-sale-result').style.display = 'block';
        window.open(data.receiptUrl, '_blank');
      } catch (err) {
        errorBox.textContent = err.message;
        errorBox.style.display = 'block';
      } finally {
        btn.disabled = false;
        btn.textContent = 'Send test receipt';
      }
    }

    function selectLayout(id) {
      document.getElementById('layoutId-input').value = id;
      document.querySelectorAll('.layout-option').forEach(el => el.classList.remove('selected'));
      document.querySelector(`.layout-option[data-layout-id="${id}"]`).classList.add('selected');
    }

    // Percent offers are whole numbers 1-100; dollar offers allow cents --
    // adjust the value field's constraints to match whichever is selected.
    function updateLoyaltyValueConstraints() {
      const type = document.getElementById('loyaltyOfferType').value;
      const valueInput = document.getElementById('loyaltyOfferValue');
      if (type === 'PERCENT') {
        valueInput.step = '1';
        valueInput.max = '100';
      } else {
        valueInput.step = '0.01';
        valueInput.removeAttribute('max');
      }
    }
    document.getElementById('loyaltyOfferType').addEventListener('change', updateLoyaltyValueConstraints);
    updateLoyaltyValueConstraints();

    // Gathers every field that actually affects the rendered receipt, so both
    // the small thumbnails and the full-size modal always show the merchant's
    // real current (even if unsaved) choices -- never a stale or partial preview.
    function buildPreviewParams() {
      const val = (name) => document.querySelector(`[name=${name}]`).value;
      const checked = (id) => document.getElementById(id).checked;
      return new URLSearchParams({
        primaryColor: val('primaryColor'),
        accentColor: val('accentColor'),
        headerText: val('headerText'),
        footerText: val('footerText'),
        displayName: val('displayName'),
        location: val('location'),
        phone: val('phone'),
        gstHstNumber: val('gstHstNumber'),
        taxLabel: val('taxLabel'),
        returnPolicy: val('returnPolicy'),
        googleReviewUrl: val('googleReviewUrl'),
        showGoogleReview: checked('showGoogleReview'),
        showWarranty: checked('showWarranty'),
        showPartnerProgram: checked('showPartnerProgram'),
        instagramUrl: val('instagramUrl'),
        facebookUrl: val('facebookUrl'),
        tiktokUrl: val('tiktokUrl'),
        xUrl: val('xUrl'),
        youtubeUrl: val('youtubeUrl'),
        linkedinUrl: val('linkedinUrl'),
        loyaltyEnabled: checked('loyaltyEnabled'),
        loyaltyOfferType: val('loyaltyOfferType'),
        loyaltyOfferValue: val('loyaltyOfferValue'),
      });
    }

    // Live-update the 3 preview thumbnails as the merchant edits any setting,
    // so they can see how each layout looks with THEIR branding before saving.
    function refreshPreviews() {
      const params = buildPreviewParams();
      document.querySelectorAll('.layout-option-frame iframe').forEach(iframe => {
        const layoutId = iframe.src.split('/preview/')[1].split('?')[0];
        iframe.src = `/dashboard/settings/receipt/preview/${layoutId}?${params}`;
      });
    }

    function openPreviewModal(layoutId) {
      const params = buildPreviewParams();
      const frame = document.getElementById('preview-modal-frame');
      // Auto-size the iframe to its actual content once it loads, so
      // everything below the fold (Google review card, warranty, loyalty,
      // footer) is reachable via one obvious scroll on the modal itself,
      // rather than a easy-to-miss scrollbar nested inside the iframe.
      frame.style.height = '620px';
      frame.onload = function () {
        try {
          const doc = frame.contentDocument || frame.contentWindow.document;
          frame.style.height = doc.documentElement.scrollHeight + 'px';
        } catch (e) {
          // Cross-origin or not-yet-ready -- keep the default height
        }
      };
      frame.src = `/dashboard/settings/receipt/preview/${layoutId}?${params}`;
      document.getElementById('preview-modal-title').textContent = layoutId.charAt(0).toUpperCase() + layoutId.slice(1) + ' layout';
      document.getElementById('preview-modal').classList.add('open');
    }
    function closePreviewModal() {
      document.getElementById('preview-modal').classList.remove('open');
    }

    let refreshTimer;
    ['primaryColor', 'accentColor', 'headerText', 'footerText', 'displayName', 'location', 'phone', 'gstHstNumber', 'taxLabel', 'returnPolicy', 'googleReviewUrl', 'instagramUrl', 'facebookUrl', 'tiktokUrl', 'xUrl', 'youtubeUrl', 'linkedinUrl', 'loyaltyOfferValue'].forEach(name => {
      document.querySelector(`[name=${name}]`).addEventListener('input', () => {
        clearTimeout(refreshTimer);
        refreshTimer = setTimeout(refreshPreviews, 400); // debounce so it doesn't refresh on every keystroke
      });
    });
    ['showGoogleReview', 'showWarranty', 'loyaltyEnabled', 'showPartnerProgram'].forEach(id => {
      document.getElementById(id).addEventListener('change', refreshPreviews);
    });
    document.getElementById('loyaltyOfferType').addEventListener('change', refreshPreviews);

    // Instant logo preview: reads the picked file locally (nothing is
    // uploaded until Save) and pushes it into the preview iframes via
    // postMessage, so the thumbnails/modal update immediately instead of
    // only reflecting the logo after it's actually been saved.
    function broadcastLogoPreview(dataUrl) {
      const frames = document.querySelectorAll('.layout-option-frame iframe, #preview-modal-frame');
      frames.forEach(iframe => {
        if (iframe.contentWindow) {
          iframe.contentWindow.postMessage({ type: 'receiptap-logo-preview', dataUrl }, window.location.origin);
        }
      });
    }

    const logoFileInput = document.querySelector('[name=logoFile]');
    if (logoFileInput) {
      logoFileInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = () => broadcastLogoPreview(reader.result);
        reader.readAsDataURL(file);
      });
    }
  </script>
</body>
</html>
